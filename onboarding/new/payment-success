// /payment-success — landing page after Stripe Checkout
//
// Stripe only sends the user here after a successful payment, so landing
// on this page IS the confirmation. The success state renders immediately
// with trial dates computed client-side (today → today + 7 days); nothing
// waits on the database or the Stripe webhook. The record write happens
// in the background behind the already-visible UI.
//
// (Earlier revision polled the subscription_status lookup before showing
// success. That lookup can't resolve until the webhook writes billing and
// links the account, so first-time payers sat on a "finishing your setup"
// screen and only saw success after a manual reload. Gone.)
//
// On landing we persist the trial window to the user row in the
// brieflee beta users table (idempotent — only on first visit):
//   - trial_start (J06K2): now
//   - trial_end   (5cUNI): now + 7 days
//
// A computed FORMULA field `trialing` (YtEyS) on the same row evaluates
// AND(trial_start != BLANK, trial_end != BLANK, trial_start <= NOW, NOW <= trial_end)
// so the rest of the app can branch on a single boolean.
//
// IMPORTANT — Google Ads conversion tag:
//   The Google Tag for conversion tracking lives in Softr's Page
//   Settings → Custom Code → Header for /payment-success. It is NOT
//   in this block. Updating the block does not touch the tag; it
//   will keep firing on page load as before.
//
// SOFTR UI SETUP:
//   Source tab → Database: brieflee beta → Table: users.
//   The block scopes itself in code via useCurrentUser; the source
//   binding is still required so the data layer knows the table.

import { useEffect, useRef, useState } from "react";
import { useRecord, useRecordUpdate, q } from "@/lib/datasource";
import { useCurrentUser } from "@/lib/user";
import { Button } from "@/components/ui/button";
import { ArrowRight } from "lucide-react";

// brieflee beta users table — field aliases for the per-user write + read.
// Source: Tables API GET /tables/brpbVf8sL2xqxV.
const userFields = q.select({
  trialStart: "J06K2",  // DATETIME
  trialEnd:   "5cUNI",  // DATETIME
});

// UPDATE select — writable fields only. A read-only field (lookup/formula)
// in an update hook's map stops Softr's analyzer registering ANY action,
// which disables the write for everyone. Same split as app/settings/workspace.
const writeFields = q.select({
  trialStart: "J06K2",
  trialEnd:   "5cUNI",
});

const TRIAL_DAYS = 7;
const NEXT_PATH = "/set-up";

const SMILE_LOGO =
  "https://res.cloudinary.com/dchroynzv/image/upload/v1777622985/brieflee_logo_primary-logo-blue-wordmark-smiley-mark_2025-03.png";

const BL_NAVY       = "#001364";
const BL_DEEP       = "#000F4D";
const BL_PERIWINKLE = "#879CF7";
const BL_MUTED      = "#6B7A99";

export default function Block() {
  const user = useCurrentUser();
  const { data, status } = useRecord({ recordId: user?.id, select: userFields });
  const updateRecord = useRecordUpdate({ fields: writeFields });
  const hasInitialisedRef = useRef(false);

  // Trial end shown on screen. Computed on first render (today + 7 days)
  // so the page is complete on paint — no data fetch in the critical path.
  // If the record turns out to hold real dates, they replace this silently.
  const [trialEndDate, setTrialEndDate] = useState(() => {
    const d = new Date();
    d.setDate(d.getDate() + TRIAL_DAYS);
    return d;
  });

  // ----- Idempotent trial-date persistence, behind the visible UI -----
  useEffect(() => {
    if (status !== "success") return;
    if (!user?.id) return;
    if (hasInitialisedRef.current) return;
    hasInitialisedRef.current = true;

    const existingStart = data?.fields?.trialStart;
    const existingEnd   = data?.fields?.trialEnd;

    if (existingStart) {
      // Returning visit — the record is the source of truth.
      const end = existingEnd
        ? new Date(existingEnd)
        : (() => { const d = new Date(existingStart); d.setDate(d.getDate() + TRIAL_DAYS); return d; })();

      if (end.getTime() < Date.now()) {
        // Trial over — this page has nothing to show; go to the dashboard.
        if (typeof window !== "undefined") window.location.replace("/new");
        return;
      }

      setTrialEndDate(end);
      return;
    }

    // First visit: write trial_start = now, trial_end = now + 7 days.
    const now = new Date();
    const end = new Date(now);
    end.setDate(end.getDate() + TRIAL_DAYS);
    setTrialEndDate(end);

    updateRecord
      .mutateAsync({
        recordId: user.id,
        fields: {
          trialStart: now.toISOString(),
          trialEnd:   end.toISOString(),
        },
      })
      .catch((err) => {
        console.error("Failed to persist trial dates:", err);
      });
  }, [status, user?.id, data?.fields?.trialStart, data?.fields?.trialEnd, updateRecord]);

  const formattedDate = trialEndDate.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

  return (
    <>
      <Style />
      <div className="bl-paysuccess">
        <div className="bl-paysuccess-inner">
          <img
            src={SMILE_LOGO}
            alt="Brieflee"
            className="bl-paysuccess-logo"
          />

          <h1 className="bl-paysuccess-title">Welcome to Brieflee!</h1>

          <p className="bl-paysuccess-trial">
            Your {TRIAL_DAYS}-day free trial is now active. You won't be
            charged until {formattedDate}.
          </p>

          <p className="bl-paysuccess-body">
            Your AI video quality checker is ready to use. Finish your quick
            setup to start reviewing your first videos in minutes.
          </p>

          <Button
            onClick={() => (window.location.href = NEXT_PATH)}
            className="bl-paysuccess-cta font-semibold gap-2"
            style={{ backgroundColor: BL_PERIWINKLE, color: "#fff" }}
          >
            Complete setup
            <ArrowRight className="h-4 w-4" />
          </Button>

          <p className="bl-paysuccess-fineprint">
            You can cancel anytime before {formattedDate} and you won't be
            charged.
          </p>
        </div>
      </div>
    </>
  );
}

function Style() {
  return (
    <style>
      {`
        @import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700&display=swap');

        .bl-paysuccess,
        .bl-paysuccess * {
          font-family: 'League Spartan', sans-serif;
        }

        .bl-paysuccess {
          min-height: 100vh;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 32px 20px;
          box-sizing: border-box;
        }

        .bl-paysuccess-inner {
          width: 100%;
          max-width: 520px;
          text-align: center;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        .bl-paysuccess-logo {
          width: 96px;
          height: 96px;
          object-fit: contain;
          margin-bottom: 24px;
          display: block;
        }

        .bl-paysuccess-title {
          font-size: 32px;
          font-weight: 700;
          color: ${BL_DEEP};
          letter-spacing: -0.015em;
          line-height: 1.15;
          margin: 0 0 14px;
        }

        .bl-paysuccess-trial {
          font-size: 16px;
          color: ${BL_NAVY};
          line-height: 1.55;
          margin: 0 0 18px;
          max-width: 440px;
        }

        .bl-paysuccess-body {
          font-size: 14px;
          color: ${BL_MUTED};
          line-height: 1.6;
          margin: 0 0 28px;
          max-width: 440px;
        }

        .bl-paysuccess-cta {
          font-size: 14px;
          padding: 10px 20px;
          height: 40px;
          border-radius: 8px;
          margin-bottom: 18px;
        }
        .bl-paysuccess-cta:hover:not(:disabled) {
          background-color: #294FF6 !important;
        }

        .bl-paysuccess-fineprint {
          font-size: 12px;
          color: ${BL_MUTED};
          line-height: 1.5;
          margin: 0;
          max-width: 360px;
        }

      `}
    </style>
  );
}
