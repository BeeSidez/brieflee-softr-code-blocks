.bl-sub{font-size:15px;line-height:1.5;color:var(--body);max-width:46ch;text-align:left}
.bl-tabs{display:inline-flex;gap:2px;padding:4px;background:rgba(255,255,255,.85);border:1px solid var(--bd2);border-radius:999px;box-shadow:0 1px 3px rgba(0,15,77,.06)}
