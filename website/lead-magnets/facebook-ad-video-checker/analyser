// Mounted only when a ?score= record id is present, so useRecord never
// queries with an empty id (failed queries retry on a timer and toast).
function ReturnScoreLoader({ recordId, onFields, onMiss }) {
  const { data, status } = useRecord({ recordId, select: readFields, from: ds.scores });
  const done = useRef(false);
  useEffect(() => {
    if (done.current) return;
    if (status === "error") { done.current = true; onMiss(); return; }
    if (data?.fields) { done.current = true; onFields(data.fields); }
  }, [data, status, onFields, onMiss]);
  return null;
}

