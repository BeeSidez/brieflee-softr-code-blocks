                  <div className="bl-faqitem" key={f.q}>
                    <button type="button" aria-expanded={openFaq === i} onClick={() => setOpenFaq(openFaq === i ? -1 : i)}>
                      <h3>{f.q}</h3>
                      <span className={openFaq === i ? "bl-faqtoggle bl-open" : "bl-faqtoggle"}>{openFaq === i ? <MinusIcon /> : <PlusIcon />}</span>
                    </button>
                    <div className={openFaq === i ? "bl-faqbody bl-open" : "bl-faqbody"}><div><p>{f.a}</p></div></div>
                  </div>
                ))}
              </div>
            </div>
          </section>

          {/* ── Final CTA (v2 block design: light band + glow blobs) ── */}
          <section className="bl-lsec bl-final">
            <span className="bl-fblob bl-fblob-a" /><span className="bl-fblob bl-fblob-b" />
            <div className="bl-finalwrap2">
              <span className="bl-pillbadge"><img src={EYES_STICKER} alt="" draggable={false} />Free to use</span>
              <h2>Check one. Then decide about the budget.</h2>
              <p>Paste the URL and 24 Review Agents watch it for you. A score out of 100 and a flag on everything you would have caught on a good week.</p>
              <div className="bl-logostrip">
                <img src={TIKTOK_LOGO} alt="" style={{ transform: "rotate(-6deg)" }} />
                <img src={IG_LOGO} alt="" style={{ transform: "rotate(6deg)" }} />
                <img src={YT_LOGO} alt="" style={{ transform: "rotate(-6deg)" }} />
                <img src={FB_LOGO} alt="" style={{ transform: "rotate(6deg)" }} />
                <img src={UPLOAD_LOGO} alt="" style={{ transform: "rotate(-6deg)" }} />
              </div>
              <div className="bl-ctastack">
                <button className="bl-btn" onClick={scrollTop}><UpArrowIcon />Check a video</button>
              </div>
            </div>
          </section>
        </>
      )}

      {/* ── Gate (work email BEFORE anything runs) ── */}
      {page === "gate" && (
        <div className="bl-gatewrap">
          <div className="bl-gatevid">
            <span className="bl-gvshot"><img src={EYES} alt="" /></span>
            <div className="bl-gvmeta">
              <span className="bl-minilabel">Ready to watch</span>
              <b>{nowWatching || "Your video"}</b>
              <span className="bl-gvsub">Facebook · {tab === "url" ? "pasted just now" : "uploaded just now"}</span>
            </div>
          </div>
          <div className="bl-card bl-gatecard">
            <h3>See all 24 checks</h3>
            <p>Every flag with a timestamp and the frame beside it, so your feedback to the creator names a second instead of a feeling.</p>
            <span className="bl-fieldlabel">Your work email</span>
            <label className="bl-input">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /></svg>
              <input type="email" value={email} autoFocus onChange={(e) => setEmail(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter" && !busy) handleGateSubmit(); }} placeholder="you@company.com" />
            </label>
            <span className="bl-fieldlabel">Company website</span>
            <label className="bl-input">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round"><circle cx="12" cy="12" r="9" /><path d="M3.5 9.5h17M3.5 14.5h17M12 3a15 15 0 0 1 0 18A15 15 0 0 1 12 3Z" /></svg>
              <input type="text" value={website} onChange={(e) => setWebsite(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter" && !busy) handleGateSubmit(); }} placeholder="brieflee.co" />
            </label>
            <button className="bl-btn bl-w100" disabled={busy} onClick={handleGateSubmit}>{busy ? "Starting..." : "Send my full check"}</button>
            <p className="bl-microcopy">Free email addresses are not accepted, so use the one you use for the business.</p>
            <label className="bl-optin">
              <input type="checkbox" checked={optIn} onChange={(e) => setOptIn(e.target.checked)} />
              <span>Send me Brieflee's guides on briefing creators. Unsubscribe anytime.</span>
            </label>
            {error ? <p className="bl-error" role="alert">{error}</p> : null}
          </div>
          <button className="bl-backlink" onClick={() => { setPage("input"); setError(""); }}>Back</button>
          <div className="bl-truststrip bl-center"><span><i className="bl-pulse" />24 Review Agents</span><span><CheckIcon />Under 60 seconds</span><span><CheckIcon />Free</span></div>
        </div>
      )}

      {/* ── Processing ── */}
      {(page === "processing" || page === "loadingReturn") && (
        <div className="bl-proc">
          {page === "processing" && nowWatching ? (
            <div className="bl-gatevid bl-procvid">
              <span className="bl-gvshot"><img src={EYES} alt="" /></span>
              <div className="bl-gvmeta">
                <span className="bl-minilabel">Now watching</span>
                <b>{nowWatching}</b>
                <span className="bl-gvsub">Facebook · {tab === "url" ? "pasted just now" : "uploaded just now"}</span>
              </div>
            </div>
          ) : null}
          {procSrc || procImg ? (
            <div className="bl-procscan">
              {procSrc
                ? <video src={procSrc} muted autoPlay loop playsInline onError={() => setProcSrc("")} />
                : <img src={procImg} alt="" onError={() => setProcImg("")} />}
              <span className="bl-scanui"><i className="bl-k bl-k1" /><i className="bl-k bl-k2" /><i className="bl-k bl-k3" /><i className="bl-k bl-k4" /><i className="bl-scanline" /></span>
            </div>
          ) : (
            <div className="bl-halo"><img src={EYES} alt="Review Agents" /></div>
          )}
          <h2>24 agents watching</h2>
          <p className="bl-status">{STATUS_LINES[statusIdx % STATUS_LINES.length]}</p>
          <div className="bl-barind" />
          <div className="bl-dots">{Array.from({ length: 24 }, (_, j) => <i key={j} className={j <= (statusIdx * 3) % 25 ? "bl-on" : ""} />)}</div>
          <p className="bl-cnt">Usually takes under a minute. Keep this tab open.</p>
        </div>
      )}

      {/* ── Score reveal ── */}
      {page === "score" && analysis && (
        <div className="bl-scorepad">
          <div className="bl-dlbar"><button className="bl-btn bl-sm" onClick={handleDownloadReport}>Download report</button></div>
          <div className="bl-scoreside">
            <div>
              <div className="bl-scard">
                <div className="bl-scard-top">
                  <div className="bl-thumb">{analysis.thumb ? <img src={analysis.thumb} alt="Scored video" /> : null}<b>{analysis.duration ? fmtTs(analysis.duration) : ""}</b></div>
                  <Ring score={analysis.overall.score} size="lg" />
                </div>
                <div className="bl-metarow">
                  <span className="bl-lbl">Video score</span>
                  <span className="bl-h">{analysis.handle || "Your video"}</span>
                  <span className="bl-sm">{analysis.overall.checks_passed} of 24 checks passed</span>
                </div>
                <p className="bl-verdict">{analysis.overall.verdict}</p>
                <div className="bl-checks">
                  {(analysis.headline || []).map((h) => (
                    <div className="bl-checkrow" key={h.label}><span className="bl-nm">{h.label}</span><Pill kind={h.status === "PASS" ? "pass" : "flag"}>{h.status === "PASS" ? "Pass" : "Flag"}</Pill></div>
                  ))}
                </div>
                <div className="bl-mark">
                  <span className="bl-mark-l"><img src={EYES} alt="" /><b>Scored by Brieflee</b></span>
                  <span className="bl-mark-r">brieflee.co/score</span>
                </div>
              </div>
              <div className="bl-cropnote"><span>Shareable crop ends at the watermark edge.</span></div>
            </div>
            <div className="bl-aside">
              <div className="bl-sechead bl-left"><h2>Your full breakdown is ready</h2><p>All 24 checks with timestamps are below, and a copy is on its way to {email || "your inbox"}.</p></div>
              <button className="bl-btn" onClick={() => { setPage("breakdown"); scrollTop(); }}>See all 24 checks<ArrowIcon /></button>
              <div className="bl-sharerow">
                <button className="bl-btn bl-sm bl-ghost" onClick={handleDownloadReport}>Download report</button>
                <button className="bl-btn bl-sm bl-ghost" onClick={handleCopyLink}>Copy link</button>
                <button className="bl-btn bl-sm bl-ghost" onClick={handleShare}>Share</button>
              </div>
              <div className="bl-truststrip"><span><i className="bl-pulse" />24 Review Agents</span><span><CheckIcon />Under 60 seconds</span><span><CheckIcon />Free</span></div>
            </div>
          </div>
        </div>
      )}

      {/* ── Full breakdown + close ── */}
      {page === "breakdown" && analysis && (
        <div className="bl-scorepad">
          <div className="bl-dlbar"><button className="bl-btn bl-sm" onClick={handleDownloadReport}>Download report</button></div>
          <div className="bl-band">
            <span className="bl-band-num">{analysis.overall.score}<sup>/100</sup></span>
            <span className="bl-band-txt">{analysis.overall.checks_passed} of 24 checks passed</span>
            <span className="bl-track"><b style={{ width: `${Math.round((analysis.overall.checks_passed / 24) * 100)}%` }} /></span>
          </div>
          <div className="bl-repgrid">
          <aside className="bl-repvideo">
            {analysis.videoEmbed ? (
              <iframe src={analysis.videoEmbed} title="Scored video" allow="autoplay; encrypted-media; picture-in-picture" allowFullScreen />
            ) : analysis.videoSrc ? (
              <video src={analysis.videoSrc} poster={analysis.thumb || undefined} controls playsInline preload="metadata" />
            ) : analysis.thumb ? (
              <img src={analysis.thumb} alt="Scored video" />
            ) : null}
            <p className="bl-repvideo-cap">Play it back while you read the checks.</p>
          </aside>
          <div className="bl-repmain">
          {analysis.insights ? (
            <div className="bl-rtabs" role="tablist">
              <button role="tab" aria-selected={breakdownTab === "checks"} onClick={() => setBreakdownTab("checks")}>All 24 checks</button>
              <button role="tab" aria-selected={breakdownTab === "overview"} onClick={() => setBreakdownTab("overview")}>Overview</button>
              {analysis.insights.quotes.length ? <button role="tab" aria-selected={breakdownTab === "insights"} onClick={() => setBreakdownTab("insights")}>Insights ({analysis.insights.quotes.length})</button> : null}
              {analysis.insights.hooks.length ? <button role="tab" aria-selected={breakdownTab === "hooks"} onClick={() => setBreakdownTab("hooks")}>Hooks ({analysis.insights.hooks.length})</button> : null}
              {analysis.insights.selling_points.length ? <button role="tab" aria-selected={breakdownTab === "selling"} onClick={() => setBreakdownTab("selling")}>Selling points ({analysis.insights.selling_points.length})</button> : null}
              {analysis.insights.spoken_transcript ? <button role="tab" aria-selected={breakdownTab === "transcript"} onClick={() => setBreakdownTab("transcript")}>Transcript</button> : null}
            </div>
          ) : null}

          {(!analysis.insights || breakdownTab === "checks") && (
          <div className="bl-groups">
            {groups.map((g, gi) => (
              <details className="bl-grp" key={g.name} open={gi === 0}>
                <summary><span className="bl-gname">{g.name}</span><Pill kind="blue">{g.passed} of {g.rows.length} passed</Pill><ChevIcon /></summary>
                <div className="bl-agents">
                  {g.rows.map((a) => (
                    <div className="bl-agent" key={a.name}>
                      {a.screenshot ? <span className="bl-shot"><img src={a.screenshot} alt={`${a.name} check frame`} loading="lazy" /></span> : null}
                      <div className="bl-agent-bd">
                        <div className="bl-agent-hd">
                          <span className="bl-an">{a.name}</span>
                          <Pill kind={a.status === "PASS" ? "pass" : "flag"}>{a.status === "PASS" ? "Pass" : "Flag"}</Pill>
                          {a.value ? <span className="bl-score">{a.value}</span> : null}
                          {a.timestamp !== null ? <span className="bl-chip">{fmtTs(a.timestamp)}</span> : null}
                        </div>
                        {a.comment ? <p className="bl-cm">{a.comment}</p> : null}
                      </div>
                    </div>
                  ))}
                </div>
              </details>
            ))}
          </div>
          )}

          {analysis.insights && breakdownTab === "overview" && (
            <div className="bl-ipanel">
              {analysis.insights.stats ? (
                <div className="bl-istats">
                  <div><b>{fmtCount(analysis.insights.stats.plays)}</b><span>Plays</span></div>
                  <div><b>{fmtCount(analysis.insights.stats.likes)}</b><span>Likes</span></div>
                  <div><b>{fmtCount(analysis.insights.stats.comments)}</b><span>Comments</span></div>
                  <div><b>{fmtCount(analysis.insights.stats.shares)}</b><span>Shares</span></div>
                  <div><b>{fmtCount(analysis.insights.stats.saves)}</b><span>Saves</span></div>
                </div>
              ) : null}
              {analysis.insights.tone || analysis.insights.reading_level ? (
                <div className="bl-ichips">
                  {analysis.insights.tone ? <Pill kind="blue">Tone: {analysis.insights.tone}</Pill> : null}
                  {analysis.insights.reading_level ? <Pill kind="blue">Reading level: {analysis.insights.reading_level}</Pill> : null}
                </div>
              ) : null}
              {analysis.insights.content_overview ? <div className="bl-icard"><h4>Content overview</h4><p>{analysis.insights.content_overview}</p></div> : null}
              {analysis.insights.target_audience ? <div className="bl-icard"><h4>Target audience</h4><p>{analysis.insights.target_audience}</p></div> : null}
              {analysis.insights.product_notes ? <div className="bl-icard"><h4>Product notes</h4><p>{analysis.insights.product_notes}</p></div> : null}
              {analysis.insights.on_screen_text ? (
                <div className="bl-icard">
                  <div className="bl-icopyrow"><h4>On-screen text</h4><button className="bl-btn bl-sm bl-ghost" onClick={async () => { try { await navigator.clipboard.writeText(analysis.insights.on_screen_text); toast.success("Copied"); } catch { toast.error("Couldn't copy"); } }}>Copy</button></div>
                  <p className="bl-iquote">{analysis.insights.on_screen_text}</p>
                </div>
              ) : null}
            </div>
          )}

          {analysis.insights && breakdownTab === "insights" && (
            <div className="bl-ipanel">
              {analysis.insights.quotes.map((q) => (
                <div className="bl-icard" key={q.quote}>
                  <p className="bl-iquote">{q.quote}</p>
                  {q.insight ? <p>{q.insight}</p> : null}
                </div>
              ))}
            </div>
          )}

          {analysis.insights && breakdownTab === "hooks" && (
            <div className="bl-ipanel">
              {analysis.insights.hooks.map((h) => (
                <div className="bl-icard" key={h.hook}>
                  <h4>{h.hook}</h4>
                  {h.score ? <div className="bl-ibarrow"><span className="bl-ibar"><b style={{ width: `${h.score * 10}%` }} /></span><span className="bl-iscore">{h.score}/10</span></div> : null}
                  {h.why ? <p>{h.why}</p> : null}
                </div>
              ))}
            </div>
          )}

          {analysis.insights && breakdownTab === "selling" && (
            <div className="bl-ipanel">
              {analysis.insights.selling_points.map((s) => (
                <div className="bl-icard" key={s.point}>
                  <h4>{s.point}</h4>
                  {s.score ? <div className="bl-ibarrow"><span className="bl-ibar"><b style={{ width: `${s.score * 10}%` }} /></span><span className="bl-iscore">{s.score}/10</span></div> : null}
                  {s.why ? <p>{s.why}</p> : null}
                </div>
              ))}
            </div>
          )}

          {analysis.insights && breakdownTab === "transcript" && (
            <div className="bl-ipanel">
              <div className="bl-icard">
                <div className="bl-icopyrow"><h4>Spoken transcript</h4><button className="bl-btn bl-sm bl-ghost" onClick={async () => { try { await navigator.clipboard.writeText(analysis.insights.spoken_transcript); toast.success("Copied"); } catch { toast.error("Couldn't copy"); } }}>Copy</button></div>
                <p>{analysis.insights.spoken_transcript}</p>
              </div>
            </div>
          )}
          </div>
          </div>
          <div className="bl-closing">
            <img src={EYES} alt="" style={{ width: 74, height: 74 }} />
            <h2>That is one video. You have a hundred.</h2>
            <p className="bl-closing-s">Brieflee runs all 24 Review Agents across every creator video you get sent, and tells you which ones are ready.</p>
            <div className="bl-sharerow bl-center">
              <button className="bl-btn bl-sm bl-ghost" onClick={handleDownloadReport}>Download report</button>
              <button className="bl-btn bl-sm bl-ghost" onClick={handleCopyLink}>Copy link</button>
              <button className="bl-btn bl-sm bl-ghost" onClick={handleShare}>Share</button>
            </div>
            <p className="bl-closing-line">Review all your creator content with Brieflee</p>
            <div className="bl-ctastack">
              <a className="bl-btn" href={DEMO_URL}>Book a demo</a>
              <button className="bl-btn bl-ghost" onClick={resetForAnother}>Score another video</button>
            </div>
          </div>
        </div>
      )}

      {/* ── Failure ── */}
      {page === "failure" && (
        <div className="bl-errwrap">
          <div className="bl-card bl-errcard">
            <span className="bl-err-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round"><path d="M12 8.5v4" /><circle cx="12" cy="16" r=".6" fill="currentColor" /><circle cx="12" cy="12" r="9" /></svg></span>
            <h3>We couldn't read that video</h3>
            <p>The link may be private, deleted, or region locked. Try uploading the file instead.</p>
            <button className="bl-btn bl-sm" onClick={() => { setPage("input"); setError(""); }}>Try again</button>
            <label className="bl-drop bl-w100">
              <UploadIcon />
              <span className="bl-drop-t">Upload a video</span>
              <span className="bl-drop-s">MP4 or MOV, up to 200MB</span>
              <input type="file" accept="video/mp4,video/quicktime" hidden onChange={(e) => { const f = e.target.files?.[0] || null; if (f) { setFile(f); setTab("file"); setPage("gate"); } }} />
            </label>
          </div>
          <p className="bl-crosslink">Still stuck? <a href="mailto:bev@brieflee.co">Tell us what happened</a></p>
        </div>
      )}

      {/* ── Print-only report (Download report → Save as PDF) ── */}
      {analysis ? (
        <div className="bl-printreport">
          <div className="bl-pr-head">
            <span className="bl-pr-brand"><img src={EYES} alt="" />Scored by <b>Brieflee</b></span>
            <span className="bl-pr-score">{analysis.overall.score}<i>/100</i></span>
          </div>
          {analysis.thumb ? <img className="bl-pr-thumb" src={analysis.thumb} alt="" /> : null}
          <p className="bl-pr-meta">{analysis.handle || "Video"} · {analysis.overall.checks_passed} of 24 checks passed{analysis.duration ? ` · ${fmtTs(analysis.duration)}` : ""} · Facebook</p>
          <p className="bl-pr-verdict">{analysis.overall.verdict}</p>
          {analysis.overall.comment ? <p className="bl-pr-comment">{analysis.overall.comment}</p> : null}
          {(analysis.agents || []).some((a) => a.status !== "PASS") ? (
            <div className="bl-pr-fixfirst">
              <h3>What to fix first</h3>
              {(analysis.agents || []).filter((a) => a.status !== "PASS").map((a) => (
                <div className="bl-pr-fix" key={a.name}>
                  {a.screenshot ? <img className="bl-pr-frame" src={a.screenshot} alt="" /> : null}
                  <div>
                    <p className="bl-pr-ahead"><b>{a.name}</b>{a.timestamp !== null ? <i>{fmtTs(a.timestamp)}</i> : null}{a.value ? <i>{a.value}</i> : null}</p>
                    {a.comment ? <p className="bl-pr-cm">{a.comment}</p> : null}
                  </div>
                </div>
              ))}
            </div>
          ) : null}
          {groups.map((g) => (
            <div className="bl-pr-group" key={g.name}>
              <h3>{g.name} <span>{g.passed} of {g.rows.length} passed</span></h3>
              {g.rows.map((a) => (
                <div className="bl-pr-agent" key={a.name}>
                  <p className="bl-pr-ahead">
                    <b>{a.name}</b>
                    <span className={a.status === "PASS" ? "bl-pr-pass" : "bl-pr-flag"}>{a.status === "PASS" ? "Pass" : "Flag"}</span>
                    {a.value ? <i>{a.value}</i> : null}
                    {a.timestamp !== null ? <i>{fmtTs(a.timestamp)}</i> : null}
                  </p>
                  {a.comment ? <p className="bl-pr-cm">{a.comment}</p> : null}
                </div>
              ))}
            </div>
          ))}
          {analysis.insights ? (
            <div>
              {analysis.insights.content_overview ? <div className="bl-pr-group"><h3>Overview</h3>{analysis.insights.stats ? <p className="bl-pr-cm"><b>{fmtCount(analysis.insights.stats.plays)} plays · {fmtCount(analysis.insights.stats.likes)} likes · {fmtCount(analysis.insights.stats.comments)} comments · {fmtCount(analysis.insights.stats.shares)} shares · {fmtCount(analysis.insights.stats.saves)} saves</b></p> : null}<p className="bl-pr-cm">{analysis.insights.content_overview}</p>{analysis.insights.target_audience ? <p className="bl-pr-cm"><b>Audience:</b> {analysis.insights.target_audience}</p> : null}{analysis.insights.product_notes ? <p className="bl-pr-cm"><b>Product:</b> {analysis.insights.product_notes}</p> : null}</div> : null}
              {analysis.insights.hooks.length ? <div className="bl-pr-group"><h3>Hooks</h3>{analysis.insights.hooks.map((h) => <div className="bl-pr-agent" key={h.hook}><p className="bl-pr-ahead"><b>{h.hook}</b>{h.score ? <i>{h.score}/10</i> : null}</p>{h.why ? <p className="bl-pr-cm">{h.why}</p> : null}</div>)}</div> : null}
              {analysis.insights.selling_points.length ? <div className="bl-pr-group"><h3>Selling points</h3>{analysis.insights.selling_points.map((s) => <div className="bl-pr-agent" key={s.point}><p className="bl-pr-ahead"><b>{s.point}</b>{s.score ? <i>{s.score}/10</i> : null}</p>{s.why ? <p className="bl-pr-cm">{s.why}</p> : null}</div>)}</div> : null}
              {analysis.insights.quotes.length ? <div className="bl-pr-group"><h3>What works, in the video's own words</h3>{analysis.insights.quotes.map((q) => <div className="bl-pr-agent" key={q.quote}><p className="bl-pr-ahead"><b>"{q.quote}"</b></p>{q.insight ? <p className="bl-pr-cm">{q.insight}</p> : null}</div>)}</div> : null}
              {analysis.insights.spoken_transcript ? <div className="bl-pr-group"><h3>Transcript{analysis.insights.reading_level ? ` (${analysis.insights.reading_level})` : ""}</h3><p className="bl-pr-cm">{analysis.insights.spoken_transcript}</p></div> : null}
            </div>
          ) : null}
          <div className="bl-pr-foot">
            <span>Scored by Brieflee · brieflee.co</span>
            <span>Review all your creator content with Brieflee · brieflee.co{DEMO_URL}</span>
          </div>
        </div>
      ) : null}
    </div>
  );
}

// ─── Styles (ported from the v3 design desk, bl- prefixed) ─────
const CSS = `
.bl-tt{--blue:#294ff6;--blue3:#5e7bf6;--blue4:#7a93ff;--blue5:#879cf7;--navy:#000f4d;--navy2:#001364;--page:#FAFBFF;--l2:#eef4fd;--peri:#d9e0ff;--lav:#d8d8ff;--border:#eef4fd;--bd2:#d6defc;--body:#565d78;--muted:#838aa3;--quiet:#aeb4c8;--pass:#2daa63;--passbg:rgba(45,170,99,.12);--warn:#a9750a;--warnbg:rgba(248,211,19,.16);--fail:#c8443c;--failbg:rgba(200,68,60,.10);
  font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--page);color:var(--body);-webkit-font-smoothing:antialiased;width:100%;overflow-x:hidden}
.bl-tt h1,.bl-tt h2,.bl-tt h3,.bl-tt h4{margin:0;color:var(--navy)}
