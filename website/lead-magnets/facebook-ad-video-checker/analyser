        "X-Goog-Upload-Header-Content-Type": mime,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ file: { display_name: "free-tool-video" } }),
    });
    const uploadUrl = startRes.ok ? startRes.headers.get("x-goog-upload-url") : "";
