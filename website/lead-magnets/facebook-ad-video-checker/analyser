// Adapter for "Auto Download All In One" (/v1/social/autolink):
// { url, source, author, title, thumbnail, duration, medias: [{ url,
//   quality, extension, type }] }. Fallbacks kept for shape drift.
function adaptScrape(json) {
  const d = json?.data || json || {};
  const medias = Array.isArray(d.medias) ? d.medias : [];
  // Response shapes differ by platform AND by call:
  // - TikTok/IG: medias [{ url, data_size, type }] — sometimes
  //   api.tiktokv.com /play streaming endpoints instead of files.
  // - YouTube: adaptive formats where MOST video entries carry NO
  //   audio (audioQuality: null); only muxed ones (audioQuality set,
  //   or is_audio) have sound, and sizes hide in the URL clen= param.
  // Durations arrive as seconds OR milliseconds.
  const durRaw = Number(d.duration) || 0;
  const durSec = Math.round(durRaw > 600 ? durRaw / 1000 : durRaw);
  const sizeOf = (m) => {
    if (m.data_size) return Number(m.data_size) || 9e9;
    const clen = /[?&]clen=(\d+)/.exec(String(m.url || ""));
    if (clen) return Number(clen[1]);
    if (m.bitrate && durSec) return (Number(m.bitrate) / 8) * durSec;
    return 9e9;
  };
  const vids = medias.filter((m) => m?.type === "video" && m?.url);
  // If ANY variant declares muxed audio (YouTube's adaptive lists),
  // exclude the silent video-only variants — a muted video would gut
  // the audio half of the review.
  const withAudio = vids.filter((m) => m.audioQuality || m.is_audio);
  const audible = withAudio.length ? withAudio : vids;
  const direct = audible.filter((m) => !/api\.tiktokv\.com/i.test(m.url));
  const pool = direct.length ? direct : audible;
  pool.sort((a, b) => sizeOf(a) - sizeOf(b));
  const vid = pool[0] || medias.find((m) => m?.url) || {};
  const authorRaw = d.author;
  const handle = typeof authorRaw === "string"
    ? authorRaw
    : (authorRaw?.unique_id || authorRaw?.nickname || d.author_name || "");
  const st = d.statistics || {};
  return {
    mp4: vid.url || d.hdplay || d.play || d.video_url || d.download_url || "",
    handle: handle ? (String(handle).startsWith("@") ? String(handle) : "@" + handle) : "",
    duration: durSec || Math.round(Number(vid.duration) || 0),
    cover: d.thumbnail || d.cover || d.origin_cover || "",
    stats: {
      plays: Number(st.play_count) || 0,
      likes: Number(st.digg_count) || 0,
      comments: Number(st.comment_count) || 0,
      shares: Number(st.share_count) || 0,
      saves: Number(st.collect_count) || 0,
    },
  };
}

function fmtCount(n) {
  const v = Number(n) || 0;
  if (v >= 1e6) return (v / 1e6).toFixed(1).replace(/\.0$/, "") + "M";
  if (v >= 1e3) return (v / 1e3).toFixed(1).replace(/\.0$/, "") + "K";
