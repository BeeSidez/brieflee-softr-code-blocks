      // video first; onError drops to the thumbnail, then the halo.
      setProcSrc(scraped.mp4);
      if (isYouTube) setProcImg(cover);
    }

    // 4. Cloudinary (unsigned, plain fetch): frame screenshots via
    // so_<sec>, plus a CORS-safe copy of scraped videos the browser
    // can download for Gemini. Best-effort — a failure only costs
    // the frames, unless the link path needs it as the relay.
    // YouTube blocks reposts of its playback URLs: googlevideo 403s
    // Cloudinary's fetcher and sends no CORS headers, so a browser
    // block has no download path at all. Gemini reads YouTube natively,
    // so those links skip the relay and go straight into the model.
    let publicId = "";
    let deliveryUrl = "";
    if (!isYouTube) try {
      const form = new FormData();
      form.append("file", localFile || mp4);
      form.append("upload_preset", CLOUDINARY_PRESET);
      form.append("folder", CLOUDINARY_FOLDER);
      const cldRes = await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD}/video/upload`, { method: "POST", body: form });
      if (cldRes.ok) {
        const cld = await cldRes.json();
        publicId = cld.public_id || "";
        deliveryUrl = cld.secure_url || "";
        if (!duration) duration = Math.round(Number(cld.duration) || 0);
      } else {
        console.error("Cloudinary upload rejected (continuing without frames):", cldRes.status);
      }
    } catch (e) {
      console.error("Cloudinary upload failed (continuing without frames):", e);
    }
    const thumb = publicId ? cldThumb(publicId) : (cover || "");

    // 5. Get the bytes (Gemini on this source can't fetch URLs itself).
    // HARD CONSTRAINT learned from the records: Softr's proxy rejects
    // request bodies over roughly 4MB with a bare 500 — and base64
    // inflates by a third — so the blob target is 2.5MB. Gemini samples
    // video at ~1fps; heavy compression costs the review nothing.
    const INLINE_SAFE = 2.5 * 1024 * 1024;
    const rungs = publicId ? [
      `https://res.cloudinary.com/${CLOUDINARY_CLOUD}/video/upload/q_auto:low,c_limit,h_854/${publicId}.mp4`,
      `https://res.cloudinary.com/${CLOUDINARY_CLOUD}/video/upload/q_35,c_limit,h_640/${publicId}.mp4`,
      `https://res.cloudinary.com/${CLOUDINARY_CLOUD}/video/upload/q_25,c_limit,h_480/${publicId}.mp4`,
      `https://res.cloudinary.com/${CLOUDINARY_CLOUD}/video/upload/q_20,c_limit,h_360/${publicId}.mp4`,
    ] : [];
    let blob = localFile;
    let mime = localFile?.type || "video/mp4";
    let rungIdx = 0;
    for (; rungIdx < rungs.length; rungIdx++) {
      const cRes = await fetch(rungs[rungIdx]);
      if (!cRes.ok) { console.error(`Cloudinary rung ${rungIdx} returned ${cRes.status}`); continue; }
      const b = await cRes.blob();
      if (b.size > 1000) { blob = b; mime = "video/mp4"; }
      if (blob && blob.size <= INLINE_SAFE) break;
    }
    if (!blob && !isYouTube) {
      const vRes = await fetch(deliveryUrl || mp4);
      if (!vRes.ok) throw new Error("We couldn't read that video.");
      blob = await vRes.blob();
      mime = blob.type || "video/mp4";
    }
    let videoPart;
    if (isYouTube) {
      videoPart = { file_data: { file_uri: url.trim() } };
    } else {
      videoPart = await makeVideoPart(blob, mime);
    }

    // 6. One Gemini call with the 24-agent prompt
    const screenshotBase = publicId
      ? `https://res.cloudinary.com/${CLOUDINARY_CLOUD}/video/upload/so_{timestamp}/c_fill,h_1920,w_1080/${publicId}.jpg`
      : "";
    const genUrl = `${GEMINI_BASE}/v1beta/models/${GEMINI_MODEL}:generateContent`;
    const attempt = (part) => proxyGoogle(genUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        contents: [{ role: "user", parts: [{ text: buildPrompt(screenshotBase) }, part] }],
        generationConfig: { temperature: 0.4, topP: 1, topK: 32, maxOutputTokens: 16384, responseMimeType: "application/json" },
      }),
    });
    // Self-heal ladder. Two error classes are retryable: 5xx (transient
    // Gemini errors; proxy body limits also masquerade as bare 500s) and
    // 400 INVALID_ARGUMENT, which Gemini intermittently returns for a
    // perfectly valid inline-video request (the identical request can
    // score on the next attempt — verified live 2026-08-04). Retry
    // twice, then step DOWN the compression rungs.
    const retryable = (r) => !r.ok && (r.status >= 500 || r.status === 400);
    let gRes = await attempt(videoPart);
    for (let tries = 0; retryable(gRes) && tries < 2; tries++) {
      await sleep(2500);
      gRes = await attempt(videoPart);
    }
    while (retryable(gRes) && rungIdx + 1 < rungs.length) {
      rungIdx += 1;
      const rRes = await fetch(rungs[rungIdx]);
      if (!rRes.ok) { console.error(`Cloudinary rung ${rungIdx} returned ${rRes.status}`); continue; }
      const b = await rRes.blob();
      if (b.size < 1000) continue;
      blob = b;
      videoPart = await makeVideoPart(blob, "video/mp4");
      gRes = await attempt(videoPart);
    }
    if (!gRes.ok) {
      // Diagnostic detail lands in error_message on the record; the
      // visitor only ever sees the friendly failure card.
      const detail = await gRes.text().catch(() => "");
      throw new Error(`Gemini ${gRes.status}: ${detail.slice(0, 300)}`);
    }
    const parsed = parseGeminiJson(await gRes.json());
    if (!parsed?.overall || !Array.isArray(parsed?.agents)) throw new Error("The analysis came back incomplete.");

    // 6. Normalise + em dash guard, backfill screenshots from timestamps
    const agents = parsed.agents.map((a) => ({
      name: String(a.name || ""),
      status: String(a.status || "").toUpperCase() === "PASS" ? "PASS" : "FLAG",
      score: stripEmDash(a.score),
      value: stripEmDash(a.value),
      comment: stripEmDash(a.comment),
      timestamp: a.timestamp === null || a.timestamp === undefined || a.timestamp === "" ? null : Math.max(0, Math.round(Number(a.timestamp) || 0)),
      // Frame URLs are built here, never taken from the model — Gemini
      // fills screenshot_url with fragments like "so_0" that render as
      // broken images. The timestamp is the only model input needed.
      screenshot: a.timestamp === null || a.timestamp === undefined || a.timestamp === "" ? "" : (ytId ? ytFrame(ytId, a.timestamp, duration) : cldScreenshot(publicId, a.timestamp)),
    }));
    const passed = agents.filter((a) => a.status === "PASS").length;
    const overall = {
      score: Math.max(0, Math.min(100, Math.round(Number(parsed.overall.score) || 0))),
      checks_passed: passed,
      handle: stripEmDash(parsed.overall.handle || handle),
      verdict: stripEmDash(parsed.overall.verdict),
      comment: stripEmDash(parsed.overall.comment),
    };
    const headline = Array.isArray(parsed.headline)
      ? parsed.headline.slice(0, 5).map((h) => ({ label: stripEmDash(h.label), status: String(h.status || "").toUpperCase() === "PASS" ? "PASS" : "FLAG" }))
      : [];
    const tenScore = (s) => { const n = Math.round(Number(s)); return n >= 1 && n <= 10 ? n : null; };
    const insRaw = parsed.insights || {};
    const insights = {
      content_overview: stripEmDash(insRaw.content_overview),
      target_audience: stripEmDash(insRaw.target_audience),
      product_notes: stripEmDash(insRaw.product_notes),
      tone: stripEmDash(insRaw.tone),
      on_screen_text: stripEmDash(insRaw.on_screen_text),
      spoken_transcript: stripEmDash(insRaw.spoken_transcript),
      reading_level: stripEmDash(insRaw.reading_level),
      quotes: Array.isArray(insRaw.quotes) ? insRaw.quotes.slice(0, 6).map((x) => ({ quote: stripEmDash(x.quote), insight: stripEmDash(x.insight) })).filter((x) => x.quote) : [],
      hooks: Array.isArray(insRaw.hooks) ? insRaw.hooks.slice(0, 6).map((x) => ({ hook: stripEmDash(x.hook), score: tenScore(x.score), why: stripEmDash(x.why) })).filter((x) => x.hook) : [],
      selling_points: Array.isArray(insRaw.selling_points) ? insRaw.selling_points.slice(0, 6).map((x) => ({ point: stripEmDash(x.point), score: tenScore(x.score), why: stripEmDash(x.why) })).filter((x) => x.point) : [],
      stats,
    };
    const report = { overall, agents, headline, insights, transcript: stripEmDash(parsed.transcript) };

    // 7. The ONE record: everything from the run in a single create.
    const created = await createRecord.mutateAsync({
      ...basePayload,
      status: OPT.stScored,
      // Softr URL fields reject values over 1024 chars (bisected against
      // the live table), and YouTube's googlevideo links run ~2000 (and
      // expire in hours anyway) — the durable link is already in video_url.
      downloadUrl: mp4 && mp4.length <= 1000 ? mp4 : "",
      thumbnailUrl: thumb && thumb.length <= 1000 ? thumb : "",
      creatorHandle: overall.handle,
      videoDuration: duration,
      transcript: report.transcript,
      overallScore: overall.score,
      overallComment: overall.verdict,
      scoreReport: JSON.stringify(report),
    });
    setRecordId(created?.id || created?.recordId || created?.record?.id || "");

    // Only successful runs count against the session cap, so failed
    // attempts never lock a visitor out.
    bumpRunCount();
    bumpEmailRunCount(basePayload.email);
    setAnalysis({
      ...report,
      handle: overall.handle,
      duration,
      thumb,
      videoEmbed: ytId ? `https://www.youtube.com/embed/${ytId}` : "",
      videoSrc: ytId ? "" : (deliveryUrl || (localFile ? procSrc : mp4)),
    });
    setPage("score");
    scrollTop();
  }

