      method: "POST",
      headers: { "X-Goog-Upload-Command": "upload, finalize", "X-Goog-Upload-Offset": "0" },
      body: blob,
    });
    if (!upRes.ok) throw new Error(`Gemini upload failed (HTTP ${upRes.status}, ${Math.round(blob.size / 1048576)}MB).`);
    let f = (await upRes.json())?.file || {};
    const deadline = Date.now() + 90000;
    while (f.state === "PROCESSING" && Date.now() < deadline) {
      await sleep(2000);
      const pRes = await proxyGoogle(`${GEMINI_BASE}/v1beta/${f.name}`, { method: "GET" });
      if (pRes.ok) f = await pRes.json();
    }
    if (f.state !== "ACTIVE" || !f.uri) throw new Error("The Review Agents couldn't finish preparing the video.");
    return { file_data: { mime_type: mime, file_uri: f.uri } };
  }

  // ── Steps 3-6: scrape → Cloudinary → Gemini → ONE record ─────
  async function runPipeline(basePayload, localFile) {
    const isYouTube = !localFile && /youtube\.com|youtu\.be/i.test(url.trim());
    const ytId = isYouTube ? ytVideoId(url.trim()) : "";
    // 3. Source the mp4
    let mp4 = "";
    let handle = "";
    let duration = 0;
    let stats = null;
    let cover = "";
    if (!localFile) {
      const res = await proxyRapid(SCRAPE_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url: url.trim() }),
      });
      if (!res.ok) {
        const detail = await res.text().catch(() => "");
        throw new Error(`Scrape ${res.status}: ${detail.slice(0, 200)}`);
      }
      const scraped = adaptScrape(await res.json());
      if (!scraped.mp4) throw new Error("We couldn't read that video.");
      mp4 = scraped.mp4;
      handle = scraped.handle;
      duration = scraped.duration;
      stats = scraped.stats && scraped.stats.plays ? scraped.stats : null;
      cover = scraped.cover || "";
