/* score */
.bl-scorepad{padding:30px 20px 48px;max-width:1140px;margin:0 auto}
.bl-scoreside{display:flex;flex-direction:column;gap:24px}
.bl-scard{background:linear-gradient(168deg,#fff 0%,#fdfdff 52%,#f4f7ff 100%);border:1px solid var(--bd2);border-radius:22px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 60px -30px rgba(0,15,77,.42)}
.bl-scard-top{display:flex;gap:16px;padding:20px 20px 14px;align-items:center;justify-content:space-between}
.bl-thumb{width:64px;aspect-ratio:9/16;flex:none;position:relative;overflow:hidden;border-radius:10px;background:#dfe5f5;border:1px solid var(--bd2)}
.bl-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.bl-thumb b{position:absolute;left:0;right:0;bottom:5px;text-align:center;font-size:9px;font-weight:700;color:#fff;letter-spacing:.04em;text-shadow:0 1px 3px rgba(0,15,77,.7)}
.bl-ring{position:relative;flex:none;display:block}
.bl-ring-val{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.bl-ring-lg .bl-ring-val b{font-size:34px;font-weight:800;color:var(--blue);letter-spacing:-.04em;line-height:1}
.bl-ring-lg .bl-ring-val i{font-style:normal;font-size:10.5px;font-weight:700;color:var(--quiet);letter-spacing:.06em}
.bl-ring-sm .bl-ring-val b{font-size:20px;font-weight:800;color:var(--blue);letter-spacing:-.03em}
.bl-metarow{display:flex;flex-direction:column;gap:3px;padding:0 20px 16px;min-width:0}
.bl-lbl{font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue5)}
.bl-metarow .bl-h{font-size:17px;font-weight:700;color:var(--navy);letter-spacing:-.01em}
.bl-metarow .bl-sm{font-size:13px;color:var(--muted)}
.bl-verdict{margin:0 20px 16px;padding:14px 16px;background:var(--peri);border-radius:12px;font-size:13.5px;line-height:1.5;color:var(--navy2)}
.bl-checks{display:flex;flex-direction:column;gap:1px;background:var(--border);margin:0 20px;border-radius:12px;overflow:hidden}
.bl-checkrow{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;padding:11px 14px}
.bl-checkrow .bl-nm{font-size:13.5px;font-weight:600;color:var(--navy)}
.bl-mark{margin-top:18px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 20px;background:var(--navy)}
.bl-mark-l{display:flex;align-items:center;gap:9px}
.bl-mark-l img{width:22px;height:22px}
.bl-mark-l b{font-size:13px;font-weight:700;letter-spacing:-.01em;color:#fff}
.bl-mark-r{font-size:11.5px;color:#a9b6e8;letter-spacing:.02em}
.bl-cropnote{display:flex;justify-content:center;margin-top:10px}
.bl-cropnote span{font-size:11.5px;color:var(--quiet)}
.bl-aside{display:flex;flex-direction:column;gap:18px}
.bl-sharerow{display:flex;flex-wrap:wrap;gap:8px}

/* breakdown */
.bl-band{display:flex;align-items:center;gap:14px;padding:14px 16px;background:#fff;border:1px solid var(--border);border-radius:14px;margin-bottom:16px}
.bl-band-num{font-size:26px;font-weight:800;color:var(--blue);letter-spacing:-.04em;line-height:1}
.bl-band-num sup{font-size:12px;font-weight:700;color:var(--quiet)}
.bl-band-txt{font-size:13px;color:var(--body);font-weight:500}
.bl-track{flex:1;height:6px;background:var(--l2);border-radius:99px;overflow:hidden;min-width:60px}
.bl-track b{display:block;height:100%;background:linear-gradient(90deg,var(--blue5),var(--blue))}
.bl-groups{display:flex;flex-direction:column;gap:10px}
.bl-grp{background:#fff;border:1px solid var(--border);border-radius:14px;overflow:hidden}
.bl-grp>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:12px;padding:15px 16px}
.bl-grp>summary::-webkit-details-marker{display:none}
.bl-gname{flex:1;font-size:14.5px;font-weight:700;color:var(--navy);letter-spacing:-.01em}
.bl-chev{color:var(--blue4);transition:transform .18s}
.bl-grp[open]>summary .bl-chev{transform:rotate(180deg)}
.bl-grp[open]>summary{border-bottom:1px solid var(--border)}
.bl-agents{display:flex;flex-direction:column}
.bl-agent{display:flex;gap:12px;padding:14px 16px;border-top:1px solid var(--page)}
.bl-agent:first-child{border-top:0}
.bl-shot{width:44px;aspect-ratio:9/16;flex:none;border-radius:7px;overflow:hidden;background:#e3e8f7;border:1px solid var(--border)}
.bl-shot img{width:100%;height:100%;object-fit:cover;display:block}
.bl-agent-bd{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}
.bl-agent-hd{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.bl-an{font-size:13.5px;font-weight:600;color:var(--navy)}
.bl-cm{font-size:12.5px;line-height:1.5;color:var(--body)}
.bl-chip{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;color:var(--muted);background:var(--l2);border-radius:6px;padding:3px 7px}
.bl-score{font-size:12px;font-weight:700;color:var(--blue);letter-spacing:-.01em}
/* report tabs + insight panels */
.bl-rtabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
.bl-rtabs button{border:1px solid var(--bd2);background:#fff;color:var(--muted);font-family:inherit;font-size:13px;font-weight:600;padding:8px 14px;border-radius:999px;cursor:pointer}
.bl-rtabs button[aria-selected="true"]{background:var(--blue5);border-color:var(--blue5);color:#fff}
.bl-ipanel{display:flex;flex-direction:column;gap:12px}
.bl-istats{display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:10px}
.bl-istats div{background:#fff;border:1px solid var(--border);border-radius:12px;padding:12px 10px;text-align:center;display:flex;flex-direction:column;gap:2px}
.bl-istats b{font-size:18px;font-weight:800;color:var(--blue);letter-spacing:-.02em}
.bl-istats span{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.bl-icard{background:#fff;border:1px solid var(--border);border-radius:14px;padding:16px 18px}
.bl-icard h4{font-size:14px;line-height:1.4;margin-bottom:6px}
.bl-icard p{font-size:13.5px;line-height:1.6;color:var(--body)}
.bl-iquote{background:var(--l2);border-radius:10px;padding:10px 12px;font-style:italic;color:var(--navy2)!important;margin-bottom:8px}
.bl-ichips{display:flex;gap:8px;flex-wrap:wrap}
.bl-ibarrow{display:flex;align-items:center;gap:10px;margin:8px 0}
.bl-ibar{flex:1;height:6px;background:var(--l2);border-radius:99px;overflow:hidden;max-width:320px}
.bl-ibar b{display:block;height:100%;background:linear-gradient(90deg,var(--blue5),var(--blue))}
.bl-iscore{font-size:12.5px;font-weight:800;color:var(--blue)}
.bl-icopyrow{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:6px}
.bl-icopyrow h4{margin-bottom:0}

.bl-closing{display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center;padding:44px 22px 20px}
.bl-closing h2{font-size:23px;line-height:1.2;max-width:22ch}
.bl-closing-s{font-size:14px;color:var(--body);max-width:38ch;line-height:1.5}

/* failure */
.bl-errwrap{padding:44px 20px 50px;display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
.bl-errcard{width:100%;max-width:420px;padding:24px 20px;display:flex;flex-direction:column;gap:14px;align-items:center}
.bl-err-ic{width:44px;height:44px;border-radius:12px;background:var(--l2);display:grid;place-items:center;color:var(--blue4)}
.bl-errcard h3{font-size:17px}
.bl-errcard p{font-size:13.5px;color:var(--body);line-height:1.5;max-width:30ch}

/* desktop */
@media (min-width:700px){
 .bl-herowrap{padding:72px 40px 84px}
 .bl-herogrid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,1fr);gap:56px;align-items:center}
 .bl-hcol{gap:22px}
 .bl-h1blk h1{font-size:50px}
 .bl-typing{font-size:50px}
 .bl-assetwrap{max-width:440px;margin:0 auto}
 .bl-inputcard{padding:26px}
 .bl-inputrow{flex-direction:row;align-items:center;gap:12px}
 .bl-inputrow .bl-input{flex:1;min-width:0;height:58px;font-size:15.5px}
