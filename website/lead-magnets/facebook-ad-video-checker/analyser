/* What you get — v2 block design */
.bl-wghead{display:flex;flex-direction:column;align-items:flex-start;gap:16px;max-width:768px}
.bl-wghead h2{font-size:30px;line-height:1.1;letter-spacing:-.02em}
.bl-wghead p{font-size:15px;line-height:1.6;color:var(--body)}
.bl-wgcards{display:grid;gap:20px}
.bl-wgcard{background:#fff;border:1px solid var(--border);border-radius:18px;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s}
.bl-wgcard:hover{transform:translateY(-4px);box-shadow:0 20px 60px -25px rgba(41,79,246,.4);border-color:rgba(41,79,246,.3)}
.bl-wgimg{aspect-ratio:4/3;background:linear-gradient(135deg,rgba(41,79,246,.06),rgba(41,79,246,.12));overflow:hidden}
.bl-wgimg img{width:100%;height:100%;object-fit:cover;display:block}
.bl-wgtxt{padding:22px}
.bl-wgtxt h3{font-size:18px;line-height:1.25}
.bl-wgtxt p{margin-top:8px;font-size:14px;line-height:1.6;color:var(--body)}

/* How it works — v2 block design (alternating rows) */
.bl-hiwsec{background:linear-gradient(180deg,#fff,rgba(41,79,246,.03),#fff)}
.bl-hiwhead{display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px;max-width:640px;margin:0 auto}
.bl-hiwhead h2{font-size:30px;line-height:1.1;letter-spacing:-.02em}
.bl-hiwhead p{font-size:15px;line-height:1.6;color:var(--body)}
.bl-hiwrows{display:flex;flex-direction:column;gap:48px}
.bl-hiwrow{display:grid;gap:28px;align-items:center}
.bl-hiwtop{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.bl-hiwno{font-size:52px;font-weight:900;color:rgba(41,79,246,.3);line-height:1;letter-spacing:-.04em}
.bl-hiwic{width:48px;height:48px;border-radius:12px;background:rgba(41,79,246,.1);display:grid;place-items:center;color:var(--blue)}
.bl-hiwcopy h3{font-size:24px;line-height:1.2;letter-spacing:-.01em}
.bl-hiwcopy p{margin-top:10px;font-size:15px;line-height:1.6;color:var(--body)}
.bl-hiwimgwrap{position:relative}
.bl-hiwglow{position:absolute;inset:0;border-radius:24px;background:rgba(41,79,246,.15);filter:blur(60px);z-index:0}
.bl-hiwimg{position:relative;z-index:1;border-radius:18px;overflow:hidden;border:1px solid var(--border);background:#fff;box-shadow:0 20px 60px -25px rgba(41,79,246,.45)}
.bl-hiwimg img{width:100%;height:auto;display:block}
.bl-hiwdrop{border:2px dashed rgba(41,79,246,.3);background:rgba(41,79,246,.04);border-radius:18px;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;gap:24px;padding:24px}
.bl-hiwlogo-lg{width:128px;height:128px;object-fit:contain;filter:drop-shadow(0 16px 32px rgba(41,79,246,.3))}
.bl-hiwlogo-sm{width:80px;height:80px;object-fit:contain;filter:drop-shadow(0 12px 24px rgba(41,79,246,.25))}
.bl-hiwplus{font-size:32px;font-weight:700;color:rgba(41,79,246,.4);user-select:none}

/* Frame by frame — v2 block design (During/Result composition) */
.bl-fbfrow{display:grid;gap:36px;align-items:center}
.bl-fbfcopy{display:flex;flex-direction:column;align-items:flex-start;gap:16px}
.bl-fbfcopy h2{font-size:30px;line-height:1.1;letter-spacing:-.02em}
.bl-fbfcopy>p{font-size:15px;line-height:1.6;color:var(--body)}
.bl-fbflist{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:10px 24px}
.bl-fbflist li{display:flex;align-items:flex-start;gap:8px;font-size:14px;color:var(--navy2);line-height:1.45}
.bl-fbflist li svg{color:var(--blue);flex:none;margin-top:2px}
.bl-fbfvis{position:relative}
.bl-fbfglow{position:absolute;inset:0;border-radius:24px;background:rgba(41,79,246,.2);filter:blur(80px);z-index:0}
.bl-fbfgrid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.bl-fbfshot{position:relative}
.bl-fbfshot-down{margin-top:32px}
.bl-fbftag{position:absolute;top:-12px;left:12px;z-index:2;display:inline-flex;align-items:center;background:#fff;border:1px solid var(--bd2);border-radius:999px;padding:4px 10px;font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:700;color:var(--muted);box-shadow:0 2px 6px rgba(0,15,77,.08)}
.bl-fbftag-blue{background:var(--blue5);border-color:var(--blue5);color:#fff}
.bl-fbfimg{border-radius:16px;overflow:hidden;border:1px solid var(--border);background:#fff;box-shadow:0 16px 40px -20px rgba(0,15,77,.35)}
.bl-fbfimg img{width:100%;height:auto;display:block}

/* Comparison table — v2 block design */
.bl-cmphead{display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px;max-width:768px;margin:0 auto}
.bl-cmphead h2{font-size:30px;line-height:1.1;letter-spacing:-.02em}
.bl-cmphead p{font-size:15px;line-height:1.6;color:var(--body)}
.bl-cmpcard{background:#fff;border:1px solid var(--border);border-radius:18px;overflow:hidden;box-shadow:0 20px 60px -25px rgba(41,79,246,.25)}
.bl-cmpscroll{overflow-x:auto}
.bl-cmptable{width:100%;min-width:720px;border-collapse:collapse;text-align:left;table-layout:fixed}
.bl-cmptable thead tr{border-bottom:1px solid var(--border)}
.bl-cmptable thead th{padding:16px 8px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);text-align:center}
.bl-cmptable thead th.bl-cmpfeat{text-align:left;padding-left:20px;width:26%;font-weight:600}
.bl-cmptable tbody tr{border-bottom:1px solid rgba(238,244,253,.6)}
.bl-cmptable tbody tr:last-child{border-bottom:0}
.bl-cmptable tbody th{padding:12px 12px 12px 20px;font-size:13.5px;font-weight:500;color:var(--navy2);text-align:left}
.bl-cmptable td{padding:12px;text-align:center}
.bl-cmptable td svg{vertical-align:middle}
.bl-cmpbrand{background:rgba(41,79,246,.06);border-left:1px solid rgba(41,79,246,.2);border-right:1px solid rgba(41,79,246,.2)}
.bl-cmptable thead th.bl-cmpbrand{color:var(--blue);font-weight:800}
.bl-cmp-y{color:var(--blue)}
.bl-cmp-p{color:var(--muted)}
.bl-cmp-n{color:#dfe3ee}
.bl-cmplegend{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 24px;font-size:12px;color:var(--muted)}
.bl-cmplegend span{display:inline-flex;align-items:center;gap:6px}

/* FAQ — v2 block design */
.bl-faqwrap{max-width:768px;margin:0 auto;display:flex;flex-direction:column;gap:34px}
.bl-faqhead{display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px}
.bl-faqhead h2{font-size:30px;line-height:1.1;letter-spacing:-.02em}
.bl-pillbadge{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--bd2);background:#fff;border-radius:999px;padding:4px 12px 4px 6px;font-size:12px;font-weight:500;color:var(--muted)}
.bl-pillbadge img{width:20px;height:20px}
.bl-faqcard{background:#fff;border:1px solid var(--border);border-radius:18px;padding:0 22px;box-shadow:0 10px 30px -22px rgba(0,15,77,.25)}
.bl-faqitem{border-bottom:1px solid var(--border)}
.bl-faqitem:last-child{border-bottom:0}
.bl-faqitem>button{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;background:none;border:0;cursor:pointer;text-align:left}
.bl-faqitem>button h3{font-size:15.5px;font-weight:600;color:var(--navy);line-height:1.35;transition:color .15s}
.bl-faqitem>button:hover h3{color:var(--blue)}
.bl-faqtoggle{flex:none;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--l2);color:var(--muted);transition:all .18s}
.bl-faqitem>button:hover .bl-faqtoggle{background:rgba(41,79,246,.1);color:var(--blue)}
.bl-faqtoggle.bl-open{background:var(--blue5);color:#fff}
.bl-faqbody{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .3s ease,opacity .3s ease}
.bl-faqbody.bl-open{grid-template-rows:1fr;opacity:1;padding-bottom:20px}
.bl-faqbody>div{overflow:hidden}
.bl-faqbody p{font-size:14px;line-height:1.6;color:var(--body);padding-right:48px}

/* Final CTA — v2 block design (light band + glow blobs) */
.bl-lsec.bl-final{background:linear-gradient(135deg,rgba(41,79,246,.06),var(--page) 45%,rgba(41,79,246,.10));overflow:hidden}
.bl-fblob{position:absolute;border-radius:50%;filter:blur(110px);pointer-events:none}
.bl-fblob-a{top:-20%;left:25%;width:420px;height:420px;background:rgba(41,79,246,.25)}
.bl-fblob-b{bottom:-20%;right:25%;width:360px;height:360px;background:rgba(41,79,246,.15)}
.bl-finalwrap2{position:relative;z-index:1;max-width:768px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px}
.bl-finalwrap2 h2{font-size:32px;line-height:1.08;letter-spacing:-.02em;max-width:22ch}
.bl-finalwrap2>p{font-size:15px;line-height:1.6;color:var(--body);max-width:46ch}

/* Nav — pinned, transparent over the page, sized to match the native site nav */
.bl-nav{position:sticky;top:0;z-index:50;padding:14px 20px;background:transparent}
.bl-navin{max-width:1140px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
.bl-nav-logo img{height:42px;width:auto;display:block}
.bl-nav-right{display:flex;align-items:center;gap:22px}
.bl-nav-link{font-size:15px;font-weight:600;color:var(--navy);text-decoration:none}
.bl-nav-link:hover{color:var(--blue)}
.bl-nav .bl-btn.bl-sm{height:44px;padding:0 20px;font-size:14.5px}

/* Pinned download bar */
.bl-dlbar{position:sticky;top:70px;z-index:40;display:flex;justify-content:flex-end;margin-bottom:10px}
.bl-dlbar .bl-btn{box-shadow:0 10px 26px -12px rgba(0,15,77,.4)}

/* Closing bridge line */
.bl-closing-line{font-size:15px;font-weight:700;color:var(--navy);margin-top:6px}

/* Print report */
.bl-printreport{display:none}
@media print{
 body *{visibility:hidden!important}
 iframe{display:none!important}
 .bl-nav,.bl-dlbar{display:none!important}
 .bl-printreport,.bl-printreport *{visibility:visible!important}
 .bl-printreport{display:block;position:absolute;top:0;left:0;width:100%;background:#fff;color:#20242f;padding:26px 30px;font-family:"Inter",-apple-system,sans-serif;font-size:11px;line-height:1.5;-webkit-print-color-adjust:exact;print-color-adjust:exact}
 .bl-pr-head{display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #001364;padding-bottom:10px;margin-bottom:8px}
 .bl-pr-brand{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:#565d78}
 .bl-pr-brand img{width:24px;height:24px}
 .bl-pr-brand b{color:#001364;font-weight:800}
 .bl-pr-thumb{float:right;width:44px;height:78px;object-fit:cover;border-radius:8px;border:1px solid #d6defc;margin:0 0 8px 12px}
 .bl-pr-score{font-size:30px;font-weight:800;color:#294ff6;letter-spacing:-.03em}
 .bl-pr-score i{font-style:normal;font-size:12px;color:#838aa3;font-weight:700;letter-spacing:0}
 .bl-pr-meta{color:#565d78;margin:0 0 12px;font-size:11.5px}
 .bl-pr-verdict{font-weight:600;color:#001364;background:#e6ebff;border-radius:8px;padding:10px 12px;margin:0 0 8px;font-size:12.5px;line-height:1.5}
 .bl-pr-comment{color:#3c4358;white-space:pre-line;margin:0 0 14px}
 .bl-pr-fixfirst{background:#fdf3f2;border:1px solid #f3d5d2;border-radius:10px;padding:12px 14px;margin:0 0 16px;break-inside:avoid-page}
 .bl-pr-fixfirst h3{font-size:12px;font-weight:800;color:#b03a33;text-transform:uppercase;letter-spacing:.06em;margin:0 0 8px}
 .bl-pr-fix{display:flex;gap:10px;margin:0 0 9px;break-inside:avoid}
 .bl-pr-fix:last-child{margin-bottom:0}
 .bl-pr-frame{width:34px;height:60px;object-fit:cover;border-radius:5px;border:1px solid #e6d0ce;flex:none}
 .bl-pr-group{margin:0 0 14px;break-inside:avoid-page}
 .bl-pr-group h3{font-size:12.5px;font-weight:800;color:#001364;border-bottom:1.5px solid #d6defc;padding-bottom:5px;margin:0 0 7px;display:flex;justify-content:space-between;align-items:baseline}
 .bl-pr-group h3 span{font-size:10.5px;font-weight:700;color:#294ff6;background:#e6ebff;border-radius:99px;padding:2px 8px}
 .bl-pr-agent{margin:0 0 8px;break-inside:avoid}
 .bl-pr-ahead{margin:0;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
 .bl-pr-ahead b{color:#20242f;font-size:11.5px}
 .bl-pr-ahead i{font-style:normal;color:#565d78;font-size:10px;background:#eef2fa;border-radius:5px;padding:1px 6px}
 .bl-pr-pass{color:#1e7a48;background:rgba(45,170,99,.13);font-weight:700;font-size:9.5px;border-radius:99px;padding:1.5px 8px;text-transform:uppercase;letter-spacing:.04em}
 .bl-pr-flag{color:#b03a33;background:rgba(200,68,60,.12);font-weight:700;font-size:9.5px;border-radius:99px;padding:1.5px 8px;text-transform:uppercase;letter-spacing:.04em}
 .bl-pr-cm{margin:2px 0 0;color:#3c4358}
 .bl-pr-foot{margin-top:18px;border-top:1.5px solid #d6defc;padding-top:9px;color:#838aa3;font-size:9.5px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
 .bl-pr-foot span:last-child{color:#294ff6;font-weight:600}
}

@media (prefers-reduced-motion:reduce){
 .bl-scanline,.bl-flo,.bl-chip2,.bl-scorechip,.bl-pulse,.bl-caret,.bl-halo:before,.bl-halo img,.bl-barind:after,.bl-ping i:first-child{animation:none}
}
`;
