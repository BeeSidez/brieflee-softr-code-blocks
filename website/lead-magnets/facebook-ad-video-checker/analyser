async function blobToBase64(blob) {
  const buf = new Uint8Array(await blob.arrayBuffer());
  let bin = "";
  const CH = 0x8000;
  for (let i = 0; i < buf.length; i += CH) bin += String.fromCharCode.apply(null, buf.subarray(i, i + CH));
  return btoa(bin);
}

// ─── Typing cycle ──────────────────────────────────────────────
function useTypingCycle(words) {
  const [text, setText] = useState("");
  const [wordIndex, setWordIndex] = useState(0);
  const [phase, setPhase] = useState("typing");
  useEffect(() => {
    const word = words[wordIndex] || "";
    let t;
    if (phase === "typing") {
      if (text.length < word.length) t = setTimeout(() => setText(word.slice(0, text.length + 1)), 70);
      else t = setTimeout(() => setPhase("holding"), 0);
    } else if (phase === "holding") {
      t = setTimeout(() => setPhase("deleting"), 1400);
    } else if (text.length > 0) {
      t = setTimeout(() => setText(word.slice(0, text.length - 1)), 35);
    } else {
      setWordIndex((wordIndex + 1) % words.length);
      setPhase("typing");
    }
    return () => clearTimeout(t);
  }, [text, wordIndex, phase, words]);
  return text;
}

