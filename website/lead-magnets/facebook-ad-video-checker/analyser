.bl-assetdisc{position:relative;width:100%;height:100%;border-radius:50%;overflow:hidden;border:6px solid #fff;background:radial-gradient(circle at 50% 26%,#f4f7ff 0%,#e4eaff 55%,#d9e0ff 100%);box-shadow:0 30px 80px -25px rgba(41,79,246,.5);display:grid;place-items:center}
.bl-discvid{position:relative;height:66%;aspect-ratio:9/16;border-radius:12px;overflow:hidden;transform:rotate(-5deg);background:#d5dcf0;border:1px solid rgba(255,255,255,.85);box-shadow:0 16px 34px -16px rgba(0,15,77,.4)}
