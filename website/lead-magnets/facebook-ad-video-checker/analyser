        chain.forEach((node) => {
          const parent = node.parentElement;
          if (!parent) return;
          Array.from(parent.children).forEach((sib) => {
            if (sib !== node && !chain.includes(sib)) {
              touched.push([sib, sib.style.display]);
              sib.style.display = "none";
            }
          });
        });
      }
      window.print();
    } catch { /* ignore */ } finally {
