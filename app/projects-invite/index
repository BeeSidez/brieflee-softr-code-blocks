        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
      }
      .bl-invite-title {
        font-size: 18px;
        font-weight: 500;
        color: ${NAVY_DEEP};
        margin: 0;
        line-height: 1.25;
        letter-spacing: -0.01em;
      }
      .bl-invite-close {
        width: 28px;
        height: 28px;
        background: transparent;
        color: ${MUTED};
        border: none;
        border-radius: 999px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: background 0.15s, color 0.15s;
        flex-shrink: 0;
      }
      .bl-invite-close:hover {
        background: rgba(135, 156, 247, 0.10);
        color: ${NAVY_DEEP};
      }

      .bl-invite-body { display: flex; flex-direction: column; gap: 10px; }
      .bl-invite-field { display: flex; flex-direction: column; gap: 4px; }
      .bl-invite-label {
        font-size: 12px;
        font-weight: 500;
        color: ${NAVY_DEEP};
        letter-spacing: 0.01em;
      }
      .bl-invite-optional {
