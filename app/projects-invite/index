        color: ${MUTED};
        border: none;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 14px;
        border-radius: 8px;
        cursor: pointer;
        transition: color 0.15s;
      }
      .bl-invite-cancel:hover:not(:disabled) { color: ${NAVY_DEEP}; }
      .bl-invite-cancel:disabled { color: #C5CFE8; cursor: not-allowed; }

      /* Responsive: tighter padding on small screens so the form
         doesn't squeeze against the modal frame on mobile. */
      @media (max-width: 520px) {
        .bl-invite { padding: 18px 16px 16px; }
      }
    `}</style>
  );
}
