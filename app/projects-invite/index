      /* The block lives INSIDE Softr's modal iframe. Softr provides the
         outer white panel + drop shadow + X close, so we render the
         form flush — no second card, no lavender background. Just
         padding so the contents don't kiss the iframe edges. Tight
         vertical rhythm so the whole form fits inside Softr's "sm"
         modal height without forcing a scroll. */
      .bl-invite {
        background: #FFFFFF;
        min-height: auto;
        padding: 18px 24px 16px;
      }

      .bl-invite-content {
        width: 100%;
        max-width: none;
      }

