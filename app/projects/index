// =====================================================================
// /app/projects — Projects list (Vibe Code block)
// =====================================================================
// First foundation block of the projects rebuild. Replaces the Softr
// native projects list. Contains:
//
//   • Header (Projects + "Hey {firstName}" greeting)
//   • View tabs: Grid / List / Inactive / Unassigned
//     - Grid + List = layout toggles, show non-inactive projects
//     - Inactive = filters to status = Inactive
//     - Unassigned = filters to projects with no linked workspace
//   • Search input
//   • Status filter (Draft / Active / Closed)
//   • Workspace filter (the user's own accounts)
//   • Create Review button → opens vibe-coded "New Project" modal
//     (same file — captures name + description + workspace, writes to
//     the projects table via useRecordCreate)
//   • Card grid (default) / list rows — each tile shows thumbnail,
//     private/public lock, name, brief count, status pill. Clicking
//     navigates to /project/details/?recordId=...
//
// SOFTR UI SETUP:
//   1. Source tab → Database: brieflee beta → Tables: projects, accounts,
//      users. Three sources, so every record hook passes `from` (see the
//      datasource block below). The accounts source carries a record filter
//      so it only ever returns the logged-in user’s own workspaces.
//   2. Actions tab → enable Add Record (aliases auto-populate from
//      createFields below)
//   3. Visibility tab → logged-in user groups (Active / Paid / etc.)
//   4. Source filter optional — Softr's built-in row-level security
//      via the users relation already scopes projects to the current
//      user. We do additional client-side filtering for the tabs.
// =====================================================================

import { useEffect, useMemo, useRef, useState } from "react";
import {
  datasource,
  useRecord, useRecords, useRecordCreate, useRecordUpdate, useRecordDelete,
  useUpload, q,
} from "@/lib/datasource";
import { useCurrentUser } from "@/lib/user";
import {
  ArrowRight, Archive, Inbox, Grid as GridIcon, List as ListIcon,
  Lock, LockOpen, Plus, Search, X,
  MoreHorizontal, UserPlus, Copy as CopyIcon, Link2 as LinkIcon,
  Settings, Trash2, Upload as UploadIcon, ArrowUpDown,
} from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { toast } from "sonner";

// ─── Brand palette ────────────────────────────────────────────
const NAVY = "#000F4D";
const NAVY_DEEP = "#001364";
const PERIWINKLE = "#879CF7";
const PERIWINKLE_HOVER = "#294FF6";
const MUTED = "#6B7A99";
const BORDER = "rgba(217, 224, 255, 0.55)";
const TRACK = "rgba(217, 224, 255, 0.6)";

// ─── Datasources ──────────────────────────────
// The workspace dropdown and the demo-dismiss flag live on other tables, so
// this block reads three. With more than one source every record hook has to
// name its target — a hook without `from` throws at runtime.
const ds = datasource.define({
  projects: "86873560-190b-44bf-8303-c4714fb5acbb",
  accounts: "accounts",
  users: "users",
});

// ─── projects table field aliases (brieflee beta · hne0kugPrigIMs) ───
const select = q.select({
  name: "bvDEj", // SINGLE_LINE_TEXT (primary)
  description: "j2HQW", // LONG_TEXT
  status: "O7yxh", // SELECT — Draft / Active / Closed / Inactive
  accounts: "IBYGK", // LINKED_RECORD → accounts
  thumbnail: "hJd3v", // ATTACHMENT
  privateMode: "UP5QR", // CHECKBOX
  isDemo: "Halzm", // CHECKBOX — onboarding sample project
  totalBriefs: "wLX5S", // ROLLUP
  totalSubmissions: "74YXf", // ROLLUP
  totalReviews: "pMHqN", // ROLLUP
  pendingReviews: "TK0cc", // ROLLUP
  internalLink: "sgt6I", // FORMULA → /projects/details/?recordId=...
  createdAt: "SCgzt", // CREATED_AT
  updatedAt: "NTH6u", // UPDATED_AT
  users: "2YWNF", // LINKED_RECORD → users
});

// Aliases used by the user-record read + write for the demo-dismiss flag.
const userSelect = q.select({ demoDismissed: "dXPOQ" });

// Separate read against the user record for their linked accounts —
// kept apart from `userSelect` so the demoDismissed update hook
// can't accidentally clobber the accounts link.
const userAccountsSelect = q.select({
  accounts: "Nz6VX", // LINKED_RECORD → accounts
});

// Workspace creation page — where to send users who have zero
// accounts (brand new signups whose onboarding didn't run, or any
// edge case where the linked accounts list is empty).
const CREATE_WORKSPACE_PATH = "/settings/new-workspace";

// Fields written when creating a new project. Status defaults to Draft
// per the schema's defaultValue, so we don't need to set it explicitly.
const createFields = q.select({
  name: "bvDEj",
  description: "j2HQW",
  accounts: "IBYGK",
  users: "2YWNF",
});

// Fields written by the per-card actions (Settings, Mark Inactive, Duplicate).
const updateFields = q.select({
  name: "bvDEj",
  status: "O7yxh",
  accounts: "IBYGK",
  thumbnail: "hJd3v",
  privateMode: "UP5QR",
});

// Status SELECT option ids (from schema, pinned so we don't fetch).
const STATUS_OPTIONS = [
  { id: "66aed7a1-e9d0-454a-a8b7-db8ab34863df", label: "Draft", color: "#c2e9d7" },
  { id: "027772eb-5fa0-41c4-8f22-01b3f5a3a27b", label: "Active", color: "#c9e4ff" },
  { id: "02c2c8bb-a2bc-4df5-9631-eb566d938d86", label: "Closed", color: "#ffbcb3" },
  { id: "f65b9d24-c9e5-42c9-b05c-cc9d10800d73", label: "Inactive", color: "#cccfd4" },
];
const INACTIVE_ID = "f65b9d24-c9e5-42c9-b05c-cc9d10800d73";

// Default project thumbnail when none uploaded — the 3D projects
// folder. It is a transparent PNG of an object, so a card showing the
// default contains it (.bl-thumb-mark) rather than cropping it.
const DEFAULT_THUMB =
  "https://res.cloudinary.com/dchroynzv/image/upload/v1782934424/brieflee_icon_projects-folder-glass-3d-clearer-periwinkle-transparent_2026-07.png";

// Shared demo project — surfaced to every logged-in user until they
// dismiss it (which flips users.demo_dismissed via the X button).
// The projects table is scoped per-user by Softr's row-level security
// on the `users` link, so we fetch the demo by ID separately to bypass
// that filter. Multiple demo IDs supported in case we add more later;
// each is fetched individually because the q-builder doesn't expose a
// stable "checkbox = true" filter we can rely on across Softr versions.
const DEMO_PROJECT_IDS = ["1duDpSxMregIZy"]; // Velouré — Sunkissed Lip Oil — Launch UGC

// ─── Helpers ──────────────────────────────────────────────────
function deriveBrandLabel(websiteUrl) {
  if (!websiteUrl) return "";
  try {
    const u = new URL(/^https?:\/\//i.test(websiteUrl) ? websiteUrl : `https://${websiteUrl}`);
    const host = u.hostname.replace(/^www\./, "");
    const root = host.split(".")[0];
    return root ? root.charAt(0).toUpperCase() + root.slice(1) : "";
  } catch {
    return "";
  }
}
function unwrap(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw.trim();
  if (Array.isArray(raw)) return raw.map(unwrap).filter(Boolean).join(", ");
  if (typeof raw === "object") return raw.label || raw.value || raw.name || "";
  return String(raw);
}
function extractThumbUrl(raw) {
  if (!raw) return null;
  if (typeof raw === "string") return raw;
  const first = Array.isArray(raw) ? raw[0] : raw;
  if (!first) return null;
  if (typeof first === "string") return first;
  return first.thumbnailUrl || first.url || null;
}
function statusFor(record) {
  const raw = record?.fields?.status;
  if (!raw) return null;
  if (Array.isArray(raw)) return raw[0] || null;
  return raw;
}
function accountIdsFor(record) {
  const raw = record?.fields?.accounts;
  if (!Array.isArray(raw)) return [];
  return raw.map((a) => (a?.id || a)).filter(Boolean);
}
function getInternalLink(record) {
  const v = unwrap(record?.fields?.internalLink);
  return v || `/projects/details/?recordId=${record?.id || ""}`;
}
function isDemoProject(record) {
  return record?.fields?.isDemo === true;
}

// =====================================================================
// MAIN BLOCK
// =====================================================================
export default function Block() {
  const user = useCurrentUser();
  const firstName =
    user?.firstName || user?.first_name ||
    (user?.fullName || user?.name || "").split(" ")[0] || "";

  // Pull projects — Softr scopes via Source binding; we additionally
  // filter client-side based on tab + search + dropdowns.
  const { data, status: loadStatus, refetch } = useRecords({
    from: ds.projects,
    select,
    // useRecords pages at 6 by default and every tab, filter, search and sort
    // below runs client-side over this array, so the whole list has to be here.
    count: 100,
  });
  const ownProjects = useMemo(() => {
    const pages = data?.pages;
    if (Array.isArray(pages)) return pages.flatMap((p) => p?.items ?? []);
    return Array.isArray(data) ? data : [];
  }, [data]);

  // Demo project(s) — fetched by ID so Softr's row-level security on
  // projects.users doesn't filter them out for users who aren't
  // explicitly linked. Hooks can't be called in a loop, so we wire up
  // one useRecord per known demo ID. Keep DEMO_PROJECT_IDS small.
  const demoRecord0 = useRecord({
    from: ds.projects,
    recordId: DEMO_PROJECT_IDS[0],
    select,
    enabled: !!DEMO_PROJECT_IDS[0],
  });
  const demoProjects = useMemo(() => {
    const rec = demoRecord0?.data;
    if (!rec?.id) return [];
    // Only surface projects actually flagged is_demo — defensive in
    // case the flag gets unchecked.
    return rec?.fields?.isDemo === true ? [rec] : [];
  }, [demoRecord0?.data]);

  // Merge own + demo projects, deduping by id (the user may already be
  // linked to the demo project, e.g. the seed demo account itself).
  const projects = useMemo(() => {
    const seen = new Set(ownProjects.map((p) => p.id));
    return [...ownProjects, ...demoProjects.filter((d) => !seen.has(d.id))];
  }, [ownProjects, demoProjects]);

  // Pull the user's accounts so the Workspace dropdown has options.
  // Fallback chain for the visible label: account name → derived from
  // website (e.g. "huel.com" → "Huel") → "Untitled workspace". Never
  // shows the record id.
  const accountsSelect = q.select({
    name: "aAKkT",
    website: "RaK4B",
  });
  const accountsQuery = useRecords({ from: ds.accounts, select: accountsSelect, count: 100 });
  const accountOptions = useMemo(() => {
    const pages = accountsQuery.data?.pages;
    const items = Array.isArray(pages)
      ? pages.flatMap((p) => p?.items ?? [])
      : (Array.isArray(accountsQuery.data) ? accountsQuery.data : []);
    return items.map((a) => {
      const name = unwrap(a?.fields?.name);
      const fromWebsite = deriveBrandLabel(unwrap(a?.fields?.website));
      return {
        id: a.id,
        label: name || fromWebsite || "Untitled workspace",
      };
    });
  }, [accountsQuery.data]);

  // ─── View + filter state ──────────────────────────────────
  const [view, setView] = useState("grid"); // 'grid' | 'list' | 'inactive' | 'unassigned'
  const [sortBy, setSortBy] = useState("updated"); // 'updated' | 'name' | 'created'
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState(""); // option id or ""
  // workspaceFilter reads from the URL `?workspace=` param, which is
  // a comma-separated list of workspace IDs written by the workspace-
  // switcher block above. Empty = no filter (normal state, sample
  // visible). One id = filter to that workspace. Many ids = OR filter
  // (project matches if any of its accounts is in the set).
  const [workspaceFilter] = useState(() => {
    if (typeof window === "undefined") return "";
    return new URL(window.location.href).searchParams.get("workspace") || "";
  });
  const workspaceFilterSet = useMemo(() => {
    if (!workspaceFilter) return null;
    const ids = workspaceFilter.split(",").map((s) => s.trim()).filter(Boolean);
    return ids.length ? new Set(ids) : null;
  }, [workspaceFilter]);

  // Single read of the user's linked accounts — this is the source
  // of truth for "what workspaces does this user have". No
  // projects-derivation, no window handoffs — the user record knows
  // its own accounts, just read them.
  const userAccountsRecord = useRecord({
    from: ds.users,
    recordId: user?.id,
    select: userAccountsSelect,
    enabled: !!user?.id,
  });
  const userAccounts = useMemo(() => {
    const raw = userAccountsRecord?.data?.fields?.accounts;
    if (!Array.isArray(raw)) return [];
    return raw
      .map((a) => ({
        id: a?.id || "",
        label: unwrap(a) || "Untitled workspace",
      }))
      .filter((x) => x.id);
  }, [userAccountsRecord?.data]);

  // Map of workspace id → name for label resolution in the modal.
  // We prefer accountOptions (which carries the full `name` field from
  // the accounts table) over userAccounts (which only has whatever
  // label the linked-record reference happens to expose — sometimes
  // empty). Merge both as a fallback for edge cases where one source
  // has an id the other doesn't.
  const workspaceLabelLookup = useMemo(() => {
    const m = new Map();
    for (const a of userAccounts) {
      if (a.id) m.set(a.id, a.label);
    }
    for (const a of accountOptions) {
      if (a.id && a.label) m.set(a.id, a.label);
    }
    return m;
  }, [userAccounts, accountOptions]);

  // Default workspace a new project lands in:
  //   • Multi-account user with a tick in the switcher → that ticked workspace
  //   • Single-account user → their one and only account
  //   • Multi-account user with nothing ticked → empty (modal nudges them to pick)
  //   • Zero-account user → empty (modal shows the "create workspace" CTA)
  const defaultWorkspaceId = useMemo(() => {
    if (typeof window !== "undefined") {
      const raw = new URL(window.location.href).searchParams.get("workspace") || "";
      const first = raw.split(",").map((s) => s.trim()).filter(Boolean)[0];
      if (first) return first;
    }
    if (userAccounts.length === 1) return userAccounts[0].id;
    return "";
  }, [userAccounts]);

  const hasNoAccounts = !userAccountsRecord?.data
    ? false  // still loading — don't render the "create workspace" CTA prematurely
    : userAccounts.length === 0;

  // ─── Modal state for New Project ──────────────────────────
  // npWorkspace tracks which workspace the new project goes into.
  // It seeds from the URL on mount (for multi-account users coming
  // off the switcher) and gets re-seeded any time defaultWorkspaceId
  // changes — which happens once the user's projects load and we
  // know whether they have a single workspace to fall back to.
  const [modalOpen, setModalOpen] = useState(false);
  const [npName, setNpName] = useState("");
  const [npWorkspace, setNpWorkspace] = useState("");
  const [submitting, setSubmitting] = useState(false);

  // Default project name → "Untitled {workspaceName} Project".
  // Falls back to "Untitled Project" if we don't have a workspace name
  // yet (e.g. accounts haven't loaded or the user has zero accounts).
  const defaultName = useMemo(() => {
    if (!defaultWorkspaceId) return "Untitled Project";
    const label = workspaceLabelLookup.get(defaultWorkspaceId);
    if (!label) return "Untitled Project";
    return `Untitled ${label} Project`;
  }, [defaultWorkspaceId, workspaceLabelLookup]);

  // Sync npWorkspace to the computed default whenever the default
  // changes (e.g. projects finish loading for a single-account user
  // and we now know their workspace). Doesn't clobber a manual pick:
  // we only set if npWorkspace is empty OR matches the previous URL.
  useEffect(() => {
    if (!defaultWorkspaceId) return;
    setNpWorkspace((prev) => (prev ? prev : defaultWorkspaceId));
  }, [defaultWorkspaceId]);

  // Seed npName with the default when the modal opens — but only if
  // the user hasn't already typed something. We don't clobber edits
  // mid-session; we only fill the field when it's empty (which is
  // the case both on first open and after a Cancel→reopen).
  useEffect(() => {
    if (!modalOpen) return;
    setNpName((prev) => (prev ? prev : defaultName));
  }, [modalOpen, defaultName]);

  const createRecord = useRecordCreate({ from: ds.projects, fields: createFields });
  const updateRecord = useRecordUpdate({ from: ds.projects, fields: updateFields });
  const deleteRecord = useRecordDelete({ from: ds.projects });
  const upload = useUpload();

  // ─── Demo (onboarding sample) state ──────────────────────
  // Read the current user's demo_dismissed flag and offer a single
  // updateUser hook to flip it true when they confirm "Hide sample".
  // One shared demo project lives in the projects table tagged
  // is_demo=true — visible to every logged-in user until they dismiss
  // it. The X on the demo card opens a confirmation modal (rather
  // than dismissing immediately) so users understand the action is
  // permanent on this account — we don't surface a way to un-hide it
  // from the UI later.
  const userRecord = useRecord({
    from: ds.users,
    recordId: user?.id,
    select: userSelect,
    enabled: !!user?.id,
  });
  const demoDismissed = userRecord?.data?.fields?.demoDismissed === true;
  const updateUser = useRecordUpdate({ from: ds.users, fields: userSelect });

  const [dismissDemoOpen, setDismissDemoOpen] = useState(false);
  const [dismissDemoSubmitting, setDismissDemoSubmitting] = useState(false);
  const requestDismissDemo = () => setDismissDemoOpen(true);
  const closeDismissDemo = () => {
    if (dismissDemoSubmitting) return;
    setDismissDemoOpen(false);
  };
  const handleDismissDemo = async () => {
    if (!user?.id) return;
    setDismissDemoSubmitting(true);
    try {
      await updateUser.mutateAsync({
        recordId: user.id,
        fields: { demoDismissed: true },
      });
      toast.success("Sample project hidden");
      setDismissDemoOpen(false);
      await userRecord.refetch?.();
    } catch (e) {
      console.error("Dismiss demo failed:", e);
      toast.error("Couldn't dismiss", { description: e?.message || "Try again." });
    } finally {
      setDismissDemoSubmitting(false);
    }
  };

  // ─── Per-card menu + per-card modal state ────────────────
  // Only one card's menu open at a time. Outside-click closes.
  const [cardMenuOpenId, setCardMenuOpenId] = useState(null);
  const menuRef = useRef(null);
  useEffect(() => {
    if (!cardMenuOpenId) return;
    const onDown = (e) => {
      if (menuRef.current && !menuRef.current.contains(e.target)) {
        setCardMenuOpenId(null);
      }
    };
    document.addEventListener("mousedown", onDown);
    return () => document.removeEventListener("mousedown", onDown);
  }, [cardMenuOpenId]);

  // Which modal (if any) is open — and the project it acts on.
  const [activeModal, setActiveModal] = useState(null); // 'rename' | 'settings' | 'delete'
  const [activeProjectId, setActiveProjectId] = useState(null);
  const activeProject = useMemo(
    () => projects.find((p) => p.id === activeProjectId) || null,
    [projects, activeProjectId],
  );

  // Settings form state — Rename is folded into Settings as the
  // top-most Name field; there's no separate Rename modal anymore.
  const [stName, setStName] = useState("");
  const [stPrivate, setStPrivate] = useState(false);
  const [stStatus, setStStatus] = useState("");
  const [stWorkspace, setStWorkspace] = useState("");
  const [stThumbSaved, setStThumbSaved] = useState(null);    // existing attachment array (or null)
  const [stThumbPending, setStThumbPending] = useState(null); // new File pending save
  const [stThumbCleared, setStThumbCleared] = useState(false);
  const stThumbInputRef = useRef(null);

  const [actionSubmitting, setActionSubmitting] = useState(false);

  const openCardMenu = (id) => setCardMenuOpenId((cur) => (cur === id ? null : id));

  // A project's linked workspace can come back as an id, or as an object, or
  // as a bare label, depending on how the linked record resolves. Match it
  // against the real options so the select always opens on the right one.
  const resolveWorkspaceId = (project) => {
    const ids = accountIdsFor(project);
    for (const v of ids) {
      if (accountOptions.some((o) => o.id === v)) return v;
      const hit = accountOptions.find((o) => o.label === v);
      if (hit) return hit.id;
    }
    const raw = project?.fields?.accounts;
    const arr = Array.isArray(raw) ? raw : raw ? [raw] : [];
    for (const a of arr) {
      const label = a?.label || a?.title || a?.name || "";
      const hit = accountOptions.find((o) => o.label === label);
      if (hit) return hit.id;
    }
    return "";
  };

  const openModalForProject = (type, project) => {
    if (!project) return;
    setCardMenuOpenId(null);
    setActiveProjectId(project.id);
    setActiveModal(type);
    const f = project?.fields || {};
    if (type === "settings") {
      setStName(unwrap(f.name));
      setStPrivate(f.privateMode === true);
      const s = statusFor(project);
      setStStatus(s?.id || "");
      setStWorkspace(resolveWorkspaceId(project));
      setStThumbSaved(Array.isArray(f.thumbnail) ? f.thumbnail : null);
      setStThumbPending(null);
      setStThumbCleared(false);
    }
  };
  const closeAnyModal = () => {
    setActiveModal(null);
    setActiveProjectId(null);
    setStName("");
    setStPrivate(false);
    setStStatus("");
    setStWorkspace("");
    setStThumbSaved(null);
    setStThumbPending(null);
    setStThumbCleared(false);
    if (stThumbInputRef.current) stThumbInputRef.current.value = "";
  };

  // The Settings modal can open before the accounts finish loading, and
  // resolveWorkspaceId has nothing to match against until they do. Re-run it
  // once they land so the dropdown settles on the project’s real workspace
  // instead of sitting on “Select…”.
  useEffect(() => {
    if (activeModal !== "settings" || stWorkspace) return;
    if (!activeProject) return;
    const resolved = resolveWorkspaceId(activeProject);
    if (resolved) setStWorkspace(resolved);
  }, [activeModal, activeProject, accountOptions, stWorkspace]);

  // ─── Per-card action handlers ────────────────────────────
  const handleAddPeople = (project) => {
    setCardMenuOpenId(null);
    if (typeof window === "undefined") return;
    window.location.href = `/projects/details?recordId=${encodeURIComponent(project.id)}`;
  };

  const handleMarkInactive = async (project) => {
    setCardMenuOpenId(null);
    if (!project?.id) return;
    try {
      await updateRecord.mutateAsync({
        recordId: project.id,
        fields: { status: { id: INACTIVE_ID, label: "Inactive" } },
      });
      const name = unwrap(project?.fields?.name) || "Project";
      toast.success(`${name} marked inactive`);
      await refetch?.();
    } catch (e) {
      console.error("Mark inactive failed:", e);
      toast.error("Couldn't update", { description: e?.message || "Try again." });
    }
  };

  // ─── Copy Link ─────────────────────────────────────────────
  // Copies the absolute project detail URL to the clipboard. Uses
  // the `internalLink` formula field as the source-of-truth path
  // (falls back to /projects/details/?recordId=... if blank), then
  // builds an absolute URL with window.location.origin so the
  // recipient can paste it straight into Slack / email and land on
  // the right page.
  const handleCopyLink = async (project) => {
    setCardMenuOpenId(null);
    if (!project?.id) return;
    const href = getInternalLink(project);
    const absolute = typeof window !== "undefined" && href.startsWith("/")
      ? `${window.location.origin}${href}`
      : href;
    try {
      if (navigator?.clipboard?.writeText) {
        await navigator.clipboard.writeText(absolute);
      } else {
        // Fallback for older browsers / non-secure contexts.
        const ta = document.createElement("textarea");
        ta.value = absolute;
        ta.style.position = "fixed";
        ta.style.left = "-9999px";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
      }
      toast.success("Link copied");
    } catch (e) {
      console.error("Copy link failed:", e);
      toast.error("Couldn't copy link", { description: e?.message || "Try again." });
    }
  };

  // ─── Duplicate Project ────────────────────────────────────
  // Shell-only clone — copies name (prefixed with "Copy of"),
  // description, workspace, privacy, thumbnail. Briefs/submissions/
  // reviews are NOT copied — those belong to the original. Status
  // defaults to Draft via the schema default; we set it explicitly so
  // the duplicate doesn't inherit Inactive from the source.
  const handleDuplicate = async (project) => {
    setCardMenuOpenId(null);
    if (!project?.id || !user?.id) return;
    if (!createRecord.enabled) {
      toast.error("Cannot create records right now");
      return;
    }
    const f = project?.fields || {};
    const originalName = unwrap(f.name) || "Untitled project";
    try {
      await createRecord.mutateAsync({
        name: `Copy of ${originalName}`,
        description: unwrap(f.description) || "",
        accounts: accountIdsFor(project).map((id) => ({ id })),
        users: [{ id: user.id }],
      });
      toast.success(`Duplicated ${originalName}`);
      await refetch?.();
    } catch (e) {
      console.error("Duplicate failed:", e);
      toast.error("Couldn't duplicate", { description: e?.message || "Try again." });
    }
  };

  const handleSettingsSubmit = async () => {
    if (!activeProjectId) return;
    if (!stName.trim()) {
      toast.error("Name can't be empty");
      return;
    }
    setActionSubmitting(true);
    try {
      // Resolve the new thumbnail value (upload first if needed).
      let thumbnailForWrite; // undefined = don't touch
      if (stThumbPending) {
        // useUpload exposes uploadAsync, not mutateAsync, and it resolves to an
        // ARRAY of results. Calling mutateAsync here was the save error.
        const [res] = await upload.uploadAsync(stThumbPending);
        if (!res || res.status !== "completed") {
          throw new Error(res?.error?.message || "That image could not be uploaded.");
        }
        thumbnailForWrite = [
          { filename: res.file?.name || stThumbPending?.name || "thumbnail", url: res.url },
        ];
      } else if (stThumbCleared) {
        thumbnailForWrite = null;
      }
      const fields = {
        name: stName.trim(),
        privateMode: stPrivate,
      };
      if (stStatus) {
        const opt = STATUS_OPTIONS.find((o) => o.id === stStatus);
        if (opt) fields.status = { id: opt.id, label: opt.label };
      }
      if (stWorkspace) {
        fields.accounts = [{ id: stWorkspace }];
      }
      if (thumbnailForWrite !== undefined) fields.thumbnail = thumbnailForWrite;

      await updateRecord.mutateAsync({
        recordId: activeProjectId,
        fields,
      });
      toast.success("Project settings updated");
      closeAnyModal();
      await refetch?.();
    } catch (e) {
      console.error("Settings save failed:", e);
      // Never show a raw implementation error to the customer.
      const raw = e?.message || "";
      const looksInternal = /is not a function|undefined|null|\bTypeError\b/i.test(raw);
      toast.error("Couldn't save settings", {
        description: looksInternal || !raw ? "Something went wrong saving those changes. Try again." : raw,
      });
    } finally {
      setActionSubmitting(false);
    }
  };

  const handleDeleteConfirm = async () => {
    if (!activeProjectId) return;
    setActionSubmitting(true);
    try {
      // useRecordDelete takes the record id DIRECTLY, not { recordId }.
      // (useRecordUpdate is the one that takes an object — easy to mix up.)
      // Passing an object here is what produced "Failed to delete record: 400".
      await deleteRecord.mutateAsync(activeProjectId);
      const name = unwrap(activeProject?.fields?.name) || "Project";
      toast.success(`${name} deleted`);
      closeAnyModal();
      await refetch?.();
    } catch (e) {
      console.error("Delete failed:", e);
      // A bare status code tells the user nothing, so swap it for the
      // likeliest cause. Anything with a real message shows as-is.
      const raw = (e?.message || "").trim();
      const bareStatus = !raw || /^failed to delete record:?\s*\d+$/i.test(raw);
      toast.error("Couldn't delete", {
        description: bareStatus
          ? "This project couldn't be removed. It may still have briefs or submissions linked to it — clear those first."
          : raw,
      });
    } finally {
      setActionSubmitting(false);
    }
  };

  const handleThumbnailFile = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setStThumbPending(file);
    setStThumbCleared(false);
  };
  const handleThumbnailRemove = () => {
    setStThumbPending(null);
    setStThumbCleared(true);
    if (stThumbInputRef.current) stThumbInputRef.current.value = "";
  };
  const previewThumbnailUrl = useMemo(() => {
    if (stThumbCleared) return null;
    if (stThumbPending) return URL.createObjectURL(stThumbPending);
    return extractThumbUrl(stThumbSaved);
  }, [stThumbCleared, stThumbPending, stThumbSaved]);

  // Single dispatcher the card menus call into. Keeps ProjectCard
  // dumb — it only emits action names + the project record.
  const dispatchAction = (action, project) => {
    if (!project) return;
    switch (action) {
      case "copy-link": return handleCopyLink(project);
      case "duplicate": return handleDuplicate(project);
      case "mark-inactive": return handleMarkInactive(project);
      case "settings": return openModalForProject("settings", project);
      case "add-people": return handleAddPeople(project);
      case "delete": return openModalForProject("delete", project);
      default: return;
    }
  };

  // ─── Filtered list ────────────────────────────────────────
  const filtered = useMemo(() => {
    const list = projects.filter((p) => {
      const s = statusFor(p);
      const sid = s?.id;
      const accIds = accountIdsFor(p);
      const demo = isDemoProject(p);

      // Demos only appear on Grid + List. Hide everywhere if the user
      // has dismissed them. Hide from Inactive + Unassigned tabs too —
      // the sample never lives in those buckets.
      if (demo) {
        if (demoDismissed) return false;
        if (view === "inactive" || view === "unassigned") return false;
      }

      // Tab gate
      if (view === "inactive") {
        if (sid !== INACTIVE_ID) return false;
      } else if (view === "unassigned") {
        if (accIds.length > 0) return false;
      } else {
        // grid / list — exclude inactive
        if (sid === INACTIVE_ID) return false;
      }

      // Status filter (only applies on grid + list views)
      if ((view === "grid" || view === "list") && statusFilter) {
        if (sid !== statusFilter) return false;
      }

      // Workspace filter — multi-select. Project passes if any of its
      // linked accounts is in the user-selected set. Empty set = no
      // filter, everything passes.
      if (workspaceFilterSet && view !== "unassigned") {
        const matches = accIds.some((id) => workspaceFilterSet.has(id));
        if (!matches) return false;
      }

      // Search
      if (search.trim()) {
        const needle = search.trim().toLowerCase();
        const haystack = [
          unwrap(p?.fields?.name),
          unwrap(p?.fields?.description),
        ].join(" ").toLowerCase();
        if (!haystack.includes(needle)) return false;
      }

      return true;
    });

    // Sort. Demos always pin to the top so the onboarding card doesn't
    // get buried, regardless of which sort is active.
    const getDate = (p, key) => {
      const raw = p?.fields?.[key];
      if (!raw) return 0;
      const t = new Date(raw).getTime();
      return Number.isFinite(t) ? t : 0;
    };
    const cmp = (() => {
      if (sortBy === "name") {
        return (a, b) => unwrap(a?.fields?.name).localeCompare(unwrap(b?.fields?.name));
      }
      if (sortBy === "created") {
        return (a, b) => getDate(b, "createdAt") - getDate(a, "createdAt");
      }
      // default: recently updated
      return (a, b) => getDate(b, "updatedAt") - getDate(a, "updatedAt");
    })();
    const sorted = [...list].sort(cmp);
    sorted.sort((a, b) => Number(isDemoProject(b)) - Number(isDemoProject(a)));
    return sorted;
  }, [projects, view, statusFilter, workspaceFilterSet, search, sortBy, demoDismissed]);

  // ─── Modal lifecycle ──────────────────────────────────────
  const resetModal = () => {
    // Clear npName so the seed effect re-fills with the latest
    // defaultName next time the modal opens (e.g. after Cancel).
    setNpName("");
    // Re-default to the computed workspace (URL switcher first,
    // single-account fallback second).
    setNpWorkspace(defaultWorkspaceId);
  };
  const closeModal = () => {
    resetModal();
    setModalOpen(false);
  };

  const handleCreate = async () => {
    if (!npName.trim()) {
      toast.error("Project name is required");
      return;
    }
    if (!npWorkspace) {
      toast.error("Pick a workspace for this project");
      return;
    }
    if (!user?.id) {
      toast.error("Please log in to create a project");
      return;
    }
    if (!createRecord.enabled) {
      toast.error("Cannot create records right now");
      return;
    }
    setSubmitting(true);
    try {
      const created = await createRecord.mutateAsync({
        name: npName.trim(),
        accounts: [{ id: npWorkspace }],
        users: [{ id: user.id }],
      });
      toast.success("Project created");
      resetModal();
      setModalOpen(false);
      // Refetch the list so the new project appears immediately.
      await refetch?.();
      // Optionally navigate to the new project. Keep the user on the
      // list for now — they can click into it. (Toggleable later.)
      void created;
    } catch (e) {
      console.error("Create project failed:", e);
      toast.error("Couldn't create project", {
        description: e?.message || "Try again.",
      });
    } finally {
      setSubmitting(false);
    }
  };

  // ─── Render ───────────────────────────────────────────────
  const isLoading = loadStatus === "pending";
  const isEmpty = !isLoading && filtered.length === 0;

  return (
    <>
      <Style />
      <div className="bl-projects">
        <div className="bl-projects-inner">

          {/* Header */}
          <header className="bl-projects-header">
            <h1 className="bl-projects-title">Projects</h1>
            <p className="bl-projects-greeting">
              <span className="bl-greeting-spark" aria-hidden>✨</span>{" "}
              Hey {firstName || "there"}
            </p>
          </header>

          {/* View tabs */}
          <nav className="bl-projects-tabs" role="tablist" aria-label="Project views">
            <TabButton
              icon={GridIcon}
              label="Grid"
              active={view === "grid"}
              onClick={() => setView("grid")}
            />
            <TabButton
              icon={ListIcon}
              label="List"
              active={view === "list"}
              onClick={() => setView("list")}
            />
            <TabButton
              icon={Archive}
              label="Inactive"
              active={view === "inactive"}
              onClick={() => setView("inactive")}
            />
            <TabButton
              icon={Inbox}
              label="Unassigned"
              active={view === "unassigned"}
              onClick={() => setView("unassigned")}
            />
          </nav>

          {/* Controls row: search · filters · create button */}
          <div className="bl-projects-controls">
            <div className="bl-projects-search">
              <Search className="bl-projects-search-icon" size={14} />
              <input
                type="text"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search projects"
                className="bl-projects-search-input"
              />
              {search && (
                <button
                  type="button"
                  onClick={() => setSearch("")}
                  className="bl-projects-search-clear"
                  aria-label="Clear search"
                >
                  <X size={14} />
                </button>
              )}
            </div>

            <div className="bl-projects-filters">
              <select
                value={statusFilter}
                onChange={(e) => setStatusFilter(e.target.value)}
                className="bl-projects-select"
                aria-label="Status filter"
                disabled={view === "inactive" || view === "unassigned"}
              >
                <option value="">Status</option>
                {STATUS_OPTIONS
                  .filter((o) => o.id !== INACTIVE_ID)
                  .map((o) => (
                    <option key={o.id} value={o.id}>{o.label}</option>
                  ))}
              </select>

              <select
                value={sortBy}
                onChange={(e) => setSortBy(e.target.value)}
                className="bl-projects-select"
                aria-label="Sort projects"
              >
                <option value="updated">Recently updated</option>
                <option value="created">Recently created</option>
                <option value="name">Name (A → Z)</option>
              </select>
            </div>

            <button
              type="button"
              onClick={() => setModalOpen(true)}
              className="bl-btn bl-btn-primary bl-btn-end"
            >
              <Plus size={14} strokeWidth={2} />
              Create Review
            </button>
          </div>

          {/* Body */}
          {isLoading ? (
            <div className="bl-projects-loading">
              {Array.from({ length: 6 }).map((_, i) => (
                <div key={i} className="bl-projects-skeleton" />
              ))}
            </div>
          ) : isEmpty ? (
            <EmptyState view={view} onCreate={() => setModalOpen(true)} />
          ) : view === "list" ? (
            <ListView
              projects={filtered}
              menuOpenId={cardMenuOpenId}
              onOpenMenu={openCardMenu}
              onAction={dispatchAction}
              menuRef={menuRef}
              onDismissDemo={requestDismissDemo}
            />
          ) : (
            <GridView
              projects={filtered}
              menuOpenId={cardMenuOpenId}
              onOpenMenu={openCardMenu}
              onAction={dispatchAction}
              menuRef={menuRef}
              onDismissDemo={requestDismissDemo}
            />
          )}
        </div>
      </div>

      {/* ============ Project Settings Modal ============ */}
      {activeModal === "settings" && activeProject && (
        <div className="bl-modal-backdrop" onClick={closeAnyModal}>
          <div
            className="bl-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="st-title"
            onClick={(e) => e.stopPropagation()}
            style={{ maxWidth: 520 }}
          >
            <header className="bl-modal-header">
              <div>
                <h3 id="st-title" className="bl-modal-title">Project settings</h3>
                <p className="bl-modal-sub">Visibility, status, thumbnail, workspace.</p>
              </div>
              <button
                type="button"
                onClick={closeAnyModal}
                className="bl-modal-close"
                aria-label="Close"
              ><X size={18} /></button>
            </header>

            <div className="bl-modal-body">
              {/* Name (Rename folded into Settings) */}
              <div className="bl-modal-field">
                <label className="bl-modal-label" htmlFor="st-name">
                  Name <span style={{ color: "#d92626" }}>*</span>
                </label>
                <Input
                  id="st-name"
                  value={stName}
                  onChange={(e) => setStName(e.target.value)}
                  disabled={actionSubmitting}
                  autoFocus
                />
              </div>

              {/* Project access (private toggle) */}
              <div className="bl-modal-field">
                <label className="bl-toggle-row">
                  <input
                    type="checkbox"
                    checked={stPrivate}
                    onChange={(e) => setStPrivate(e.target.checked)}
                    disabled={actionSubmitting}
                  />
                  <span>
                    <span className="bl-toggle-label">
                      {stPrivate ? "Private" : "Public"}
                    </span>
                    <span className="bl-toggle-hint">
                      {stPrivate
                        ? "Only people you add can see this project."
                        : "Anyone with the link can view this project."}
                    </span>
                  </span>
                </label>
              </div>

              {/* Status */}
              <div className="bl-modal-field">
                <label className="bl-modal-label" htmlFor="st-status">Status</label>
                <select
                  id="st-status"
                  value={stStatus}
                  onChange={(e) => setStStatus(e.target.value)}
                  className="bl-projects-select"
                  disabled={actionSubmitting}
                >
                  <option value="">Select…</option>
                  {STATUS_OPTIONS.map((o) => (
                    <option key={o.id} value={o.id}>{o.label}</option>
                  ))}
                </select>
              </div>

              {/* Thumbnail */}
              <div className="bl-modal-field">
                <label className="bl-modal-label">Thumbnail</label>
                <div className="bl-thumb-row">
                  <div className="bl-thumb-preview">
                    {previewThumbnailUrl ? (
                      <img src={previewThumbnailUrl} alt="Project thumbnail" />
                    ) : (
                      <span className="bl-thumb-empty">No thumbnail</span>
                    )}
                  </div>
                  <div className="bl-thumb-actions">
                    <input
                      ref={stThumbInputRef}
                      type="file"
                      accept="image/*"
                      onChange={handleThumbnailFile}
                      style={{ display: "none" }}
                    />
                    <button
                      type="button"
                      onClick={() => stThumbInputRef.current?.click()}
                      disabled={actionSubmitting}
                      className="bl-thumb-btn"
                    >
                      <UploadIcon size={14} />
                      {previewThumbnailUrl ? "Change" : "Upload"}
                    </button>
                    {previewThumbnailUrl && (
                      <button
                        type="button"
                        onClick={handleThumbnailRemove}
                        disabled={actionSubmitting}
                        className="bl-thumb-btn bl-thumb-btn-ghost"
                      >
                        Remove
                      </button>
                    )}
                  </div>
                </div>
              </div>

              {/* Workspace */}
              <div className="bl-modal-field">
                <label className="bl-modal-label" htmlFor="st-ws">Workspace</label>
                <select
                  id="st-ws"
                  value={stWorkspace}
                  onChange={(e) => setStWorkspace(e.target.value)}
                  className="bl-projects-select"
                  disabled={actionSubmitting}
                >
                  <option value="">Select…</option>
                  {accountOptions.map((a) => (
                    <option key={a.id} value={a.id}>{a.label}</option>
                  ))}
                </select>
              </div>
            </div>

            <footer className="bl-modal-footer">
              <button
                type="button"
                onClick={closeAnyModal}
                disabled={actionSubmitting}
                className="bl-modal-cancel"
              >Cancel</button>
              <Button
                onClick={handleSettingsSubmit}
                disabled={actionSubmitting || !stName.trim()}
                style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
              >
                {actionSubmitting ? "Saving…" : "Save"}
              </Button>
            </footer>
          </div>
        </div>
      )}

      {/* ============ Delete Confirmation Modal ============ */}
      {activeModal === "delete" && activeProject && (
        <div className="bl-modal-backdrop" onClick={closeAnyModal}>
          <div
            className="bl-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="dl-title"
            onClick={(e) => e.stopPropagation()}
            style={{ maxWidth: 420 }}
          >
            <header className="bl-modal-header">
              <div>
                <h3 id="dl-title" className="bl-modal-title">Delete this project?</h3>
                <p className="bl-modal-sub">
                  This permanently removes <strong>{unwrap(activeProject?.fields?.name)}</strong> and everything inside it. This can't be undone.
                </p>
              </div>
              <button
                type="button"
                onClick={closeAnyModal}
                className="bl-modal-close"
                aria-label="Close"
              ><X size={18} /></button>
            </header>
            <footer className="bl-modal-footer">
              <button
                type="button"
                onClick={closeAnyModal}
                disabled={actionSubmitting}
                className="bl-modal-cancel"
              >Cancel</button>
              <Button
                onClick={handleDeleteConfirm}
                disabled={actionSubmitting}
                style={{ backgroundColor: "#d92626", color: "#fff" }}
              >
                {actionSubmitting ? "Deleting…" : "Delete"}
              </Button>
            </footer>
          </div>
        </div>
      )}

      {/* ============ Dismiss Demo Confirmation Modal ============ */}
      {dismissDemoOpen && (
        <div className="bl-modal-backdrop" onClick={closeDismissDemo}>
          <div
            className="bl-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="dd-title"
            onClick={(e) => e.stopPropagation()}
            style={{ maxWidth: 420 }}
          >
            <header className="bl-modal-header">
              <div>
                <h3 id="dd-title" className="bl-modal-title">Hide this sample?</h3>
                <p className="bl-modal-sub">
                  We added this sample project so you can poke around a real
                  Brieflee review. Hide it and it won't come back on this
                  account.
                </p>
              </div>
              <button
                type="button"
                onClick={closeDismissDemo}
                className="bl-modal-close"
                aria-label="Close"
              ><X size={18} /></button>
            </header>
            <footer className="bl-modal-footer">
              <button
                type="button"
                onClick={closeDismissDemo}
                disabled={dismissDemoSubmitting}
                className="bl-modal-cancel"
              >Cancel</button>
              <Button
                onClick={handleDismissDemo}
                disabled={dismissDemoSubmitting}
                style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
              >
                {dismissDemoSubmitting ? "Hiding…" : "Hide sample"}
              </Button>
            </footer>
          </div>
        </div>
      )}

      {/* ============ Create Project Modal ============ */}
      {modalOpen && (
        <div
          className="bl-modal-backdrop"
          role="presentation"
          onClick={closeModal}
        >
          <div
            className="bl-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="np-title"
            onClick={(e) => e.stopPropagation()}
          >
            <header className="bl-modal-header">
              <div>
                <h3 id="np-title" className="bl-modal-title">Create New Project</h3>
                <p className="bl-modal-sub">Group briefs, content, and reviews together.</p>
              </div>
              <button
                type="button"
                onClick={closeModal}
                className="bl-modal-close"
                aria-label="Close"
              >
                <X size={18} />
              </button>
            </header>

            <div className="bl-modal-body">
              <div className="bl-modal-field">
                <label className="bl-modal-label" htmlFor="np-name">
                  Name <span style={{ color: "#d92626" }}>*</span>
                </label>
                <Input
                  id="np-name"
                  value={npName}
                  onChange={(e) => setNpName(e.target.value)}
                  placeholder={defaultName}
                  disabled={submitting}
                  autoFocus
                />
              </div>

              {/* Workspace — read-only. Comes from the user's
                  linked accounts. Three states:
                   - they have a workspace selected → show its name
                   - they have multiple but haven't picked → nudge to switcher
                   - they have zero accounts → CTA to create one */}
              <div className="bl-modal-field">
                <label className="bl-modal-label">Workspace</label>
                {npWorkspace ? (
                  <div className="bl-modal-static">
                    {workspaceLabelLookup.get(npWorkspace) || "Selected workspace"}
                  </div>
                ) : hasNoAccounts ? (
                  <a
                    href={CREATE_WORKSPACE_PATH}
                    className="bl-modal-static"
                    style={{
                      display: "block",
                      color: PERIWINKLE,
                      background: "rgba(135, 156, 247, 0.08)",
                      borderColor: "rgba(135, 156, 247, 0.45)",
                      textDecoration: "none",
                    }}
                  >
                    You don't have a workspace yet — create one to get started.
                  </a>
                ) : (
                  <div className="bl-modal-static" style={{ color: "#B45309", background: "rgba(217, 119, 6, 0.06)", borderColor: "rgba(217, 119, 6, 0.35)" }}>
                    Tick a workspace in the switcher above first.
                  </div>
                )}
              </div>
            </div>

            <footer className="bl-modal-footer">
              <button
                type="button"
                onClick={closeModal}
                disabled={submitting}
                className="bl-modal-cancel"
              >
                Cancel
              </button>
              <Button
                onClick={handleCreate}
                disabled={submitting || !npName.trim() || !npWorkspace}
                style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
              >
                {submitting ? "Creating…" : "Create"}
              </Button>
            </footer>
          </div>
        </div>
      )}
    </>
  );
}

// =====================================================================
// Subcomponents
// =====================================================================

function TabButton({ icon: Icon, label, active, onClick }) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={`bl-projects-tab ${active ? "is-active" : ""}`}
      role="tab"
      aria-selected={active}
    >
      <Icon size={14} />
      <span>{label}</span>
    </button>
  );
}

// Defensive label normalization — until the Softr Tables UI rename
// of "Archive" → "Inactive" is done by hand, records may still surface
// the old label. Map both to the current user-facing word.
function normalizeStatusLabel(raw) {
  if (!raw) return "";
  return raw === "Archive" ? "Inactive" : raw;
}

function StatusPill({ status }) {
  if (!status) return null;
  const label = normalizeStatusLabel(status.label || "");
  const bg = (status.color || "#cccfd4") + "33"; // ~20% alpha for fill
  const border = (status.color || "#cccfd4") + "66";
  return (
    <span
      className="bl-status-pill"
      style={{ backgroundColor: bg, border: `1px solid ${border}`, color: NAVY }}
    >
      {label}
    </span>
  );
}

function PrivacyOverlay({ isPrivate }) {
  return (
    <span className="bl-privacy-overlay">
      {isPrivate ? <Lock size={11} /> : <LockOpen size={11} />}
      {isPrivate ? "Private" : "Public"}
    </span>
  );
}

function ProjectCard({
  project, menuOpen, onOpenMenu, onAction, menuRef, onDismissDemo,
}) {
  const f = project?.fields || {};
  const ownThumb = extractThumbUrl(f.thumbnail);
  const thumb = ownThumb || DEFAULT_THUMB;
  const status = statusFor(project);
  const name = unwrap(f.name) || "Untitled project";
  const briefs = Number(unwrap(f.totalBriefs)) || 0;
  const pending = Number(unwrap(f.pendingReviews)) || 0;
  const isPrivate = f.privateMode === true;
  const href = getInternalLink(project);
  const demo = isDemoProject(project);
  const stop = (e) => { e.preventDefault(); e.stopPropagation(); };

  return (
    <a href={href} className={`bl-card ${menuOpen ? "is-menu-open" : ""} ${demo ? "is-demo" : ""}`}>
      <div className="bl-card-thumb">
        <img src={thumb} alt={name} draggable={false} className={ownThumb ? undefined : "bl-thumb-mark"} />
        {demo ? (
          <span className="bl-card-sample-badge">Sample</span>
        ) : (
          <PrivacyOverlay isPrivate={isPrivate} />
        )}
        {status && <span className="bl-card-status"><StatusPill status={status} /></span>}
        {demo && (
          <div
            className="bl-card-menu-wrap"
            onMouseDown={stop}
            onClick={stop}
          >
            <button
              type="button"
              className="bl-card-menu-trigger bl-card-dismiss-btn is-open"
              aria-label="Hide sample project"
              title="Hide sample"
              onClick={(e) => { stop(e); onDismissDemo?.(); }}
            >
              <X size={14} />
            </button>
          </div>
        )}
      </div>
      <div className="bl-card-body">
        <div className="bl-card-name">{name}</div>
        <div className="bl-card-meta">
          {briefs === 0 && !demo ? (
            <button
              type="button"
              className="bl-card-invite"
              onClick={(e) => { stop(e); onAction("add-people", project); }}
            >
              <UserPlus size={11} />
              <span>Invite team</span>
            </button>
          ) : (
            <span>{briefs} {briefs === 1 ? "brief" : "briefs"}</span>
          )}
          {pending > 0 && (
            <span className="bl-card-pending">{pending} pending</span>
          )}
          {!demo && (
            <div className="bl-card-meta-actions">
              <CardMenu
                project={project}
                isOpen={menuOpen}
                onOpenMenu={onOpenMenu}
                onAction={onAction}
                menuRef={menuRef}
              />
            </div>
          )}
        </div>
      </div>
    </a>
  );
}

// Shared `…` menu rendered on each card (Grid) and each list row.
// Trigger is hover-visible (or always visible when the menu is open).
// Stops event propagation on every interaction so the wrapping <a>
// never navigates while the user is using the menu.
function CardMenu({ project, isOpen, onOpenMenu, onAction, menuRef }) {
  const stop = (e) => { e.preventDefault(); e.stopPropagation(); };
  return (
    <div
      className="bl-card-menu-wrap"
      ref={isOpen ? menuRef : undefined}
      onMouseDown={stop}
      onClick={stop}
    >
      <button
        type="button"
        className={`bl-card-menu-trigger ${isOpen ? "is-open" : ""}`}
        aria-label="Project actions"
        aria-haspopup="menu"
        aria-expanded={isOpen}
        onClick={(e) => { stop(e); onOpenMenu(project.id); }}
      >
        <MoreHorizontal size={16} />
      </button>
      {isOpen && (
        <div className="bl-card-menu" role="menu">
          <MenuItem
            icon={LinkIcon}
            label="Copy link"
            onClick={(e) => { stop(e); onAction("copy-link", project); }}
          />
          <MenuItem
            icon={CopyIcon}
            label="Duplicate Project"
            onClick={(e) => { stop(e); onAction("duplicate", project); }}
          />
          <MenuItem
            icon={Archive}
            label="Mark Inactive"
            onClick={(e) => { stop(e); onAction("mark-inactive", project); }}
          />
          <MenuItem
            icon={Settings}
            label="Project Settings"
            onClick={(e) => { stop(e); onAction("settings", project); }}
          />
          <MenuItem
            icon={UserPlus}
            label="Add people"
            onClick={(e) => { stop(e); onAction("add-people", project); }}
          />
          <div className="bl-menu-divider" role="separator" />
          <MenuItem
            icon={Trash2}
            label="Delete"
            danger
            onClick={(e) => { stop(e); onAction("delete", project); }}
          />
        </div>
      )}
    </div>
  );
}

function MenuItem({ icon: Icon, label, danger, onClick }) {
  return (
    <button
      type="button"
      role="menuitem"
      className={`bl-menu-item ${danger ? "is-danger" : ""}`}
      onClick={onClick}
    >
      <Icon size={14} />
      <span>{label}</span>
    </button>
  );
}

function GridView({ projects, menuOpenId, onOpenMenu, onAction, menuRef, onDismissDemo }) {
  return (
    <div className="bl-projects-grid">
      {projects.map((p) => (
        <ProjectCard
          key={p.id}
          project={p}
          menuOpen={menuOpenId === p.id}
          onOpenMenu={onOpenMenu}
          onAction={onAction}
          menuRef={menuRef}
          onDismissDemo={onDismissDemo}
        />
      ))}
    </div>
  );
}

function ListView({ projects, menuOpenId, onOpenMenu, onAction, menuRef, onDismissDemo }) {
  const stop = (e) => { e.preventDefault(); e.stopPropagation(); };
  return (
    <div className="bl-projects-list">
      <div className="bl-projects-list-head">
        <div>Name</div>
        <div>Status</div>
        <div>Briefs</div>
        <div>Pending</div>
        <div>Visibility</div>
        <div></div>
      </div>
      {projects.map((p) => {
        const f = p?.fields || {};
        const ownThumb = extractThumbUrl(f.thumbnail);
        const thumb = ownThumb || DEFAULT_THUMB;
        const status = statusFor(p);
        const name = unwrap(f.name) || "Untitled project";
        const briefs = Number(unwrap(f.totalBriefs)) || 0;
        const pending = Number(unwrap(f.pendingReviews)) || 0;
        const isPrivate = f.privateMode === true;
        const href = getInternalLink(p);
        const isMenuOpen = menuOpenId === p.id;
        const demo = isDemoProject(p);
        return (
          <a
            key={p.id}
            href={href}
            className={`bl-projects-list-row ${isMenuOpen ? "is-menu-open" : ""} ${demo ? "is-demo" : ""}`}
          >
            <div className="bl-projects-list-name">
              <img src={thumb} alt="" className={`bl-projects-list-thumb${ownThumb ? "" : " bl-thumb-mark"}`} />
              <span>{name}</span>
              {demo && <span className="bl-list-sample-badge">Sample</span>}
            </div>
            <div><StatusPill status={status} /></div>
            <div>{briefs}</div>
            <div>{pending > 0 ? <span className="bl-card-pending">{pending}</span> : "—"}</div>
            <div className="bl-projects-list-priv">
              {isPrivate ? <Lock size={12} /> : <LockOpen size={12} />}
              <span>{isPrivate ? "Private" : "Public"}</span>
            </div>
            <div className="bl-projects-list-actions">
              {demo ? (
                <button
                  type="button"
                  className="bl-card-menu-trigger bl-card-dismiss-btn is-open"
                  aria-label="Dismiss sample project"
                  title="Dismiss sample"
                  onClick={(e) => { stop(e); onDismissDemo?.(); }}
                >
                  <X size={14} />
                </button>
              ) : (
                <CardMenu
                  project={p}
                  isOpen={isMenuOpen}
                  onOpenMenu={onOpenMenu}
                  onAction={onAction}
                  menuRef={menuRef}
                />
              )}
            </div>
          </a>
        );
      })}
    </div>
  );
}

function EmptyState({ view, onCreate }) {
  const messages = {
    grid: { title: "No projects yet", body: "Create your first project to group briefs, content, and reviews." },
    list: { title: "No projects yet", body: "Create your first project to group briefs, content, and reviews." },
    inactive: { title: "Nothing marked inactive", body: "Inactive projects will show up here." },
    unassigned: { title: "All projects have a workspace", body: "Projects with no workspace linked appear here." },
  };
  const m = messages[view] || messages.grid;
  return (
    <div className="bl-projects-empty">
      <div className="bl-projects-empty-icon">
        <Inbox size={28} strokeWidth={1.5} />
      </div>
      <h3 className="bl-projects-empty-title">{m.title}</h3>
      <p className="bl-projects-empty-body">{m.body}</p>
      {(view === "grid" || view === "list") && (
        <Button
          onClick={onCreate}
          style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
          className="mt-4"
        >
          <Plus className="h-4 w-4 mr-1.5" strokeWidth={2.5} />
