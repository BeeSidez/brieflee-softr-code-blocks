// Workspace switcher — multi-select.
//
// Click trigger to open. Click workspaces to tick / untick. Click
// "Apply" to commit. Nothing ticked = no filter on the projects grid
// (normal state, sample card visible). Multiple ticked = grid shows
// projects from ANY of the ticked workspaces.
//
// URL format: ?workspace=id1,id2,id3 (comma-separated). No param at
// all = the "normal" state.
//
// Trigger is a regular <button>; popover is positioned absolute below
// it. No outside-click magic — user closes by clicking the trigger
// again or by clicking Apply / Done. This keeps clicks on items
// reliable (previous version's mousedown-listener was eating click
// events on some browsers).
//
// SOFTR CONFIG REQUIRED:
//   1. THIS block's Source tab:
//      - Bind to ACCOUNTS table.
//      - Filter: accounts.users includes logged-in user.

import { useEffect, useMemo, useState } from "react";
import { useRecords, q } from "@/lib/datasource";

const SHOW_ADD_WORKSPACE = false;
const ADD_WORKSPACE_PATH = "/account/add";
const ADD_WORKSPACE_MODAL_SIZE = "lg";

const select = q.select({
  name:    "aAKkT",
  logo:    "q1B5K",
  logoUrl: "nPI65",
});

// Brand palette
const NAVY_DEEP  = "#001364";
const PERIWINKLE = "#879CF7";
const PERIWINKLE_HOVER = "#294FF6";
const MUTED      = "#6B7A99";
const BORDER     = "rgba(217, 224, 255, 0.55)";

export default function Block() {
  const { data, status } = useRecords({ select, count: 100 });
  const accounts =
    data?.pages?.flatMap((p) => p?.items ?? []) ??
    (Array.isArray(data) ? data : []);

  // Initial selection straight from the URL.
  const initialIds = useMemo(() => readSelectionFromUrl(), []);

  // selected = the user's current draft picks (in-popover state).
  // committedIds = what's in the URL right now (what the grid sees).
  // We hard-nav only when the user hits Apply AND the draft differs.
  const [selected, setSelected] = useState(initialIds);
  const [open, setOpen] = useState(false);

  const toggle = (id) => {
    setSelected((prev) =>
      prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]
    );
  };

  const clearAll = () => setSelected([]);

  const apply = () => {
    setOpen(false);
    if (typeof window === "undefined") return;
    const url = new URL(window.location.href);
    if (selected.length === 0) {
      url.searchParams.delete("workspace");
    } else {
      url.searchParams.set("workspace", selected.join(","));
    }
    // Hard nav so the projects-index block re-mounts and reads the
    // new URL state.
    window.location.href = url.toString();
  };

  const handleAddWorkspace = () => {
    if (
      typeof window !== "undefined" &&
      typeof window.openSwModal === "function"
    ) {
      window.openSwModal(ADD_WORKSPACE_PATH, ADD_WORKSPACE_MODAL_SIZE);
    } else if (typeof window !== "undefined") {
      window.location.href = ADD_WORKSPACE_PATH;
    }
  };

  // Trigger label — summarises current SELECTED draft (not committed),
  // so it updates as the user toggles before pressing Apply.
  const triggerLabel = useMemo(() => {
    if (selected.length === 0) return "All workspaces";
    if (selected.length === 1) {
      const only = accounts.find((a) => a.id === selected[0]);
      return extractName(only) || "1 workspace";
    }
    return `${selected.length} workspaces`;
  }, [selected, accounts]);

  // Render guards
  if (status === "pending") return null;
  if (status === "error") return null;
  const showSwitcher = accounts.length > 1;
  if (!showSwitcher && !SHOW_ADD_WORKSPACE) return null;

  // Dirty = user has changed selection vs what's in the URL
  const dirty = selected.join(",") !== initialIds.join(",");

  return (
    <div
      style={{
        display: "flex",
        alignItems: "center",
        justifyContent: "flex-end",
        gap: "12px",
        flexWrap: "wrap",
        padding: "16px 24px",
        width: "100%",
        fontFamily: "'League Spartan', sans-serif",
      }}
    >
      <div
        style={{
          position: "relative",
          display: "inline-flex",
          alignItems: "center",
          gap: "10px",
        }}
      >
        {showSwitcher && (
          <>
            <span
              style={{
                fontSize: "11px",
                fontWeight: 600,
                color: PERIWINKLE,
                textTransform: "uppercase",
                letterSpacing: "0.05em",
              }}
            >
              Workspace
            </span>

            <button
              type="button"
              onClick={() => setOpen((o) => !o)}
              style={{
                minWidth: "220px",
                display: "inline-flex",
                alignItems: "center",
                justifyContent: "space-between",
                gap: "8px",
                height: "38px",
                padding: "0 12px",
                background: "#FFFFFF",
                color: NAVY_DEEP,
                border: `1px solid ${BORDER}`,
                borderRadius: "10px",
                fontSize: "13px",
                fontWeight: 500,
                fontFamily: "'League Spartan', sans-serif",
                cursor: "pointer",
                textAlign: "left",
              }}
            >
              <span>{triggerLabel}</span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                strokeWidth="2"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>

            {open && (
              <div
                style={{
                  position: "absolute",
                  top: "calc(100% + 6px)",
                  right: 0,
                  minWidth: "280px",
                  background: "#FFFFFF",
                  border: `1px solid ${BORDER}`,
                  borderRadius: "12px",
                  boxShadow: "0 16px 36px -16px rgba(0, 15, 77, 0.30)",
                  padding: "6px",
                  zIndex: 50,
                  fontFamily: "'League Spartan', sans-serif",
                }}
              >
                <div
                  style={{
                    maxHeight: "260px",
                    overflowY: "auto",
                    display: "flex",
                    flexDirection: "column",
                    gap: "2px",
                  }}
                >
                  {accounts.map((acc) => {
                    const id = acc.id;
                    const checked = selected.includes(id);
                    return (
                      <Row
                        key={id}
                        account={acc}
                        checked={checked}
                        onToggle={() => toggle(id)}
                      />
                    );
                  })}
                </div>

                {/* Footer */}
                <div
                  style={{
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "center",
                    gap: "8px",
                    marginTop: "6px",
                    paddingTop: "8px",
                    borderTop: `1px solid ${BORDER}`,
                  }}
                >
                  <button
                    type="button"
                    onClick={clearAll}
                    disabled={selected.length === 0}
                    style={{
                      background: "transparent",
                      color: selected.length === 0 ? "#C5CFE8" : MUTED,
                      border: "none",
                      padding: "6px 8px",
                      fontSize: "12px",
                      fontWeight: 500,
                      fontFamily: "'League Spartan', sans-serif",
                      cursor: selected.length === 0 ? "not-allowed" : "pointer",
                    }}
                  >
                    Clear all
                  </button>
                  <button
                    type="button"
                    onClick={apply}
                    disabled={!dirty}
                    style={{
                      background: dirty ? PERIWINKLE : "#E5E9F5",
                      color: dirty ? "#FFFFFF" : "#9AA3BF",
                      border: "none",
                      borderRadius: "8px",
                      padding: "8px 14px",
                      fontSize: "12px",
                      fontWeight: 500,
                      fontFamily: "'League Spartan', sans-serif",
                      cursor: dirty ? "pointer" : "not-allowed",
                    }}
                    onMouseEnter={(e) => {
                      if (dirty) e.currentTarget.style.background = PERIWINKLE_HOVER;
                    }}
                    onMouseLeave={(e) => {
                      if (dirty) e.currentTarget.style.background = PERIWINKLE;
                    }}
                  >
                    Apply
                  </button>
                </div>
              </div>
            )}
          </>
        )}

        {SHOW_ADD_WORKSPACE && (
          <button
            type="button"
            onClick={handleAddWorkspace}
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "6px",
              padding: "8px 14px",
              background: "transparent",
              color: PERIWINKLE,
              border: `1px dashed rgba(135, 156, 247, 0.55)`,
              borderRadius: "999px",
              fontSize: "13px",
              fontWeight: 600,
              fontFamily: "'League Spartan', sans-serif",
              cursor: "pointer",
            }}
          >
            <span aria-hidden="true">+</span> Add workspace
          </button>
        )}
      </div>
    </div>
  );
}

// ─── One workspace row inside the popover ────────────────────
function Row({ account, checked, onToggle }) {
  const [hover, setHover] = useState(false);
  const name = extractName(account) || "Untitled workspace";
  const logo = extractLogoUrl(account);
  return (
    <button
      type="button"
      onClick={onToggle}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      style={{
        display: "flex",
        alignItems: "center",
        gap: "10px",
        width: "100%",
        padding: "8px 10px",
        background: checked
          ? "rgba(135, 156, 247, 0.10)"
          : hover ? "rgba(135, 156, 247, 0.06)" : "transparent",
        color: NAVY_DEEP,
        border: "none",
        borderRadius: "8px",
        fontSize: "13px",
        fontWeight: 500,
        fontFamily: "'League Spartan', sans-serif",
        textAlign: "left",
        cursor: "pointer",
        transition: "background 0.12s",
      }}
    >
      <span
        style={{
          width: "16px",
          height: "16px",
          flexShrink: 0,
          background: checked ? PERIWINKLE : "#FFFFFF",
          border: `1px solid ${checked ? PERIWINKLE : BORDER}`,
          borderRadius: "4px",
          display: "inline-flex",
          alignItems: "center",
          justifyContent: "center",
        }}
      >
        {checked && (
          <svg
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#FFFFFF"
            strokeWidth="3"
            strokeLinecap="round"
            strokeLinejoin="round"
          >
            <polyline points="20 6 9 17 4 12" />
          </svg>
        )}
      </span>

      {logo && (
        <img
          src={logo}
          alt=""
          style={{
            height: "20px",
            width: "20px",
            objectFit: "contain",
            flexShrink: 0,
            borderRadius: "4px",
          }}
        />
      )}

      <span
        style={{
          flex: 1,
          overflow: "hidden",
          textOverflow: "ellipsis",
          whiteSpace: "nowrap",
        }}
      >
        {name}
      </span>
    </button>
  );
}

// ─── Helpers ──────────────────────────────────────────────────

function readSelectionFromUrl() {
  if (typeof window === "undefined") return [];
  const raw = new URL(window.location.href).searchParams.get("workspace") || "";
  return raw.split(",").map((s) => s.trim()).filter(Boolean);
}

function extractName(account) {
  return unwrap(account?.fields?.name) || "";
}

function extractLogoUrl(account) {
  const formula = unwrap(account?.fields?.logoUrl);
  if (formula && /^https?:\/\//i.test(formula)) return formula;
  const raw = account?.fields?.logo;
  if (!raw) return null;
  if (typeof raw === "string") return raw;
  if (Array.isArray(raw)) {
    const first = raw[0];
    if (!first) return null;
    if (typeof first === "string") return first;
    return first.url || first.thumbnailUrl || null;
  }
  if (typeof raw === "object") return raw.url || raw.thumbnailUrl || null;
  return null;
}

function unwrap(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw.trim();
  if (Array.isArray(raw)) {
    const f = raw[0];
    if (typeof f === "string") return f.trim();
    if (f?.label) return String(f.label).trim();
    if (f?.name) return String(f.name).trim();
    return "";
  }
  if (typeof raw === "object") {
    if (raw.label) return String(raw.label).trim();
    if (raw.name) return String(raw.name).trim();
    return "";
  }
  return String(raw).trim();
}
