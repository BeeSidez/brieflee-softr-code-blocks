  datasource,
  useRecord,
  useRecords,
  useCurrentRecordId,
  useRecordCreate,
  useRecordUpdate,
  useRecordDelete,
  useUpload,
  q,
} from "@/lib/datasource";
import { Plus, Trash2 } from "lucide-react";
import { toast } from "sonner";

// SOURCES on this block. Naming them explicitly is NOT optional: a Vibe
// block with a single source can get away with omitting `from`, but the
// moment a second source is attached every hook without `from` throws at
// runtime while the code still compiles. The products source is attached
// for the Products & features section, so every hook below passes `from`.
const ds = datasource.define({
  accounts: "39b52618-2cba-4fc3-9e35-77a55ca48892",
  products: "products",
});

