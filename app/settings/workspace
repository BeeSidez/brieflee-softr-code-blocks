          transition: color 0.2s ease;
        }
        .workspace-discard-btn:hover:not(:disabled) {
          color: #294FF6;
        }
        .workspace-discard-btn:disabled {
          color: #C5CFE8;
          cursor: not-allowed;
        }

        /* ── Logo upload ──────────────────────────────────────── */
        .workspace-logo-row {
          display: flex;
