});
const PRODUCT_TYPE_PRODUCT = { id: "09733eb9-9e77-4e11-bbdf-4e5e9d5a445e", label: "Product" };
const PRODUCT_TYPE_FEATURE = { id: "0059fed7-4bfa-4532-bfc4-c99477589e9a", label: "Feature" };
const PRODUCT_STATUS_ACTIVE = { id: "8e6bd9b0-6f7a-4d69-b23d-bb69577c1de3", label: "Active" };

// An ATTACHMENT comes back as an array of { url, filename }. The uploaded
// image wins over the scraped image_url, which is frequently a brand logo
// or a promo tile rather than the product.
function extractFileUrl(raw) {
  if (!raw) return "";
  const first = Array.isArray(raw) ? raw[0] : raw;
  if (!first) return "";
  if (typeof first === "string") return first;
  return first.url || first.thumbnailUrl || "";
}
function productImageOf(f) {
  return extractFileUrl(f.image) || extractText(f.imageUrl) || "";
}

