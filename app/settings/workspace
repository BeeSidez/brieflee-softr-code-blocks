        }
        .workspace-logo-preview img {
          width: 64px;
          height: 64px;
          border-radius: 12px;
          object-fit: contain;
          background: #FFFFFF;
          border: 1px solid rgba(217, 224, 255, 0.6);
          padding: 6px;
        }
        .workspace-logo-placeholder {
          font-size: 12px;
          color: #879CF7;
          font-weight: 500;
          padding: 0;
        }
        .workspace-logo-actions {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          flex-wrap: wrap;
        }
        .workspace-logo-btn {
          padding: 8px 14px;
          background: #FFFFFF;
          color: #879CF7;
          border: 1px solid rgba(135, 156, 247, 0.45);
          border-radius: 8px;
          font-size: 14px;
          font-weight: 600;
          cursor: pointer;
          transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
        }
        .workspace-logo-btn:hover {
          background: rgba(135, 156, 247, 0.10);
          color: #294FF6;
          border-color: rgba(41, 79, 246, 0.55);
        }
        .workspace-logo-btn-ghost {
          color: #DC2626;
          border-color: rgba(220, 38, 38, 0.40);
        }
        .workspace-logo-btn-ghost:hover {
          background: rgba(220, 38, 38, 0.08);
          color: #B91C1C;
          border-color: rgba(185, 28, 28, 0.55);
        }
      `}
    </style>
  );
}

// =====================================================================
// Contact & Community rows editor — platform select (+ Other free
// label) alongside the handle/url input.
// =====================================================================
function PlatformRowsEditor({ rows, onChange, platforms, valuePlaceholder, addLabel }) {
  const setRow = (i, patch) => onChange(rows.map((r, idx) => (idx === i ? { ...r, ...patch } : r)));
  const removeRow = (i) => onChange(rows.filter((_, idx) => idx !== i));
  const addRow = () => onChange([...rows, { platform: platforms[0], custom: "", value: "" }]);

  return (
    <div className="space-y-2">
      {rows.map((r, i) => (
        <div key={i} className="flex items-center gap-2">
          <select
            value={r.platform}
            onChange={(e) => setRow(i, { platform: e.target.value })}
            className="text-sm rounded-lg px-2 py-2 bg-white"
            style={{ border: "1px solid rgba(217, 224, 255, 0.7)", color: "#001364", minWidth: 130 }}
          >
            {platforms.map((p) => <option key={p} value={p}>{p}</option>)}
            <option value="Other">Other…</option>
          </select>
          {r.platform === "Other" && (
            <Input
              value={r.custom}
              onChange={(e) => setRow(i, { custom: e.target.value })}
              placeholder="Label"
              style={{ maxWidth: 130 }}
            />
          )}
          <Input
            value={r.value}
            onChange={(e) => setRow(i, { value: e.target.value })}
            placeholder={valuePlaceholder}
          />
          <button
            type="button"
            onClick={() => removeRow(i)}
            aria-label="Remove"
            style={{ background: "transparent", border: "none", cursor: "pointer", color: "#879CF7", padding: 4, flexShrink: 0 }}
          >
            <X className="h-4 w-4" />
          </button>
        </div>
      ))}
      <button
        type="button"
        onClick={addRow}
        style={{ background: "transparent", border: "none", cursor: "pointer", color: "#879CF7", fontSize: 12, fontWeight: 600, padding: 0 }}
      >
        {addLabel}
      </button>
    </div>
  );
}