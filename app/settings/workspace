const updateFields = q.select({
  name:               "aAKkT",
  logo:               "q1B5K",
  niche:              "vOp4b",
  brandBio:           "iVPat",
  brandVoice:         "ybmp8",
  brandCta:           "s9vzj",
  targetAudience:     "6g1Vd",
  audiencePainPoints: "B4zya",
  audienceObjectives: "5Wq2k",
  productOrFeature1:  "FLZz5",
  productOrFeature2:  "4nv9b",
  productOrFeature3:  "ty0gw",
  preferredFormats:   "V7fzw",
  socialHandles:      "yo2NI",
  communityLinks:     "oHBT3",
});

const EMPTY_DRAFT = {
  name: "",
  niche: "",
  brandBio: "",
  brandVoice: "",
  brandCta: "",
  targetAudience: "",
  audiencePainPoints: "",
  audienceObjectives: "",
  productOrFeature1: "",
  productOrFeature2: "",
  productOrFeature3: "",
  preferredFormats: "",
};

// Platform pickers for the Contact & Community editors. "Other" swaps
// the select for a free-text label so brand-specific links (ambassador
// pages, affiliate sign-ups) still carry a name the brief builder can
// render.
const SOCIAL_PLATFORMS = ["TikTok", "Instagram", "YouTube", "Facebook", "X (Twitter)", "LinkedIn", "Pinterest", "Snapchat"];
const COMMUNITY_PLATFORMS = ["WhatsApp", "Discord", "Slack", "Telegram", "Lark", "Facebook Group", "Ambassador page", "Affiliate sign-up"];

function parseJsonList(raw) {
  if (!raw || typeof raw !== "string") return [];
  try {
    const v = JSON.parse(raw);
    return Array.isArray(v) ? v : [];
  } catch {
    return [];
  }
}

// [{platform|label, value}] stored rows → editor rows with an "Other"
// custom-label escape hatch.
function toEditorRows(list, knownPlatforms, nameKey, valueKey) {
  return list.map((x) => {
    const name = (x?.[nameKey] || "").trim();
    const known = knownPlatforms.includes(name);
    return {
      platform: known ? name : "Other",
      custom: known ? "" : name,
      value: (x?.[valueKey] || "").trim(),
    };
  });
}

function serializeEditorRows(rows, nameKey, valueKey) {
  const list = rows
    .map((r) => ({
      [nameKey]: (r.platform === "Other" ? r.custom.trim() : r.platform) || "Other",
      [valueKey]: r.value.trim(),
    }))
    .filter((x) => x[valueKey]);
  return list.length ? JSON.stringify(list) : "";
}

// product_or_feature_1-3 arrive as "Name\nDESCRIPTION\n...\nHOOKS\n..."
// — first line is the product name, then ALL-CAPS section headings.
// Parse that shape so the accordion can show the real product name as
// the row label and render each section under a styled eyebrow.
function parseProductBlob(text) {
  if (!text) return null;
  const lines = text.replace(/<br\s*\/?>/gi, "\n").split("\n");
  const isHeading = (t) => t.length > 2 && t === t.toUpperCase() && /^[A-Z][A-Z &/\-]*$/.test(t.replace(/\s+/g, " "));
  let name = "";
  const sections = [];
  let current = null;
  lines.forEach((line) => {
    const t = line.trim();
    if (!t) return;
    if (isHeading(t)) { current = { heading: t, body: [] }; sections.push(current); return; }
    if (!current) {
      if (!name) { name = t; return; }
      current = { heading: "", body: [] };
      sections.push(current);
    }
    current.body.push(line);
  });
  if (!name && sections.length === 0) return null;
  return { name, sections: sections.map((s) => ({ heading: s.heading, body: s.body.join("\n") })) };
}

function ProductRead({ parsed }) {
  return (
    <div>
      {parsed.sections.map((s, i) => (
        <div key={i} style={{ marginTop: i === 0 ? 0 : 12 }}>
          {s.heading && (
            <div style={{ fontSize: 10.5, fontWeight: 600, letterSpacing: "0.08em", textTransform: "uppercase", color: "#879CF7", marginBottom: 3 }}>
              {s.heading}
            </div>
          )}
          <div className="text-sm leading-relaxed" style={{ color: "#000F4D", fontWeight: 300 }}>
            {formatTextWithBullets(s.body)}
          </div>
        </div>
      ))}
    </div>
  );
}

// One-line teaser for a collapsed field (same as onboarding customize):
// first line(s) of plain text, CSS ellipsis does the clipping.
function teaserOf(text) {
  if (!text) return "";
  return text
    .replace(/<br\s*\/?>/gi, " ")
    .split("\n")
    .map((l) => l.trim().replace(/^[•\-\*]\s+/, ""))
    .filter(Boolean)
    .join(" · ");
}

// Read view for an expanded field: bullet lines become a real list.
function formatTextWithBullets(text) {
  if (!text) return null;
  const lines = text.replace(/<br\s*\/?>/gi, "\n").split("\n").filter((l) => l.trim());
  if (lines.length === 0) return null;
  const elements = [];
  let currentList = [];
  lines.forEach((line) => {
    const trimmed = line.trim();
    const bullet = trimmed.match(/^([•\-\*])\s+(.+)$/);
    if (bullet) {
      currentList.push(bullet[2]);
    } else {
      if (currentList.length > 0) {
        elements.push(
          <ul key={`list-${elements.length}`} className="list-disc list-inside space-y-1 my-2">
            {currentList.map((item, i) => <li key={i}>{item}</li>)}
          </ul>
        );
        currentList = [];
      }
      elements.push(<div key={`text-${elements.length}`}>{trimmed}</div>);
    }
  });
  if (currentList.length > 0) {
    elements.push(
      <ul key={`list-${elements.length}`} className="list-disc list-inside space-y-1 my-2">
        {currentList.map((item, i) => <li key={i}>{item}</li>)}
      </ul>
    );
  }
  return elements.length > 0 ? elements : null;
}

// =====================================================================
// Block
// =====================================================================
// If the URL has `?workspace=<id>` (set by the workspace-switcher
// block), use that as the record ID. Falls back to Softr's
// useCurrentRecordId if the URL param isn't present. Re-reads on every
// render so the switcher's URL update flows through.
function useWorkspaceRecordId() {
  const fromContext = useCurrentRecordId();
  const fromUrl =
    typeof window !== "undefined"
      ? new URL(window.location.href).searchParams.get("workspace")
      : null;
  return fromUrl || fromContext;
}

export default function Block() {
  const recordId = useWorkspaceRecordId();
  const { data: record, status, refetch } = useRecord({ recordId, select, from: ds.accounts });

  // Saved state — mirrors the record after each successful save
  const [saved, setSaved] = useState(EMPTY_DRAFT);
  // Draft state — what the user is editing right now
  const [draft, setDraft] = useState(EMPTY_DRAFT);

  // Contact & Community editors — rows of {platform, custom, value};
  // saved snapshots kept as the serialized JSON for dirty checks.
  const [socialRows, setSocialRows] = useState([]);
  const [socialSavedJson, setSocialSavedJson] = useState("");
  const [communityRows, setCommunityRows] = useState([]);
  const [communitySavedJson, setCommunitySavedJson] = useState("");

  // Logo state (handled separately — not a plain string)
  const [logoSaved, setLogoSaved] = useState(null); // attachment array or null
  const [logoPending, setLogoPending] = useState(null); // File object pending save
  const [logoCleared, setLogoCleared] = useState(false); // user removed it

  // Save lifecycle
  const [savingSection, setSavingSection] = useState(null);
  const [recentlySavedSection, setRecentlySavedSection] = useState(null);

  // Accordion: at most ONE long-text field open across the whole tab;
  // the pencil opens straight into an inline edit.
  const [openField, setOpenField] = useState(null);
  const [editingField, setEditingField] = useState(null);
  const toggleField = (key) => {
    if (editingField === key) return; // don't collapse mid-edit
    setOpenField((cur) => (cur === key ? null : key));
  };
  const editField = (key) => {
    setOpenField(key);
    setEditingField(key);
  };

  // Hydration is keyed by record.id so workspace switches re-hydrate
  const hydratedForRecordIdRef = useRef(null);
  const pendingSaveContextRef = useRef(null);
  const savedFlashTimerRef = useRef(null);
  const logoInputRef = useRef(null);

  // ---- File upload hook --------------------------------------------
  // useUpload() returns { uploadAsync, isUploading } — NOT a mutation.
  const { uploadAsync } = useUpload();

  // ---- Hydrate from record (re-runs when record.id changes) -------
  // useRecord returns data with fields nested under data.fields.<alias>.
  // (Confirmed against Bev's working Softr-generated reference block.)
  useEffect(() => {
    if (!record || !record.fields) return;
    if (hydratedForRecordIdRef.current === record.id) return;
    hydratedForRecordIdRef.current = record.id;

    const f = record.fields;
    const next = {
      name:               extractText(f.name),
      niche:              extractText(f.niche),
      brandBio:           extractText(f.brandBio),
      brandVoice:         extractText(f.brandVoice),
      brandCta:           extractText(f.brandCta),
      targetAudience:     extractText(f.targetAudience),
      audiencePainPoints: extractText(f.audiencePainPoints),
      audienceObjectives: extractText(f.audienceObjectives),
      productOrFeature1:  extractText(f.productOrFeature1),
      productOrFeature2:  extractText(f.productOrFeature2),
      productOrFeature3:  extractText(f.productOrFeature3),
      preferredFormats:   extractText(f.preferredFormats),
    };
    setSaved(next);
    setDraft(next);
    setLogoSaved(f.logo ?? null);

    const socials = toEditorRows(parseJsonList(f.socialHandles), SOCIAL_PLATFORMS, "platform", "handle");
    setSocialRows(socials);
    setSocialSavedJson(serializeEditorRows(socials, "platform", "handle"));
    const community = toEditorRows(parseJsonList(f.communityLinks), COMMUNITY_PLATFORMS, "label", "url");
    setCommunityRows(community);
    setCommunitySavedJson(serializeEditorRows(community, "label", "url"));
  }, [record]);

  // ---- Update hook -------------------------------------------------
  const updateRecord = useRecordUpdate({
    fields: updateFields,
    from: ds.accounts,
    onSuccess: () => {
      const ctx = pendingSaveContextRef.current;
      pendingSaveContextRef.current = null;
      setSavingSection(null);
      if (!ctx) { refetch(); return; }
      ctx.onComplete?.();
      setRecentlySavedSection(ctx.section);
      if (savedFlashTimerRef.current) clearTimeout(savedFlashTimerRef.current);
      savedFlashTimerRef.current = setTimeout(() => {
        setRecentlySavedSection((cur) => (cur === ctx.section ? null : cur));
      }, 1800);
      refetch();
    },
    onError: (err) => {
      pendingSaveContextRef.current = null;
      setSavingSection(null);
      toast.error("Couldn't save", { description: err?.message || "Try again." });
    },
  });

  const performSave = (section, fields, onComplete) => {
    if (!recordId) {
      toast.error("Couldn't find your account record.");
      return;
    }
    pendingSaveContextRef.current = { section, onComplete };
    setSavingSection(section);
    updateRecord.mutate({ recordId, fields });
  };

  // ---- Cleanup -----------------------------------------------------
  useEffect(() => () => {
    if (savedFlashTimerRef.current) clearTimeout(savedFlashTimerRef.current);
  }, []);

  // ---- Per-section dirty checks ------------------------------------
  const isLogoDirty = logoPending !== null || logoCleared;
  const isIdentityDirty =
    draft.name !== saved.name || isLogoDirty;
  const isBrandDirty =
    draft.brandBio !== saved.brandBio ||
    draft.brandVoice !== saved.brandVoice ||
    draft.brandCta !== saved.brandCta ||
    draft.niche !== saved.niche;
  const isAudienceDirty =
    draft.targetAudience !== saved.targetAudience ||
    draft.audiencePainPoints !== saved.audiencePainPoints ||
    draft.audienceObjectives !== saved.audienceObjectives;
  const isProductsDirty =
    draft.productOrFeature1 !== saved.productOrFeature1 ||
    draft.productOrFeature2 !== saved.productOrFeature2 ||
    draft.productOrFeature3 !== saved.productOrFeature3 ||
    draft.preferredFormats !== saved.preferredFormats;
  const isContactDirty =
    serializeEditorRows(socialRows, "platform", "handle") !== socialSavedJson ||
    serializeEditorRows(communityRows, "label", "url") !== communitySavedJson;
  const anyDirty = isIdentityDirty || isBrandDirty || isAudienceDirty || isProductsDirty || isContactDirty;

  // ---- beforeunload guard -----------------------------------------
  useEffect(() => {
    if (!anyDirty) return;
    const handler = (e) => { e.preventDefault(); e.returnValue = ""; };
    window.addEventListener("beforeunload", handler);
    return () => window.removeEventListener("beforeunload", handler);
  }, [anyDirty]);

  // ---- Save / discard handlers ------------------------------------
  const setField = (key, value) =>
    setDraft((cur) => ({ ...cur, [key]: value }));

  const saveIdentity = async () => {
    if (!recordId) {
      toast.error("Couldn't find your account record.");
      return;
    }

    let logoForWrite = undefined; // undefined = don't touch the field
    try {
      if (logoPending) {
        setSavingSection("identity");
        // uploadAsync resolves to an ARRAY of { id, file, status, url }.
        const [result] = await uploadAsync(logoPending);
        if (!result || result.status !== "completed" || !result.url) {
          throw new Error("Upload didn't complete.");
        }
        // Attachment fields take an array of { filename, url }.
        logoForWrite = [{ filename: result.file?.name || "logo", url: result.url }];
      } else if (logoCleared) {
        logoForWrite = null;
      }
    } catch (err) {
      setSavingSection(null);
      toast.error("Couldn't upload logo", {
        description: err?.message || "Try again.",
      });
      return;
    }

    const fields = { name: draft.name.trim() };
    if (logoForWrite !== undefined) fields.logo = logoForWrite;

    performSave(
      "identity",
      fields,
      () => {
        setSaved((cur) => ({ ...cur, name: draft.name }));
        if (logoForWrite !== undefined) {
          setLogoSaved(logoForWrite);
        }
        setLogoPending(null);
        setLogoCleared(false);
        if (logoInputRef.current) logoInputRef.current.value = "";
      },
    );
  };
  const discardIdentity = () => {
    setDraft((cur) => ({ ...cur, name: saved.name }));
    setLogoPending(null);
    setLogoCleared(false);
    if (logoInputRef.current) logoInputRef.current.value = "";
  };

  // ---- Logo handlers ----------------------------------------------
  const handleLogoFileChange = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setLogoPending(file);
    setLogoCleared(false);
  };

  const handleLogoRemove = () => {
    setLogoPending(null);
    setLogoCleared(true);
    if (logoInputRef.current) logoInputRef.current.value = "";
  };

  const currentLogoUrl = (() => {
    if (logoCleared) return null;
    if (logoPending) {
      return URL.createObjectURL(logoPending);
    }
    // Prefer the user's uploaded ATTACHMENT; fall back to the formula
    // (Google favicon or Brieflee approval-stamp default).
    const attachment = extractAttachmentUrl(logoSaved);
    if (attachment) return attachment;
    const formula = (record?.fields?.logoUrl || "").trim();
    return formula && /^https?:\/\//i.test(formula) ? formula : null;
  })();

  const saveBrand = () => {
    performSave(
      "brand",
      {
        brandBio: draft.brandBio.trim(),
        brandVoice: draft.brandVoice.trim(),
        brandCta: draft.brandCta.trim(),
        niche: draft.niche.trim(),
      },
      () => setSaved((cur) => ({
        ...cur,
        brandBio: draft.brandBio,
        brandVoice: draft.brandVoice,
        brandCta: draft.brandCta,
        niche: draft.niche,
      })),
    );
  };
  const discardBrand = () =>
    setDraft((cur) => ({
      ...cur,
      brandBio: saved.brandBio,
      brandVoice: saved.brandVoice,
      brandCta: saved.brandCta,
      niche: saved.niche,
    }));

  const saveAudience = () => {
    performSave(
      "audience",
      {
        targetAudience: draft.targetAudience.trim(),
        audiencePainPoints: draft.audiencePainPoints.trim(),
        audienceObjectives: draft.audienceObjectives.trim(),
      },
      () => setSaved((cur) => ({
        ...cur,
        targetAudience: draft.targetAudience,
        audiencePainPoints: draft.audiencePainPoints,
        audienceObjectives: draft.audienceObjectives,
      })),
    );
  };
  const discardAudience = () =>
    setDraft((cur) => ({
      ...cur,
      targetAudience: saved.targetAudience,
      audiencePainPoints: saved.audiencePainPoints,
      audienceObjectives: saved.audienceObjectives,
    }));

  const saveProducts = () => {
    performSave(
      "products",
      {
        productOrFeature1: draft.productOrFeature1.trim(),
        productOrFeature2: draft.productOrFeature2.trim(),
        productOrFeature3: draft.productOrFeature3.trim(),
        preferredFormats: draft.preferredFormats.trim(),
      },
      () => {
        setSaved((cur) => ({
          ...cur,
          productOrFeature1: draft.productOrFeature1,
          productOrFeature2: draft.productOrFeature2,
          productOrFeature3: draft.productOrFeature3,
          preferredFormats: draft.preferredFormats,
        }));
      },
    );
  };
  const discardProducts = () => {
    setDraft((cur) => ({
      ...cur,
      productOrFeature1: saved.productOrFeature1,
      productOrFeature2: saved.productOrFeature2,
      productOrFeature3: saved.productOrFeature3,
      preferredFormats: saved.preferredFormats,
    }));
  };

  const saveContact = () => {
    performSave(
      "contact",
      {
        socialHandles: serializeEditorRows(socialRows, "platform", "handle"),
        communityLinks: serializeEditorRows(communityRows, "label", "url"),
      },
      () => {
        setSocialSavedJson(serializeEditorRows(socialRows, "platform", "handle"));
        setCommunitySavedJson(serializeEditorRows(communityRows, "label", "url"));
      },
    );
  };
  const discardContact = () => {
    setSocialRows(toEditorRows(parseJsonList(socialSavedJson), SOCIAL_PLATFORMS, "platform", "handle"));
    setCommunityRows(toEditorRows(parseJsonList(communitySavedJson), COMMUNITY_PLATFORMS, "label", "url"));
  };

  // ---- Render guards -----------------------------------------------
  if (status === "pending") return <BlockShell><Loading /></BlockShell>;
  if (status === "error") return <BlockShell><Loading error /></BlockShell>;
  if (!record) {
    return (
      <BlockShell>
        <Loading message="No account record found. Check the block's Source tab is bound to accounts with a filter to the logged-in user." />
      </BlockShell>
    );
  }

  return (
    <BlockShell>
      {/* ── Section 1 · Identity ────────────────────────────────────── */}
      <SectionCard
        title="Workspace identity"
        subtitle="The name and logo that anchor this workspace."
        dirty={isIdentityDirty}
        saving={savingSection === "identity"}
        justSaved={recentlySavedSection === "identity"}
        onSave={saveIdentity}
        onDiscard={discardIdentity}
      >
        <FieldRow label="Workspace name">
          <Input
            value={draft.name}
            onChange={(e) => setField("name", e.target.value)}
          />
        </FieldRow>

        <FieldRow label="Logo">
          <div className="workspace-logo-row">
            <div className="workspace-logo-preview">
              {currentLogoUrl ? (
                <img src={currentLogoUrl} alt="Workspace logo" />
              ) : (
                <span className="workspace-logo-placeholder">No logo yet</span>
              )}
            </div>
            <div className="workspace-logo-actions">
              <input
                ref={logoInputRef}
                type="file"
                accept="image/*"
                onChange={handleLogoFileChange}
                style={{ display: "none" }}
              />
              <button
                type="button"
                onClick={() => logoInputRef.current?.click()}
                className="workspace-logo-btn"
              >
                {currentLogoUrl ? "Change logo" : "Upload logo"}
              </button>
              {currentLogoUrl && (
                <button
                  type="button"
                  onClick={handleLogoRemove}
                  className="workspace-logo-btn workspace-logo-btn-ghost"
                >
                  Remove
                </button>
              )}
            </div>
          </div>
          <p
            className="text-xs"
            style={{ color: "#879CF7", fontWeight: 400, marginTop: 6 }}
          >
            Square image works best. Click Save changes to upload.
          </p>
        </FieldRow>
      </SectionCard>

      {/* ── Section 2 · Brand ───────────────────────────────────────── */}
      <SectionCard
        title="Brand"
        subtitle="How Brieflee should think about your brand when reviewing content."
        dirty={isBrandDirty}
        saving={savingSection === "brand"}
        justSaved={recentlySavedSection === "brand"}
        onSave={saveBrand}
        onDiscard={discardBrand}
      >
        <div className="ws-acc-group">
          {[
            { key: "brandBio",   label: "Brand bio",     rows: 4 },
            { key: "brandVoice", label: "Content Style", rows: 4 },
            { key: "brandCta",   label: "Brand CTA",     rows: 3 },
            { key: "niche",      label: "Niche",         rows: 3 },
          ].map((fld) => (
            <AccordionField
              key={fld.key}
              label={fld.label}
              value={draft[fld.key]}
              rows={fld.rows}
              open={openField === fld.key}
              editing={editingField === fld.key}
              onToggle={() => toggleField(fld.key)}
              onEdit={() => editField(fld.key)}
              onBlurEdit={() => setEditingField(null)}
              onChange={(v) => setField(fld.key, v)}
            />
          ))}
        </div>
      </SectionCard>

      {/* ── Section 3 · Audience ───────────────────────────────────── */}
      <SectionCard
        title="Audience"
        subtitle="Who you're talking to and what they care about."
        dirty={isAudienceDirty}
        saving={savingSection === "audience"}
        justSaved={recentlySavedSection === "audience"}
        onSave={saveAudience}
        onDiscard={discardAudience}
      >
        <div className="ws-acc-group">
          {[
            { key: "targetAudience",     label: "Target audience",       rows: 4 },
            { key: "audiencePainPoints", label: "Audience pain points",  rows: 4 },
            { key: "audienceObjectives", label: "Audience objectives",   rows: 4 },
          ].map((fld) => (
            <AccordionField
              key={fld.key}
              label={fld.label}
              value={draft[fld.key]}
              rows={fld.rows}
              open={openField === fld.key}
              editing={editingField === fld.key}
              onToggle={() => toggleField(fld.key)}
              onEdit={() => editField(fld.key)}
              onBlurEdit={() => setEditingField(null)}
              onChange={(v) => setField(fld.key, v)}
            />
          ))}
        </div>
      </SectionCard>

      {/* ── Section 4 · Products & features ────────────────────────── */}
      <SectionCard
        title="Products & features"
        subtitle="What creators should feature, in the words they can use on camera."
        dirty={isProductsDirty}
        saving={savingSection === "products"}
        justSaved={recentlySavedSection === "products"}
        onSave={saveProducts}
        onDiscard={discardProducts}
      >
        <ProductsManager accountId={recordId} />
        <FieldRow label="Preferred formats">
          <Input
            value={draft.preferredFormats}
            onChange={(e) => setField("preferredFormats", e.target.value)}
            placeholder="ASMR, Demo, Founder"
          />
          <p className="text-xs" style={{ color: "#879CF7", fontWeight: 400, marginTop: 6 }}>
            The video formats you want creators to make, separated by commas.
          </p>
        </FieldRow>
      </SectionCard>

      {/* ── Section 5 · Contact & community ────────────────────────── */}
      <SectionCard
        title="Contact & community"
        subtitle="Where creators can find, tag, and point their audience to your brand."
        dirty={isContactDirty}
        saving={savingSection === "contact"}
        justSaved={recentlySavedSection === "contact"}
        onSave={saveContact}
        onDiscard={discardContact}
      >
        <FieldRow label="Social handles">
          <PlatformRowsEditor
            rows={socialRows}
            onChange={setSocialRows}
            platforms={SOCIAL_PLATFORMS}
            valuePlaceholder="@yourbrand"
            addLabel="+ Add handle"
          />
        </FieldRow>
        <FieldRow label="Community links">
          <PlatformRowsEditor
            rows={communityRows}
            onChange={setCommunityRows}
            platforms={COMMUNITY_PLATFORMS}
            valuePlaceholder="https://…"
            addLabel="+ Add link"
          />
        </FieldRow>
      </SectionCard>
    </BlockShell>
  );
}

// =====================================================================
// Sub-components
// =====================================================================

function BlockShell({ children }) {
  return (
    <div
      className="flex flex-col"
      style={{
        background: "#FAFBFF",
        borderRadius: "16px",
        padding: "12px 0 48px",
      }}
    >
      <Style />
      <div className="settings-workspace container mx-auto px-4 w-full" style={{ maxWidth: 1140 }}>
        <div className="space-y-4">{children}</div>
      </div>
    </div>
  );
}

// =====================================================================
// Products & features — one card per row in the products table
// =====================================================================
// Each product saves itself, so this sits inside the section card but
// outside its Save/Discard footer, which now only governs Preferred
// formats. The three product_or_feature_* fields still exist on the
// account as the legacy fallback and are simply no longer edited here.
function ProductsManager({ accountId }) {
  const { data, status, refetch } = useRecords({
    select: productFields,
    from: ds.products,
    count: 100,
    enabled: !!accountId,
    where: q.array("accounts").is(accountId || ""),
    orderBy: q.asc("name"),
  });
  const items = (data?.pages || []).flatMap((p) => p.items || []);

  const createProduct = useRecordCreate({ fields: productFields, from: ds.products });
  const updateProduct = useRecordUpdate({ fields: productFields, from: ds.products });
  const deleteProduct = useRecordDelete({ from: ds.products });
  const { uploadAsync, isUploading } = useUpload();

  const [openId, setOpenId] = useState("");
  const [drafts, setDrafts] = useState({});
  const [files, setFiles] = useState({});
  const [busyId, setBusyId] = useState("");

  // The draft always starts from the full record. Merging a patch onto an
  // empty object is what broke editing: after a save cleared the draft
  // while the row was still open, the next keystroke produced a draft
  // holding ONLY that field and every other input blanked out.
  const baseDraft = (item) => {
    const f = item.fields || {};
    return {
      name: extractText(f.name),
      price: extractText(f.price),
      url: extractText(f.url),
      description: extractText(f.description),
      type: extractText(f.type) === "Feature" ? "Feature" : "Product",
    };
  };
  const draftFor = (item) => drafts[item.id] || baseDraft(item);
  const setDraft = (item, patch) =>
    setDrafts((cur) => ({ ...cur, [item.id]: { ...(cur[item.id] || baseDraft(item)), ...patch } }));

  const toggle = (item) => {
    const next = openId === item.id ? "" : item.id;
    if (next && !drafts[item.id]) setDrafts((c) => ({ ...c, [item.id]: baseDraft(item) }));
    setOpenId(next);
  };

  const saveProduct = async (item) => {
    if (!updateProduct.enabled) {
      toast.error("You do not have permission to edit products");
      return;
    }
    const d = draftFor(item);
    if (!d.name.trim()) { toast.error("Give the product a name"); return; }
    setBusyId(item.id);
    try {
      const fields = {
        name: d.name.trim(),
        price: d.price.trim(),
        url: d.url.trim(),
        description: d.description,
        type: d.type === "Feature" ? PRODUCT_TYPE_FEATURE : PRODUCT_TYPE_PRODUCT,
      };
      const pending = files[item.id];
      if (pending) {
        // uploadAsync resolves to an ARRAY of { id, file, status, url }.
        const [result] = await uploadAsync(pending);
        if (!result || result.status !== "completed" || !result.url) {
          throw new Error("Image upload didn't complete.");
        }
        // Attachment fields take an array of { filename, url }.
        fields.image = [{ filename: result.file?.name || "product", url: result.url }];
      }
      await updateProduct.mutateAsync({ recordId: item.id, fields });
      setFiles((c) => { const n = { ...c }; delete n[item.id]; return n; });
      // Keep the draft. Clearing it while the row is open is what made the
      // next keystroke wipe the other fields.
      await refetch();
      toast.success("Product saved");
    } catch (e) {
      toast.error("Couldn't save product", { description: e?.message || "Try again." });
    } finally {
      setBusyId("");
    }
  };

  const removeProduct = async (item) => {
    if (!deleteProduct.enabled) {
      toast.error("You do not have permission to delete products");
      return;
    }
    if (typeof window !== "undefined" &&
        !window.confirm(`Delete "${extractText(item.fields?.name) || "this product"}"? This cannot be undone.`)) return;
    setBusyId(item.id);
    try {
      // useRecordDelete takes the id DIRECTLY, not an object.
      await deleteProduct.mutateAsync(item.id);
      if (openId === item.id) setOpenId("");
      await refetch();
      toast.success("Product deleted");
    } catch (e) {
      toast.error("Couldn't delete product", { description: e?.message || "Try again." });
    } finally {
      setBusyId("");
    }
  };

  const addProduct = async () => {
    if (!createProduct.enabled) {
      toast.error("You do not have permission to add products");
      return;
    }
    if (!accountId) return;
    setBusyId("new");
    try {
      const created = await createProduct.mutateAsync({
        name: "Untitled product",
        accounts: [{ id: accountId }],
        type: PRODUCT_TYPE_PRODUCT,
        status: PRODUCT_STATUS_ACTIVE,
        description: "",
      });
      await refetch();
      const newId = created?.id || created?.recordId || "";
      if (newId) {
        setDrafts((c) => ({ ...c, [newId]: { name: "", price: "", url: "", description: "", type: "Product" } }));
        setOpenId(newId);
      }
    } catch (e) {
      toast.error("Couldn't add product", { description: e?.message || "Try again." });
    } finally {
      setBusyId("");
    }
  };

  if (!accountId) return null;

  return (
    <div style={{ marginBottom: 14 }}>
      {status === "pending" && (
        <p className="text-xs" style={{ color: "#879CF7" }}>Loading products…</p>
      )}
      {status === "error" && (
        <p className="text-xs" style={{ color: "#C2410C" }}>Couldn't load products.</p>
      )}
      {status === "success" && items.length === 0 && (
        <p className="text-xs" style={{ color: "#879CF7", marginBottom: 10 }}>
          No products yet. Add the products or features you want creators to talk about.
        </p>
      )}

      <div className="ws-acc-group">
        {items.map((item) => {
          const f = item.fields || {};
          const d = draftFor(item);
          const open = openId === item.id;
          const busy = busyId === item.id;
          const img = files[item.id]
            ? null
            : productImageOf(f);
          return (
            <div key={item.id} style={{ borderBottom: "1px solid rgba(217, 224, 255, 0.55)" }}>
              <button
                type="button"
                onClick={() => toggle(item)}
                style={{
                  width: "100%", display: "flex", alignItems: "center", gap: 12,
                  padding: "10px 2px", background: "none", border: "none",
                  cursor: "pointer", textAlign: "left",
                }}
              >
                <span style={{
                  width: 38, height: 38, borderRadius: 8, flexShrink: 0, overflow: "hidden",
                  background: "rgba(135, 156, 247, 0.10)", display: "flex",
                  alignItems: "center", justifyContent: "center",
                }}>
                  {img
                    ? <img src={img} alt="" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                    : <span style={{ fontSize: 10, color: "#879CF7" }}>No image</span>}
                </span>
                <span style={{ minWidth: 0, flex: 1 }}>
                  <span style={{ display: "block", fontSize: 13, fontWeight: 600, color: "#000F4D", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                    {d.name || "Untitled"}
                  </span>
                  <span style={{ display: "block", fontSize: 11, color: "#879CF7" }}>
                    {d.type}{d.price ? " · " + d.price : ""}
                  </span>
                </span>
                <ChevronDown
                  className="h-4 w-4"
                  style={{ color: "#879CF7", flexShrink: 0, transform: open ? "rotate(180deg)" : "none", transition: "transform 0.15s" }}
                />
              </button>

              {open && (
                <div style={{ padding: "4px 2px 16px" }} className="space-y-3">
                  <div style={{ display: "flex", gap: 12, alignItems: "flex-start" }}>
                    <div style={{
                      width: 84, height: 84, borderRadius: 10, flexShrink: 0, overflow: "hidden",
                      background: "rgba(135, 156, 247, 0.10)", display: "flex",
                      alignItems: "center", justifyContent: "center",
                    }}>
                      {files[item.id]
                        ? <span style={{ fontSize: 10, color: "#879CF7", padding: 6, textAlign: "center" }}>Ready to upload</span>
                        : img
                          ? <img src={img} alt="" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                          : <span style={{ fontSize: 10, color: "#879CF7" }}>No image</span>}
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <label className="text-xs" style={{ color: "#334283", fontWeight: 500, display: "block", marginBottom: 4 }}>
                        Product image
                      </label>
                      <Input
                        type="file"
                        accept="image/*"
                        onChange={(e) => {
                          const file = e.target.files && e.target.files[0];
                          setFiles((c) => ({ ...c, [item.id]: file || null }));
                        }}
                      />
                      <p className="text-xs" style={{ color: "#879CF7", marginTop: 6 }}>
                        An uploaded image is used ahead of the one found when your page was read.
                      </p>
                    </div>
                  </div>

                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
                    <div>
                      <label className="text-xs" style={{ color: "#334283", fontWeight: 500, display: "block", marginBottom: 4 }}>Name</label>
                      <Input
                        value={d.name}
                        onChange={(e) => setDraft(item, { name: e.target.value })}
                        placeholder="Product name"
                      />
                    </div>
                    <div>
                      <label className="text-xs" style={{ color: "#334283", fontWeight: 500, display: "block", marginBottom: 4 }}>Price</label>
                      <Input
                        value={d.price}
                        onChange={(e) => setDraft(item, { price: e.target.value })}
                        placeholder="e.g. $12.00"
                      />
                    </div>
                  </div>

                  <div>
                    <label className="text-xs" style={{ color: "#334283", fontWeight: 500, display: "block", marginBottom: 4 }}>Type</label>
                    <div style={{ display: "inline-flex", gap: 6 }}>
                      {["Product", "Feature"].map((t) => (
                        <button
                          key={t}
                          type="button"
                          onClick={() => setDraft(item, { type: t })}
                          style={{
                            padding: "5px 12px", borderRadius: 999, fontSize: 12, fontWeight: 600,
                            cursor: "pointer",
                            border: "1px solid " + (d.type === t ? "#879CF7" : "rgba(217, 224, 255, 0.9)"),
                            background: d.type === t ? "rgba(135, 156, 247, 0.12)" : "#FFFFFF",
                            color: d.type === t ? "#334283" : "#879CF7",
                          }}
                        >
                          {t}
                        </button>
                      ))}
                    </div>
                  </div>

                  <div>
                    <label className="text-xs" style={{ color: "#334283", fontWeight: 500, display: "block", marginBottom: 4 }}>Page link</label>
                    <Input value={d.url} onChange={(e) => setDraft(item, { url: e.target.value })} placeholder="https://" />
                  </div>

                  <div>
                    <label className="text-xs" style={{ color: "#334283", fontWeight: 500, display: "block", marginBottom: 4 }}>What creators should know</label>
                    <Textarea
                      value={d.description}
                      rows={10}
                      onChange={(e) => setDraft(item, { description: e.target.value })}
                    />
                  </div>

                  <div className="flex items-center justify-between gap-2">
                    {deleteProduct.enabled ? (
                      <button
                        type="button"
                        onClick={() => removeProduct(item)}
                        disabled={busy}
                        className="workspace-discard-btn"
                        style={{ display: "inline-flex", alignItems: "center", gap: 6 }}
                      >
                        <Trash2 className="h-3.5 w-3.5" /> Delete
                      </button>
                    ) : <span />}
                    {updateProduct.enabled && (
                      <button
                        type="button"
                        onClick={() => saveProduct(item)}
                        disabled={busy || isUploading}
                        className="workspace-save-btn"
                      >
                        {busy || isUploading ? "Saving…" : "Save product"}
                      </button>
                    )}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      {createProduct.enabled && (
        <button
          type="button"
          onClick={addProduct}
          disabled={busyId === "new"}
          className="workspace-discard-btn"
          style={{ marginTop: 12, display: "inline-flex", alignItems: "center", gap: 6 }}
        >
          <Plus className="h-3.5 w-3.5" /> {busyId === "new" ? "Adding…" : "Add product"}
        </button>
      )}
    </div>
  );
}

function SectionCard({
  title, subtitle, dirty, saving, justSaved, onSave, onDiscard, children,
}) {
  let pill = null;
  if (saving) pill = <StatusPill tone="loading" label="Saving…" />;
  else if (justSaved) pill = <StatusPill tone="success" label="Saved" />;
  else if (dirty) pill = <StatusPill tone="warning" label="Unsaved" />;

  return (
    <section
      style={{
        background: "#FFFFFF",
        border: "1px solid rgba(217, 224, 255, 0.55)",
        borderRadius: "18px",
        padding: "22px 24px",
        boxShadow: "0 1px 3px rgba(0, 15, 77, 0.04)",
      }}
    >
      <header className="mb-4 flex items-start justify-between gap-3">
        <div className="min-w-0">
          <h3
            className="text-base"
            style={{ color: "#000F4D", fontWeight: 600, letterSpacing: "-0.005em" }}
          >
            {title}
          </h3>
          {subtitle && (
            <p
              className="text-xs mt-0.5"
              style={{ color: "#879CF7", fontWeight: 400, lineHeight: 1.5 }}
            >
              {subtitle}
            </p>
          )}
        </div>
        {pill && <div style={{ flexShrink: 0 }}>{pill}</div>}
      </header>

      <div className="space-y-4">{children}</div>

      <footer
        className="mt-5 pt-4 flex items-center justify-end gap-2"
        style={{ borderTop: "1px solid rgba(217, 224, 255, 0.5)" }}
      >
        <button
          type="button"
          onClick={onDiscard}
          disabled={!dirty || saving}
          className="workspace-discard-btn"
        >
          Discard
        </button>
        <button
          type="button"
          onClick={onSave}
          disabled={!dirty || saving}
          className="workspace-save-btn"
        >
          {saving ? "Saving…" : "Save changes"}
        </button>
      </footer>
    </section>
  );
}

function FieldRow({ label, children }) {
  return (
    <div className="space-y-1.5">
      <label
        className="text-xs font-medium block"
        style={{ color: "#001364", fontWeight: 600 }}
      >
        {label}
      </label>
      {children}
    </div>
  );
}

// Collapsed teaser row → tap to expand (read view) → pencil to edit
// inline. Same pattern as the onboarding customize blueprint review.
// `structured` = a product_or_feature blob: the row label becomes the
// product name and the read view renders eyebrow section headings.
function AccordionField({ label, value, rows, structured, open, editing, onToggle, onEdit, onBlurEdit, onChange }) {
  const parsed = structured ? parseProductBlob(value) : null;
  const rowLabel = parsed?.name || label;
  const teaser = parsed
    ? teaserOf(parsed.sections.map((s) => s.body).join("\n"))
    : teaserOf(value);
  return (
    <div className="ws-acc">
      <div
        className="flex items-center gap-2"
        onClick={onToggle}
        style={{ cursor: "pointer", userSelect: "none" }}
      >
        <div className="flex-1" style={{ minWidth: 0 }}>
          {parsed && (
            <div style={{ fontSize: 9.5, fontWeight: 600, letterSpacing: "0.08em", textTransform: "uppercase", color: "rgba(135, 156, 247, 0.75)" }}>
              {label}
            </div>
          )}
          <label className="text-xs" style={{ color: "#001364", fontWeight: 600, cursor: "pointer" }}>
            {rowLabel}
          </label>
          {!open && (
            <div
              className="text-xs"
              style={{
                color: teaser ? "#6B7A99" : "rgba(0, 19, 100, 0.35)",
                fontWeight: 300, marginTop: 1,
                whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis",
              }}
            >
              {teaser || "Empty"}
            </div>
          )}
        </div>
        <button
          type="button"
          onClick={(e) => { e.stopPropagation(); onEdit(); }}
          className="p-1 rounded flex-shrink-0"
          style={{ background: "transparent", border: "none", cursor: "pointer" }}
          aria-label={`Edit ${label}`}
        >
          <Edit2 className="w-3.5 h-3.5" style={{ color: "#879CF7" }} />
        </button>
        <ChevronDown
          className="w-4 h-4 flex-shrink-0"
          style={{ color: "#879CF7", transition: "transform 0.2s ease", transform: open ? "rotate(180deg)" : "none" }}
        />
      </div>
      {open && (
        <div style={{ marginTop: 8 }}>
          {editing ? (
            <Textarea
              value={value}
              onChange={(e) => onChange(e.target.value)}
              onBlur={onBlurEdit}
              rows={rows}
              autoFocus
              className="text-sm"
              style={{ borderColor: "#879CF7" }}
            />
          ) : parsed ? (
            <ProductRead parsed={parsed} />
          ) : (
            <div className="text-sm leading-relaxed" style={{ color: "#000F4D", fontWeight: 300 }}>
              {formatTextWithBullets(value) || (
                <span style={{ color: "rgba(0, 19, 100, 0.4)" }}>Empty</span>
              )}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function StatusPill({ tone, label }) {
  const palette =
    tone === "success"
      ? { fg: "#22A06B", dot: "#22A06B", border: "rgba(34, 160, 107, 0.30)" }
      : tone === "warning"
      ? { fg: "#C97D3F", dot: "#E89B5C", border: "rgba(232, 155, 92, 0.45)" }
      : { fg: "#879CF7", dot: "#879CF7", border: "rgba(135, 156, 247, 0.45)" };

  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        gap: 6,
        fontSize: 11,
        fontWeight: 600,
        color: palette.fg,
        padding: "4px 10px",
        background: "#FFFFFF",
        border: `1px solid ${palette.border}`,
        borderRadius: 999,
        whiteSpace: "nowrap",
      }}
    >
      <span
        style={{
          width: 5,
          height: 5,
          borderRadius: "50%",
          background: palette.dot,
          animation: tone === "loading" ? "wsPulse 1.2s ease-in-out infinite" : "none",
        }}
      />
      {label}
    </span>
  );
}

function Loading({ message, error }) {
  return (
    <div
      className="text-center"
      style={{ padding: "60px 20px", color: error ? "#D14343" : "#879CF7" }}
    >
      <p className="text-sm">{message || (error ? "Couldn't load workspace." : "Loading…")}</p>
    </div>
  );
}

function extractAttachmentUrl(raw) {
  if (raw == null) return null;
  if (typeof raw === "string") return raw;
  if (Array.isArray(raw)) {
    const first = raw[0];
    if (!first) return null;
    if (typeof first === "string") return first;
    return first.url || first.thumbnailUrl || null;
  }
  if (typeof raw === "object") {
    return raw.url || raw.thumbnailUrl || null;
  }
  return null;
}

function extractText(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw;
  if (Array.isArray(raw)) {
    const f = raw[0];
    if (typeof f === "string") return f;
    return f?.label ?? "";
  }
  if (typeof raw === "object") return raw.label ?? "";
  return String(raw);
}

function Style() {
  return (
    <style>
      {`
        @import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700&display=swap');
        .settings-workspace * { font-family: 'League Spartan', sans-serif; }

        @keyframes wsPulse {
          0%, 100% { opacity: 0.5; transform: scale(0.85); }
