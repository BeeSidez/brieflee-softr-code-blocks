// ---- Product image + price from the page's structured data ----------
// og:image is a BAD source for a product shot: measured across the live
// catalogue it returned a brand logo (Qure), a shared brand asset (The
// Ordinary), a generic promo tile (Purplle) and a parked-domain "for
// sale" banner (a dead demo URL). JSON-LD Product.image is the real
// product shot whenever the page publishes one, so it goes first and
// og:image is the fallback. The stored scrape can never help here:
// capForStore strips every markdown image before saving.
const CURRENCY_SYMBOL = { USD: "$", GBP: "£", EUR: "€", INR: "₹", AUD: "$", CAD: "$" };

// Some CDNs put a thumbnail transform in the JSON-LD url (Purplle ships a
// 150x150). Dropping that segment returns the full-size image.
const stripThumbTransform = (u) => String(u).replace(/\/tr:[^/]+\//, "/");

const formatPrice = (value, currency) => {
  const n = Number(value);
  if (!isFinite(n) || n <= 0) return "";
  const code = String(currency || "").toUpperCase();
  const sym = CURRENCY_SYMBOL[code];
  return sym ? sym + n.toFixed(2) : (code ? n.toFixed(2) + " " + code : n.toFixed(2));
};

// Walk every ld+json block for a schema.org Product and pull its image
// and its offer price. Returns null when the page publishes neither.
function jsonLdProduct(rawHtml) {
  if (!rawHtml) return null;
  const out = { image: "", price: "" };
  const re = /<script[^>]+application\/ld\+json[^>]*>([\s\S]*?)<\/script>/gi;
  let m;
  while ((m = re.exec(rawHtml))) {
    let data;
    try { data = JSON.parse(m[1].trim()); } catch { continue; }
    const stack = [data];
    while (stack.length) {
      const o = stack.pop();
      if (Array.isArray(o)) { o.forEach((x) => stack.push(x)); continue; }
      if (!o || typeof o !== "object") continue;
      const t = o["@type"];
      const types = Array.isArray(t) ? t : [t];
      if (types.indexOf("Product") > -1) {
        if (!out.image && o.image) {
          let im = Array.isArray(o.image) ? o.image[0] : o.image;
          if (im && typeof im === "object") im = im.url;
          if (im) out.image = stripThumbTransform(String(im));
        }
        if (!out.price && o.offers) {
          const offer = Array.isArray(o.offers) ? o.offers[0] : o.offers;
          if (offer && typeof offer === "object") {
            const spec = offer.priceSpecification || {};
            out.price = formatPrice(offer.price || spec.price, offer.priceCurrency || spec.priceCurrency);
          }
        }
      }
      Object.keys(o).forEach((k) => { const v = o[k]; if (v && typeof v === "object") stack.push(v); });
    }
  }
  return (out.image || out.price) ? out : null;
}

