  if (!v) return "";
  try {
    const u = new URL(/^https?:\/\//i.test(v) ? v : `https://${v}`);
    const host = u.hostname.replace(/^www\./, "").toLowerCase();
    if (!host || !host.includes(".") || host.length < 4) {
      return "That doesn't look like a website. Try yourbrand.com.";
    }
    if (SOCIAL_VIDEO_HOSTS.has(host)) {
      return "Enter your brand's own website, not a social or video link.";
    }
  } catch {
    return "That doesn't look like a website. Try yourbrand.com.";
  }
  return "";
}

export default function Block() {
  const [open, setOpen] = useState(false);
  const [name, setName] = useState("");
  const [hasWebsite, setHasWebsite] = useState(true);
  const [website, setWebsite] = useState("");
  const [description, setDescription] = useState("");
  const [submitting, setSubmitting] = useState(false);

  // Full parity with /onboarding/new/set-up: top product/feature pages
  // for the scraper, and 1-3 format picks from the gallery.
  const [pageType, setPageType] = useState("products");
  const [links, setLinks] = useState([""]);
  const [pickedFormats, setPickedFormats] = useState([]);

  const user = useCurrentUser();
  const createRecord = useRecordCreate({ fields: createFields, from: ds.accounts });

  // Blueprint engine wiring (this block builds it itself).
  const userRow = useRecord({ recordId: user?.id, select: userRead, from: ds.users, enabled: !!user?.id });
  const updateAccount = useRecordUpdate({ fields: updateFields, from: ds.accounts });
  const createProduct = useRecordCreate({ fields: productWrite, from: ds.products });
  const updateProduct = useRecordUpdate({ fields: productWrite, from: ds.products });
  const createProject = useRecordCreate({ fields: projectWrite, from: ds.projects });
  const createNotification = useRecordCreate({ fields: notificationWrite, from: ds.notifications });
  const proxyFirecrawl = useProxyFetch(ds.firecrawl);
  const proxyOpenRouter = useProxyFetch(ds.openrouter);
  // phase: idle | running | done | failed
  const [build, setBuild] = useState({ phase: "idle", note: "", error: "" });
  const building = build.phase === "running" || build.phase === "failed";

  const reset = () => {
    setName("");
    setWebsite("");
    setDescription("");
    setHasWebsite(true);
    setPageType("products");
    setLinks([""]);
    setPickedFormats([]);
  };

  const setLinkAt = (i, val) => setLinks((cur) => cur.map((l, idx) => (idx === i ? val : l)));
  const addLink = () => setLinks((cur) => (cur.length >= 3 ? cur : [...cur, ""]));
  const removeLink = (i) => setLinks((cur) => (cur.length <= 1 ? cur : cur.filter((_, idx) => idx !== i)));
  const toggleFormat = (f) => {
    setPickedFormats((cur) => {
      if (cur.find((x) => x.id === f.id)) return cur.filter((x) => x.id !== f.id);
      if (cur.length >= 3) return cur;
      return [...cur, f];
    });
  };

  const handleClose = () => {
    // The build runs in this tab: closing would kill it mid-run.
    if (build.phase === "running") return;
    reset();
    setBuild({ phase: "idle", note: "", error: "" });
    setOpen(false);
  };

  const websiteError = hasWebsite ? getWebsiteError(website) : "";

  // The blueprint build. `form` carries the values just submitted, so
  // nothing has to be read back first.
  const runBuild = async (accountId, form, userFields) => {
    const website = String(form.website || "").trim();
    const description = String(form.description || "").trim();
    const links = parsePageLinks(form.pageLinks);
    const formats = pickedFormatGuidance(form.preferredFormats);
    const stage = (note) => setBuild({ phase: "running", note, error: "" });
    try {
      stage(website ? "Reading your website" : "Reading your description");

      // 1. Scrape the website and every page link, in parallel. A page
      //    that fails is skipped, never fatal.
      // One Firecrawl attempt. proxyMode null is Firecrawl's default.
      const scrapeOnce = async (target, proxyMode) => {
        const payload = { url: target, formats: ["markdown", "rawHtml"], onlyMainContent: true };
        if (proxyMode) payload.proxy = proxyMode;
        const res = await withTimeout(
          proxyFirecrawl(FIRECRAWL_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          }),
          proxyMode ? STEALTH_TIMEOUT_MS : SCRAPE_TIMEOUT_MS,
          proxyMode ? "Stealth scrape" : "Scrape",
        );
        if (!res.ok) { console.error("[blueprint] Firecrawl returned", res.status, target, proxyMode || "basic"); return null; }
        const j = await res.json();
        const d = j?.data || j || {};
        const md = String(d.markdown || "");
        const meta = d.metadata || {};
        if (Number(meta.statusCode) >= 400) { console.error("[blueprint] page returned", meta.statusCode, target); return null; }
        if (!md.trim()) return null;
        return {
          markdown: md,
          title: String(meta.title || meta.ogTitle || meta["og:title"] || "").trim(),
          description: String(meta.description || meta.ogDescription || meta["og:description"] || "").trim(),
          image: String(meta.ogImage || meta["og:image"] || "").trim(),
          ld: jsonLdProduct(d.rawHtml),
        };
      };

      const scrape = async (url) => {
        if (!url) return null;
        const target = /^https?:\/\//i.test(url) ? url : `https://${url}`;
        try {
          let out = await scrapeOnce(target, null);
          // Nothing came back, or what came back is a bot wall. Retry once
          // through the stealth proxy and keep whichever result is better.
          if (!out || looksBlocked(out.markdown)) {
            console.warn("[blueprint] bot wall or empty page at", target, "- retrying with the stealth proxy");
            const retry = await scrapeOnce(target, "stealth");
            if (retry && (!out || !looksBlocked(retry.markdown))) out = retry;
          }
          return out;
        } catch (e) { console.error("[blueprint] scrape failed:", url, e); return null; }
      };
      const [site, ...pageScrapes] = await Promise.all([
        website ? scrape(website) : Promise.resolve(null),
        ...links.map((l) => scrape(l.url)),
      ]);
      const pages = links.map((l, i) => ({ ...l, slot: i + 1, scrape: pageScrapes[i], text: trimForModel(pageScrapes[i]?.markdown) }));
      const siteText = trimForModel(site?.markdown);
      if (!siteText && !pages.some((p) => p.text) && !description) {
        throw new Error("We couldn't read your website, and there is no description to work from.");
      }

      // 2. One products row per page, created BEFORE the model call so
      //    the rows exist even if the writer fails.
      if (pages.length) stage(`Saving ${pages.length} page${pages.length > 1 ? "s" : ""}`);
      const nowIso = new Date().toISOString();
      for (const p of pages) {
        if (p.product_id) continue;
        try {
          const createdProduct = await createProduct.mutateAsync({
            name: (p.scrape?.title || hostSlug(p.url)).slice(0, 120),
            accounts: [{ id: accountId }],
            type: PRODUCT_TYPE[p.type] || PRODUCT_TYPE.Product,
            url: p.url,
            description: p.scrape?.description || "",
            imageUrl: p.scrape?.ld?.image || p.scrape?.image || "",
            price: p.scrape?.ld?.price || "",
            scrape: capForStore(p.scrape?.markdown),
            scrapedAt: p.scrape ? nowIso : null,
            status: PRODUCT_ACTIVE,
          });
          p.product_id = createdProduct?.id || createdProduct?.recordId || "";
        } catch (e) { console.error("[blueprint] product create failed:", p.url, e); }
      }

      // 3. The writer. Brand keys in one call, each page in its own call,
      //    all in parallel, so no single call outruns the 120s proxy.
      stage("Writing your blueprint");
      const callModel = async ({ model, temperature, userPrompt, maxTokens }) => {
        const res = await withTimeout(
          proxyOpenRouter(OPENROUTER_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              model,
              temperature,
              max_tokens: maxTokens,
              response_format: { type: "json_object" },
              provider: { sort: "throughput" },
              messages: [
                { role: "system", content: BLUEPRINT_SYSTEM_PROMPT },
                { role: "user", content: userPrompt },
              ],
            }),
          }),
          MODEL_TIMEOUT_MS,
          "The writer",
        );
        if (!res.ok) throw new Error(`The writer is busy right now (${res.status}).`);
        const j = await res.json();
        const raw = j?.choices?.[0]?.message?.content || "";
        const text = Array.isArray(raw) ? raw.map((x) => x?.text || "").join("\n") : String(raw);
        return safeParseJson(text);
      };
      const write = async (userPrompt, maxTokens, accept) => {
        const attempts = [
          { model: BLUEPRINT_MODEL, temperature: 0.3 },
          { model: BLUEPRINT_FALLBACK_MODEL, temperature: 0.3 },
          { model: BLUEPRINT_FALLBACK_MODEL, temperature: 0.4 },
        ];
        let lastErr = null;
        for (const a of attempts) {
          try {
            const out = await callModel({ ...a, userPrompt, maxTokens });
            if (out && accept(out)) return out;
            lastErr = new Error("The blueprint came back in a shape we could not read.");
          } catch (e) { lastErr = e; console.error("[blueprint] writer attempt failed:", a.model, e); }
        }
        throw lastErr || new Error("The writer did not answer.");
      };
      const baseArgs = { workspaceName: form.name, description, website, siteText, formats };
      const livePages = pages.filter((p) => p.text);
      const brandAsk = "Write ONLY the brand-level keys now: name, bio, content_style, cta, niche, target_audience, objectives, pain. Set \"products\" to an empty array. The product or feature pages above are context for the brand; their own objects are written separately.";
      const productAsk = (p) => `Write ONLY {"products": [ one object for slot ${p.slot} ]} now, grounded in PRODUCT OR FEATURE PAGE ${p.slot}. The website scrape is context only. Do not write the brand-level keys.`;
      const [brand, ...productOuts] = await Promise.all([
        write(buildUserPrompt({ ...baseArgs, pages: livePages, ask: brandAsk }), 2500, (o) => !!(o.bio || o.name)),
        ...livePages.map((p) =>
          write(buildUserPrompt({ ...baseArgs, pages: [p], ask: productAsk(p) }), 2000, (o) => Array.isArray(o.products) && o.products.length > 0)
            .catch((e) => { console.error("[blueprint] page", p.slot, "skipped:", e); return null; }),
        ),
      ]);
      const ai = { ...brand, products: [] };
      productOuts.forEach((o, i) => {
        const obj = o && Array.isArray(o.products) ? o.products[0] : null;
        if (obj) ai.products.push({ ...obj, slot: livePages[i].slot });
      });

      // 4. Format, then write the account row.
      stage("Saving your blueprint");
      const out = formatBlueprint(ai, form.name);
      const scr = (p) => capForStore(p?.scrape?.markdown);
      const linkIds = (arr) => (Array.isArray(arr) ? arr : []).filter((x) => x?.id).map((x) => ({ id: x.id }));
      const fields = {
        name: out.name || form.name,
        brandBio: out.brandBio,
        brandVoice: out.brandVoice,
        brandCta: out.brandCta,
        niche: out.niche,
        targetAudience: out.targetAudience,
        audienceObjectives: out.audienceObjectives,
        audiencePainPoints: out.audiencePainPoints,
        productOrFeature1: out.productBlocks[0],
        productOrFeature2: out.productBlocks[1],
        productOrFeature3: out.productBlocks[2],
        websiteScrape: capForStore(site?.markdown),
        page1Scrape: scr(pages[0]),
        page2Scrape: scr(pages[1]),
        page3Scrape: scr(pages[2]),
        communityLinks: `Email:${userFields.email || user?.email || ""}\n\nWebsite:${website}`,
        pageLinks: JSON.stringify(pages.map((p) => ({ url: p.url, type: p.type, product_id: p.product_id || "" }))),
        blueprintStatus: BLUEPRINT_COMPLETE,
        status: ACCOUNT_ACTIVE,
      };
      if (user?.id) fields.owner = [{ id: user.id }];
      const billingLinks = linkIds(userFields.billing);
      const usageLinks = linkIds(userFields.usage);
      if (billingLinks.length) fields.billing = billingLinks;
      if (usageLinks.length) fields.usage = usageLinks;
      await updateAccount.mutateAsync({ recordId: accountId, fields });

      // 5. Each page's blueprint block onto its products row (best effort).
      for (let i = 0; i < pages.length; i++) {
        const p = pages[i];
        const blockText = out.productBlocks[i];
        if (!p.product_id || !blockText) continue;
        // JSON-LD wins on price; the model's reading of the scrape is the
        // fallback for pages that publish no structured offer.
        const productFields = { description: blockText };
        if (!p.scrape?.ld?.price && out.productPrices[i]) productFields.price = out.productPrices[i];
        try { await updateProduct.mutateAsync({ recordId: p.product_id, fields: productFields }); }
        catch (e) { console.error("[blueprint] product description failed:", p.url, e); }
      }

      // 6. First project + in-app notification.
      try {
        await createProject.mutateAsync({
          name: `${out.name || form.name}'s First Project`,
          accounts: [{ id: accountId }],
          users: user?.id ? [{ id: user.id }] : [],
          status: PROJECT_DRAFT,
        });
      } catch (e) { console.error("[blueprint] project create failed:", e); }
      try {
        await createNotification.mutateAsync({
          type: NOTIFY_ACCOUNT_CREATED,
          accounts: [{ id: accountId }],
          users: user?.id ? [{ id: user.id }] : [],
        });
      } catch (e) { console.error("[blueprint] notification create failed:", e); }

      // Done: close the form and let the page pick the new workspace up.
      setBuild({ phase: "done", note: "", error: "" });
      toast.success("Workspace ready", { description: `${out.name || form.name} is set up.` });
      reset();
      setOpen(false);
      setBuild({ phase: "idle", note: "", error: "" });
      if (typeof window !== "undefined") window.location.reload();
    } catch (e) {
      console.error("[blueprint] build failed:", e);
      setBuild({ phase: "failed", note: "", error: e?.message || "Something went wrong." });
      try { await updateAccount.mutateAsync({ recordId: accountId, fields: { blueprintStatus: BLUEPRINT_FAILED } }); }
      catch { /* leave it Pending; it can be retried */ }
    }
  };

  const handleSubmit = async () => {
    if (!name.trim()) {
      toast.error("Workspace name is required");
      return;
    }
    if (hasWebsite && !website.trim()) {
      toast.error("Website is required (or switch to description)");
      return;
    }
    if (hasWebsite && websiteError) {
      toast.error(websiteError);
      return;
    }
    if (!hasWebsite && !description.trim()) {
      toast.error("Description is required (or switch to website)");
      return;
    }
    if (pickedFormats.length === 0) {
      toast.error("Pick at least one format");
      return;
    }
    if (!user?.id) {
      toast.error("Please log in to create a workspace");
      return;
    }

    setSubmitting(true);
    try {
      const cleanLinks = links.map((l) => l.trim()).filter(Boolean).slice(0, MAX_PAGE_LINKS);
      const pageLinksJson = JSON.stringify(
        cleanLinks.map((url) => ({ url, type: pageType === "features" ? "Feature" : "Product", product_id: "" })),
      );
      const created = await createRecord.mutateAsync({
        name: name.trim(),
        users: [{ id: user.id }],
        blueprintStatus: BLUEPRINT_PENDING,
        web: hasWebsite ? WEB_YES : WEB_NO,
        website: hasWebsite ? website.trim() : "",
        description: hasWebsite ? "" : description.trim(),
        preferredFormats: pickedFormats.map((f) => f.name).join(", "),
        pageLinks: pageLinksJson,
      });
      const accountId = created?.id || created?.recordId || "";
      if (!accountId) throw new Error("Create returned no record id");
      try { window.localStorage.setItem("bl-active-workspace", accountId); } catch { /* ignore */ }
      try { window.localStorage.setItem("bl-workspace-building", JSON.stringify({ accountId, ts: Date.now() })); } catch { /* ignore */ }
      // Stay on /settings and build the blueprint right here.
      await runBuild(accountId, {
        name: name.trim(),
        website: hasWebsite ? website.trim() : "",
        description: hasWebsite ? "" : description.trim(),
        pageLinks: pageLinksJson,
        preferredFormats: pickedFormats.map((f) => f.name).join(", "),
      }, userRow.data?.fields || {});
    } catch (e) {
      console.error("Workspace create failed:", e);
      setBuild({ phase: "failed", note: "", error: e?.message || "Try again." });
      toast.error("Couldn't create workspace", {
        description: e?.message || "Try again.",
      });
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div
      style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        padding: "16px 24px 0",
        width: "100%",
      }}
    >
      <Style />

      <div
        className="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
        style={{
          backgroundColor: "rgba(135, 156, 247, 0.10)",
          color: "#879CF7",
          border: "1px solid rgba(135, 156, 247, 0.25)",
        }}
      >
        <span
          className="rounded-full"
          style={{ width: 6, height: 6, backgroundColor: "#879CF7" }}
        />
        Workspace
      </div>

      <button
        type="button"
        onClick={() => setOpen(true)}
        className="newws-trigger"
      >
        <Plus className="h-4 w-4" strokeWidth={2.5} />
        New workspace
      </button>

      {open && (
        <div
          className="newws-backdrop"
          onClick={handleClose}
          role="presentation"
        >
          <div
            className="newws-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="newws-title"
            onClick={(e) => e.stopPropagation()}
          >
            {building && (
              <div className="newws-building" role="status" aria-live="polite">
                {build.phase === "running" && <div className="newws-spinner" />}
                <div className="newws-building-title">
                  {build.phase === "failed" ? "That didn't work" : "Building your workspace"}
                </div>
                <div className="newws-building-note">
                  {build.phase === "failed" ? build.error : (build.note || "Getting started") + "..."}
                </div>
                {build.phase === "running" && (
                  <div className="newws-building-hint">
                    This takes about a minute. Keep this tab open.
                  </div>
                )}
                {build.phase === "failed" && (
                  <button
                    type="button"
                    className="newws-submit"
                    style={{ marginTop: 18 }}
                    onClick={() => setBuild({ phase: "idle", note: "", error: "" })}
                  >
                    Back
                  </button>
                )}
              </div>
            )}
            <header className="newws-form-header">
              <div>
                <h3 id="newws-title" className="newws-form-title">
                  New workspace
                </h3>
                <p className="newws-form-sub">
                  Brieflee will build a fresh content blueprint for it.
                </p>
              </div>
              <button
                type="button"
                onClick={handleClose}
                className="newws-close"
                aria-label="Close"
              >
                ×
              </button>
            </header>

            <div className="newws-fields">
              <div>
                <label className="newws-label">Workspace name</label>
                <Input
                  value={name}
                  onChange={(e) => setName(e.target.value)}
                  placeholder="e.g. My Brand"
                  disabled={submitting}
                  autoFocus
                />
              </div>

              <div>
                <label className="newws-label">How should we set this up?</label>
                <div className="newws-toggle-row">
                  <button
                    type="button"
                    onClick={() => setHasWebsite(true)}
                    className={"newws-toggle " + (hasWebsite ? "active" : "")}
                    disabled={submitting}
                  >
                    From a website
                  </button>
                  <button
                    type="button"
                    onClick={() => setHasWebsite(false)}
                    className={"newws-toggle " + (!hasWebsite ? "active" : "")}
                    disabled={submitting}
                  >
                    From a description
                  </button>
                </div>
              </div>

              {hasWebsite ? (
                <div>
                  <label className="newws-label">Website URL</label>
                  <Input
                    type="url"
                    value={website}
                    onChange={(e) => setWebsite(e.target.value)}
                    placeholder="https://example.com"
                    disabled={submitting}
                  />
                  {website.trim() && websiteError && (
                    <p style={{ color: "#d92626", fontSize: 12, marginTop: 6 }}>
                      {websiteError}
                    </p>
                  )}
                </div>
              ) : (
                <div>
                  <label className="newws-label">Brand description</label>
                  <Textarea
                    value={description}
                    onChange={(e) => setDescription(e.target.value)}
                    placeholder="A few sentences on what this brand is and who it's for."
                    rows={3}
                    disabled={submitting}
                  />
                </div>
              )}

              <div>
                <label className="newws-label">Top pages (optional, up to 5)</label>
                <div className="newws-toggle-row" style={{ marginBottom: 8 }}>
                  <button
                    type="button"
                    onClick={() => setPageType("products")}
                    className={"newws-toggle " + (pageType === "products" ? "active" : "")}
                    disabled={submitting}
                  >
                    Products
                  </button>
                  <button
                    type="button"
                    onClick={() => setPageType("features")}
                    className={"newws-toggle " + (pageType === "features" ? "active" : "")}
                    disabled={submitting}
                  >
                    Features
                  </button>
                </div>
                <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                  {links.map((val, i) => (
                    <div key={i} style={{ display: "flex", alignItems: "center", gap: 6 }}>
                      <div style={{ position: "relative", flex: 1 }}>
                        <Link2 className="h-4 w-4" style={{ position: "absolute", left: 10, top: "50%", transform: "translateY(-50%)", color: "#879CF7" }} />
                        <Input
                          value={val}
                          onChange={(e) => setLinkAt(i, e.target.value)}
                          placeholder={pageType === "features" ? "yourbrand.com/features/…" : "yourbrand.com/products/…"}
                          disabled={submitting}
                          style={{ paddingLeft: 34 }}
                        />
                      </div>
                      {links.length > 1 && (
                        <button
                          type="button"
                          onClick={() => removeLink(i)}
                          disabled={submitting}
                          aria-label="Remove link"
                          style={{ background: "transparent", border: "none", cursor: "pointer", color: "#879CF7", padding: 4 }}
                        >
                          <X className="h-4 w-4" />
                        </button>
                      )}
                    </div>
                  ))}
                  {links.length < MAX_PAGE_LINKS && (
                    <button
                      type="button"
                      onClick={addLink}
                      disabled={submitting}
                      style={{ background: "transparent", border: "none", cursor: "pointer", color: "#879CF7", fontSize: 12, fontWeight: 600, textAlign: "left", padding: 0 }}
                    >
                      + Add another link
                    </button>
                  )}
                </div>
              </div>

              <div>
                <label className="newws-label">Formats — pick 1 to 3</label>
                <FormatGrid formats={FORMATS} picked={pickedFormats} onToggle={toggleFormat} />
              </div>
            </div>

            <footer className="newws-form-footer">
              <button
                type="button"
                onClick={handleClose}
                disabled={submitting}
                className="newws-cancel"
              >
                Cancel
              </button>
              <Button
                onClick={handleSubmit}
                disabled={
                  submitting ||
                  !name.trim() ||
                  (hasWebsite && (!website.trim() || !!websiteError)) ||
                  (!hasWebsite && !description.trim()) ||
                  pickedFormats.length === 0
                }
              >
                {submitting ? "Creating…" : "Create workspace"}
              </Button>
            </footer>
          </div>
        </div>
      )}
    </div>
  );
}

function Style() {
  return (
    <style>
      {`
        @import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700&display=swap');
        .newws-trigger,
        .newws-modal,
        .newws-modal * { font-family: 'League Spartan', sans-serif; }

        .newws-trigger {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 8px 16px;
          background: #879CF7;
          color: #FFFFFF;
          border: none;
          border-radius: 8px;
          font-size: 14px;
          font-weight: 600;
          cursor: pointer;
          transition: background 0.2s ease;
        }
        .newws-trigger:hover {
          background: #294FF6;
        }

        @keyframes newwsBackdropFade {
          from { opacity: 0; }
          to   { opacity: 1; }
        }
        @keyframes newwsModalRise {
          from { opacity: 0; transform: translateY(6px); }
          to   { opacity: 1; transform: translateY(0); }
        }

        .newws-backdrop {
          position: fixed;
          top: 0; left: 0; right: 0; bottom: 0;
          background: rgba(0, 15, 77, 0.40);
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 9999;
          padding: 20px;
          animation: newwsBackdropFade 0.16s ease-out;
        }
        .newws-building {
          position: absolute;
          inset: 0;
          z-index: 5;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 32px;
          background: #FAFBFF;
          border-radius: inherit;
        }
        .newws-spinner {
          width: 34px;
          height: 34px;
          border-radius: 50%;
          border: 3px solid rgba(135, 156, 247, 0.25);
          border-top-color: #879CF7;
          animation: newws-spin 0.8s linear infinite;
          margin-bottom: 18px;
        }
        @keyframes newws-spin { to { transform: rotate(360deg); } }
        .newws-building-title {
          font-size: 16px;
          font-weight: 600;
          color: #334283;
        }
        .newws-building-note {
          margin-top: 6px;
          font-size: 13px;
          color: #6B7A99;
        }
        .newws-building-hint {
          margin-top: 14px;
          font-size: 12px;
          color: #93A0BB;
        }
        .newws-modal {
          position: relative;
          width: 100%;
          max-width: 460px;
          background: #FFFFFF;
          border: 1px solid rgba(217, 224, 255, 0.6);
          border-radius: 14px;
          padding: 22px 24px 18px;
          box-shadow: 0 12px 36px rgba(0, 15, 77, 0.18);
          animation: newwsModalRise 0.18s ease-out;
          max-height: calc(100vh - 40px);
          overflow-y: auto;
        }
        .newws-form-header {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 12px;
          margin-bottom: 18px;
        }
        .newws-form-title {
          font-size: 16px;
          font-weight: 600;
          color: #000F4D;
          margin: 0;
        }
        .newws-form-sub {
          font-size: 12px;
          color: #6b7a99;
          margin: 4px 0 0;
        }
        .newws-close {
          width: 28px;
          height: 28px;
          background: transparent;
          color: #6b7a99;
          border: none;
          border-radius: 999px;
          font-size: 22px;
          line-height: 1;
          cursor: pointer;
          padding: 0;
          transition: background 0.2s ease, color 0.2s ease;
        }
        .newws-close:hover {
          background: rgba(135, 156, 247, 0.10);
          color: #001364;
        }

        .newws-fields {
          display: flex;
          flex-direction: column;
          gap: 14px;
        }
        .newws-label {
          display: block;
          font-size: 12px;
          font-weight: 600;
          color: #001364;
          margin-bottom: 6px;
        }

        .newws-toggle-row {
          display: flex;
          gap: 6px;
        }
        .newws-toggle {
          flex: 1;
          padding: 9px 12px;
          background: #FFFFFF;
          color: #6b7a99;
          border: 1px solid rgba(217, 224, 255, 0.7);
          border-radius: 8px;
          font-size: 12px;
          font-weight: 500;
          cursor: pointer;
          transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
        }
        .newws-toggle.active {
          background: rgba(135, 156, 247, 0.10);
          color: #001364;
          border-color: #879CF7;
          font-weight: 600;
        }
        .newws-toggle:disabled { opacity: 0.6; cursor: not-allowed; }

        .newws-form-footer {
          display: flex;
          justify-content: flex-end;
          align-items: center;
          gap: 8px;
          margin-top: 20px;
          padding-top: 16px;
          border-top: 1px solid rgba(217, 224, 255, 0.55);
        }
        .newws-cancel {
          background: transparent;
          color: #6b7a99;
          border: none;
          font-size: 14px;
          font-weight: 500;
          padding: 8px 14px;
          border-radius: 8px;
          cursor: pointer;
          transition: color 0.2s ease;
        }
        .newws-cancel:hover:not(:disabled) { color: #001364; }
        .newws-cancel:disabled { color: #C5CFE8; cursor: not-allowed; }
      `}
    </style>
  );
}

// =====================================================================
// Format gallery — same cards as /app/briefs/create-brief (looping MP4
// thumbs). Data constants live BELOW the components on purpose: Softr's
// Vibe Code analyzer has a byte budget and needs to see the component
// code first.
// =====================================================================
function FormatGrid({ formats, picked, onToggle }) {
  return (
    <div className="grid grid-cols-2 gap-2 max-h-[340px] overflow-y-auto pr-1">
      {formats.map((f) => {
        const on = picked.some((x) => x.id === f.id);
        return (
          <button
            key={f.id}
            onClick={() => onToggle(f)}
            className="text-left rounded-lg overflow-hidden bg-white transition-all"
            style={{ border: on ? "2px solid #7A93FF" : "1px solid rgba(217, 224, 255, 0.6)" }}
          >
            <div className="relative aspect-square overflow-hidden" style={{ background: "rgba(135, 156, 247, 0.06)" }}>
              {f.thumb ? (
                <video src={f.thumb} muted playsInline loop autoPlay preload="metadata" className="w-full h-full object-cover" />
              ) : (
                <div className="w-full h-full flex items-center justify-center"><ImageIcon size={24} style={{ color: "#7A93FF" }} /></div>
              )}
              {on && (
                <div className="absolute top-1.5 right-1.5 w-5 h-5 rounded-full flex items-center justify-center" style={{ background: "#294FF6" }}>
                  <Check size={12} className="text-white" />
                </div>
              )}
            </div>
            <div className="px-2 py-1.5">
              <div className="text-xs" style={{ color: "#000F4D", fontWeight: on ? 600 : 500 }}>{f.name}</div>
              {f.desc && <div className="text-[10px] leading-snug mt-0.5" style={{ color: "#7A93FF", fontWeight: 300, display: "-webkit-box", WebkitLineClamp: 1, WebkitBoxOrient: "vertical", overflow: "hidden" }}>{f.desc}</div>}
            </div>
          </button>
        );
      })}
    </div>
  );
}

