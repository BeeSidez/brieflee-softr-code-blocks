// /settings · "+ New workspace" button (separate Vibe Code block).
//
// Shows a single button. Click → in-block form expands. Submit →
// fires the BL | New Workspace v2 Softr workflow webhook with
// is_additional_workspace: true. The workflow does everything:
// Gemini brand research → create the accounts row → copy
// billing/usage/subscriptions LINKED_RECORDs from the user.
//
// Place this block above (or beside) the workspace switcher. Set
// VISIBILITY in Softr to user groups whose plan allows multiple
// workspaces — single-workspace plans never see the button.
//
// SOFTR CONFIG REQUIRED:
//   No source binding needed — this block doesn't read from or
//   write to a Softr table directly. It just calls the workflow.

import { useState } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Plus } from "lucide-react";
import { useCurrentUser } from "@/lib/user";
import { toast } from "sonner";

// BL | New Workspace v2 — Softr workflow webhook URL.
// Shared with /onboarding/new/set-up; same body shape from both callers
// (this block sets is_additional_workspace: true; /set-up sends false).
const WORKSPACE_WORKFLOW_URL = "https://workflows-api.softr.io/v1/workflows/45e0663d-3163-4183-b055-d21b2449eb5a/executions/3a18e3de-2702-4dc1-8ce7-97bb40ae5b37";

// People keep pasting their TikTok/Reel/Shorts/Tweet links here. Block
// them outright. Mirrors the list in /set-up so the rules match.
const SOCIAL_VIDEO_HOSTS = new Set([
  "youtube.com", "m.youtube.com", "youtube-nocookie.com", "youtu.be",
  "tiktok.com", "m.tiktok.com", "vm.tiktok.com", "vt.tiktok.com",
  "instagram.com", "instagr.am",
  "facebook.com", "m.facebook.com", "fb.com", "fb.watch",
  "twitter.com", "x.com", "t.co",
  "threads.net",
  "linkedin.com", "lnkd.in",
  "pinterest.com", "pin.it",
  "snapchat.com",
  "reddit.com", "redd.it",
  "vimeo.com",
  "twitch.tv",
]);
function getWebsiteError(value) {
  const v = (value || "").trim();
  if (!v) return "";
  try {
    const u = new URL(/^https?:\/\//i.test(v) ? v : `https://${v}`);
    const host = u.hostname.replace(/^www\./, "").toLowerCase();
    if (!host || !host.includes(".") || host.length < 4) {
      return "That doesn't look like a website. Try yourbrand.com.";
    }
    if (SOCIAL_VIDEO_HOSTS.has(host)) {
      return "Enter your brand's own website, not a social or video link.";
    }
  } catch {
    return "That doesn't look like a website. Try yourbrand.com.";
  }
  return "";
}

export default function Block() {
  const [open, setOpen] = useState(false);
  const [name, setName] = useState("");
  const [hasWebsite, setHasWebsite] = useState(true);
  const [website, setWebsite] = useState("");
  const [description, setDescription] = useState("");
  const [submitting, setSubmitting] = useState(false);

  const user = useCurrentUser();

  const reset = () => {
    setName("");
    setWebsite("");
    setDescription("");
    setHasWebsite(true);
  };

  const handleClose = () => {
    reset();
    setOpen(false);
  };

  const websiteError = hasWebsite ? getWebsiteError(website) : "";

  const handleSubmit = async () => {
    if (!name.trim()) {
      toast.error("Workspace name is required");
      return;
    }
    if (hasWebsite && !website.trim()) {
      toast.error("Website is required (or switch to description)");
      return;
    }
    if (hasWebsite && websiteError) {
      toast.error(websiteError);
      return;
    }
    if (!hasWebsite && !description.trim()) {
      toast.error("Description is required (or switch to website)");
      return;
    }
    if (!user?.id) {
      toast.error("Please log in to create a workspace");
      return;
    }

    setSubmitting(true);
    try {
      const res = await fetch(WORKSPACE_WORKFLOW_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          user_id: user.id,
          workspace_name: name.trim(),
          website: hasWebsite ? website.trim() : "",
          description: hasWebsite ? "" : description.trim(),
          is_additional_workspace: true,
        }),
      });
      if (!res.ok) {
        throw new Error(`Workflow returned HTTP ${res.status}`);
      }
      toast.success("Workspace created — Brieflee is building your content blueprint.");
      reset();
      setOpen(false);
    } catch (e) {
      console.error("Workspace workflow failed:", e);
      toast.error("Couldn't create workspace", {
        description: e?.message || "Try again.",
      });
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div
      style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        padding: "16px 24px 0",
        width: "100%",
      }}
    >
      <Style />

      <div
        className="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
        style={{
          backgroundColor: "rgba(135, 156, 247, 0.10)",
          color: "#879CF7",
          border: "1px solid rgba(135, 156, 247, 0.25)",
        }}
      >
        <span
          className="rounded-full"
          style={{ width: 6, height: 6, backgroundColor: "#879CF7" }}
        />
        Workspace
      </div>

      <button
        type="button"
        onClick={() => setOpen(true)}
        className="newws-trigger"
      >
        <Plus className="h-4 w-4" strokeWidth={2.5} />
        New workspace
      </button>

      {open && (
        <div
          className="newws-backdrop"
          onClick={handleClose}
          role="presentation"
        >
          <div
            className="newws-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="newws-title"
            onClick={(e) => e.stopPropagation()}
          >
            <header className="newws-form-header">
              <div>
                <h3 id="newws-title" className="newws-form-title">
                  New workspace
                </h3>
                <p className="newws-form-sub">
                  Brieflee will build a fresh content blueprint for it.
                </p>
              </div>
              <button
                type="button"
                onClick={handleClose}
                className="newws-close"
                aria-label="Close"
              >
                ×
              </button>
            </header>

            <div className="newws-fields">
              <div>
                <label className="newws-label">Workspace name</label>
                <Input
                  value={name}
                  onChange={(e) => setName(e.target.value)}
                  placeholder="e.g. My Brand"
                  disabled={submitting}
                  autoFocus
                />
              </div>

              <div>
                <label className="newws-label">How should we set this up?</label>
                <div className="newws-toggle-row">
                  <button
                    type="button"
                    onClick={() => setHasWebsite(true)}
                    className={"newws-toggle " + (hasWebsite ? "active" : "")}
                    disabled={submitting}
                  >
                    From a website
                  </button>
                  <button
                    type="button"
                    onClick={() => setHasWebsite(false)}
                    className={"newws-toggle " + (!hasWebsite ? "active" : "")}
                    disabled={submitting}
                  >
                    From a description
                  </button>
                </div>
              </div>

              {hasWebsite ? (
                <div>
                  <label className="newws-label">Website URL</label>
                  <Input
                    type="url"
                    value={website}
                    onChange={(e) => setWebsite(e.target.value)}
                    placeholder="https://example.com"
                    disabled={submitting}
                  />
                  {website.trim() && websiteError && (
                    <p style={{ color: "#d92626", fontSize: 12, marginTop: 6 }}>
                      {websiteError}
                    </p>
                  )}
                </div>
              ) : (
                <div>
                  <label className="newws-label">Brand description</label>
                  <Textarea
                    value={description}
                    onChange={(e) => setDescription(e.target.value)}
                    placeholder="A few sentences on what this brand is and who it's for."
                    rows={3}
                    disabled={submitting}
                  />
                </div>
              )}
            </div>

            <footer className="newws-form-footer">
              <button
                type="button"
                onClick={handleClose}
                disabled={submitting}
                className="newws-cancel"
              >
                Cancel
              </button>
              <Button
                onClick={handleSubmit}
                disabled={
                  submitting ||
                  !name.trim() ||
                  (hasWebsite && (!website.trim() || !!websiteError)) ||
                  (!hasWebsite && !description.trim())
                }
              >
                {submitting ? "Creating…" : "Create workspace"}
              </Button>
            </footer>
          </div>
        </div>
      )}
    </div>
  );
}

