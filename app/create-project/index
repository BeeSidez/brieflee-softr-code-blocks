// =====================================================================
// /create-project — Create Project modal (Vibe Code block)
// =====================================================================
// Opens via window.openSwModal("/create-project?workspace=<id>") from
// the "Create Review" button on /app/projects.
//
// What it does:
//   • Reads the URL `?workspace=<id>` so multi-account users coming
//     off the switcher land in the right workspace
//   • Reads the logged-in user's `accounts` linked field directly so
//     single-account users auto-default to their one workspace, and
//     zero-account users get a "create workspace" CTA
//   • Renders the same form as before: Name / Description / Workspace
//   • On submit, creates the project row, posts a "project-created"
//     message to the parent window (so /app/projects refetches the
//     grid), then closes the modal
//
// SOFTR UI SETUP:
//   1. Page: /create-project
//   2. Source binding → Database: brieflee beta · Table: projects
//      (so useRecordCreate writes there)
//   3. Actions: enable Add Record
//   4. Visibility: logged-in user groups (Active / Paid / etc.)
//   5. NO Softr-side workspace filter needed — this block only
//      writes; it reads user.accounts directly to figure out
//      available workspaces.
// =====================================================================

import { useEffect, useMemo, useState } from "react";
import {
  useRecord, useRecordCreate, q,
} from "@/lib/datasource";
import { useCurrentUser } from "@/lib/user";
import { X } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { toast } from "sonner";

// ─── Brand palette ────────────────────────────────────────────
const NAVY_DEEP  = "#001364";
const PERIWINKLE = "#879CF7";
const MUTED      = "#6B7A99";
const BORDER     = "rgba(217, 224, 255, 0.55)";

// ─── Field maps ───────────────────────────────────────────────
// projects table — write payload
const createFields = q.select({
  name:        "bvDEj",
  description: "j2HQW",
  accounts:    "IBYGK", // LINKED_RECORD → accounts
  users:       "2YWNF", // LINKED_RECORD → users
});

// users table — single read for the logged-in user's linked accounts.
// If `Hvx8O` returns empty, swap to `Nz6VX` — one of the two is the
// canonical link Softr's data layer exposes.
const userAccountsSelect = q.select({
  accounts: "Hvx8O",
});

// Workspace creation page — where to send users with zero accounts.
const CREATE_WORKSPACE_PATH = "/settings/new-workspace";

// ─── Helpers ──────────────────────────────────────────────────
function unwrap(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw.trim();
  if (Array.isArray(raw)) {
    const f = raw[0];
    if (typeof f === "string") return f.trim();
    if (f?.label) return String(f.label).trim();
    if (f?.name) return String(f.name).trim();
    return "";
  }
  if (typeof raw === "object") {
    if (raw.label) return String(raw.label).trim();
    if (raw.name) return String(raw.name).trim();
    return "";
  }
  return String(raw).trim();
}

// Closes the Softr modal we're rendered inside. Tries the direct
// parent-API first, falls back to postMessage.
function closeSoftrModal() {
  if (typeof window === "undefined") return;
  try {
    const p = window.parent;
    if (p && typeof p.closeSwModal === "function") {
      p.closeSwModal();
      return;
    }
    if (p) {
      p.postMessage({ type: "softr-modal-close" }, "*");
      p.postMessage({ type: "closeModal" }, "*");
    }
  } catch (e) {
    console.error("closeSoftrModal failed:", e);
  }
}

// =====================================================================
// MAIN BLOCK
// =====================================================================
export default function Block() {
  const user = useCurrentUser();

  // Read the user's linked accounts.
  const userAccountsRecord = useRecord({
    recordId: user?.id,
    select: userAccountsSelect,
    enabled: !!user?.id,
  });
  const userAccounts = useMemo(() => {
    const raw = userAccountsRecord?.data?.fields?.accounts;
    if (!Array.isArray(raw)) return [];
    return raw
      .map((a) => ({
        id: a?.id || "",
        label: unwrap(a) || "Untitled workspace",
      }))
      .filter((x) => x.id);
  }, [userAccountsRecord?.data]);

  const workspaceLabelLookup = useMemo(() => {
    const m = new Map();
    for (const a of userAccounts) m.set(a.id, a.label);
    return m;
  }, [userAccounts]);

  // Pick the right workspace to land in:
  //   1. URL `?workspace=<id>` from the switcher in /app/projects
  //   2. Single-account user → their one and only account
  //   3. Multi-account user with nothing ticked → empty (nudge them)
  //   4. Zero-account user → empty (CTA shown)
  const defaultWorkspaceId = useMemo(() => {
    if (typeof window !== "undefined") {
      const fromUrl = new URL(window.location.href).searchParams.get("workspace");
      if (fromUrl) return fromUrl.split(",").map((s) => s.trim()).filter(Boolean)[0] || "";
    }
    if (userAccounts.length === 1) return userAccounts[0].id;
    return "";
  }, [userAccounts]);

  const hasNoAccounts = !userAccountsRecord?.data
    ? false
    : userAccounts.length === 0;

  // ─── Form state ───────────────────────────────────────
  const [name, setName] = useState("");
  const [description, setDescription] = useState("");
  const [workspace, setWorkspace] = useState("");
  const [submitting, setSubmitting] = useState(false);

  // Re-sync workspace when defaultWorkspaceId resolves (it changes
  // once the user.accounts read finishes loading).
  useEffect(() => {
    if (!defaultWorkspaceId) return;
    setWorkspace((prev) => (prev ? prev : defaultWorkspaceId));
  }, [defaultWorkspaceId]);

  const createRecord = useRecordCreate({ fields: createFields });

  const handleCreate = async () => {
    if (!name.trim()) {
      toast.error("Project name is required");
      return;
    }
    if (!workspace) {
      toast.error("Pick a workspace for this project");
      return;
    }
    if (!user?.id) {
      toast.error("Please log in to create a project");
      return;
    }
    if (!createRecord.enabled) {
      toast.error("Cannot create records right now");
      return;
    }
    setSubmitting(true);
    try {
      await createRecord.mutateAsync({
        name: name.trim(),
        description: description.trim(),
        accounts: [{ id: workspace }],
        users: [{ id: user.id }],
      });
      toast.success("Project created");

      // Tell the parent (/app/projects) to refetch its grid.
      if (typeof window !== "undefined" && window.parent) {
        try {
          window.parent.postMessage({ type: "brieflee:project-created" }, "*");
        } catch (e) {
          console.error("postMessage to parent failed:", e);
        }
      }
      closeSoftrModal();
    } catch (e) {
      console.error("Create project failed:", e);
      toast.error("Couldn't create project", {
        description: e?.message || "Try again.",
      });
    } finally {
      setSubmitting(false);
    }
  };

  const handleCancel = () => closeSoftrModal();

  const isFormValid = !!name.trim() && !!workspace;

  return (
    <>
      <Style />
      <div className="bl-cp">
        <div className="bl-cp-content">
          <header className="bl-cp-header">
            <h2 className="bl-cp-title">Create new project</h2>
            <button
              type="button"
              onClick={handleCancel}
              className="bl-cp-close"
              aria-label="Close"
            ><X size={18} /></button>
          </header>

          <div className="bl-cp-body">
            <div className="bl-cp-field">
              <label className="bl-cp-label" htmlFor="cp-name">
                Name <span style={{ color: "#d92626" }}>*</span>
              </label>
              <Input
                id="cp-name"
                value={name}
                onChange={(e) => setName(e.target.value)}
                placeholder="Q1 TikTok Affiliates"
                disabled={submitting}
                autoFocus
              />
            </div>

            <div className="bl-cp-field">
              <label className="bl-cp-label" htmlFor="cp-desc">
                Description <span className="bl-cp-optional">(optional)</span>
              </label>
              <Textarea
                id="cp-desc"
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                placeholder="Add a few details"
                rows={3}
                disabled={submitting}
              />
            </div>

            <div className="bl-cp-field">
              <label className="bl-cp-label">Workspace</label>
              {workspace ? (
                <div className="bl-cp-static">
                  {workspaceLabelLookup.get(workspace) || "Selected workspace"}
                </div>
              ) : hasNoAccounts ? (
                <a
                  href={CREATE_WORKSPACE_PATH}
                  className="bl-cp-static bl-cp-static-cta"
                >
                  You don't have a workspace yet — create one to get started.
                </a>
              ) : (
                <div className="bl-cp-static bl-cp-static-warn">
                  Tick a workspace in the switcher above first.
                </div>
              )}
            </div>
          </div>

          <footer className="bl-cp-footer">
            <button
              type="button"
              onClick={handleCancel}
              disabled={submitting}
              className="bl-cp-cancel"
            >Cancel</button>
            <Button
              onClick={handleCreate}
              disabled={submitting || !isFormValid}
              style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
            >
              {submitting ? "Creating…" : "Create"}
            </Button>
          </footer>
        </div>
      </div>
    </>
  );
}

