// =====================================================================
// Countdown — live ticker for the submission close date.
// Updates every minute (fine-grain enough for a deadline that's days/
// hours out; cheap on re-renders).
// =====================================================================
function Countdown({ targetIso }) {
  const [now, setNow] = useState(() => Date.now());
  useEffect(() => {
    if (!targetIso) return;
    const id = setInterval(() => setNow(Date.now()), 60000);
    return () => clearInterval(id);
  }, [targetIso]);
  if (!targetIso) return null;
  const target = new Date(targetIso).getTime();
  if (!Number.isFinite(target)) return null;
  const diff = target - now;
  if (diff <= 0) {
    return <span className="bl-live-countdown is-closed">Submissions closed</span>;
  }
  const days = Math.floor(diff / 86400000);
  const hours = Math.floor((diff % 86400000) / 3600000);
  const minutes = Math.floor((diff % 3600000) / 60000);
  let label;
  if (days >= 1) label = `${days}d ${hours}h left`;
  else if (hours >= 1) label = `${hours}h ${minutes}m left`;
  else label = `${Math.max(1, minutes)}m left`;
  const isUrgent = diff < 86400000; // under 24h
  return <span className={`bl-live-countdown ${isUrgent ? "is-urgent" : ""}`}>{label}</span>;
}

