// v2: sanitized rich-text body for the new-model section fields.
function HtmlBody({ html }) {
  const clean = useMemo(() => sanitizeHtml(html), [html]);
  if (!clean) return null;
  return <div className="bl-live-html" dangerouslySetInnerHTML={{ __html: clean }} />;
}

// Strips the label a brief often carries in front of each line, so a
// card reads as the line itself rather than "Hook 1: the line".
// Handles "Hook 1:", "Talking point 2 -", "3.", "1)" and bare bullets.
function stripLineLabel(text) {
  return String(text || "")
    .replace(/^\s*(?:hook|talking\s*point|point|idea|option)?\s*\d+\s*[:.)\]-]\s*/i, "")
    .replace(/^\s*(?:hook|talking\s*point|point|idea|option)\s*[:.)\]-]\s*/i, "")
    .replace(/^\s*[-•*]\s*/, "")
    .trim();
}
// Splits a rich-text body into its individual lines. Reads list items
// when there are any, otherwise paragraphs, so a brief written either
// way comes out the same.
function htmlToLines(html) {
  const clean = sanitizeHtml(html);
  if (!clean || typeof DOMParser === "undefined") return [];
  let doc;
  try {
    doc = new DOMParser().parseFromString(`<div>${clean}</div>`, "text/html");
  } catch (e) {
    return [];
  }
  const items = doc.querySelectorAll("li");
  const nodes = items.length > 0 ? items : doc.querySelectorAll("p");
  const out = [];
  nodes.forEach((n) => {
    const t = stripLineLabel(n.textContent || "");
    if (t) out.push(t);
  });
  return out;
}
// One card per line. Falls back to the plain rich-text body when the
// content has no line structure to split on, so nothing ever vanishes.
function LineCards({ html, grid }) {
  const lines = useMemo(() => htmlToLines(html), [html]);
  if (lines.length === 0) return <HtmlBody html={html} />;
  return (
    <div className={`bl-live-linecards ${grid ? "is-grid" : ""}`}>
      {lines.map((t, i) => (
        <div key={i} className="bl-live-linecard">{t}</div>
      ))}
    </div>
  );
}

