// ─── v2: the bars — thresholded agents render as chips ────────
// Creator-phrased: the number shows where the number is the useful
// part (seconds, counts, coverage); quality scores keep the standard
// in words and the precise bar in the tooltip.
function barChips(f, brandName) {
  const chips = [];
  const active = (a) => {
    const v = selectLabel(f[a]);
    return v && !/^none\b/i.test(v) ? v : "";
  };
  let v;
  if ((v = active("hook_speed_threshold")))
    chips.push({ label: "Hook", value: "first " + v.toLowerCase(), tip: "Grab attention with what you say inside the first " + v.toLowerCase() + "." });
  if ((v = active("visual_hook_threshold")))
    chips.push({ label: "Scroll-stopping open", value: "", tip: "The opening frames are scored on how hard they stop the scroll. Bar: " + v + "." });
  if ((v = active("product_screen_time_threshold")))
    chips.push({ label: "Product on screen", value: v + " of the video", tip: "Keep the product clearly visible for at least " + v + " of the video." });
  if ((v = active("face_time_threshold")))
    chips.push({ label: "You on camera", value: v + " of the video", tip: "Be on camera yourself for at least " + v + " of the video." });
  if ((v = active("engagement_pacing_threshold")))
    chips.push({ label: "New scene", value: v.toLowerCase(), tip: "Change scene or angle at least " + v.toLowerCase() + "." });
  if ((v = active("cta_placement_threshold"))) {
    const low = v.toLowerCase().replace(" (no cta required)", "");
    chips.push({
      label: "Call to action",
      value: /^throughout/i.test(v) ? "throughout" : low,
      tip: /^first/i.test(v) ? "Get your ask in within the " + low + "." : /^last/i.test(v) ? "End with a clear ask in the " + low + "." : "Weave the ask through the video.",
    });
  }
  if ((v = active("brand_mention_count_threshold")) && v !== "0")
    chips.push({
      label: brandName ? "Say " + brandName : "Say the brand name",
      value: v === "1" ? "at least once" : v === "2" ? "at least twice" : "at least " + v.replace("+", "") + " times",
      tip: "Say the brand name out loud in the video.",
    });
  if ((v = active("text_legibility_threshold")))
    chips.push({ label: "Readable text", value: "", tip: "On-screen text is scored for legibility. Bar: " + v + "." });
  if ((v = active("audio_clarity_threshold")))
    chips.push({ label: "Clean audio", value: "", tip: "Audio is scored for clarity: no noise, echo, or hum. Bar: " + v + "." });
  return chips;
}
