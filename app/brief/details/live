function unwrap(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw.trim();
  if (Array.isArray(raw)) return raw.map(unwrap).filter(Boolean).join(", ");
  if (typeof raw === "object") return raw.label || raw.value || raw.name || "";
  return String(raw);
}
function selectLabel(raw) {
  if (!raw) return "";
  if (typeof raw === "string") return raw;
  if (Array.isArray(raw)) return raw.map(selectLabel).filter(Boolean).join(", ");
  return raw.label || "";
}
function selectLabels(raw) {
  if (!raw) return [];
  if (typeof raw === "string") return [raw];
  if (Array.isArray(raw)) return raw.map((x) => selectLabel(x)).filter(Boolean);
  return [raw.label || ""].filter(Boolean);
}
function asArray(raw) {
  if (Array.isArray(raw)) return raw;
  if (raw == null) return [];
  return [raw];
}
function extractThumbUrl(raw) {
  if (!raw) return null;
  if (typeof raw === "string") return raw;
  const first = Array.isArray(raw) ? raw[0] : raw;
  if (!first) return null;
  if (typeof first === "string") return first;
  return first.thumbnailUrl || first.url || null;
}
// products.image_url carries a DEFAULT VALUE (the Cloudinary product
// sample), so it is NEVER blank. Testing it for truthiness would show
// the same stock photo on every product that has no real one, and
// would bury an uploaded shot behind it. That is exactly what logo_url
// did to every workspace's real logo. Match the sample and step past
// it, on the path fragment so a Cloudinary version bump still counts.
const PRODUCT_SAMPLE_MARK = "product_sample_";
// Uploaded image, then the one derived from the website, then nothing.
// Nothing means no <img> at all: never the placeholder, never a
// mascot. A product shot is the creator's factual reference, and a
// stock picture of the wrong thing is worse than no picture, because
// they would film against it.
function resolveProductImage(image, imageUrl) {
  const uploaded = extractThumbUrl(image);          // 1. HCEi9, link expiry OFF
  if (uploaded) return uploaded;
  const derived = typeof imageUrl === "string"      // 2. wRahq, HAS A DEFAULT
    ? imageUrl.trim()
    : (extractThumbUrl(imageUrl) || "");
  if (derived && !derived.includes(PRODUCT_SAMPLE_MARK)) return derived;
  return "";                                        // 3. absent, render nothing
}
function extractJson(raw) {
  if (!raw) return null;
  const s = String(raw);
  const m = s.match(/\{[\s\S]*\}/);
  if (!m) return null;
  try { return JSON.parse(m[0]); } catch { return null; }
}
function extractBrandBio(blueprint) {
  const s = unwrap(blueprint);
  if (!s) return "";
  const m = s.match(/Brand bio:\s*([\s\S]*?)(?:\n\s*(?:CTA|Brand voice|Niche|Audience|Pain points|Target audience):|$)/i);
  return m ? m[1].trim() : s.trim();
}
// LOOKUP video fields can return either a raw URL or HTML <iframe>
// string built by a FORMULA on the linked table. Normalize into a
// playable URL string usable in <video src=…>.
function resolveLookupVideoUrl(raw) {
  if (!raw) return "";
  const first = Array.isArray(raw) ? raw[0] : raw;
  if (!first) return "";
  const s = typeof first === "string" ? first : (first.url || first.value || first.label || "");
  if (!s || typeof s !== "string") return "";
  const trimmed = s.trim();
  if (trimmed.startsWith("<")) {
    const m = trimmed.match(/src=['"]([^'"]+)['"]/i);
    return m ? m[1] : "";
  }
