// =====================================================================
// v3: in-block submission panel — replaces the old Upload tab's
// Conditional Form. Two steps (video → name + email), then
// one create on the submissions table with the same hidden writes the
// form made: submission_type "Brief", revision 0, and the accounts /
// briefs / projects links from this brief. BL | New Video picks the
// record up exactly as before.
// =====================================================================
function UploadPanel({
  open, onClose, briefId, f, briefName, submitDisabled, onInfo,
  uploadAsync, isUploading, onRun, canRun, modeLabel,
}) {
  const [step, setStep] = useState(1);
  const [video, setVideo] = useState(null); // { filename, url, size }
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [dragOver, setDragOver] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [done, setDone] = useState(false);
  const [result, setResult] = useState(null); // { subId, decision } once the engine has run
  const [error, setError] = useState("");
  const fileRef = useRef(null);

  // The overlay locks the page scroll while it's open.
  useEffect(() => {
    if (!open || typeof document === "undefined") return;
    const prev = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => { document.body.style.overflow = prev; };
  }, [open]);

  if (!open) return null;

  const reset = () => {
    setStep(1); setVideo(null); setName(""); setEmail("");
    setDone(false); setResult(null); setError("");
  };
  const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim());
  const canNext = step === 1 ? !!video && !isUploading : name.trim().length > 0 && emailOk;

  const pickFile = async (files) => {
    const file = files && files[0];
    if (!file) return;
    setError("");
    try {
      const results = await uploadAsync([file]);
      const res = Array.isArray(results) ? results[0] : results;
      if (!res || !res.url) throw new Error("The upload did not finish. Try again.");
      setVideo({ filename: file.name, url: res.url, size: file.size || 0, file });
    } catch (e) {
      setError(e?.message || "That upload did not go through. Try again.");
    }
  };

  const submit = async () => {
    if (submitDisabled || submitting) return;
    if (!canRun) {
      setError("Submissions are not available right now.");
      return;
    }
    setSubmitting(true);
    setError("");
    try {
      const r = await onRun({
        file: video?.file,
        uploaded: video ? { filename: video.filename, url: video.url } : null,
        name: name.trim(), email: email.trim(), note: "",
      });
      setResult(r);
      setDone(true);
    } catch (e) {
      setError(e?.message || "Submitting did not go through. Try again.");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="bl-up-overlay" onClick={(e) => { if (e.target === e.currentTarget && !submitting) onClose(); }}>
      <div className="bl-up-panel" role="dialog" aria-modal="true" aria-label="Submit your video">
        <header className="bl-up-head">
          <div className="bl-up-head-text">
            <span className="bl-up-eyebrow">Submit your video</span>
            <strong className="bl-up-brief">{briefName}</strong>
          </div>
          <button type="button" className="bl-up-x" onClick={onClose} aria-label="Close"><X size={18} /></button>
        </header>

        {submitDisabled && (
          <div className="bl-up-previewnote">Preview only. Submissions are turned off here.</div>
        )}

        {done ? (
          <div className="bl-up-done">
            <span className="bl-up-done-badge"><Check size={22} strokeWidth={2.5} /></span>
            <h3>Thanks for submitting!</h3>
            <p>You'll receive an email when your content has been reviewed.</p>
            <div className="bl-up-done-actions">
              {result?.subId && modeLabel !== "Manual" ? (
                <a className="bl-live-cta-primary" href={`/live/submissions?recordId=${encodeURIComponent(result.subId)}`}>See your result</a>
              ) : null}
              <button type="button" className="bl-live-cta-primary" onClick={reset}>Submit another</button>
              <button type="button" className="bl-up-ghost" onClick={() => { reset(); onClose(); }}>Done</button>
            </div>
          </div>
        ) : (
          <>
            <div className="bl-up-progress">
              {[1, 2].map((n) => (
                <span key={n} className={`bl-up-dot ${step >= n ? "is-on" : ""}`} />
              ))}
              <span className="bl-up-progress-label">Step {step} of 2</span>
            </div>

            {step === 1 && (
              <div className="bl-up-step">
                <label className="bl-up-label">Upload your video</label>
                <p className="bl-up-caption">One video file max.</p>
                {video ? (
                  <div className="bl-up-file">
                    <Check size={15} />
                    <span className="bl-up-file-name">{video.filename}</span>
                    {video.size > 0 && (
                      <span className="bl-up-file-size">{(video.size / (1024 * 1024)).toFixed(1)} MB</span>
                    )}
                    <button type="button" className="bl-up-ghost" onClick={() => setVideo(null)}>Swap</button>
                  </div>
                ) : (
                  <div
                    className={`bl-up-drop ${dragOver ? "is-over" : ""} ${isUploading ? "is-busy" : ""}`}
                    onClick={() => fileRef.current && fileRef.current.click()}
                    onDragOver={(e) => { e.preventDefault(); setDragOver(true); }}
                    onDragLeave={() => setDragOver(false)}
                    onDrop={(e) => { e.preventDefault(); setDragOver(false); pickFile(e.dataTransfer.files); }}
                  >
                    <Upload size={22} />
                    {isUploading
                      ? <span>Uploading your video…</span>
                      : <span><b>Drag and drop your video</b> or tap to browse. MP4, MOV, JPG, PNG.</span>}
                  </div>
                )}
                <input
                  ref={fileRef}
                  type="file"
                  accept="video/mp4,video/quicktime,image/jpeg,image/png"
                  style={{ display: "none" }}
                  onChange={(e) => { pickFile(e.target.files); e.target.value = ""; }}
                />
                <button type="button" className="bl-live-info-link" onClick={onInfo}>
                  <HelpCircle size={13} /> How reviews work
                </button>
              </div>
            )}

            {step === 2 && (
              <div className="bl-up-step">
                <label className="bl-up-label" htmlFor="bl-up-name">Your name</label>
                <input
                  id="bl-up-name" className="bl-up-input" type="text" placeholder="Full name"
                  value={name} onChange={(e) => setName(e.target.value)}
                />
                <label className="bl-up-label" htmlFor="bl-up-email">Email</label>
                <input
                  id="bl-up-email" className="bl-up-input" type="email" placeholder="your@email.com"
                  value={email} onChange={(e) => setEmail(e.target.value)}
                />
                <p className="bl-up-caption">Your review lands in this inbox.</p>
              </div>
            )}

            {error && <p className="bl-up-error">{error}</p>}

            {submitting && (
              <div className="bl-up-reviewing" role="status">
                <span className="bl-up-bar"><i /></span>
                <span>Reviewing your video, usually under 2 minutes. Keep this tab open.</span>
              </div>
            )}

            <footer className="bl-up-foot">
              {step > 1 ? (
                <button type="button" className="bl-up-ghost" onClick={() => setStep(step - 1)} disabled={submitting}>
                  <ChevronLeft size={15} /> Back
                </button>
              ) : <span />}
              {step < 2 ? (
                <button type="button" className="bl-live-cta-primary" onClick={() => setStep(step + 1)} disabled={!canNext}>
                  Next
                </button>
              ) : (
                <button
                  type="button"
                  className="bl-live-cta-primary"
                  onClick={submit}
                  disabled={submitting || submitDisabled || !video || !name.trim() || !emailOk}
                >
                  <Sparkles size={15} />
                  {submitting ? "Reviewing…" : "Submit video"}
                </button>
              )}
            </footer>
          </>
        )}
      </div>
    </div>
  );
}

