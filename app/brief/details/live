        border: 1px solid ${TINT_BORDER};
      }
      .bl-live-hero-left { display: flex; flex-direction: column; gap: 14px; }

      /* Brand line — "[logo] The {Brand} brief" sits above the title */
      .bl-live-brand-line {
        display: inline-flex; align-items: center; gap: 10px;
        align-self: flex-start;
      }
      .bl-live-brand-logo {
        /* No background / border / padding so the brand's logo
           displays exactly as designed — square OR rectangle, with
           transparent edges intact. Height-locked, width auto. */
        height: 44px;
        width: auto;
        max-width: 180px;
        object-fit: contain;
        display: block;
      }
      .bl-live-brand-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 13px; font-weight: 600;
        color: ${NAVY_DEEP};
        letter-spacing: -0.005em;
      }
      .bl-live-format-pill {
        display: inline-flex; align-items: center;
        padding: 2px 9px;
        background: ${TAG_BG};
        color: ${PERIWINKLE_HOVER};
        border-radius: 999px;
        font-size: 10px; font-weight: 500;
        letter-spacing: 0.04em; text-transform: uppercase;
      }

      .bl-live-title {
        font-size: clamp(24px, 2.4vw, 30px); font-weight: 600; color: ${NAVY_DEEP};
        margin: 0; letter-spacing: -0.02em; line-height: 1.15;
        text-wrap: pretty;
      }
      .bl-live-summary {
        font-size: 15px; line-height: 1.5; color: ${NAVY_DEEP}; margin: 0;
      }
      .bl-live-brand-bio {
        background: rgba(255,255,255,0.55);
        border: 1px solid ${TINT_BORDER};
        border-radius: 12px;
        padding: 14px 16px;
        display: flex; flex-direction: column; gap: 6px;
      }
      .bl-live-brand-bio-label {
        font-size: 10px; font-weight: 600; color: ${MUTED};
        text-transform: uppercase; letter-spacing: 0.06em;
      }
      .bl-live-brand-bio p {
        font-size: 13px; line-height: 1.55; color: ${MUTED};
        margin: 0;
      }
      .bl-live-cta-primary {
        display: inline-flex; align-items: center; gap: 8px;
        align-self: flex-start;
        height: 46px; padding: 0 24px;
        background: ${NAVY_DEEP};
        color: #FFFFFF;
        border: none; border-radius: 13px;
        font-size: 14.5px; font-weight: 700;
        cursor: pointer;
        transition: background 0.16s ease, transform 0.16s ease;
      }
      .bl-live-cta-primary:hover:not(:disabled) {
        background: ${PERIWINKLE_HOVER};
        transform: translateY(-1px);
      }
      .bl-live-cta-primary:disabled { opacity: 0.55; cursor: not-allowed; }
      .bl-live-cta-large { height: 52px; padding: 0 28px; font-size: 15px; }
      .bl-live-hero-right { position: relative; }
      .bl-live-hero-image {
        width: 100%; aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 18px;
        background: ${TAG_BG};
      }
      .bl-live-hero-image--mark { object-fit: contain; padding: 24%; box-sizing: border-box; }

      /* Closed-state banner — full-width pill at the very top */
      .bl-live-closed-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 20px;
        background: rgba(217, 38, 38, 0.08);
        border: 1px solid rgba(217, 38, 38, 0.45);
        border-radius: 14px;
      }
      .bl-live-closed-banner-text {
        display: flex; flex-direction: column; gap: 2px;
        font-size: 13px; color: ${NAVY_DEEP}; line-height: 1.45;
      }
      .bl-live-closed-banner-text strong {
        font-size: 14px; font-weight: 600; color: #d92626;
      }

      /* Specs — two compact rows, production then timing */
      .bl-live-specs {
        background: ${CARD_BG};
        border: 1px solid ${TINT_BORDER};
        border-radius: 18px;
        padding: 12px;
        display: flex; flex-direction: column; gap: 8px;
      }
      .bl-live-spec-row {
        display: flex; flex-wrap: wrap;
        gap: 8px;
      }
      .bl-live-spec-row-timing {
        padding-top: 8px;
        border-top: 1px solid ${BORDER};
      }
      .bl-live-spec {
        flex: 1 1 auto;
        min-width: 140px;
        display: flex; align-items: center; gap: 8px;
        padding: 8px 12px;
        border-radius: 10px;
        background: ${TINT_BG};
      }
      .bl-live-spec-icon {
        flex: 0 0 24px;
        width: 24px; height: 24px;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 7px;
        display: inline-flex; align-items: center; justify-content: center;
        color: ${PERIWINKLE_HOVER};
      }
      .bl-live-spec-text {
        flex: 1 1 auto;
        display: flex; flex-direction: column; line-height: 1.2;
        min-width: 0;
      }
      .bl-live-spec-label {
        font-size: 9px; font-weight: 600; color: ${MUTED};
        text-transform: uppercase; letter-spacing: 0.06em;
      }
      .bl-live-spec-value {
        font-size: 12px; font-weight: 500; color: ${NAVY_DEEP};
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .bl-live-spec-chip {
        flex: 0 0 auto;
        display: inline-flex;
      }

      /* Bento grid */
      .bl-live-bento {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }
      .bl-live-bento-wide { grid-column: span 2; }
      .bl-live-bento-full { grid-column: span 3; }
      /* Section cards float on the aurora as glass. Hairline dividers do
         the separating, so these carry no heavy shadow of their own. */
      .bl-live-bento-card {
        border-radius: 18px;
        padding: 20px 22px;
        background: ${CARD_BG};
        border: 1px solid ${TINT_BORDER};
      }
      .bl-live-bento-head {
        display: flex; align-items: center; gap: 10px;
        width: 100%;
        background: transparent; border: none;
        cursor: pointer; text-align: left; padding: 0;
        margin-bottom: 10px;
      }
      /* Section headings carry no icon. The brand mark in the hero is the
         one mark on this screen zone. */
      .bl-live-bento-title {
        flex: 1 1 auto;
        font-size: 15px; font-weight: 600;
        letter-spacing: -0.01em;
        color: ${NAVY_DEEP}; margin: 0;
        display: inline-flex; align-items: center; gap: 6px;
      }
      .bl-live-bento-body { font-size: 13px; line-height: 1.55; color: ${NAVY_DEEP}; }
      .bl-live-list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; }
      .bl-live-list li { line-height: 1.5; }
      .bl-live-script {
        margin: 0;
        white-space: pre-wrap;
        font-family: inherit;
        font-size: 13px;
        line-height: 1.6;
        color: ${NAVY_DEEP};
      }
      .bl-live-copy-btn {
        margin-top: 10px;
        display: inline-flex; align-items: center; gap: 6px;
        height: 32px; padding: 0 12px;
        background: #FFFFFF; color: ${NAVY_DEEP};
        border: 1px solid ${BORDER}; border-radius: 8px;
        font-size: 12px; font-weight: 500; cursor: pointer;
      }
      .bl-live-copy-btn:hover { border-color: ${PERIWINKLE}; }

      /* Tooltip */
      .bl-live-tooltip { position: relative; display: inline-flex; }
      .bl-live-tooltip-i {
        width: 14px; height: 14px;
        background: ${MUTED}; color: #FFFFFF;
        border-radius: 999px;
        font-size: 9px; font-weight: 600;
        display: inline-flex; align-items: center; justify-content: center;
        cursor: help;
      }
      .bl-live-tooltip-text {
        position: absolute; bottom: 100%; left: 50%;
        transform: translateX(-50%) translateY(-6px);
        background: ${NAVY_DEEP}; color: #FFFFFF;
        font-size: 11px; font-weight: 400; line-height: 1.4;
        padding: 6px 10px; border-radius: 8px;
        white-space: normal; width: 220px;
        opacity: 0; visibility: hidden; pointer-events: none;
        z-index: 100;
      }
      .bl-live-tooltip:hover .bl-live-tooltip-text {
        opacity: 1; visibility: visible;
      }

      /* Storyboard */
      .bl-live-storyboard { display: flex; flex-direction: column; }
      .bl-live-storyboard-head,
      .bl-live-storyboard-row {
        display: grid;
        grid-template-columns: 60px 140px 1.2fr 1fr;
        gap: 10px;
        padding: 10px 6px;
      }
      .bl-live-storyboard-head {
        font-size: 10px; font-weight: 600; color: ${MUTED};
        text-transform: uppercase; letter-spacing: 0.06em;
        border-bottom: 1px solid ${BORDER};
      }
      .bl-live-storyboard-row {
        border-bottom: 1px solid ${BORDER};
        font-size: 13px; color: ${NAVY_DEEP};
        align-items: start;
      }
      .bl-live-storyboard-row:last-child { border-bottom: none; }
      .bl-live-storyboard-num {
        font-weight: 600; color: ${MUTED};
      }
      .bl-live-storyboard-tag {
        display: inline-flex; align-items: center;
        padding: 3px 10px;
        background: rgba(135,156,247,0.20);
        color: ${NAVY_DEEP};
        border-radius: 999px;
        font-size: 11px; font-weight: 500;
        white-space: nowrap;
      }

      /* Inspiration grid */
      .bl-live-inspo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
      }
      .bl-live-video {
        position: relative;
        background: #000;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid ${BORDER};
        width: 100%;
      }
      .bl-live-video-vertical { aspect-ratio: 9 / 16; }
      .bl-live-video-horizontal { aspect-ratio: 16 / 9; }
      .bl-live-video iframe,
      .bl-live-video video {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
        border: none; background: #000;
        display: block;
      }
      .bl-live-inspo-empty {
        aspect-ratio: 9 / 16;
        display: flex; align-items: center; justify-content: center;
        background: ${TAG_BG};
        border: 1px dashed ${BORDER};
        border-radius: 12px;
        font-size: 12px; color: ${MUTED};
      }
      .bl-live-video-link {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 12px; color: ${PERIWINKLE_HOVER}; text-decoration: none;
        padding: 12px;
        background: ${TAG_BG};
        border-radius: 10px;
      }
      .bl-live-empty {
        font-size: 13px; color: ${MUTED};
        margin: 0; text-align: center;
      }

      /* PDF wrap */
      .bl-live-pdf-wrap {
        width: 100%;
        height: 600px;
        border-radius: 12px;
        overflow: hidden;
        background: ${SURFACE};
        border: 1px solid ${BORDER};
      }
      .bl-live-pdf-wrap iframe {
        width: 100%; height: 100%; border: none; display: block;
      }
      .bl-live-pdf-open {
        display: inline-flex; align-items: center; gap: 4px;
        margin-top: 8px;
        font-size: 11px; color: ${PERIWINKLE_HOVER}; text-decoration: none;
      }

      /* Live countdown chip — sits to the right of the Closes spec only
         when the brief is still open. Smaller and cleaner now that the
         closed-state has its own banner up top. */
      .bl-live-countdown {
        display: inline-flex; align-items: center;
        padding: 3px 9px;
        background: ${PERIWINKLE};
        color: #FFFFFF;
        border-radius: 999px;
        font-size: 10px; font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }
      .bl-live-countdown.is-urgent { background: #E07A2F; }
      .bl-live-countdown.is-closed { background: #d92626; }

      /* Review Agents grid */
      .bl-live-agents {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 10px;
      }
      .bl-live-agent {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 12px;
        background: rgba(255,255,255,0.55);
        border: 1px solid ${BORDER};
        border-radius: 12px;
      }
      .bl-live-agent-icon {
        width: 32px; height: 32px;
        flex-shrink: 0; object-fit: contain;
        filter: drop-shadow(0 4px 8px rgba(135, 156, 247, 0.25));
      }
      .bl-live-agent-text {
        display: flex; flex-direction: column; gap: 2px; min-width: 0;
      }
      .bl-live-agent-name {
        font-size: 13px; font-weight: 600; color: ${NAVY_DEEP};
      }
      .bl-live-agent-desc {
        font-size: 11px; line-height: 1.4; color: ${MUTED};
      }

      /* Thresholds (below the agents) */
      .bl-live-thresholds {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid ${BORDER};
      }
      .bl-live-thresholds-title {
        font-size: 11px; font-weight: 600; color: ${MUTED};
        text-transform: uppercase; letter-spacing: 0.06em;
        margin-bottom: 10px;
      }
      .bl-live-thresholds-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 8px;
      }
      .bl-live-threshold {
        display: flex; justify-content: space-between; align-items: center; gap: 10px;
        padding: 8px 12px;
        background: rgba(255,255,255,0.55);
        border: 1px solid ${BORDER};
        border-radius: 10px;
      }
      .bl-live-threshold-label {
        font-size: 12px; color: ${NAVY_DEEP};
      }
      .bl-live-threshold-value {
        font-size: 12px; font-weight: 600;
        color: ${PERIWINKLE_HOVER};
        white-space: nowrap;
      }

      /* Inspiration cards — now clickable when they're linked records */
      .bl-live-inspo-card {
        display: flex; flex-direction: column; gap: 8px;
      }
      .bl-live-inspo-cardname {
        display: inline-flex; align-items: center; justify-content: space-between; gap: 6px;
        width: 100%;
        padding: 8px 12px;
        background: rgba(255,255,255,0.55);
        border: 1px solid ${BORDER};
        border-radius: 10px;
        font-size: 12px; font-weight: 500; color: ${NAVY_DEEP};
        text-align: left;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .bl-live-inspo-cardname:hover {
        border-color: ${PERIWINKLE};
        color: ${PERIWINKLE_HOVER};
        background: ${TINT_BG};
      }
      .bl-live-inspo-cardname.is-static {
        cursor: default;
      }
      .bl-live-inspo-cardname-label {
        flex: 1 1 auto; min-width: 0;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }

      /* Footer CTA */
      .bl-live-footer {
        display: flex; flex-direction: column; gap: 14px; align-items: center;
      }
      .bl-live-footer-card {
        width: 100%;
        background: ${CARD_BG};
        border: 1px solid ${TINT_BORDER};
        color: ${NAVY_DEEP};
        border-radius: 18px;
        padding: 26px 28px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px; align-items: center;
      }
      .bl-live-footer-card.is-closed .bl-live-cta-primary {
        background: ${MUTED}; color: #FFFFFF; opacity: 0.6;
        cursor: not-allowed;
      }
      .bl-live-footer-text h3 {
        font-size: 17px; font-weight: 600; margin: 0 0 6px;
        letter-spacing: -0.01em;
      }
      .bl-live-footer-text p {
        font-size: 13px; line-height: 1.5; margin: 0;
        color: ${MUTED};
      }
      .bl-live-footer-card .bl-live-cta-primary:hover:not(:disabled) {
        background: #F7F9FF; color: ${PERIWINKLE_HOVER};
      }
      .bl-live-footer-stamp {
        display: inline-flex; align-items: center; gap: 6px;
        margin-top: 6px;
        font-size: 11px; color: ${MUTED};
      }
      .bl-live-footer-stamp img {
        height: 18px;
        width: auto;
      }

      /* ── v2: rich-text section bodies ─────────────────────── */
      .bl-live-html { font-size: 15px; line-height: 1.7; color: ${NAVY_DEEP}; }
      .bl-live-html p { margin: 0 0 12px; }
      .bl-live-html p:last-child { margin-bottom: 0; }
      .bl-live-html ul, .bl-live-html ol { margin: 0 0 12px; padding-left: 22px; }
      .bl-live-html ul { list-style: disc outside; }
      .bl-live-html ol { list-style: decimal outside; }
      .bl-live-html li { margin: 5px 0; line-height: 1.65; display: list-item; }
      .bl-live-html li::marker { color: ${PERIWINKLE_HOVER}; }
      .bl-live-html b, .bl-live-html strong { color: ${NAVY_DEEP}; font-weight: 700; }
      .bl-live-html h3, .bl-live-html h4 { margin: 0 0 10px; font-size: 15px; font-weight: 700; color: ${NAVY_DEEP}; }
      .bl-live-html blockquote { margin: 0 0 12px; padding: 4px 0 4px 14px; border-left: 3px solid ${PERIWINKLE}; font-style: italic; }
      .bl-live-html table { width: 100%; border-collapse: collapse; margin: 0 0 12px; font-size: 13.5px; }
      .bl-live-html th, .bl-live-html td { border: 1px solid ${BORDER}; padding: 7px 9px; text-align: left; vertical-align: top; }
      .bl-live-html th { background: ${TINT_BG}; font-weight: 700; color: ${NAVY_DEEP}; }
      .bl-live-html a { color: ${PERIWINKLE_HOVER}; }

      /* ── v2: part labels + blocks ─────────────────────────── */
      .bl-live-partblock { margin-bottom: 16px; }
      .bl-live-partblock:last-child { margin-bottom: 0; }
      .bl-live-part-label {
        font-size: 10.5px; font-weight: 600; letter-spacing: 0.09em;
        text-transform: uppercase; color: ${PERIWINKLE_HOVER};
        margin: 0 0 8px;
      }
      .bl-live-part-head {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 13px; font-weight: 600; color: ${NAVY_DEEP};
        margin: 0 0 10px;
      }
      .bl-live-part-head img { width: 18px; height: 18px; object-fit: contain; }
      .bl-live-datechips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }

      /* ── v2: the bars (thresholded agents as chips) ───────── */
      .bl-live-barwrap { margin-bottom: 18px; }
      .bl-live-barchips { display: flex; flex-wrap: wrap; gap: 8px; }
      .bl-live-barchip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 999px;
        background: ${TAG_BG}; border: 1px solid ${TINT_BORDER};
        font-size: 12.5px; font-weight: 500; color: ${NAVY_DEEP};
      }
      .bl-live-barchip b { color: ${PERIWINKLE_HOVER}; font-weight: 700; }

      /* ── v3: product shot ─────────────────────────────────── */
      .bl-live-product-row {
        display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 20px;
        align-items: start;
      }
      /* No copy in the card. A 220px track beside an empty one reads
         as broken, so the shot takes the row and stays sane at width. */
      .bl-live-product-row.is-solo { grid-template-columns: minmax(0, 320px); }
      .bl-live-product-copy { min-width: 0; }
      .bl-live-product-shot img {
        display: block;
        width: 100%; aspect-ratio: 1 / 1;
        object-fit: contain;
        border-radius: 18px;
        background: ${TAG_BG};
      }

      /* ── v2: Do / Don't pair ──────────────────────────────── */
      .bl-live-ddpair {
        display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
      }
      .bl-live-ddcard {
        background: rgba(255,255,255,0.55);
        border: 1px solid ${BORDER};
        border-radius: 18px;
        padding: 18px 20px;
      }

      /* ── v2: hook columns ─────────────────────────────────── */
      .bl-live-hook-grid {
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px;
      }

      /* ── v3: one card per line (hooks, talking points) ────── */
      .bl-live-linecards { display: flex; flex-direction: column; gap: 10px; }
      .bl-live-linecards.is-grid {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;
      }
      .bl-live-linecard {
        background: rgba(255,255,255,0.55);
        border: 1px solid ${BORDER};
        border-radius: 14px;
        padding: 14px 18px;
        font-size: 14px; line-height: 1.5; color: ${NAVY_DEEP};
        box-shadow: 0 1px 2px rgba(0, 19, 100, 0.04);
        transition: border-color 0.12s, box-shadow 0.12s;
      }
      .bl-live-linecard:hover {
        border-color: ${PERIWINKLE};
        box-shadow: 0 4px 14px rgba(0, 19, 100, 0.06);
      }

      /* ── v2: "On this page" chip nav ──────────────────────── */
      .bl-live-nav {
        display: flex; flex-wrap: wrap; gap: 8px;
      }
      .bl-live-nav button {
        padding: 8px 14px;
        background: ${TINT_BG};
        border: 1px solid ${TINT_BORDER};
        border-radius: 999px;
        font-size: 12.5px; font-weight: 400; color: ${NAVY_DEEP};
        cursor: pointer; font-family: inherit;
        transition: background 0.14s, color 0.14s;
      }
      .bl-live-nav button:hover { background: #FFFFFF; border-color: ${PERIWINKLE}; color: ${PERIWINKLE_HOVER}; }

      /* ── v2: soft review line ─────────────────────────────── */
      .bl-live-soft { font-size: 12px; color: ${MUTED}; margin: -4px 0 0; }

      /* ── v2: sticky submit bar (phones only) ──────────────── */
      .bl-live-sticky {
        display: none;
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
        align-items: center; gap: 12px;
        padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
        background: rgba(255, 255, 255, 0.96);
        border-top: 1px solid ${BORDER};
        backdrop-filter: blur(8px);
      }
      .bl-live-sticky-name {
        flex: 1 1 auto; min-width: 0;
        font-size: 13px; font-weight: 600; color: ${NAVY_DEEP};
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }

      /* ── v2: preview frame ────────────────────────────────── */
      .bl-live-previewbar {
        position: sticky; top: 0; z-index: 60;
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        margin: -32px 0 20px;
        padding: 10px 18px;
        background: ${NAVY_DEEP}; color: #FFFFFF;
      }
      .bl-live-previewbar-label { font-size: 12.5px; font-weight: 500; }
      .bl-live-previewbar-toggle {
        display: inline-flex; padding: 2px; gap: 2px;
        background: rgba(255, 255, 255, 0.12); border-radius: 999px;
      }
      .bl-live-previewbar-toggle button {
        padding: 5px 14px; border: none; border-radius: 999px;
        background: transparent; color: #FFFFFF;
        font-size: 12px; font-weight: 500; cursor: pointer; font-family: inherit;
      }
      .bl-live-previewbar-toggle button.is-on { background: #FFFFFF; color: ${NAVY_DEEP}; }
      /* Studio-style device toggle: the same page, just at phone
         width — a plain narrowed canvas, no device chrome. */
      .bl-live-phone-stage {
        display: flex; justify-content: center; padding: 20px 16px 40px;
      }
      .bl-live-phone {
        width: 390px; max-width: 100%;
        height: calc(100vh - 140px); min-height: 560px;
        border: 1px solid ${BORDER}; border-radius: 8px;
        overflow: hidden; background: #FFFFFF;
      }
      .bl-live-phone iframe { width: 100%; height: 100%; border: none; display: block; }

      /* ── v3: back to the brand's public brief index ───────── */
      .bl-live-back {
        display: inline-flex; align-items: center; gap: 6px;
        /* .bl-live-inner is a flex column with a 24px gap, so spacing
           below comes from the gap. No margin, or it doubles up. */
        align-self: flex-start;
        padding: 7px 14px 7px 11px;
        border: 1px solid ${BORDER}; border-radius: 999px;
        background: #FFFFFF;
        font-size: 12.5px; font-weight: 500; color: ${NAVY_DEEP};
        text-decoration: none; white-space: nowrap;
        transition: border-color 0.12s, color 0.12s;
      }
      .bl-live-back:hover { border-color: ${PERIWINKLE}; color: ${PERIWINKLE_HOVER}; }

      /* ── v3: how-reviews-work link ────────────────────────── */
      .bl-live-info-link {
        display: inline-flex; align-items: center; gap: 5px;
        border: none; background: none; padding: 0; margin: 0;
        color: ${MUTED}; font-size: 12px; font-weight: 500;
        cursor: pointer; font-family: inherit;
        align-self: flex-start;
      }
      .bl-live-info-link:hover { color: ${PERIWINKLE_HOVER}; }

      /* ── v3: submission panel ─────────────────────────────── */
      /* Softr's own modals dim with neutral black at 60%. Matching it
         stops this panel reading as a different app. */
      .bl-up-overlay {
        position: fixed; inset: 0; z-index: 900;
        background: rgba(0, 0, 0, 0.6);
        display: flex; align-items: center; justify-content: center;
        padding: 20px;
      }
      /* Same panel the upload page uses, so a creator recognises it
         whichever link they arrived on. */
      .bl-up-panel {
        width: 560px; max-width: 100%; max-height: calc(100vh - 40px);
        overflow-y: auto;
        border-radius: 26px;
        padding: 26px;
        background: ${CARD_BG};
        border: 1px solid ${BORDER};
        box-shadow: 0 30px 60px -30px rgba(0,19,100,0.35);
        display: flex; flex-direction: column; gap: 14px;
      }
      .bl-up-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
      .bl-up-head-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .bl-up-eyebrow {
        font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
        text-transform: uppercase; color: ${PERIWINKLE_HOVER};
      }
      .bl-up-brief {
        font-size: 16px; font-weight: 600; color: ${NAVY_DEEP};
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .bl-up-x {
        flex: 0 0 auto; width: 32px; height: 32px;
        border: 1px solid ${BORDER}; border-radius: 10px;
        background: #FFFFFF; color: ${MUTED};
        display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; transition: color 0.12s, border-color 0.12s;
      }
      .bl-up-x:hover { color: ${NAVY_DEEP}; border-color: ${PERIWINKLE}; }
      .bl-up-previewnote {
        padding: 8px 12px; background: ${TAG_BG}; border-radius: 10px;
        font-size: 12px; font-weight: 500; color: ${PERIWINKLE_HOVER};
      }
      .bl-up-progress { display: flex; align-items: center; gap: 6px; }
      .bl-up-dot {
        width: 22px; height: 4px; border-radius: 999px;
        background: rgba(217, 224, 255, 0.8);
      }
      .bl-up-dot.is-on { background: ${PERIWINKLE}; }
      .bl-up-progress-label { margin-left: 6px; font-size: 11px; color: ${MUTED}; }
      .bl-up-step { display: flex; flex-direction: column; gap: 8px; }
      .bl-up-label { font-size: 13px; font-weight: 600; color: ${NAVY_DEEP}; }
      .bl-up-caption { font-size: 11.5px; color: ${MUTED}; margin: -4px 0 0; }
      .bl-up-drop {
        border: 1.5px dashed rgba(135, 156, 247, 0.5); border-radius: 20px;
        background: rgba(255, 255, 255, 0.66);
        padding: 34px 20px; text-align: center; cursor: pointer;
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        color: #5A6790; font-size: 13px; line-height: 1.5;
        transition: background 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
      }
      .bl-up-drop:hover { border-color: #879CF7; background: rgba(255,255,255,0.9); transform: translateY(-1px); }
      .bl-up-drop b { color: #001364; font-weight: 700; }
      .bl-up-drop.is-over { border-color: #879CF7; background: rgba(255,255,255,0.9); }
      .bl-up-drop.is-busy { opacity: 0.6; pointer-events: none; }
      .bl-up-drop svg { color: ${PERIWINKLE_HOVER}; }
      .bl-up-file {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 14px; border: 1px solid ${BORDER}; border-radius: 12px;
        font-size: 13px; color: ${NAVY_DEEP};
      }
      .bl-up-file svg { color: #2DAA63; flex: 0 0 auto; }
      .bl-up-file-name {
        flex: 1 1 auto; min-width: 0; font-weight: 500;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .bl-up-file-size { font-size: 11.5px; color: ${MUTED}; }
      .bl-up-input {
        width: 100%; box-sizing: border-box;
        padding: 10px 14px; border: 1px solid ${BORDER}; border-radius: 12px;
        font-size: 14px; color: ${NAVY_DEEP}; background: #FFFFFF;
        font-family: inherit; outline: none;
        transition: border-color 0.12s;
      }
      .bl-up-input:focus { border-color: ${PERIWINKLE}; }
      .bl-up-textarea { resize: vertical; min-height: 96px; line-height: 1.5; }
      .bl-up-reviewing { display: flex; flex-direction: column; gap: 8px; margin: 12px 0 4px; font-size: 13px; color: #64708C; }
      .bl-up-bar { display: block; height: 5px; border-radius: 99px; background: rgba(0,19,100,0.06); overflow: hidden; }
      .bl-up-bar i { display: block; height: 100%; width: 40%; background: #879CF7; border-radius: 99px; animation: blUpSlide 1.4s ease-in-out infinite; }
      @keyframes blUpSlide { from { transform: translateX(-100%); } to { transform: translateX(260%); } }
      .bl-up-error { margin: 0; font-size: 12.5px; color: #d92626; }
      .bl-up-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .bl-up-ghost {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 9px 14px; border: 1px solid ${BORDER}; border-radius: 999px;
        background: #FFFFFF; color: ${NAVY_DEEP};
        font-size: 13px; font-weight: 500; cursor: pointer; font-family: inherit;
        transition: border-color 0.12s;
      }
      .bl-up-ghost:hover { border-color: ${PERIWINKLE}; }
      .bl-up-done {
        display: flex; flex-direction: column; align-items: center;
        text-align: center; gap: 8px; padding: 18px 0 10px;
      }
      .bl-up-done-badge {
        width: 46px; height: 46px; border-radius: 999px;
        background: #2DAA63; color: #FFFFFF;
        display: inline-flex; align-items: center; justify-content: center;
      }
      .bl-up-done h3 { margin: 4px 0 0; font-size: 20px; font-weight: 600; color: ${NAVY_DEEP}; }
      .bl-up-done p { margin: 0; font-size: 13.5px; color: ${MUTED}; }
      .bl-up-done-actions { display: flex; gap: 10px; margin-top: 10px; }

      /* ── v3: how-reviews-work modal ───────────────────────── */
      .bl-info-overlay {
        position: fixed; inset: 0; z-index: 900;
        background: rgba(0, 0, 0, 0.6);
        display: flex; align-items: center; justify-content: center;
        padding: 20px;
      }
      .bl-info-modal {
        width: 640px; max-width: 100%; max-height: calc(100vh - 40px);
        background: ${CARD_BG}; border: 1px solid ${BORDER}; border-radius: 20px;
        display: flex; flex-direction: column; overflow: hidden;
      }
      .bl-info-head {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 18px 24px 12px;
      }
      .bl-info-head h3 { margin: 0; font-size: 18px; font-weight: 600; color: ${NAVY_DEEP}; }
      .bl-info-body {
        overflow-y: auto; padding: 0 24px 24px;
        display: flex; flex-direction: column; gap: 12px;
      }
      .bl-info-lede { margin: 0; font-size: 13.5px; line-height: 1.55; color: ${MUTED}; }
      .bl-info-mode {
        margin: 0; padding: 10px 14px; background: ${TAG_BG}; border-radius: 12px;
        font-size: 13px; line-height: 1.5; color: ${NAVY_DEEP}; font-weight: 500;
      }
      .bl-info-body h4 {
        margin: 8px 0 0; display: flex; align-items: center; gap: 6px;
        font-size: 14px; font-weight: 600; color: ${NAVY_DEEP};
      }
      .bl-info-body h4 svg { color: ${PERIWINKLE_HOVER}; }
      .bl-info-body > p { margin: 0; font-size: 13px; line-height: 1.55; color: ${MUTED}; }
      .bl-info-steps { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .bl-info-step {
        border: 1px solid ${BORDER}; border-radius: 14px; padding: 14px;
        display: flex; flex-direction: column; gap: 6px;
      }
      .bl-info-step img { width: 34px; height: 34px; object-fit: contain; }
      .bl-info-step svg { color: ${PERIWINKLE_HOVER}; }
      .bl-info-step strong { font-size: 13.5px; color: ${NAVY_DEEP}; }
      .bl-info-step p { margin: 0; font-size: 12.5px; line-height: 1.5; color: ${MUTED}; }
      .bl-info-outcome {
        display: flex; gap: 10px; align-items: flex-start;
        border: 1px solid ${BORDER}; border-radius: 14px; padding: 12px 14px;
      }
      .bl-info-outcome.is-approved { border-left: 4px solid #2DAA63; }
      .bl-info-outcome.is-flagged  { border-left: 4px solid #E07A2F; }
      .bl-info-outcome.is-rejected { border-left: 4px solid #d92626; }
      .bl-info-badge {
        flex: 0 0 28px; width: 28px; height: 28px; border-radius: 9px;
        color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center;
      }
      .is-approved .bl-info-badge { background: #2DAA63; }
      .is-flagged  .bl-info-badge { background: #E07A2F; }
      .is-rejected .bl-info-badge { background: #d92626; }
      .bl-info-outcome strong { font-size: 13.5px; color: ${NAVY_DEEP}; display: block; margin-bottom: 2px; }
      .bl-info-outcome p { margin: 0; font-size: 12.5px; line-height: 1.5; color: ${MUTED}; }
      .bl-info-tips {
        margin: 0; padding-left: 18px;
        display: flex; flex-direction: column; gap: 6px;
        font-size: 13px; line-height: 1.5; color: ${NAVY_DEEP};
      }
      .bl-info-tips li::marker { color: ${PERIWINKLE_HOVER}; font-weight: 600; }
      .bl-info-help {
        display: flex; gap: 10px; align-items: flex-start;
        background: ${PERIWINKLE};
        color: #FFFFFF; border-radius: 14px; padding: 14px 16px;
      }
      .bl-info-help svg { flex: 0 0 20px; margin-top: 1px; }
      .bl-info-help p { margin: 0; font-size: 12.5px; line-height: 1.55; }

      /* Responsive */
      @media (max-width: 880px) {
        .bl-live-hero { grid-template-columns: 1fr; }
        .bl-live-hero-image { aspect-ratio: 4 / 3; }
        .bl-live-bento { grid-template-columns: 1fr; }
        .bl-live-bento-wide,
        .bl-live-bento-full { grid-column: span 1; }
        .bl-live-storyboard-head { display: none; }
        .bl-live-storyboard-row {
          grid-template-columns: 1fr;
          gap: 4px;
        }
        .bl-live-footer-card {
          grid-template-columns: 1fr;
          text-align: center;
        }
        .bl-live-footer-card .bl-live-cta-primary { justify-self: center; }
        .bl-live-title { font-size: 26px; }
        .bl-live-pdf-wrap { height: 400px; }
        /* v2 mobile layer. Softr renders the page header as a fixed
           57px bottom nav on phones (z-index 800) — the submit bar
           stacks directly above it, never under or over it. */
        .bl-live { padding-bottom: 150px; }
        .bl-live-sticky { display: flex; bottom: 57px; z-index: 790; padding: 10px 16px; }
        .bl-live-ddpair { grid-template-columns: 1fr; }
        .bl-live-product-row,
        .bl-live-product-row.is-solo { grid-template-columns: 1fr; }
        .bl-live-product-shot img { aspect-ratio: 4 / 3; }
        .bl-live-hook-grid { grid-template-columns: 1fr; }
        .bl-live-linecards.is-grid { grid-template-columns: 1fr; }
        .bl-live-nav {
          flex-wrap: nowrap; overflow-x: auto;
          scrollbar-width: none; -webkit-overflow-scrolling: touch;
          margin: 0 -16px; padding: 0 16px;
        }
        .bl-live-nav::-webkit-scrollbar { display: none; }
        .bl-live-nav button { flex: 0 0 auto; }
        .bl-live-inspo-grid {
          display: flex; overflow-x: auto;
          scroll-snap-type: x mandatory;
          scrollbar-width: none; -webkit-overflow-scrolling: touch;
          gap: 12px;
        }
        .bl-live-inspo-grid::-webkit-scrollbar { display: none; }
        .bl-live-inspo-card { flex: 0 0 74%; scroll-snap-align: start; }
        .bl-live-html { font-size: 16px; }
        /* v3: panel + modal go full-screen on phones */
        .bl-up-overlay, .bl-info-overlay { padding: 0; align-items: stretch; }
        .bl-up-panel, .bl-info-modal {
          width: 100%; height: 100%; max-height: none;
          border-radius: 0; border: none;
        }
        .bl-up-panel { padding-bottom: calc(22px + env(safe-area-inset-bottom)); }
        .bl-up-foot { margin-top: auto; }
        .bl-info-steps { grid-template-columns: 1fr; }
      }
    `}</style>
  );
}