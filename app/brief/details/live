function parseSectionOrder(raw) {
  const order = [];
  const partsMap = {};
  String(raw || "").split(",").map((s) => s.trim()).filter(Boolean).forEach((tok) => {
    const [k, rest] = tok.split(":");
    if (!SECTION_META[k] || order.includes(k)) return;
    order.push(k);
    const all = SECTION_PART_KEYS[k] || ["body"];
    const vis = rest ? rest.split("+").filter((p) => all.includes(p)) : all;
    partsMap[k] = vis.length ? vis : all;
  });
  return { order, partsMap };
}
