// =====================================================================
// InspirationGrid — review picks, swipe files, external URLs
// =====================================================================
function InspirationGrid({ reviews, swipes, urls }) {
  const reviewSlots = reviews.map(({ value, videoUrl }) => {
    const first = asArray(value)[0] || {};
    return {
      label: first.label || first.name || "",
      recordId: first.id || "",
      url: resolveLookupVideoUrl(videoUrl),
      kind: "review",
    };
  }).filter((s) => s.url || s.label || s.recordId);
  const swipeSlots = swipes.map(({ value, videoUrl }) => {
    const first = asArray(value)[0] || {};
    return {
      label: first.label || first.name || "",
      recordId: first.id || "",
      url: resolveLookupVideoUrl(videoUrl),
      kind: "swipe",
    };
  }).filter((s) => s.url || s.label || s.recordId);
  const urlSlots = urls.filter(Boolean).map((u) => ({ url: u.trim(), kind: "url" }));

  const all = [...reviewSlots, ...swipeSlots, ...urlSlots];
  if (!all.length) {
    return <p className="bl-live-empty">The brand hasn't added inspiration videos yet.</p>;
  }
  return (
    <div className="bl-live-inspo-grid">
      {all.map((slot, i) => (
        <VideoSlot key={i} slot={slot} />
      ))}
    </div>
  );
}

// Open a sibling detail page in a Softr modal. Used when a creator
// clicks a review/swipe card — they jump to /review-details or
// /video-details for the full record (transcript, performance, etc).
function openLinkedDetail(kind, recordId) {
  if (typeof window === "undefined" || !recordId) return;
  const path = kind === "review" ? "/review-details" : "/video-details";
  const url = `${path}?recordId=${encodeURIComponent(recordId)}`;
  if (typeof window.openSwModal === "function") {
    window.openSwModal(url, "xl");
  } else {
    // Same-tab navigation without touching window.location — see the
    // URL-read note in Block: this file registers a create action.
    window.open(url, "_self");
  }
}

function VideoSlot({ slot }) {
  // If the slot points at a linked record (review pick or swipe
  // file), wrap the whole card in a click handler that opens the
  // record's detail page in a Softr modal. External-URL slots just
  // play inline and open the source URL in a new tab on the label.
  const opensDetail = (slot.kind === "review" || slot.kind === "swipe") && !!slot.recordId;
  const onCardClick = () => opensDetail && openLinkedDetail(slot.kind, slot.recordId);

  if (!slot.url) {
    return (
      <button
        type="button"
        className="bl-live-inspo-empty"
        onClick={onCardClick}
        disabled={!opensDetail}
      >
        <span>{slot.label || ""}</span>
      </button>
    );
  }
  const embed = detectExternalEmbed(slot.url);
  const inner = embed ? (
    <iframe
      src={embed.src}
      title={slot.label || "Inspiration video"}
      allow="autoplay; encrypted-media; picture-in-picture; clipboard-write; web-share"
      allowFullScreen
      referrerPolicy="strict-origin-when-cross-origin"
      loading="lazy"
    />
  ) : isDirectVideoUrl(slot.url) ? (
    <video src={slot.url} controls preload="metadata" />
  ) : null;
  const aspectClass = embed?.aspect === "horizontal" ? "bl-live-video-horizontal" : "bl-live-video-vertical";

  if (!inner) {
    return (
      <a className="bl-live-video-link" href={slot.url} target="_blank" rel="noreferrer">
        <ExternalLink size={13} /> {slot.label || "Open video"}
      </a>
    );
  }
  return (
    <div className="bl-live-inspo-card">
      <div className={`bl-live-video ${aspectClass}`}>
        {inner}
      </div>
      {opensDetail ? (
        <button
          type="button"
          className="bl-live-inspo-cardname"
          onClick={onCardClick}
        >
          <span className="bl-live-inspo-cardname-label">{slot.label || "View details"}</span>
          <ExternalLink size={12} />
        </button>
      ) : slot.label ? (
        <div className="bl-live-inspo-cardname is-static">{slot.label}</div>
      ) : null}
    </div>
  );
}

