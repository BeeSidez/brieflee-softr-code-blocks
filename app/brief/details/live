    const screenshotBase = publicId ? `https://res.cloudinary.com/${CLOUDINARY_CLOUD}/video/upload/so_{timestamp}/c_fill,h_1920,w_1080/${publicId}.jpg` : "";
    const prompt = buildPrompt({ account: acct, brief, notes, checks, meta, screenshotBase, previous, kind: STEPPER ? kind : "review" });
    const genUrl = `${GEMINI_BASE}/v1beta/models/${GEMINI_MODEL}:generateContent`;
    // The Softr proxy gives up on a call after about two minutes, so the
    // whole answer has to come back inside that. Thinking stays low and the
    // output is kept short (see the prompt). A timeout is never retried with
    // the same payload: the next lighter copy of the video goes instead.
    const attempt = (part, thinking) => proxyGoogle(genUrl, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        contents: [{ role: "user", parts: [{ text: prompt }, part] }],
        generationConfig: {
          temperature: 0.4, topP: 1, topK: 32, maxOutputTokens: 8192, responseMimeType: "application/json",
          ...(thinking ? { thinkingConfig: { thinkingLevel: "low" } } : {}),
        },
      }),
    });
    const timedOut = (r) => !r.ok && (r.status === 504 || r.status === 502 || r.status === 408);
    const retryable = (r) => !r.ok && (r.status >= 500 || r.status === 400);
    let useThinking = true;
    let gRes = await attempt(videoPart, useThinking);
    if (!gRes.ok && gRes.status === 400) {
      // A model that does not take the thinking field answers 400; go without it.
      useThinking = false;
      gRes = await attempt(videoPart, useThinking);
    }
    let calls = 1;
    while (!gRes.ok && calls < 3 && (timedOut(gRes) || retryable(gRes))) {
      if (timedOut(gRes)) {
        if (rungIdx + 1 >= rungs.length) break;
        ui.stage("Still watching, trying a lighter copy");
        rungIdx += 1;
        const r = await fetch(rungs[rungIdx]);
        if (!r.ok) continue;
        const b = await r.blob();
        if (b.size < 1000) continue;
        blob = b; videoPart = await makeVideoPart(blob, "video/mp4");
      } else {
        await sleep(2500);
      }
      gRes = await attempt(videoPart, useThinking); calls += 1;
    }
    if (!gRes.ok) { console.error("gemini failed", gRes.status, await gRes.text().catch(() => "")); throw new Error(timedOut(gRes) ? "The Review Agents ran out of time on this video. A shorter or lighter cut usually gets through. Try again in a moment." : "The Review Agents couldn't watch the video right now. Try again in a moment."); }
    let parsed = parseGeminiJson(await gRes.json());
    const decisionRaw = String(parsed?.overall_review?.ai_decision || "").toUpperCase();
    if (!parsed?.overall_review || !Array.isArray(parsed?.analysis) || !["APPROVED", "FLAGGED", "REJECTED"].includes(decisionRaw)) {
      await sleep(1500);
      gRes = await attempt(videoPart);
      if (!gRes.ok) throw new Error("The review came back incomplete.");
      parsed = parseGeminiJson(await gRes.json());
    }
    const decision = ["APPROVED", "FLAGGED", "REJECTED"].includes(String(parsed?.overall_review?.ai_decision || "").toUpperCase())
      ? String(parsed.overall_review.ai_decision).toUpperCase() : "FLAGGED";
    const ov = parsed.overall_review || {};
    const byName = normaliseAnalysis(parsed, checks, publicId);
    if (byName.size === 0) throw new Error("The review came back without any checks.");
    if (!alive()) return null;

    // 5. Write at the end. The review goes first, then the submission that
    //    links it (submissions.reviews and reviews.submissions are a two-way
    //    pair, so the review side fills itself), then one review_report row
    //    per agent. If the submission write fails, nothing has been charged:
    //    the submission row is the credit.
    ui.stage("Saving the review");
    const platform = isFile ? "Upload" : detectPlatform(srcUrl);
    const videoTitle = (STEPPER && urlName) || stripEmDash(ov.video_title || "").slice(0, 80) || (theFile?.name || handle || "Video");
    const projectIds = idsOf(brief?.projects).length ? idsOf(brief.projects) : idsOf(parent?.projects);
    const normQa = (l) => String(l || "").toLowerCase().replace(/&/g, "and").replace(/visability/g, "visibility").replace(/\s+/g, " ").trim();
    const qaIndex = Object.fromEntries(Object.entries(SUB_QA_IDS).map(([k, v]) => [normQa(k), v]));
    const qaLabels = [...unwrapAll(acct?.qaChecklist), ...unwrapAll(brief?.qaChecklist), ...(STEPPER ? agents : [])];
    const qaIds = [...new Set(qaLabels.map((l) => qaIndex[normQa(l)] || "").filter(Boolean))];

    const g = (prefix) => byName.get(AGENTS.find((a) => a.key === prefix)?.name || "") || null;
    const col = (prefix) => {
      const r = g(prefix); if (!r) return {};
      const sc = numericScore(r.score);
      return { score: sc, status: statusValue(prefix, r.status), comment: r.comment.slice(0, 1000), shot: r.screenshot };
    };
    const pst = col("pst"), hs = col("hs"), vh = col("vh"), cta = col("cta"), ft = col("ft"), tl = col("tl"), ac = col("ac"), ep = col("ep"), bm = col("bm"), cr = col("cr"), cm = col("cm"), ba = col("ba");
    const links = {
      accounts: [{ id: workspaceId }],
      briefs: briefId ? [{ id: briefId }] : null,
      projects: projectIds.length ? projectIds.map((id) => ({ id })) : null,
    };
    const review = await createReview.mutateAsync({
      ...links,
      overallStatus: OPT.overallStatus[decision],
      aiDecision: OPT.aiDecision[decision],
      aiMode: OPT.aiMode[aiModeLabel] || OPT.aiMode.Hybrid,
      thresholdSource: OPT.thresholdSource[thresholdSource],
      overallRating: Math.min(5, Math.max(1, Math.round(Number(ov.overall_rating) || 3))),
      overallComment: stripEmDash(ov.overall_comment || ""),
      decisionReasoning: stripEmDash(ov.decision_reasoning || ""),
      recommendedAction: stripEmDash(ov.recommended_action || ""),
      transcript: stripEmDash(parsed.transcript || ""),
      adaptedScript: STEPPER && kind === "remix" ? stripEmDash(parsed.adapted_script || "") : "",
      displayUrl: (deliveryUrl || "").slice(0, 1000),
      thumbnail: cldThumb(publicId) || (ytId ? `https://i.ytimg.com/vi/${ytId}/hq2.jpg` : ""),
      offBrand: g("ba")?.value?.slice(0, 1000) || "",
      pstScore: pst.score ?? null, pstStatus: pst.status || null, pstComment: pst.comment || "", pstShot: pst.shot || "",
      hsScore: hs.score ?? null, hsStatus: hs.status || null, hsComment: hs.comment || "", hsShot: hs.shot || "",
      vhScore: vh.score ?? null, vhStatus: vh.status || null, vhComment: vh.comment || "", vhShot: vh.shot || "",
      ctaScore: g("cta")?.score || "", ctaStatus: cta.status || null, ctaComment: cta.comment || "", ctaShot: cta.shot || "",
      ftScore: ft.score ?? null, ftStatus: ft.status || null, ftComment: ft.comment || "", ftShot: ft.shot || "",
      tlScore: tl.score ?? null, tlStatus: tl.status || null, tlComment: tl.comment || "", tlShot: tl.shot || "",
      acScore: ac.score ?? null, acStatus: ac.status || null, acComment: ac.comment || "", acShot: ac.shot || "",
      epScore: ep.score ?? null, epStatus: ep.status || null, epComment: ep.comment || "", epShot: ep.shot || "",
      bmScore: bm.score ?? null, bmStatus: bm.status || null, bmComment: bm.comment || "", bmShot: bm.shot || "",
      crStatus: cr.status || null, crDetails: cr.comment || "", crShot: cr.shot || "",
      cmStatus: cm.status || null, cmDetails: cm.comment || "", cmShot: cm.shot || "",
      baStatus: ba.status || null, baDetails: ba.comment || "", baShot: ba.shot || "",
    });
    const reviewId = review?.id || review?.recordId || review?.record?.id || "";
    if (!reviewId) throw new Error("The review was not saved. No video was used.");

    const subFields = {
      name: videoTitle,
      accounts: workspaceId,
      briefs: briefId ? [{ id: briefId }] : null,
      projects: projectIds.length ? projectIds.map((id) => ({ id })) : null,
      users: brandUserId ? [{ id: brandUserId }] : null,
      reviews: [{ id: reviewId }],
      videoUrl: isFile ? "" : srcUrl,
      videoFile: uploaded ? [uploaded] : null,
      briefAttachment: pdfUploaded ? [pdfUploaded] : null,
      creatorName: cleanName(creatorName) || (isCreator ? cleanName(unwrapE(parent?.creatorName)) : (STEPPER ? cleanName(unwrapE(mf.fullName)) : "")),
      creatorEmail: isCreator ? (creatorEmail.trim() || unwrapE(parent?.creatorEmail) || "") : creatorEmail.trim(),
      submissionType: context === "submission" ? OPT.subTypeRevision : (STEPPER && kind === "analyse" ? OPT.subTypeAnalyse : STEPPER && kind === "remix" ? OPT.subTypeSwipe : briefId ? OPT.subTypeBrief : OPT.subTypeContentReview),
      status: OPT.statusReviewed,
      userValidation: OPT.userValidationProceed,
      platformName: OPT.platform[platform] || OPT.platform.Upload,
      platformUsername: handle || "",
      submissionNotes: notes.trim(),
      qaChecklist: qaIds.length ? qaIds : null,
      duration: meta.duration,
      resolution: meta.resolution,
      aspectRatio: meta.aspect,
      fileSizeMb: String(meta.sizeMb),
      format: meta.format,
      fps: Number(meta.fps) || null,
      parentSubmission: context === "submission" ? [{ id: parentId }] : null,
      parentSubmissionId: context === "submission" ? parentId : "",
      originalReviewId: context === "submission" ? (unwrapE(parent?.originalReviewId) || parentReviewId) : "",
      revisionNumber: context === "submission" ? (OPT.revision[revisionNo] || OPT.revision[10]) : null,
      isBulk: !!multi,
    };
    let sub = null;
    try { sub = await createSubmission.mutateAsync(subFields); }
    catch (e) { console.error("submission write failed, review left unattached:", reviewId, e); throw new Error("The review finished but couldn't be saved. No video was used. Try again in a moment."); }
    const subId = sub?.id || sub?.recordId || sub?.record?.id || "";
    if (!subId) { console.error("submission write returned no id, review left unattached:", reviewId); throw new Error("The review finished but couldn't be saved. No video was used. Try again in a moment."); }
    const rowLinks = { ...links, submissions: [{ id: subId }] };

    // One review_report row per agent, in order.
    if (!createReport.enabled) console.error("review_report create is not enabled for this visitor");
    let reportsWritten = 0;
    for (const [, r] of byName) {
      if (!createReport.enabled) break;
      try {
        await createReport.mutateAsync({
          threshold: r.agent.name,
          score: r.score,
          thresholdValue: r.value,
          rating: r.rating,
          severity: OPT.reportSeverity[r.severity],
          status: OPT.reportStatus[r.status] || r.status,
          comment: r.comment.slice(0, 4000),
          screenshotUrl: r.screenshot,
          keyMoment: r.timestamp === null ? null : (KEY_MOMENT_IDS[String(r.timestamp)] || null),
          review: [{ id: reviewId }],
          ...rowLinks,
        });
        reportsWritten += 1;
      } catch (e) { console.error("review_report row failed:", r.agent.name, String(e?.message || e)); }
    }
    console.log(`review_report rows written: ${reportsWritten} of ${byName.size}`);

    // 6. Notifications (to the brand user)
    const failed = [...byName.values()].filter((r) => r.status !== "PASS").map((r) => r.agent.name);
    const notifBase = { isRead: false, accounts: [{ id: workspaceId }], users: brandUserId ? [{ id: brandUserId }] : null, briefs: briefId ? [{ id: briefId }] : null, projects: links.projects, submissions: [{ id: subId }], reviews: [{ id: reviewId }] };
    const notify = async (type, title, message) => {
      if (!createNotification.enabled) return;
      try { await createNotification.mutateAsync({ ...notifBase, type, title, message }); } catch (e) { console.error("notification failed:", title, e); }
    };
    const creatorEmailFinal = subFields.creatorEmail;
    const what = context === "submission" ? `Revision ${revisionNo} of ${videoTitle}` : videoTitle;
    if (creatorEmailFinal) await notify(OPT.notif.received, "Submission received", `${what} was submitted${brief ? ` for ${unwrapE(brief.name)}` : ""}.`);
    await notify(OPT.notif.completed, "Review completed", `${what}: ${decision.toLowerCase()} by the Review Agents${failed.length ? ` (${failed.length} flagged)` : ""}.`);
    const decisionType = decision === "APPROVED" ? OPT.notif.approved : decision === "REJECTED" ? OPT.notif.rejected : OPT.notif.flagged;
    const decisionTitle = decision === "APPROVED" ? "Content approved" : decision === "REJECTED" ? "Content rejected" : "Flagged for review";
    await notify(decisionType, decisionTitle, stripEmDash(ov.decision_reasoning || "").slice(0, 500));

    // 7. EmailIt by alias, idempotent per submission + event
    const reviewUrl = `${APP_ORIGIN}${DETAILS_PATH}?recordId=${encodeURIComponent(subId)}`;
    const submissionUrl = `${APP_ORIGIN}${LIVE_PATH}?recordId=${encodeURIComponent(subId)}`;
    const vars = {
      account_name: workspaceName,
      brief_name: unwrapE(brief?.name) || "the brief",
      creator_first_name: (subFields.creatorName || "there").split(" ")[0],
      creator_name: subFields.creatorName || "the creator",
      user_first_name: brandFirstName,
      failed_thresholds: failed.length ? failed.join(", ") : "None",
      review_url: reviewUrl,
      submission_url: submissionUrl,
    };
    // EmailIt rate-limits bursts (429). Each send retries with a pause,
    // and the Idempotency-Key keeps a retry from ever sending twice.
    const send = async (alias, to) => {
      if (!to) { console.error("EmailIt skipped, no recipient for", alias); return; }
      const key = `${subId}-${alias}`.replace(/[^A-Za-z0-9_-]/g, "-").slice(0, 200);
      const waits = [2000, 5000, 12000];
      for (let attempt = 0; attempt <= waits.length; attempt++) {
        try {
          const r = await proxyEmailit("https://api.emailit.com/v2/emails", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Idempotency-Key": key },
            body: JSON.stringify({ from: EMAIL_FROM, to, template: alias, variables: vars }),
          });
          if (r.ok) return;
          const again = r.status === 429 || r.status >= 500;
          console.error("EmailIt", alias, "returned", r.status, again && attempt < waits.length ? "retrying" : "giving up");
          if (!again || attempt >= waits.length) return;
          const retryAfter = Number(r.headers?.get?.("retry-after")) || 0;
          await sleep(Math.max(retryAfter * 1000, waits[attempt]));
        } catch (e) {
          console.error("EmailIt failed:", alias, e);
          if (attempt >= waits.length) return;
          await sleep(waits[attempt]);
        }
      }
    };
    const outcome = decision === "APPROVED" ? "approved" : decision === "REJECTED" ? "rejected" : "flagged";
    const mode = aiModeLabel === "Autonomous" ? "auto" : aiModeLabel === "Manual" ? "manual" : "hybrid";
    const sendsEmail = !(STEPPER && kind !== "review");
    if (sendsEmail && creatorEmailFinal) await send("bl-sub-received-creator", creatorEmailFinal);
    if (!sendsEmail) { /* analyse and remix are for the brand's own eyes */ }
    else if (mode === "auto") { if (creatorEmailFinal) await send(`bl-sub-${outcome}-auto-creator`, creatorEmailFinal); }
    else if (mode === "hybrid") { if (creatorEmailFinal) await send(`bl-sub-${outcome}-hybrid-creator`, creatorEmailFinal); await send(`bl-sub-${outcome}-hybrid-user`, brandEmail); }
    else { await send(`bl-sub-${outcome}-manual-user`, brandEmail); }

    return { subId, reviewId, decision, title: videoTitle, failed, checks: byName.size, thumb: cldThumb(publicId) };
  }

  // One creator submission through the engine.
  const runReview = async ({ file, uploaded, name, email, note }) => {
    if (!createSubmission.enabled || !createReview.enabled) throw new Error("Submissions are not available right now.");
    if (!briefE || !workspaceId || !af) throw new Error("The brief is still loading. Try again in a moment.");
    if (unwrapE(briefE.status) !== "Active") throw new Error("This brief is closed to new submissions.");
    if (lookupStatus && lookupStatus !== "Active") throw new Error("This brief isn't taking submissions right now. Check back later or contact the brand.");
    if (!uploaded?.url) throw new Error("The upload did not finish. Try again.");
    const ctx = { agents: [], briefId, brief: briefE, notes: note || "", pdf: null, pdfUploaded: null, creatorName: name, creatorEmail: email };
    const item = { kind: "file", file: file || null, label: uploaded.filename, uploaded };
    const r = await runPipeline(item, runRef.current, { stage: () => {}, preview: () => {} }, ctx);
    if (!r) throw new Error("The review did not finish.");
    return r;
  };
  const submitDisabled = isPreview || isSilentFrame;
  const [previewDevice, setPreviewDevice] = useState("desktop");
  const model = useMemo(() => parseSectionOrder(f.section_order), [f.section_order]);
  const hasNewModel = model.order.length > 0;
  // Every section opens closed; the chip nav (and the card heads)
  // open them. Controlled here so a chip click can expand + scroll.
  const [openSecs, setOpenSecs] = useState({});
  const toggleSec = (k) => setOpenSecs((s) => ({ ...s, [k]: !s[k] }));
  // v3: the in-block submission panel + the how-reviews-work modal
  const [uploadOpen, setUploadOpen] = useState(false);
  const [infoOpen, setInfoOpen] = useState(false);

  const briefName     = unwrap(f.name) || "Untitled brief";
  const formatLabel   = selectLabel(f.first_format) || selectLabel(f.format) || "";
  // "About the brand" in the hero is the single place brand context
  // lives, so the Brand section is not rendered separately (it said the
  // same thing twice). When the account has no blueprint bio, the
  // brief's own brand copy fills the hero instead, so nothing is lost.
  const brandBio      = extractBrandBio(f.brand_blueprint) || stripTags(f.brand);
  // Legacy heroes carry the product summary as a plain-text line; the
  // new model shows it as the Product section instead, so the hero
  // stays clean and nothing renders twice (or with raw tags).
  const productSummary = typeof f.product_feature_description === "string"
    ? stripTags(f.product_feature_description) : "";
  // Resolved ONCE. The gate below, the Product card and the hero must
  // agree: a looser gate than the render uses would open an empty card
  // for a product carrying only the placeholder.
  const productImage = resolveProductImage(f.product_image, f.product_image_url);
  // Hero image chain (Bev, 22 Sep 2026): the brief's own upload, then the
  // product, then the brand's logo, and the Brieflee mascot only when there
  // is none of those. A favicon is 128px from Google, so it sits small and
  // centred (heroIsMark) instead of being stretched across the hero.
  const heroFavicon = Array.isArray(f.logo_url) ? f.logo_url[0] : f.logo_url;
  const heroPhoto = extractThumbUrl(f.thumbnail)               // 1. brief's own upload
    || productImage                                             // 2. the linked product
    || (typeof f.image_url === "string" && f.image_url)        // 3. AI-scraped product image
    || extractThumbUrl(f.logo_file);                           // 4. account's uploaded logo
  const heroIsMark = !heroPhoto;
  const heroImage = heroPhoto
    || (typeof heroFavicon === "string" && heroFavicon)        // 5. account favicon
    || BRIEFLEE_MASCOT;                                        // 6. fallback
  // Brand name comes from the accounts LOOKUP's primary-field label
  // (which is the account's `name` field by convention).
  const brandName = asArray(f.accounts)[0]?.label || "";
  // The brand's public brief index (/app/brand/index). Only offered when
  // the accounts lookup resolved an id, so the link is never dead.
  const brandAccountId = asArray(f.accounts)[0]?.id || "";
  // Brand logo — prefer the uploaded logo file, fall back to the
  // generated favicon URL. Both LOOKUPs may return arrays of attachments
  // / strings.
  const brandLogo = extractThumbUrl(f.logo_file)
    || (Array.isArray(f.logo_url) ? f.logo_url[0] : f.logo_url)
    || "";

  // Brief body — JSON parsed out of `description`
  const body = useMemo(() => extractJson(f.description) || {}, [f.description]);

  // PDF (Cloudinary upload OR pasted URL — both embed inline)
  const uploadedPdfUrl = extractThumbUrl(f.attachment);
  const pastedDocUrl = typeof f.brief_document_url === "string" ? f.brief_document_url.trim() : "";
  const pdfPreviewSrc = uploadedPdfUrl || (isPdfUrl(pastedDocUrl) ? pastedDocUrl : "");

  // Production specs (each may be array of selects)
  const platforms = selectLabels(f.platform);
  const aspectRatios = selectLabels(f.aspect_ratio);
  const contentTypes = selectLabels(f.content_type);
  const contentDelivery = selectLabel(f.content_delivery);
  const durationLabel = selectLabel(f.duration);
  const durationThresh = selectLabel(f.duration_threshold);
  const openDate = formatDateTime(f.submission_open_date);
  const closeDate = formatDateTime(f.submission_close_date);

  // Brief is closed when ANY of these are true:
  //   - submission_close_date has passed
  //   - videos_remaining (brief table FORMULA) is false → creator
  //     has used their plan's video quota for this brief
  // Drives the top banner + disables submit CTAs + hides the body.
  const dateClosed = useMemo(() => {
    const t = f.submission_close_date ? new Date(f.submission_close_date).getTime() : 0;
    if (!Number.isFinite(t) || t === 0) return false;
    return t < Date.now();
  }, [f.submission_close_date]);
  const quotaClosed = f.videos_remaining === false;
  const isClosed = dateClosed || quotaClosed;

  // Submission CTA — opens the in-block panel. It opens in preview
  // too (brands get to see the flow); the panel's own submit button
  // is what preview disables.
  const openSubmissionFlow = () => setUploadOpen(true);

  // ─── v2: new-model section rendering ────────────────────────
  const partHtml = (k, part) => {
    const alias = (SECTION_META[k].partFields || {})[part];
    return alias && typeof f[alias] === "string" ? f[alias] : "";
  };
  const inspoHasContent =
    [f.example, f.example_2, f.example_3, f.videos, f.videos_2, f.videos_3].some((v) => asArray(v).length > 0) ||
    [f.example_video_1, f.example_video_2, f.example_video_3].some((u) => typeof u === "string" && u.trim());
  const deliverablesHasContent = platforms.length > 0 || aspectRatios.length > 0 || !!durationLabel || !!contentDelivery;
  const sectionHasAnyContent = (k) => {
    // Brand context lives in the hero as "About the brand", so the
    // Brand section never renders as its own card. Gating it here also
    // drops it from the chip nav, which reads off the same check.
    if (k === "brand") return false;
    if (k === "examples") return inspoHasContent;
    if (k === "deliverables") return deliverablesHasContent;
    if (k === "submissions") return htmlHasContent(f.submission_notes) || !!openDate || !!closeDate;
    if (k === "extra") return htmlHasContent(f.extra) || !!pdfPreviewSrc;
    if (k === "visualFormat") return htmlHasContent(f.visual_format) || asArray(f.format).length > 0;
    if (k === "guidelines") return htmlHasContent(filterBarLines(f.dos)) || htmlHasContent(filterBarLines(f.donts)) || barChips(f, brandName).length > 0;
    if (k === "productFeature") {
      return htmlHasContent(f.product_feature_description) || htmlHasContent(f.feature) ||
        (typeof f.product_url === "string" && f.product_url.trim()) ||
        (typeof f.feature_url === "string" && f.feature_url.trim()) ||
        !!productImage;
    }
    const vis = model.partsMap[k] || [];
    return vis.some((p) => htmlHasContent(partHtml(k, p)));
  };
  const scrollToSection = (k) => {
    // Nav chips open the section first, then scroll once it has
    // expanded (next frame, so the card height is real).
    setOpenSecs((s) => ({ ...s, [k]: true }));
    if (typeof document === "undefined") return;
    setTimeout(() => {
      const el = document.getElementById("bl-sec-" + k);
      if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
    }, 80);
  };
  const renderSection = (k) => {
    if (!sectionHasAnyContent(k)) return null;
    const meta = SECTION_META[k];
    const vis = model.partsMap[k] || ["body"];
    const secId = "bl-sec-" + k;
    if (k === "guidelines") {
      const bars = barChips(f, brandName);
      const dosClean = filterBarLines(f.dos);
      const dontsClean = filterBarLines(f.donts);
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          {bars.length > 0 && (
            <div className="bl-live-barwrap">
              <div className="bl-live-part-label">The bars</div>
              <div className="bl-live-barchips">
                {bars.map((c, i) => (
                  <span key={i} className="bl-live-barchip">
                    {c.label}
                    {c.value && <b>{c.value}</b>}
                    <InlineTooltip text={c.tip} />
                  </span>
                ))}
              </div>
            </div>
          )}
          <div className="bl-live-ddpair">
            {vis.includes("dos") && htmlHasContent(dosClean) && (
              <div className="bl-live-ddcard">
                <div className="bl-live-part-head"><img src={ICON_DO} alt="" draggable={false} /><span>Do</span></div>
                <HtmlBody html={dosClean} />
              </div>
            )}
            {vis.includes("donts") && htmlHasContent(dontsClean) && (
              <div className="bl-live-ddcard">
                <div className="bl-live-part-head"><img src={ICON_DONT} alt="" draggable={false} /><span>Don't</span></div>
                <HtmlBody html={dontsClean} />
              </div>
            )}
          </div>
        </BentoCard>
      );
    }
    if (k === "examples") {
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          <InspirationGrid
            reviews={[
              { value: f.example, videoUrl: f.example_1_video_url },
              { value: f.example_2, videoUrl: f.example_2_video_url },
              { value: f.example_3, videoUrl: f.example_3_video_url },
            ]}
            swipes={[
              { value: f.videos, videoUrl: f.swipe_1_video_url },
              { value: f.videos_2, videoUrl: f.swipe_2_video_url },
              { value: f.videos_3, videoUrl: f.swipe_3_video_url },
            ]}
            urls={[
              typeof f.example_video_1 === "string" ? f.example_video_1 : "",
              typeof f.example_video_2 === "string" ? f.example_video_2 : "",
              typeof f.example_video_3 === "string" ? f.example_video_3 : "",
            ]}
          />
        </BentoCard>
      );
    }
    if (k === "deliverables") {
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          <SpecStrip
            platforms={platforms}
            duration={durationLabel}
            durationThresh={durationThresh}
            aspectRatios={aspectRatios}
            contentTypes={[]}
            contentDelivery={contentDelivery}
            openDate=""
            closeDate=""
            closeIso=""
            isClosed={isClosed}
            hideProduction={false}
          />
        </BentoCard>
      );
    }
    if (k === "hook") {
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          <div className="bl-live-hook-grid">
            {vis.filter((p) => htmlHasContent(partHtml(k, p))).map((p) => (
              <div key={p} className="bl-live-partblock">
                <div className="bl-live-part-label">{(meta.partLabels || {})[p] || p}</div>
                <LineCards html={partHtml(k, p)} />
              </div>
            ))}
          </div>
        </BentoCard>
      );
    }
    if (k === "talkingPoints") {
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          <LineCards html={f.talking_points} grid />
        </BentoCard>
      );
    }
    if (k === "visualFormat") {
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          {asArray(f.format).length > 0 && (
            <div className="bl-live-datechips">
              {asArray(f.format).map((x, i) => (
                <span key={i} className="bl-live-format-pill">{selectLabel(x)}</span>
              ))}
            </div>
          )}
          {vis.includes("direction") && htmlHasContent(f.visual_format) && <HtmlBody html={f.visual_format} />}
        </BentoCard>
      );
    }
    if (k === "extra") {
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          {vis.includes("notes") && htmlHasContent(f.extra) && <HtmlBody html={f.extra} />}
          {vis.includes("document") && pdfPreviewSrc && (
            <div className="bl-live-pdf-wrap"><iframe src={pdfPreviewSrc} title={`${briefName} document`} loading="lazy" /></div>
          )}
        </BentoCard>
      );
    }
    if (k === "submissions") {
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          {vis.includes("notes") && htmlHasContent(f.submission_notes) && <HtmlBody html={f.submission_notes} />}
          {vis.includes("dates") && (openDate || closeDate) && (
            <div className="bl-live-datechips">
              {openDate && <span className="bl-live-format-pill">Opens {openDate}</span>}
              {closeDate && <span className="bl-live-format-pill">Closes {closeDate}</span>}
            </div>
          )}
        </BentoCard>
      );
    }
    if (k === "productFeature") {
      const hasCopy =
        (vis.includes("description") && htmlHasContent(f.product_feature_description)) ||
        (vis.includes("feature") && htmlHasContent(f.feature)) ||
        (vis.includes("productLink") && typeof f.product_url === "string" && !!f.product_url.trim()) ||
        (vis.includes("featureLink") && typeof f.feature_url === "string" && !!f.feature_url.trim());
      return (
        <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
          <div className={`bl-live-product-row ${hasCopy ? "" : "is-solo"}`}>
            <ProductShot src={productImage} alt={briefName} />
            {hasCopy && (
              <div className="bl-live-product-copy">
                {vis.includes("description") && htmlHasContent(f.product_feature_description) && <HtmlBody html={f.product_feature_description} />}
                {vis.includes("feature") && htmlHasContent(f.feature) && (
                  <div className="bl-live-partblock">
                    <div className="bl-live-part-label">Feature</div>
                    <HtmlBody html={f.feature} />
                  </div>
                )}
                {vis.includes("productLink") && typeof f.product_url === "string" && f.product_url.trim() && (
                  <a className="bl-live-video-link" href={f.product_url} target="_blank" rel="noreferrer"><ExternalLink size={13} /> See the product</a>
                )}
                {vis.includes("featureLink") && typeof f.feature_url === "string" && f.feature_url.trim() && (
                  <a className="bl-live-video-link" href={f.feature_url} target="_blank" rel="noreferrer"><ExternalLink size={13} /> See the feature</a>
                )}
              </div>
            )}
          </div>
        </BentoCard>
      );
    }
    return (
      <BentoCard key={k} id={secId} icon={meta.icon} title={meta.name} tooltip={meta.tip} full open={!!openSecs[k]} onToggle={() => toggleSec(k)}>
        {vis.filter((p) => htmlHasContent(partHtml(k, p))).map((p) => (
          <div key={p} className="bl-live-partblock">
            {(meta.partLabels || {})[p] && <div className="bl-live-part-label">{meta.partLabels[p]}</div>}
            <HtmlBody html={partHtml(k, p)} />
          </div>
        ))}
      </BentoCard>
    );
  };

  // ─── v2: preview frame (phone view = real 390px iframe) ─────
  if (isPreview && previewDevice === "phone") {
    // Inherit the page's own query string (session/auth params like the
    // preview app's autoUser token included), swapping preview for the
    // silent flag. A bare URL blanks inside preview contexts. Built from
    // the captured string with plain string ops — no window, no parser —
    // so the create action still registers.
    const parts = rawQuery.replace(/^\?/, "").split("&").filter(
      (p) => p && !/^preview=/.test(p) && !/^pv=/.test(p) && !/^recordId=/.test(p));
    parts.push("pv=silent");
    if (briefId) parts.push("recordId=" + encodeURIComponent(briefId));
    const frameSrc = rawPath + "?" + parts.join("&");
    return (
      <>
        <Style />
        <div className="bl-live">
          <PreviewBar device={previewDevice} setDevice={setPreviewDevice} />
          <div className="bl-live-phone-stage">
            <div className="bl-live-phone">
              <iframe src={frameSrc} title="Creator view on a phone" />
            </div>
          </div>
        </div>
      </>
    );
  }

  return (
    <>
      <Style />
      <div className={`bl-live ${isPreview ? "is-preview" : ""}`}>
        {isPreview && <PreviewBar device={previewDevice} setDevice={setPreviewDevice} />}
        <div className="bl-live-inner container mx-auto px-4 w-full">

          {/* ============ Back to the brand's brief index ============
              Only when the accounts lookup resolved, so it is never a
              dead link, and never inside the phone preview frame. */}
          {brandAccountId && !isSilentFrame && (
            <a
              className="bl-live-back"
              href={`/briefs-page?recordId=${encodeURIComponent(brandAccountId)}`}
            >
              <ArrowLeft size={15} />
              {brandName ? `All ${brandName} briefs` : "All briefs"}
            </a>
          )}

          {/* ============ Closed banner ============ */}
          {isClosed && (
            <div className="bl-live-closed-banner" role="status">
              <div className="bl-live-closed-banner-text">
                <strong>Submissions closed.</strong>
                <span>
                  {quotaClosed && !dateClosed
                    ? "The brand has reached the video quota for this campaign. No more submissions are being accepted."
                    : closeDate
                      ? `Submissions ended on ${closeDate}. The brand isn't accepting new videos for this campaign.`
                      : "The brand isn't accepting new videos for this campaign."}
                </span>
              </div>
            </div>
          )}

          {/* ============ Hero ============ */}
          <header className="bl-live-hero">
            <div className="bl-live-hero-left">
              <div className="bl-live-brand-line">
                {brandLogo && (
                  <img
                    src={brandLogo}
                    alt={brandName || "Brand"}
                    className="bl-live-brand-logo"
                    draggable={false}
                  />
                )}
                <span className="bl-live-brand-eyebrow">
                  {brandName ? `The ${brandName} brief` : "Brief"}
                  {formatLabel && (
                    <span className="bl-live-format-pill">{formatLabel}</span>
                  )}
                </span>
              </div>
              <h1 className="bl-live-title">{briefName}</h1>
              {!hasNewModel && productSummary && (
                <p className="bl-live-summary">{productSummary}</p>
              )}
              {brandBio && (
                <div className="bl-live-brand-bio">
                  <span className="bl-live-brand-bio-label">About the brand</span>
                  <p>{brandBio}</p>
                </div>
              )}
              <button
                type="button"
                className="bl-live-cta-primary"
                onClick={openSubmissionFlow}
                disabled={!briefId || isClosed}
              >
                <Upload size={16} />
                {isClosed ? "Submissions closed" : "Submit your video"}
              </button>
              {!isClosed && (
                <p className="bl-live-soft">Your video is reviewed against this brief the moment you submit.</p>
              )}
              <button type="button" className="bl-live-info-link" onClick={() => setInfoOpen(true)}>
                <HelpCircle size={13} /> How reviews work
              </button>
            </div>
            <div className="bl-live-hero-right">
              <img src={heroImage} alt={briefName} className={"bl-live-hero-image" + (heroIsMark ? " bl-live-hero-image--mark" : "")} draggable={false} />
            </div>
          </header>

          {/* ============ Submission details (collapsible) ============
              Always rendered, even when the brief is closed — defaults
              closed in that case since the campaign is over. */}
          <BentoCard
            icon={ICON_SPECS}
            title="Submission details"
            tooltip="Production specs and timing. Match these exactly when you film."
          >
            <SpecStrip
              platforms={platforms}
              duration={durationLabel}
              durationThresh={durationThresh}
              aspectRatios={aspectRatios}
              contentTypes={hasNewModel ? [] : contentTypes}
              contentDelivery={contentDelivery}
              openDate={openDate}
              closeDate={closeDate}
              closeIso={f.submission_close_date}
              isClosed={isClosed}
              hideProduction={hasNewModel && model.order.includes("deliverables")}
            />
          </BentoCard>

          {/* ============ Brief PDF (inline iframe) — HIDDEN when closed ============
              The PDF is private campaign material; once the brief is
              closed we don't keep it visible to anyone with the public
              link. Same logic for AI checks + Inspiration below. */}
          {!isClosed && pdfPreviewSrc && (
            <BentoCard icon={ICON_SCRIPT} title="The brief (PDF)" tooltip="Read the full PDF inline. No need to download.">
              <div className="bl-live-pdf-wrap">
                <iframe src={pdfPreviewSrc} title={`${briefName} PDF`} loading="lazy" />
              </div>
              <a className="bl-live-pdf-open" href={pdfPreviewSrc} target="_blank" rel="noreferrer">
                <ExternalLink size={12} /> Open in new tab
              </a>
            </BentoCard>
          )}

          {/* ============ Bento grid — brief body sections ============
              Everything inside (body sections + AI checks + inspiration)
              is private campaign material — hidden once the brief is
              closed. Creators can still see the hero, brand bio, and
              submission details. */}
          {/* ============ v2: the brief, in the brand's order ============ */}
          {!isClosed && hasNewModel && (
            <>
              <nav className="bl-live-nav" aria-label="On this page">
                {model.order.filter(sectionHasAnyContent).map((k) => (
                  <button key={k} type="button" onClick={() => scrollToSection(k)}>{SECTION_META[k].name}</button>
                ))}
              </nav>
              <div className="bl-live-bento">
                {model.order.map(renderSection)}
              </div>
            </>
          )}

          {/* ============ Legacy bento — JSON-in-description briefs ============ */}
          {!isClosed && !hasNewModel && (
            <div className="bl-live-bento">

              {/* Personal experiences */}
              {nonEmptyArray(body.personal_experiences) && (
                <BentoCard
                  icon={ICON_PERSONAL}
                  title="Personal experiences"
                  tooltip="First-person scenarios in the buyer's voice. Pick one that fits your life and tell it naturally on camera."
                >
                  <BulletList items={body.personal_experiences} />
                </BentoCard>
              )}

              {/* Hooks */}
              {nonEmptyArray(body.hook) && (
                <BentoCard
                  icon={ICON_HOOK}
                  title="Hook options"
                  tooltip="Three opening lines for the first 3 seconds. Each uses a different tactic: pick the one that feels natural."
                >
                  <BulletList items={body.hook} />
                </BentoCard>
              )}

              {/* Talking points */}
              {nonEmptyArray(body.talking_points) && (
                <BentoCard
                  icon={ICON_TALKING_POINTS}
                  title="Talking points"
                  tooltip="Bullets to say in your own words. Not a script to memorise."
                  wide
                >
                  <BulletList items={body.talking_points} />
                </BentoCard>
              )}

              {/* CTAs */}
              {nonEmptyArray(body.cta) && (
                <BentoCard
                  icon={ICON_CTA}
                  title="Calls to action"
                  tooltip="Three ways to close the video. Pick the one that fits your voice."
                >
                  <BulletList items={body.cta} />
                </BentoCard>
              )}

              {/* Storyboard */}
              {nonEmptyArray(body.storyboard) && (
                <BentoCard
                  icon={ICON_STORYBOARD}
                  title="Storyboard"
                  tooltip="Shot by shot. Each row is tagged by scene type."
                  full
                >
                  <StoryboardTable rows={body.storyboard} />
                </BentoCard>
              )}

              {/* Dos / Donts side by side */}
              {nonEmptyArray(body.dos) && (
                <BentoCard
                  icon={ICON_DO}
                  title="Do's"
                  tooltip="Best practices when filming this format."
                >
                  <BulletList items={body.dos} />
                </BentoCard>
              )}
              {nonEmptyArray(body.donts) && (
                <BentoCard
                  icon={ICON_DONT}
                  title="Don'ts"
                  tooltip="What to avoid. Compliance and brand safety."
                >
                  <BulletList items={body.donts} />
                </BentoCard>
              )}

              {/* Script (full width) */}
              {typeof body.script === "string" && body.script.trim() && (
                <BentoCard
                  icon={ICON_SCRIPT}
                  title="Script"
                  tooltip="The full script as one read-through."
                  full
                  defaultOpen={false}
                  copyText={body.script}
                >
                  <pre className="bl-live-script">{body.script}</pre>
                </BentoCard>
              )}

              {/* Inspiration videos (full width) */}
              <BentoCard
                icon={ICON_EXAMPLES}
                title="Inspiration"
                tooltip="Reference videos. Watch a few before you film to calibrate."
                full
              >
                <InspirationGrid
                  reviews={[
                    { value: f.example, videoUrl: f.example_1_video_url },
                    { value: f.example_2, videoUrl: f.example_2_video_url },
                    { value: f.example_3, videoUrl: f.example_3_video_url },
                  ]}
                  swipes={[
                    { value: f.videos, videoUrl: f.swipe_1_video_url },
                    { value: f.videos_2, videoUrl: f.swipe_2_video_url },
                    { value: f.videos_3, videoUrl: f.swipe_3_video_url },
                  ]}
                  urls={[
                    typeof f.example_video_1 === "string" ? f.example_video_1 : "",
                    typeof f.example_video_2 === "string" ? f.example_video_2 : "",
                    typeof f.example_video_3 === "string" ? f.example_video_3 : "",
                  ]}
                />
              </BentoCard>
            </div>
          )}

          {/* ============ Bottom submission CTA ============ */}
          <footer className="bl-live-footer">
            <div className={`bl-live-footer-card ${isClosed ? "is-closed" : ""}`}>
              <div className="bl-live-footer-text">
                <h3>{isClosed ? "Submissions closed" : "Ready to film?"}</h3>
                <p>
                  {!isClosed
                    ? "Hit submit when your video's ready. We'll review it against this brief and send the brand your way."
                    : quotaClosed && !dateClosed
                      ? "The brand has reached the video quota for this campaign. Check back when they open a new one."
                      : closeDate
                        ? `Submissions ended on ${closeDate}. Check back when the brand opens a new campaign.`
                        : "Check back when the brand opens a new campaign."}
                </p>
              </div>
              <button
                type="button"
                className="bl-live-cta-primary bl-live-cta-large"
                onClick={openSubmissionFlow}
                disabled={!briefId || isClosed}
              >
                <Upload size={18} />
                {isClosed ? "Submissions closed" : "Submit your video"}
              </button>
            </div>
            <div className="bl-live-footer-stamp">
              <span>Powered by</span>
              <img src={BRIEFLEE_WORDMARK} alt="Brieflee" />
            </div>
          </footer>

        </div>

        {/* v2: sticky submit bar — phones only (CSS-gated) */}
        {!isClosed && (
          <div className="bl-live-sticky">
            <span className="bl-live-sticky-name">{briefName}</span>
            <button
              type="button"
              className="bl-live-cta-primary"
              onClick={openSubmissionFlow}
              disabled={!briefId}
            >
              <Upload size={15} />
              Submit
            </button>
          </div>
        )}

        {/* v3: in-block submission panel + how-reviews-work modal */}
        {briefId ? <BriefLoader key={briefId} recordId={briefId} onState={setBriefState} /> : null}
        {workspaceId ? <AccountLoader key={workspaceId} recordId={workspaceId} onState={setAfState} /> : null}
        <UploadPanel
          open={uploadOpen}
          onClose={() => setUploadOpen(false)}
          briefId={briefId}
          f={f}
          briefName={briefName}
          submitDisabled={submitDisabled}
          onInfo={() => setInfoOpen(true)}
          uploadAsync={uploadAsync}
          isUploading={isUploading}
          onRun={runReview}
          canRun={createSubmission.enabled && createReview.enabled}
          modeLabel={modeLabel}
        />
        {infoOpen && <InfoModal onClose={() => setInfoOpen(false)} aiMode={selectLabel(f.ai_mode)} />}
      </div>
    </>
  );
}

// v2: the brand-facing preview banner with the device toggle.
