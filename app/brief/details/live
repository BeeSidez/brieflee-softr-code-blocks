// BentoCard — collapsible section card. Mirror of brief-generator hero.
// =====================================================================
function BentoCard({ title, tooltip, wide, full, defaultOpen = false, copyText, id, open: openProp, onToggle, children }) {
  // Uncontrolled by default (closed on load). The new-model path
  // controls open state from the Block so the chip nav can expand a
  // section before scrolling to it.
  const [selfOpen, setSelfOpen] = useState(!!defaultOpen);
  const open = onToggle ? !!openProp : selfOpen;
  const toggle = () => (onToggle ? onToggle() : setSelfOpen((v) => !v));
  const spanClass = full ? "bl-live-bento-full" : wide ? "bl-live-bento-wide" : "";
  return (
    <section id={id} className={`bl-live-bento-card ${spanClass}`}>
      <button
        type="button"
        onClick={toggle}
        aria-expanded={open}
        className="bl-live-bento-head"
      >
        <h3 className="bl-live-bento-title">
          {title}
          {tooltip && <InlineTooltip text={tooltip} />}
        </h3>
        <ChevronDown size={16} style={{ color: NAVY, transform: open ? "rotate(0)" : "rotate(-90deg)", transition: "transform 0.15s" }} />
      </button>
      {open && (
        <div className="bl-live-bento-body">
          {children}
          {copyText ? <CopyInlineButton text={copyText} /> : null}
        </div>
      )}
    </section>
  );
