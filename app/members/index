// ─── Import modal ─────────────────────────────────────────────
// Read the file, show what will happen, then write. Nothing is
// written until the brand presses Import, and the counts they see
// before that are the counts they get.
function ImportModal({ open, existingEmails, canWrite, onImport, onClose, onDone }) {
  const [fileName, setFileName] = useState("");
  const [headers, setHeaders] = useState([]);
  const [rows, setRows] = useState([]);
  const [map, setMap] = useState({ name: -1, email: -1, mobile: -1 });
  const [busy, setBusy] = useState(false);
  const [progress, setProgress] = useState({ done: 0, total: 0 });
  const [result, setResult] = useState(null);
  const [error, setError] = useState("");

  const reset = () => {
    setFileName(""); setHeaders([]); setRows([]);
    setMap({ name: -1, email: -1, mobile: -1 });
    setBusy(false); setProgress({ done: 0, total: 0 }); setResult(null); setError("");
  };

  const readFile = async (file) => {
    setError(""); setResult(null);
    if (!file) return;
    try {
      const text = await file.text();
      const parsed = parseCsv(text);
      if (parsed.length < 2) { setError("That file has no rows under its header."); return; }
      const head = parsed[0];
      setFileName(file.name);
      setHeaders(head);
      setRows(parsed.slice(1));
      setMap({
        name: headerIndex(head, NAME_HEADERS),
        email: headerIndex(head, EMAIL_HEADERS),
        mobile: headerIndex(head, MOBILE_HEADERS),
      });
    } catch (e) {
      setError("That file could not be read. Save it as CSV and try again.");
    }
  };

  // Every row lands in exactly one bucket, and the buckets are what
  // the summary counts.
  const analysis = useMemo(() => {
    const ready = [];
    const dupes = [];
    const invalid = [];
    const seen = new Set();
    rows.forEach((cells) => {
      const at = (i) => (i > -1 ? String(cells[i] ?? "").trim() : "");
      const email = at(map.email).toLowerCase();
      // Socials are not mapped by hand: any cell holding a profile link
      // on a platform we know is filed by its domain, so a sheet with a
      // TikTok column and an Instagram column just works.
      const entry = { name: at(map.name), email, mobile: at(map.mobile), socials: socialFieldsFrom(cells) };
      if (!email || !EMAIL_RE.test(email)) { invalid.push(entry); return; }
      if (existingEmails.has(email) || seen.has(email)) { dupes.push(entry); return; }
      seen.add(email);
      ready.push(entry);
    });
    return { ready, dupes, invalid };
  }, [rows, map, existingEmails]);

  const overCap = Math.max(0, analysis.ready.length - IMPORT_CAP);

  const run = async () => {
    const queue = analysis.ready.slice(0, IMPORT_CAP);
    const total = queue.length;
    if (!total) return;
    setBusy(true);
    setProgress({ done: 0, total });
    let done = 0;
    let failed = 0;
    const lane = async () => {
      while (queue.length) {
        const item = queue.shift();
        try { await onImport(item); } catch (e) { failed += 1; }
        done += 1;
        setProgress({ done, total });
      }
    };
    await Promise.all(Array.from({ length: Math.min(IMPORT_LANES, total) }, lane));
    setBusy(false);
    setResult({ created: total - failed, failed, dupes: analysis.dupes.length, invalid: analysis.invalid.length, overCap });
    onDone();
  };

  if (!open) return null;
  const mapped = map.email > -1;

  return (
    <div className="bl-members-modal-backdrop" onClick={() => { if (!busy) { reset(); onClose(); } }}>
      <div className="bl-members-modal" onClick={(e) => e.stopPropagation()}>
        <div className="bl-members-modal-head">
          <div>
            <h2 className="bl-members-modal-title">Import creators</h2>
            <p className="bl-members-modal-sub">
              A CSV with a name, an email and a mobile number. Everyone lands on your roster at Imported, and nobody is
              emailed until you invite them to a brief.
            </p>
          </div>
          <button className="bl-members-drawer-close" onClick={() => { if (!busy) { reset(); onClose(); } }} aria-label="Close">
            <X size={14} />
          </button>
        </div>

        <div className="bl-members-modal-body">
          {result ? (
            <div className="bl-members-result">
              <p className="bl-members-result-line"><b>{result.created}</b> {result.created === 1 ? "creator" : "creators"} added.</p>
              {result.dupes > 0 && <p className="bl-members-result-note">{result.dupes} already on your roster, skipped.</p>}
              {result.invalid > 0 && <p className="bl-members-result-note">{result.invalid} without a usable email, skipped.</p>}
              {result.failed > 0 && <p className="bl-members-result-note">{result.failed} could not be saved. Import the file again to pick them up.</p>}
              {result.overCap > 0 && <p className="bl-members-result-note">{result.overCap} past the {IMPORT_CAP} row limit. Split the file and import the rest.</p>}
            </div>
          ) : (
            <>
              <label className="bl-members-drop">
                <Upload size={18} />
                <span className="bl-members-drop-title">{fileName || "Choose a CSV file"}</span>
                <span className="bl-members-drop-sub">{fileName ? rows.length + " rows read" : "Name, email, mobile. The header row names the columns."}</span>
                <input type="file" accept=".csv,text/csv" className="bl-members-drop-input" disabled={busy}
                  onChange={(e) => readFile(e.target.files && e.target.files[0])} />
              </label>

              {error && <p className="bl-members-modal-error">{error}</p>}

              {headers.length > 0 && (
                <>
                  <div className="bl-members-map">
                    {[
                      { key: "email", label: "Email *" },
                      { key: "name", label: "Name" },
                      { key: "mobile", label: "Mobile" },
                    ].map((f) => (
                      <div key={f.key}>
                        <p className="bl-members-meta-label">{f.label}</p>
                        <select
                          className="bl-members-select bl-members-map-select"
                          value={String(map[f.key])}
                          disabled={busy}
                          onChange={(e) => setMap((m) => ({ ...m, [f.key]: Number(e.target.value) }))}
                        >
                          <option value="-1">Not in this file</option>
                          {headers.map((h, i) => (
                            <option key={i} value={String(i)}>{String(h || "Column " + (i + 1))}</option>
                          ))}
                        </select>
                      </div>
                    ))}
                  </div>

                  <div className="bl-members-counts">
                    <span className="bl-members-pill" style={statusStyle("Imported")}>{Math.min(analysis.ready.length, IMPORT_CAP)} to add</span>
                    {analysis.dupes.length > 0 && <span className="bl-members-pill" style={statusStyle("")}>{analysis.dupes.length} already here</span>}
                    {analysis.invalid.length > 0 && <span className="bl-members-pill" style={statusStyle("Pending")}>{analysis.invalid.length} no valid email</span>}
                    {overCap > 0 && <span className="bl-members-pill" style={statusStyle("Pending")}>{overCap} over the limit</span>}
                  </div>

                  {analysis.ready.length > 0 && (
                    <div className="bl-members-preview">
                      {analysis.ready.slice(0, 4).map((p, i) => (
                        <div key={i} className="bl-members-preview-row">
                          <span>{p.name || "No name"}</span>
                          <span>{p.email}</span>
                          <span>{p.mobile || "No mobile"}</span>
                        </div>
                      ))}
                      {analysis.ready.length > 4 && (
                        <p className="bl-members-none">and {analysis.ready.length - 4} more</p>
                      )}
                    </div>
                  )}
                </>
              )}
            </>
          )}
        </div>

        <div className="bl-members-modal-foot">
          {busy ? (
            <span className="bl-members-none">Adding {progress.done} of {progress.total}</span>
          ) : (
            <span className="bl-members-none">{!canWrite ? "You don't have permission to add members." : ""}</span>
          )}
          <div className="bl-members-modal-actions">
            <button className="bl-members-ghost-btn" disabled={busy} onClick={() => { reset(); onClose(); }}>
              {result ? "Done" : "Cancel"}
            </button>
            {!result && (
              <button
                className="bl-members-chip-send bl-members-primary-btn"
                disabled={busy || !canWrite || !mapped || analysis.ready.length === 0}
                onClick={run}
              >
                {busy ? "Adding\u2026" : "Import " + Math.min(analysis.ready.length, IMPORT_CAP)}
              </button>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

// ─── Drawer ───────────────────────────────────────────────────
// Name, email and mobile, read-only until Edit. Saving writes the
// three fields and nothing else, so a typo fix cannot disturb a
// member's briefs or their status.
function ContactCard({ member, canUpdate, onSave }) {
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState({ name: "", email: "", mobile: "" });
  // Socials are a row of logos, tapped one at a time, so the card
  // never turns into a column of four empty boxes.
  const [socialVals, setSocialVals] = useState({});
  const [socialOpen, setSocialOpen] = useState("");
  const [socialDraft, setSocialDraft] = useState("");
  const openSocial = (field) => {
    if (socialOpen === field) { setSocialOpen(""); return; }
    setSocialOpen(field);
    setSocialDraft(socialVals[field] || "");
  };
  const commitSocial = () => {
    const url = socialValue(socialOpen, socialDraft);
    setSocialVals((v) => {
      const next = { ...v };
      if (url) next[socialOpen] = url; else delete next[socialOpen];
      return next;
    });
    setSocialOpen("");
    setSocialDraft("");
  };
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    setEditing(false);
    setError("");
  }, [member.id]);

  const start = () => {
    setDraft({ name: member.name || "", email: member.email || "", mobile: member.mobile || "" });
    setSocialVals((member.socials || []).reduce((m, l) => { m[l.field] = l.url; return m; }, {}));
    setSocialOpen("");
    setSocialDraft("");
    setError("");
    setEditing(true);
  };

  const save = async () => {
    const email = draft.email.trim();
    if (!EMAIL_RE.test(email)) { setError("That email does not look right."); return; }
    setSaving(true);
    try {
      // Every social column is sent: one emptied here has to clear on
      // the record, not silently keep its old value.
      const socialPatch = {};
      SOCIAL_KEYS.forEach((k) => { socialPatch[k] = socialVals[k] || ""; });
      await onSave(member.id, {
        fullName: draft.name.trim(),
        email,
        mobile: draft.mobile.trim(),
        ...socialPatch,
      });
      setEditing(false);
    } catch (e) {
      setError(e.message || "That did not save. Try again.");
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="bl-members-card">
      <div className="bl-members-card-head">
        <p className="bl-members-meta-label">Contact details</p>
        {canUpdate && !editing && (
          <button className="bl-members-ghost-btn bl-members-mini-btn" onClick={start}>
            <Pencil size={12} />
            Edit
          </button>
        )}
      </div>

      {editing ? (
        <div className="bl-members-edit">
          <input className="bl-members-input" value={draft.name} placeholder="Full name" disabled={saving}
            onChange={(e) => setDraft((d) => ({ ...d, name: e.target.value }))} />
          <input className="bl-members-input" value={draft.email} placeholder="name@example.com" type="email" disabled={saving}
            onChange={(e) => setDraft((d) => ({ ...d, email: e.target.value }))} />
          <input className="bl-members-input" value={draft.mobile} placeholder="Mobile, with the country code" disabled={saving}
            onChange={(e) => setDraft((d) => ({ ...d, mobile: e.target.value }))} />
          <div className="bl-members-socials">
            {SOCIAL_HOSTS.map((h) => (
              <button
                key={h.field}
                type="button"
                title={h.label}
                aria-label={h.label}
                disabled={saving}
                className={"bl-members-socialbtn" + (socialVals[h.field] ? " is-on" : "") + (socialOpen === h.field ? " is-open" : "")}
                onClick={() => openSocial(h.field)}
              >
                <img src={h.icon} alt="" />
              </button>
            ))}
          </div>
          {socialOpen && (
            <div className="bl-members-socialrow">
              <input className="bl-members-input" value={socialDraft} autoFocus placeholder="@theirhandle or a link" disabled={saving}
                onChange={(e) => setSocialDraft(e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") { e.preventDefault(); commitSocial(); } }} />
              <button type="button" className="bl-members-chip-send" disabled={saving} onClick={commitSocial}>Save</button>
            </div>
          )}
          {error && <p className="bl-members-modal-error">{error}</p>}
          <div className="bl-members-edit-actions">
            <button className="bl-members-ghost-btn bl-members-mini-btn" disabled={saving} onClick={() => setEditing(false)}>Cancel</button>
            <button className="bl-members-chip-send" disabled={saving} onClick={save}>{saving ? "Saving\u2026" : "Save"}</button>
          </div>
        </div>
      ) : (
        <div className="bl-members-card-rows">
          <p className="bl-members-card-row"><Mail size={13} />{member.email || "No email"}</p>
          <p className="bl-members-card-row"><Phone size={13} />{member.mobile || "No mobile yet"}</p>
          {(member.socials || []).length > 0 && (
            <div className="bl-members-socials">
              {member.socials.map((l) => (
                <a key={l.field} href={l.url} target="_blank" rel="noopener noreferrer"
                   className="bl-members-socialbtn is-on" title={l.url} aria-label={l.label}>
                  <img src={SOCIAL_ICONS[l.field]} alt="" />
                </a>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

