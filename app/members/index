// Excel writes semicolons in half of Europe and tabs when a column
// holds commas, so the header row decides the delimiter.
function detectDelimiter(firstLine) {
  const scores = [",", ";", "\t"].map((d) => [d, firstLine.split(d).length - 1]);
  scores.sort((a, b) => b[1] - a[1]);
  return scores[0][1] > 0 ? scores[0][0] : ",";
}

// A quoted field can hold the delimiter, a newline, and "" for a
// literal quote, so this walks the text rather than splitting it.
function parseCsv(raw) {
  const s = String(raw || "").replace(/^\uFEFF/, "");
  const delim = detectDelimiter(s.split(/\r?\n/)[0] || "");
  const rows = [];
  let row = [];
  let field = "";
  let quoted = false;
  for (let i = 0; i < s.length; i += 1) {
    const c = s[i];
    if (quoted) {
      if (c === '"' && s[i + 1] === '"') { field += '"'; i += 1; continue; }
      if (c === '"') { quoted = false; continue; }
      field += c;
      continue;
    }
    if (c === '"') { quoted = true; continue; }
    if (c === delim) { row.push(field); field = ""; continue; }
    if (c === "\r") continue;
    if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; continue; }
    field += c;
  }
  if (field !== "" || row.length) { row.push(field); rows.push(row); }
  return rows.filter((cells) => cells.some((c) => String(c).trim() !== ""));
}

function headerIndex(headers, wanted) {
  const clean = headers.map((h) => String(h || "").trim().toLowerCase());
  for (const w of wanted) {
    const hit = clean.indexOf(w);
    if (hit > -1) return hit;
  }
  for (let i = 0; i < clean.length; i += 1) {
    if (wanted.some((w) => clean[i].includes(w))) return i;
  }
  return -1;
}

