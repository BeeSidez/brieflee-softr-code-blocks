// ─── Social links ─────────────────────────────────────────────
// A creator pastes a link, the domain says which platform it is, and
// it is filed into that column. No API, no key, no lookup. Anything
// unrecognised is kept as other_url rather than dropped.
const SOCIAL_HOSTS = [
  { field: "tiktokUrl", label: "TikTok", re: /(^|\.)tiktok\.com$/i,
    icon: "https://res.cloudinary.com/dchroynzv/image/upload/brieflee_icon_tiktok-logo-3d-transparent_2026-05.png", base: "https://www.tiktok.com/@" },
  { field: "instagramUrl", label: "Instagram", re: /(^|\.)instagram\.com$/i,
    icon: "https://res.cloudinary.com/dchroynzv/image/upload/brieflee_icon_instagram-logo-3d-transparent_2026-05.png", base: "https://www.instagram.com/" },
  { field: "youtubeUrl", label: "YouTube", re: /(^|\.)(youtube\.com|youtu\.be)$/i,
    icon: "https://res.cloudinary.com/dchroynzv/image/upload/v1779101297/brieflee_icon_youtube-logo-3d-transparent_2026-05.png", base: "https://www.youtube.com/@" },
  { field: "facebookUrl", label: "Facebook", re: /(^|\.)(facebook\.com|fb\.com|fb\.me)$/i,
    icon: "https://res.cloudinary.com/dchroynzv/image/upload/brieflee_icon_facebook-logo-3d-transparent_2026-05.png", base: "https://www.facebook.com/" },
];
const SOCIAL_KEYS = SOCIAL_HOSTS.map((h) => h.field);
const SOCIAL_ICONS = SOCIAL_HOSTS.reduce((m, h) => { m[h.field] = h.icon; return m; }, {});
// A creator types "@nia" as often as a full link, so both are taken and
// turned into the one thing worth storing: the profile URL.
function socialValue(field, raw) {
  const host = SOCIAL_HOSTS.find((h) => h.field === field);
  const v = String(raw || "").trim().replace(/^@+/, "");
  if (!host || !v) return "";
  if (!/[./]/.test(v)) return host.base + v;
  const hit = socialUrl(v);
  return hit ? hit.url : host.base + v.split("/").filter(Boolean).pop().replace(/^@+/, "");
}
const SOCIAL_POST_SEG = /^(video|reel|reels|p|status|watch|shorts|posts)$/i;
function socialUrl(raw) {
  const v = String(raw || "").trim();
  if (!v) return null;
  const withScheme = /^https?:\/\//i.test(v) ? v : "https://" + v.replace(/^\/+/, "");
  let u;
  try { u = new URL(withScheme); } catch (e) { return null; }
  // "name@example.com" parses as a URL with a username. It is an email.
  if (u.username || !u.hostname.includes(".")) return null;
  const host = u.hostname.replace(/^www\./i, "");
  const parts = u.pathname.split("/").filter(Boolean);
  // A link to one post is not a profile: keep the handle, drop the rest.
  let path = u.pathname.replace(/\/+$/, "");
  if (parts.length && SOCIAL_POST_SEG.test(parts[0])) return null;
  if (parts.length > 1 && SOCIAL_POST_SEG.test(parts[1])) path = "/" + parts[0];
  const hit = SOCIAL_HOSTS.find((h) => h.re.test(host));
  // Only the four platforms have a column, so anything else is not a
  // social we keep.
  if (!hit) return null;
  return { field: hit.field, label: hit.label, url: u.origin + path };
}
function socialFieldsFrom(list) {
  const fields = {};
  (list || []).forEach((raw) => {
    const hit = socialUrl(raw);
    if (hit && !fields[hit.field]) fields[hit.field] = hit.url;
  });
  return fields;
}

