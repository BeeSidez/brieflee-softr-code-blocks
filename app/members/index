                  {canUpdate && (
                    <button
                      className={`bl-members-chip-remove${armed ? " is-armed" : ""}`}
                      onClick={() => (armed ? onRemove(member, "project", p.id) : onArm(key))}
                    >
                      {armed ? "Confirm" : "Remove"}
                    </button>
                  )}
                </div>
              );
            })}
          </div>

          <div className="bl-members-section">
            <p className="bl-members-section-title"><Video size={13} /> Submissions ({subs.length})</p>
            {subs.length === 0 && <p className="bl-members-none">Nothing submitted yet.</p>}
            {subs.map((s) => (
              <div key={s.id} className="bl-members-sub-row">
                <div style={{ minWidth: 0 }}>
                  <p className="bl-members-chip-name">{s.name || "Submission"}</p>
                  <p className="bl-members-cell-sub">{fmtDate(s.createdAt)}{s.revised ? " · revised" : ""}</p>
                </div>
                <span className="bl-members-pill" style={outcomeStyle(s.outcome)}>{s.outcome || "IN REVIEW"}</span>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </>
  );
}

// ─── Block ────────────────────────────────────────────────────
export default function Block() {
  const user = useCurrentUser();
  const [tab, setTab] = useState("All");
  const [search, setSearch] = useState("");
  const [sortBy, setSortBy] = useState("recent");
  const [selectedId, setSelectedId] = useState(null);
  const [armedKey, setArmedKey] = useState(null);

  const [importOpen, setImportOpen] = useState(false);

  const membersQ = useRecords({ from: ds.members, select: memberSelect, count: 100 });
  const subsQ = useRecords({ from: ds.submissions, select: subSelect, count: 100 });
  // The workspace an imported creator joins. The source is filtered to
  // the accounts this user belongs to, so the first row is theirs.
  const accountsQ = useRecords({ from: ds.accounts, select: accountSelect, count: 5 });
  const accountId = accountsQ.data?.pages?.flatMap((p) => p?.items ?? [])?.[0]?.id || "";

  // Pull every page so counts cover the whole account
  useEffect(() => {
    if (membersQ.hasNextPage && !membersQ.isFetching) membersQ.fetchNextPage();
  }, [membersQ.hasNextPage, membersQ.isFetching]);
  useEffect(() => {
    if (subsQ.hasNextPage && !subsQ.isFetching) subsQ.fetchNextPage();
  }, [subsQ.hasNextPage, subsQ.isFetching]);

  const updateMember = useRecordUpdate({
    from: ds.members,
    fields: updateFields,
    onSuccess: async () => {
      await membersQ.refetch();
      toast.success("Member updated");
    },
    onError: (e) => toast.error("Update failed", { description: e.message }),
  });

  // Invite sends from the drawer: quiet update (no generic toast),
  // EmailIt through the block's REST source, one send per press.
  const updateMemberQuiet = useRecordUpdate({ from: ds.members, fields: updateFields });
  const createMember = useRecordCreate({ from: ds.members, fields: createFields });
  const emailitFetch = useProxyFetch(ds.emailit);
  const [sendingKey, setSendingKey] = useState(null);

  const members = useMemo(() => {
    const items = membersQ.data?.pages?.flatMap((p) => p?.items ?? []) ?? [];
    return items.map((r) => {
      const f = r.fields || {};
      return {
        id: r.id,
        name: text(f.fullName) || text(f.email) || "Member",
        email: text(f.email),
        status: text(f.status),
        briefs: linkArr(f.briefs),
        projects: linkArr(f.projects),
        submissionIds: linkArr(f.submissions).map((s) => s.id),
        invitedBy: text(f.invitedBy),
        invitedAt: f.invitedAt || "",
        lastActive: f.lastActive || "",
        createdAt: f.createdAt || "",
        briefLinks: Array.isArray(f.briefLinks) ? f.briefLinks.map(text) : [],
        briefStatuses: Array.isArray(f.briefStatuses) ? f.briefStatuses.map(text) : [],
        accountName: linkArr(f.accountsLink)[0]?.name || "",
        message: text(f.message),
        mobile: text(f.mobile),
        profileImage: text(f.profileImage),
        socials: SOCIAL_HOSTS
          .map((h) => ({ field: h.field, label: h.label, url: text(f[h.field]) }))
          .filter((x) => x.url),
      };
    });
  }, [membersQ.data]);

  const subsById = useMemo(() => {
    const items = subsQ.data?.pages?.flatMap((p) => p?.items ?? []) ?? [];
    const map = {};
    items.forEach((r) => {
      const f = r.fields || {};
      const outcome = text(f.reviewStatus).toUpperCase();
      const revNum = parseInt(text(f.revisionNumber), 10);
      map[r.id] = {
        id: r.id,
        name: text(f.name),
        outcome,
        revised: truthy(f.revisionsRequired) || (Number.isFinite(revNum) && revNum >= 1),
        createdAt: f.subCreatedAt || "",
      };
    });
    return map;
  }, [subsQ.data]);

  // Track record per member, computed from their submission links
  const statsById = useMemo(() => {
    const map = {};
    members.forEach((m) => {
      let approved = 0;
      let revisions = 0;
      let lastSub = "";
      m.submissionIds.forEach((sid) => {
        const s = subsById[sid];
        if (!s) return;
        if (s.outcome === "APPROVED" || s.outcome === "PASS") approved += 1;
        if (s.revised) revisions += 1;
        if (s.createdAt && s.createdAt > lastSub) lastSub = s.createdAt;
      });
      map[m.id] = {
        videos: m.submissionIds.length,
        approved,
        revisions,
        lastActive: m.lastActive || lastSub,
      };
    });
    return map;
  }, [members, subsById]);

  const tabCounts = useMemo(() => {
    const counts = { All: members.length, Imported: 0, Active: 0, Invited: 0, Pending: 0, Inactive: 0 };
    members.forEach((m) => {
      const st = m.status || "Imported";
      if (counts[st] != null) counts[st] += 1;
    });
    return counts;
  }, [members]);

  const visible = useMemo(() => {
    const term = search.trim().toLowerCase();
    let list = members.filter((m) => (tab === "All" ? true : (m.status || "Imported") === tab));
    if (term) list = list.filter((m) => m.name.toLowerCase().includes(term) || m.email.toLowerCase().includes(term));
    const sorted = [...list];
    if (sortBy === "name") sorted.sort((a, b) => a.name.localeCompare(b.name));
    else if (sortBy === "videos") sorted.sort((a, b) => (statsById[b.id]?.videos ?? 0) - (statsById[a.id]?.videos ?? 0));
    else sorted.sort((a, b) => (b.createdAt || "").localeCompare(a.createdAt || ""));
    return sorted;
  }, [members, tab, search, sortBy, statsById]);

  const selected = useMemo(() => members.find((m) => m.id === selectedId) || null, [members, selectedId]);
  const selectedSubs = useMemo(() => {
    if (!selected) return [];
    return selected.submissionIds
      .map((sid) => subsById[sid])
      .filter(Boolean)
      .sort((a, b) => (b.createdAt || "").localeCompare(a.createdAt || ""));
  }, [selected, subsById]);

  // Dedupe is on the email, lowercased, across the whole roster. The
  // members read drains its pages, so this is the account's real set.
  const existingEmails = useMemo(
    () => new Set(members.map((m) => String(m.email || "").trim().toLowerCase()).filter(Boolean)),
    [members]
  );

  const saveContact = async (recordId, fields) => {
    await updateMemberQuiet.mutateAsync({ recordId, fields });
    await membersQ.refetch();
    toast.success("Contact details saved");
  };

  const importMember = async ({ name, email, mobile, socials }) => {
    await createMember.mutateAsync({
      ...(socials || {}),
      fullName: name || "",
      email,
      mobile: mobile || "",
      status: IMPORTED_STATUS,
      accounts: accountId ? [{ id: accountId }] : [],
      users: user?.id || "",
    });
  };

  const handleArm = (key) => {
    setArmedKey(key);
    setTimeout(() => setArmedKey((cur) => (cur === key ? null : cur)), 3500);
  };

  const handleRemove = (member, kind, itemId) => {
    setArmedKey(null);
    if (!updateMember.enabled) {
      toast.error("You don't have permission to update members.");
      return;
    }
    const briefs = member.briefs.filter((b) => !(kind === "brief" && b.id === itemId)).map((b) => ({ id: b.id }));
    const projects = member.projects.filter((p) => !(kind === "project" && p.id === itemId)).map((p) => ({ id: p.id }));
    const fields = { briefs, projects };
    if (briefs.length === 0 && projects.length === 0) {
      fields.status = INACTIVE_STATUS;
    }
    updateMember.mutate({ recordId: member.id, fields });
  };

  const handleSendInvite = async (member, idx) => {
    const brief = member.briefs[idx];
    if (!brief) return;
    if (!updateMemberQuiet.enabled) {
      toast.error("You don't have permission to update members.");
      return;
    }
    const link = member.briefLinks[idx] || "";
    if (!member.email || !link) {
      toast.error("This brief has no live link yet.");
      return;
    }
    const key = member.id + ":" + brief.id;
    setSendingKey(key);
    try {
      // EmailIt renders {{#section}} even for empty strings, so keys
      // only exist when they carry text.
      const variables = {
        account: member.accountName || "",
        inviter: user?.fullName || "",
        brief_name: brief.name || "",
        link,
      };
      if (member.message) variables.message = member.message;
      const res = await emailitFetch("https://api.emailit.com/v2/emails", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": "bl-invite-" + member.id + "-" + brief.id + "-" + Math.floor(Date.now() / 60000) },
        body: JSON.stringify({
          from: "Brieflee <support@brieflee.co>",
          to: member.email,
          subject: "You have a brief from " + (member.accountName || "Brieflee"),
          template: "bl-tx-invite-brief",
          variables,
        }),
      });
      if (!res.ok) throw new Error("The email failed to send (" + res.status + "). Try again.");
      await updateMemberQuiet.mutateAsync({
        recordId: member.id,
        fields: { status: INVITED_STATUS, invitedAt: new Date().toISOString().slice(0, 10) },
      });
      toast.success("Invite sent");
      await membersQ.refetch();
    } catch (e) {
      toast.error("Send failed", { description: e.message });
    } finally {
      setSendingKey(null);
    }
  };

  const isLoading = membersQ.status === "pending";
  const firstName = (user?.fullName || "").trim().split(/\s+/)[0] || "";

  return (
    <>
      <Style />
      <div className="bl-members">
        <div className="bl-members-inner container mx-auto px-4 w-full">

          <header className="bl-members-header">
            <h1 className="bl-members-title">Members</h1>
            <p className="bl-members-greeting">
              {firstName ? `Hey ${firstName}, everyone` : "Everyone"} with access to your briefs and projects.
            </p>
          </header>

          <nav className="bl-members-tabs" role="tablist" aria-label="Member status">
            {TABS.map((t) => (
              <button key={t} className={`bl-members-tab${tab === t ? " is-active" : ""}`} onClick={() => setTab(t)}>
                {t}
                <span className="bl-members-tab-count">{tabCounts[t] ?? 0}</span>
              </button>
            ))}
          </nav>

          <div className="bl-members-controls">
            <div className="bl-members-search">
              <Search className="bl-members-search-icon" size={16} />
              <input
                type="text"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search by name or email"
                className="bl-members-search-input"
              />
              {search && (
                <button type="button" className="bl-members-search-clear" onClick={() => setSearch("")} aria-label="Clear search">
                  <X size={13} />
                </button>
              )}
            </div>
            <select value={sortBy} onChange={(e) => setSortBy(e.target.value)} className="bl-members-select" aria-label="Sort members">
              <option value="recent">Recently added</option>
              <option value="name">Name (A to Z)</option>
              <option value="videos">Most videos</option>
            </select>
            <button className="bl-members-ghost-btn" onClick={() => setImportOpen(true)}>
              <Upload size={14} />
              Import creators
            </button>
          </div>

          <div className="bl-members-table">
            <div className="bl-members-thead">
              <span>Member</span>
              <span>Briefs</span>
              <span>Projects</span>
              <span>Videos</span>
              <span>Revisions</span>
              <span>Approved</span>
              <span>Last active</span>
              <span>Status</span>
            </div>

            {isLoading && (
              <>
                <div className="bl-members-skeleton" />
                <div className="bl-members-skeleton" />
                <div className="bl-members-skeleton" />
                <div className="bl-members-skeleton" />
              </>
            )}

            {!isLoading && visible.length === 0 && (
              <div className="bl-members-empty">
                <span className="bl-members-empty-icon"><Users size={20} /></span>
                <p className="bl-members-empty-title">
                  {members.length === 0 ? "No members yet" : "Nobody matches"}
                </p>
                <p className="bl-members-empty-copy">
                  {members.length === 0
                    ? "Invite people from a brief or a project and they show up here."
                    : "Try a different search or tab."}
                </p>
              </div>
            )}

            {!isLoading && visible.map((m) => {
              const st = statsById[m.id] || { videos: 0, approved: 0, revisions: 0, lastActive: "" };
              return (
                <div key={m.id} className="bl-members-row" onClick={() => setSelectedId(m.id)}>
                  <div className="bl-members-id">
                    <span className="bl-members-avatar">
                      {m.profileImage
                        ? <img className="bl-members-avatar-img" src={m.profileImage} alt="" />
                        : initials(m.name)}
                    </span>
                    <div style={{ minWidth: 0 }}>
                      <p className="bl-members-name">{m.name}</p>
                      {/* What we can reach them on. The mobile only
                          appears once there is one, so a glance down
                          the column says who is textable. */}
                      <div className="bl-members-contacts">
                        {m.email && (
                          <span className="bl-members-contact-chip" title={m.email}>
                            <Mail size={12} />
                            {m.email}
                          </span>
                        )}
                        {m.mobile && (
                          <span className="bl-members-contact-chip" title={m.mobile}>
                            <Phone size={12} />
                            {m.mobile}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                  <div className="bl-members-cell bl-members-col-hide">
                    <span className="bl-members-num">{m.briefs.length}</span>
                    <p className="bl-members-cell-sub">{m.briefs.map((b) => b.name).filter(Boolean).join(", ")}</p>
                  </div>
                  <div className="bl-members-cell bl-members-col-hide">
                    <span className="bl-members-num">{m.projects.length}</span>
                    <p className="bl-members-cell-sub">{m.projects.map((p) => p.name).filter(Boolean).join(", ")}</p>
                  </div>
                  <span className="bl-members-num bl-members-col-hide">{st.videos}</span>
                  <span className="bl-members-num bl-members-col-hide">{st.revisions}</span>
                  <span className="bl-members-num bl-members-col-hide">{st.approved}</span>
                  <span className="bl-members-cell bl-members-col-hide">{fmtDate(st.lastActive) || "Not yet"}</span>
                  <span>
                    <span className="bl-members-pill" style={statusStyle(m.status)}>{m.status}</span>
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <ImportModal
        open={importOpen}
        existingEmails={existingEmails}
        canWrite={createMember.enabled !== false && !!accountId}
        onImport={importMember}
        onClose={() => setImportOpen(false)}
        onDone={() => membersQ.refetch()}
      />

      {selected && (
        <MemberDrawer
          member={selected}
          stats={statsById[selected.id] || { videos: 0, approved: 0, revisions: 0, lastActive: "" }}
          subs={selectedSubs}
          canUpdate={updateMember.enabled}
          armedKey={armedKey}
          onArm={handleArm}
          onRemove={handleRemove}
          onSendInvite={handleSendInvite}
          onSaveContact={saveContact}
          sendingKey={sendingKey}
          onClose={() => { setSelectedId(null); setArmedKey(null); }}
        />
      )}
    </>
  );
}
