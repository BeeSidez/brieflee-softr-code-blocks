// ─── Helpers ──────────────────────────────────────────────────

// Lookups arrive as arrays, selects as {label}: flatten anything to text
function text(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw;
  if (Array.isArray(raw)) return raw.map(text).filter(Boolean).join(", ");
  if (typeof raw === "object") return text(raw.label ?? raw.value ?? raw.title ?? raw.name ?? "");
  return String(raw);
}

function linkArr(raw) {
  if (!Array.isArray(raw)) return [];
  return raw
    .map((it) => (it && typeof it === "object" ? { id: it.id, name: text(it.label) } : null))
    .filter((it) => it && it.id);
}

function truthy(raw) {
  if (Array.isArray(raw)) return raw.some(truthy);
  return raw === true || raw === "true" || raw === 1;
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
function fmtDate(iso) {
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d.getTime())) return "";
  return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
}

function initials(name) {
  const parts = String(name || "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].slice(0, 1).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function statusStyle(status) {
  if (status === "Active") return { background: "rgba(32,149,111,0.12)", color: "#1B7A5C" };
  if (status === "Invited") return { background: "rgba(135,156,247,0.16)", color: NAVY_DEEP };
  if (status === "Pending") return { background: "rgba(252,172,0,0.16)", color: "#8A5A00" };
  if (status === "Imported") return { background: "rgba(142,78,198,0.14)", color: "#6B3AA0" };
  return { background: "rgba(107,122,153,0.14)", color: MUTED };
}

function outcomeStyle(label) {
  if (label === "APPROVED" || label === "PASS") return { background: "rgba(32,149,111,0.12)", color: "#1B7A5C" };
  if (label === "REJECTED" || label === "FAIL") return { background: "rgba(217,38,38,0.10)", color: "#B32222" };
  if (label === "FLAGGED" || label === "REVIEW") return { background: "rgba(252,172,0,0.16)", color: "#8A5A00" };
  return { background: "rgba(107,122,153,0.14)", color: MUTED };
}

