// =====================================================================
// /app/briefs/swipe-picker — modal-on-modal video picker (swipe files)
// =====================================================================
// Softr page URL: /swipe-picker (modal).
// Source: brieflee beta → videos.
//
// Opened from the chat (window.openSwModal) with:
//   ?slot=<0|1|2>           — which `videos / videos_2 / videos_3` slot
//                             the pick fills
//   ?formatIds=id1,id2,...  — (optional) format record IDs picked in
//                             the chat; videos are filtered to those
//                             formats so the user sees relevant examples
//                             first.
//
// Public / public-ish data
//   These swipe-file videos are Brieflee-curated reference content (not
//   user data). No per-user scoping needed — the videos table is shared.
//   If you want to scope (e.g. paid users only), add a visibility rule
//   on the Softr page; nothing in this block depends on user identity.
//
// On pick:
//   window.parent.postMessage({
//     type:  "brieflee:swipe-pick",
//     slot:  Number,
//     video: { id, name, videoUrl, logoUrl, brand }
//   }, "*")
//
// then close the modal.
//
// SOFTR CONFIG REQUIRED:
//   1. Page: /swipe-picker (Modal, size md)
//   2. Source tab → Database: brieflee beta → Table: videos
//   3. Visibility tab → logged-in users.
// =====================================================================

import { useState, useMemo, useEffect } from "react";
import { useRecords, q } from "@/lib/datasource";
import { Search, X, Play } from "lucide-react";

const SWIPE_PICK_MESSAGE = "brieflee:swipe-pick";
const CTX_STORAGE_KEY    = "brieflee:swipe-picker-ctx";

const select = q.select({
  name:        "0woCp",   // FORMULA
  brand:       "qmyIv",   // SELECT
  visualFormat:"VuAGy",   // SINGLE_LINE_TEXT
  videoUrl:    "FiIAK",   // URL — playable MP4 (Motion swipe-file CDN)
  logoUrl:     "V2EkP",   // URL — brand logo
  formats:     "tnMBF",   // LINKED_RECORD → formats (strict link)
  formatTags:  "nSNCc",   // SELECT multi — looser tag-based format match
});

function readQuery() {
  if (typeof window === "undefined") return { slot: 0, formatIds: [], formatNames: [] };
  // 1. Primary — sessionStorage (Softr modal strips query strings)
  try {
    const raw = sessionStorage.getItem(CTX_STORAGE_KEY);
    if (raw) {
      const ctx = JSON.parse(raw);
      return {
        slot: Number(ctx.slot) || 0,
        formatIds:   Array.isArray(ctx.formatIds)   ? ctx.formatIds   : [],
        formatNames: Array.isArray(ctx.formatNames) ? ctx.formatNames : [],
      };
    }
  } catch { /* parse error */ }
  // 2. Fallback — URL query string (if Softr happens to preserve it)
  const u = new URL(window.location.href);
  const slot = Number(u.searchParams.get("slot")) || 0;
  const rawIds   = u.searchParams.get("formatIds")   || "";
  const rawNames = u.searchParams.get("formatNames") || "";
  return {
    slot,
    formatIds:   rawIds.split(",").map((s) => s.trim()).filter(Boolean),
    formatNames: rawNames.split(",").map((s) => s.trim()).filter(Boolean),
  };
}

function unwrap(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw.trim();
  if (Array.isArray(raw)) {
    const f = raw[0];
    if (typeof f === "string") return f.trim();
    if (f?.label) return String(f.label).trim();
    if (f?.name)  return String(f.name).trim();
    return "";
  }
  if (typeof raw === "object") return raw.label || raw.name || raw.url || "";
  return String(raw);
}

function closeModal() {
  if (typeof window === "undefined") return;
  try { window.parent?.closeSwModal?.(); } catch {}
}

export default function Block() {
  const { slot, formatIds, formatNames } = useMemo(readQuery, []);
  const formatIdSet   = useMemo(() => new Set(formatIds), [formatIds]);
  const formatNameSet = useMemo(
    () => new Set(formatNames.map((n) => n.toLowerCase().trim())),
    [formatNames],
  );

  const { data, status, hasNextPage, fetchNextPage, isFetchingNextPage } = useRecords({ select, count: 100 });

  // Softr's useRecords paginates at ~100 records. Auto-load the next
  // pages so the format filter sees the whole library, not just the
  // first batch.
  useEffect(() => {
    if (hasNextPage && !isFetchingNextPage && typeof fetchNextPage === "function") {
      fetchNextPage();
    }
  }, [hasNextPage, isFetchingNextPage, fetchNextPage, data]);

  // Linked-record + multi-select fields can come back as:
  //   • Array of { id, label }    (typical)
  //   • Array of plain ID strings (fallback)
  // extractIds returns the IDs, extractLabels returns the labels.
  const extractIds = (raw) => {
    if (!raw) return [];
    const arr = Array.isArray(raw) ? raw : [raw];
    return arr.map((x) => {
      if (!x) return null;
      if (typeof x === "string") return x;
      if (typeof x !== "object") return null;
      return x.id || x.recordId || x.record_id || x.value || null;
    }).filter(Boolean);
  };
  const extractLabels = (raw) => {
    if (!raw) return [];
    const arr = Array.isArray(raw) ? raw : [raw];
    return arr.map((x) => {
      if (!x) return null;
      if (typeof x === "string") return x;
      if (typeof x !== "object") return null;
      return x.label || x.name || null;
    }).filter(Boolean);
  };

  const items = useMemo(() => {
    const pages = data?.pages;
    const rows = Array.isArray(pages)
      ? pages.flatMap((p) => p?.items ?? [])
      : (Array.isArray(data) ? data : []);
    return rows.map((r) => {
      const f = r?.fields || {};
      return {
        id: r.id,
        name: unwrap(f.name) || "Untitled video",
        brand: unwrap(f.brand),
        visualFormat: unwrap(f.visualFormat),
        videoUrl: unwrap(f.videoUrl),
        logoUrl: unwrap(f.logoUrl),
        formatIds:  extractIds(f.formats),
        formatTags: extractLabels(f.formatTags).map((s) => s.toLowerCase().trim()),
      };
    }).filter((row) => !!row.videoUrl);
  }, [data]);


  const [search, setSearch] = useState("");
  const [showAll, setShowAll] = useState(formatIdSet.size === 0 && formatNameSet.size === 0); // if no format pre-picked, show everything
  const [previewId, setPreviewId] = useState(null);

  const filtered = useMemo(() => {
    let list = items;
    // Format filter — match on EITHER the linked Formats record OR the
    // Format Tags label. Wider net catches videos tagged with overlapping
    // styles (e.g. an ASMR Demo will match both "ASMR" and "Demo").
    const filterActive = !showAll && (formatIdSet.size > 0 || formatNameSet.size > 0);
    if (filterActive) {
      list = list.filter((r) => {
        const idMatch  = r.formatIds.some((fid) => formatIdSet.has(fid));
        const tagMatch = r.formatTags.some((tag) => formatNameSet.has(tag));
        return idMatch || tagMatch;
      });
    }
    // Search
    if (search.trim()) {
      const needle = search.trim().toLowerCase();
      list = list.filter((r) =>
        r.name.toLowerCase().includes(needle) ||
        r.brand.toLowerCase().includes(needle) ||
        r.visualFormat.toLowerCase().includes(needle)
      );
    }
    return list;
  }, [items, showAll, formatIdSet, formatNameSet, search]);

  const preview = items.find((r) => r.id === previewId);

  // Click a card → instant pick + close. No two-step confirm.
  const pickAndClose = (r) => {
    if (!r || typeof window === "undefined") return;
    const target = window.parent || window;
    try {
      target.postMessage({
        type: SWIPE_PICK_MESSAGE,
        slot,
        video: {
          id: r.id,
          name: r.name,
          brand: r.brand,
          videoUrl: r.videoUrl,
          logoUrl: r.logoUrl,
        },
      }, "*");
    } catch (e) {
      console.error("postMessage failed:", e);
    }
    closeModal();
  };

  const haveFormatFilter   = formatIdSet.size > 0 || formatNameSet.size > 0;
  const formatFilterActive = !showAll && haveFormatFilter;

  return (
    <div className="min-h-[500px]" style={{ background: "#FAFBFF" }}>
      <Style />
      <div className="container mx-auto px-4 py-4 max-w-3xl">

        {/* Header (Softr's modal has its own close X — no need for ours) */}
        <header className="mb-4">
          <h2 className="text-base" style={{ color: "#000F4D", fontWeight: 600 }}>Pick from Brieflee's swipe files</h2>
          <p className="text-xs mt-0.5" style={{ color: "#7A93FF", fontWeight: 300 }}>
            {formatFilterActive
              ? `Click a video to use it. Showing examples in the chosen format${Math.max(formatIdSet.size, formatNameSet.size) > 1 ? "s" : ""}.`
              : "Click a video to use it as a reference for your creator."}
          </p>
        </header>

        {/* Search + format-filter toggle */}
        <div className="mb-3 flex gap-2 flex-wrap items-center">
          <div className="relative flex-1 min-w-[180px]">
            <Search size={14} style={{ position: "absolute", left: 12, top: "50%", transform: "translateY(-50%)", color: "#7A93FF" }} />
            <input
              type="text"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search by brand, format, name…"
              className="w-full text-sm rounded-lg pl-9 pr-3 py-2.5 bg-white"
              style={{ border: "1px solid rgba(217, 224, 255, 0.7)", color: "#001364", outline: "none" }}
            />
          </div>
          {haveFormatFilter && (
            <button
              type="button"
              onClick={() => setShowAll((cur) => !cur)}
              className="text-xs px-3 py-2 rounded-lg"
              style={{
                background: showAll ? "#fff" : "#294FF6",
                color: showAll ? "#001364" : "#fff",
                border: "1px solid " + (showAll ? "rgba(217, 224, 255, 0.7)" : "#294FF6"),
                fontWeight: 500,
              }}
            >
              {showAll ? "Show only this format" : "Show all videos"}
            </button>
          )}
        </div>

        {/* Body */}
        {status === "pending" ? (
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {Array.from({ length: 6 }).map((_, i) => <div key={i} className="bln-skel rounded-lg" style={{ aspectRatio: "9 / 16" }} />)}
          </div>
        ) : items.length === 0 ? (
          <div className="text-center py-12 rounded-xl bg-white" style={{ border: "1px dashed rgba(135, 156, 247, 0.45)" }}>
            <p className="text-sm" style={{ color: "#000F4D", fontWeight: 500 }}>No videos yet</p>
            <p className="text-xs mt-1" style={{ color: "#7A93FF", fontWeight: 300 }}>The swipe-file library is empty.</p>
          </div>
        ) : filtered.length === 0 ? (
          <div className="text-center py-10 rounded-xl bg-white" style={{ border: "1px dashed rgba(135, 156, 247, 0.45)" }}>
            <p className="text-sm" style={{ color: "#000F4D", fontWeight: 500 }}>No matches</p>
            <p className="text-xs mt-1" style={{ color: "#7A93FF", fontWeight: 300 }}>
              {formatFilterActive ? "No videos in this format. Try \"Show all videos\" above." : `No videos match "${search}".`}
            </p>
          </div>
        ) : (
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {filtered.map((r) => (
              <div
                key={r.id}
                className="rounded-lg bg-white overflow-hidden transition-all hover:shadow-md hover:-translate-y-0.5"
                style={{ border: "1px solid rgba(217, 224, 255, 0.6)", cursor: "pointer" }}
                onClick={() => pickAndClose(r)}
              >
                <div className="relative overflow-hidden" style={{ aspectRatio: "9 / 16", background: "rgba(135, 156, 247, 0.06)" }}>
                  <video
                    src={r.videoUrl}
                    muted playsInline loop autoPlay preload="metadata"
                    className="w-full h-full object-cover"
                  />
                  <button
                    type="button"
                    onClick={(e) => { e.stopPropagation(); setPreviewId(r.id); }}
                    className="absolute top-1.5 right-1.5 w-7 h-7 rounded-full flex items-center justify-center"
                    style={{ background: "rgba(0, 15, 77, 0.65)", color: "#fff", border: "none" }}
                    aria-label="Preview"
                  >
                    <Play size={12} />
                  </button>
                  {/* brand badge bottom-left */}
                  {(r.logoUrl || r.brand) && (
                    <div className="absolute bottom-1.5 left-1.5 flex items-center gap-1 px-1.5 py-1 rounded-full" style={{ background: "rgba(255, 255, 255, 0.92)", color: "#001364", fontSize: 10, fontWeight: 600, maxWidth: "70%" }}>
                      {r.logoUrl && <img src={r.logoUrl} alt="" className="w-3.5 h-3.5 rounded-full object-cover" />}
                      <span style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{r.brand || "Brand"}</span>
                    </div>
                  )}
                </div>
                <div className="px-2 py-1.5">
                  {r.visualFormat && (
                    <div className="text-[10px]" style={{ color: "#7A93FF", fontWeight: 500, textTransform: "uppercase", letterSpacing: "0.04em", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{r.visualFormat}</div>
                  )}
                  <div className="text-xs mt-0.5" style={{ color: "#000F4D", fontWeight: 500, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{r.name}</div>
                </div>
              </div>
            ))}
          </div>
        )}

      </div>

      {/* Preview lightbox */}
      {preview && (
        <div
          onClick={() => setPreviewId(null)}
          style={{ position: "fixed", inset: 0, background: "rgba(0, 15, 77, 0.55)", zIndex: 100, display: "flex", alignItems: "center", justifyContent: "center", padding: 20 }}
        >
          <div onClick={(e) => e.stopPropagation()} style={{ background: "#000", borderRadius: 12, overflow: "hidden", maxWidth: 380, width: "100%" }}>
            <div style={{ position: "relative", aspectRatio: "9 / 16", background: "#000" }}>
              <video src={preview.videoUrl} controls autoPlay loop style={{ width: "100%", height: "100%" }} />
              <button onClick={() => setPreviewId(null)} aria-label="Close preview"
                style={{ position: "absolute", top: 8, right: 8, width: 32, height: 32, borderRadius: 999, background: "rgba(255,255,255,0.92)", color: "#001364", display: "inline-flex", alignItems: "center", justifyContent: "center", border: "none" }}>
                <X size={16} />
              </button>
            </div>
            <div style={{ padding: "10px 12px", color: "#fff", fontSize: 13, fontWeight: 500, display: "flex", alignItems: "center", gap: 8 }}>
              {preview.logoUrl && <img src={preview.logoUrl} alt="" style={{ width: 18, height: 18, borderRadius: 999, objectFit: "cover" }} />}
              <span>{preview.brand || ""}{preview.visualFormat ? ` · ${preview.visualFormat}` : ""}</span>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}

function Style() {
  return (
    <style>{`
      @import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700&display=swap');
      * { font-family: 'League Spartan', sans-serif; }
      .bln-skel {
        background: linear-gradient(120deg, rgba(217, 224, 255, 0.5) 30%, rgba(240, 244, 255, 1) 50%, rgba(217, 224, 255, 0.5) 70%);
        background-size: 200% 100%;
        animation: blnShimmer 1.2s ease-in-out infinite;
      }
      @keyframes blnShimmer {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
    `}</style>
  );
}
