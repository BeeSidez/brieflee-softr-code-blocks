// The 19 Brief Bible sections, verbatim from Notion (via the design's
// bible.js): what/why copy, placeholder, worked example (Luna Roca),
// and the AI generation prompt.
const RAW_BIBLE = [
  {
    n: 1, name: "Brand", icon: "sparkles", format: "text",
    what: "The belief. Your mission and USPs, the reasons this brand is worth backing. Reads persuasively, the way a good sales letter does.",
    why: "Creators convert harder when they believe in what they're repping. Audiences tell a product being flogged from a brand being backed.",
    includes: ["Who you are (brand + what you make)", "Why the brand exists (the mission)", "The USPs that make people care: ownership story, where and how it's made, what it stands for"],
    worked: `<p>We are Luna Roca, and we've created the ultimate solution for instant, shine-free skin: the Volcanic Roller. Made from real volcanic stone, it's a reusable and sustainable tool that absorbs excess oil instantly without smudging makeup.</p>`,
    placeholder: `<p>We are [Brand], and we've created [the solution] for [target outcome]: [Product]. Made from [material or method], it's [USP one] and [USP two] that [core benefit] without [the usual trade-off].</p><p>[Brand] is [ownership or origin story, e.g. mum-owned, made in Britain], and we believe [the stand the brand takes].</p>`,
    prompt: "You are writing the Brand section of a creator brief for [BRAND NAME or WEBSITE URL]. This section is the opening of the brief and needs to make a creator want to work with the brand. Write it persuasively, the way a strong sales letter opens, but keep it factual. Open with a product-led sentence: \"We are [Brand], and we've created [the solution] for [target outcome]: [Product]. Made from [material or method], it's [USP one] and [USP two] that [core benefit] without [the usual trade-off].\" Add a belief line underneath only if there's a genuine ownership story. No em dashes, British spelling, two to four sentences, concrete and specific."
  },

  {
    n: 2, name: "The Offer", icon: "tag", format: "text",
    what: "The deal. What the creator gets in return: money, gift in kind, or a stack of both. The plain answer to \u201cwhat's in it for me.\u201d",
    why: "This is the line a creator decides on. Bury it and they pass. Creators run a business and need to see the return before they give you their time.",
    includes: ["Offer type: money, gift in kind, or both", "Components: fee, commission, bonus, prize, gifted product, discount, access", "Structure: flat, per sale, or tiered", "How they get it, when they're paid", "Optional: the Brieflee free-feedback perk"],
    worked: `<p><b>Offer type:</b> Money, with a gifted product.</p><p><b>The deal:</b> 15% commission on every Volcanic Roller sold through your TikTok Shop link, a full product set gifted to film with, and a rising rate: hit 50 sales in a month and you move to 20%, 100 and you move to 25%. Top seller each month takes a \u00a3150 bonus.</p><p><b>Structure:</b> performance, tiered by monthly sales.</p><p><b>How you get it:</b> your unique TikTok Shop link, paid monthly once sales clear the return window.</p><p><b>Free feedback:</b> drop your video into Brieflee before you post for free AI feedback on what's working and anything that might get flagged.</p>`,
    placeholder: `<p><b>Offer type:</b> Money [+ gifted product]</p><p><b>The deal:</b> [X]% commission on every sale through your TikTok Shop link[, a product set gifted, and a rising rate: hit [N] sales and move to [Y]%]. [Top seller each month takes a \u00a3[amount] bonus.]</p><p><b>Structure:</b> performance[, tiered by monthly sales].</p><p><b>How you get it:</b> your unique link, paid monthly once sales clear the return window.</p><p><b>Free feedback:</b> drop your video into Brieflee before you post for free AI feedback.</p>`,
    prompt: "You are writing the Offer section of a creator brief for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator. Every offer is money and/or gift in kind, most stack. Match to type: Affiliate leads with commission per sale; Influencer with a flat fee per deliverable; UGC with a flat fee per video plus usage; Customer with a gift in kind; Employee Ambassador with vouchers/perks. Optionally add the Brieflee free-feedback perk, framed as a benefit not a rule. Write two or three concrete stacked options with real numbers. No em dashes, British spelling."
  },

  {
    n: 3, name: "Audience / Customer", icon: "users", format: "text",
    what: "The person on the other end of the camera. Who they are, what they care about, the problem in their life, and how the creator should hold themselves toward them.",
    why: "A creator who can picture exactly who they're talking to makes content that lands as a recommendation, not an advert. Without it they perform to no one, or sell too hard.",
    includes: ["Who they follow, where they spend time, whose taste they trust", "The problem, pitched at their real awareness level (often normalised background friction)", "The creator's stance: the friend who found it first, not a spokesperson"],
    worked: `<p>You're talking to someone who follows skincare and makeup creators, saves get-ready-with-me videos, and cares about their face looking fresh from morning to night. They're the friend everyone asks for product recommendations. They already know the shine problem: by midday their T-zone is greasy, their makeup starts to slide, and blotting with tissue just lifts the makeup off with it. But they've made peace with it, so they've never gone looking for a fix. Your job is to be the person who shows them there is one. Not by selling at them, but by being genuinely excited about how your skin still looks hours in. You're not an advert, you're the friend who found the thing and can't stop talking about it.</p>`,
    placeholder: `<p>You're talking to someone who follows [the creators and world this audience lives in], [a habit that shows their taste], and cares about [what they value]. They're [their role in their circle]. They already know [the problem]: [how it actually shows up, in concrete detail]. But they've made peace with it, so they've never gone looking for a fix. Your job is to be the person who shows them there is one. Not by selling at them, but by being genuinely enthusiastic about [the better state the product gives you]. You're not an advert, you're the friend who found the thing and can't stop talking about it.</p>`,
    prompt: "You are writing the Audience section of a creator brief for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator. Present tense, second person, to the creator about who they're talking to. Three moves: paint who the audience is; name the problem at their real awareness level (usually normalised background friction, in concrete physical detail); set the creator's stance as the friend who found it first, not a spokesperson. One tight paragraph. No em dashes, British spelling."
  },

  {
    n: 4, name: "Product / Feature", icon: "package", format: "text",
    what: "The product itself, said plainly. What it is, what it does, and the handful of things it's known for. The creator's factual reference.",
    why: "A creator can't talk credibly about something they don't understand. This is the ground truth they build from.",
    includes: ["What the product is, in plain terms", "What it's designed to do or replace", "The two or three USPs it's known for"],
    worked: `<p>The Volcanic Roller is a reusable oil-absorbing tool designed to replace disposable blotting papers. Made from real volcanic stone, it lifts excess oil off your skin in seconds without touching your makeup, and a quick wash brings it back to new, so one roller lasts where a pack of papers runs out. It's known for being reusable, mess-free, and kind to both your skin and the planet.</p>`,
    placeholder: `<p>[Product] is a [category, in plain terms] designed to [what it does or replaces]. Made from [material or method], it [core benefit, how it works] without [the usual trade-off], and [a second USP that sets it apart]. It's known for being [two or three qualities it's recognised for].</p>`,
    prompt: "You are writing the Product section of a creator brief for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator. Present tense, third person, plain and factual, free of hype. Cover: what the product is (its category), what it does and who for, and the two or three qualities it's genuinely known for. Descriptive not persuasive. Two or three sentences. No em dashes, British spelling."
  },

  {
    n: 5, name: "Creator Benefits", icon: "gift", format: "bulletList",
    what: "Why the creator personally wins. For commission-led creators the money case first; for fee-led creators, the benefits beyond the fee.",
    why: "A creator sizing up a brief they've never worked on needs to believe it's worth their effort. Land that and they're in.",
    includes: ["The earning case (commission-led): proof it converts, and the brand boosts their best videos", "The content win: what the product does for their videos", "The personal win: how it fits their life", "The growth win: boosting, whitelisting, repeat work, access"],
    worked: `<p><b>Why creators love it:</b></p><ul><li><b>This one sells:</b> the Volcanic Roller is our top mover on TikTok Shop, with videos regularly passing six figures in views, converting because the result is visible on camera. When it flies, your commission flies with it.</li><li><b>We back your best:</b> we actively boost your top-performing videos to put them in front of new audiences, so a good video keeps earning long after you post it.</li><li><b>The wow factor:</b> an instant on-camera before and after that stops the scroll and does half the selling for you.</li><li><b>Your travel bestie:</b> the go-to tool for staying matte on the go, no more bathroom trips blotting oil with loo roll.</li></ul>`,
    placeholder: `<p><b>Why creators love it:</b></p><ul><li><b>This one sells:</b> [proof it converts, e.g. top mover, visible result], and when it flies your commission flies with it.</li><li><b>[The growth win]:</b> [how the brand compounds earnings, e.g. we boost your best videos].</li><li><b>[The content win]:</b> [what it does on camera].</li><li><b>[The personal win]:</b> [how it fits their life].</li></ul>`,
    prompt: "You are writing the Creator Benefits section for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator whose offer is [OFFER TYPE: commission-led or fee-led]. If commission-led, open with the earning case (proof it sells, and the brand compounds it by boosting), money first. If fee-led, lead with benefits beyond the fee (content, ease of shooting, portfolio, fit, repeat work). Three or four short benefits, each a bold label with one line under. Warm, concrete. No em dashes, British spelling."
  },

  {
    n: 6, name: "Deliverables", icon: "check-square", format: "bulletList",
    what: "What to make. The number, the specs, how it's delivered, and the timing. The unambiguous definition of done.",
    why: "Vague deliverables are where briefs fall apart: wrong length, wrong ratio, one video when you needed three.",
    includes: ["Output: how many videos, variants, duration, sizes (9:16, 1:1, 16:9)", "Delivery: raw, edited or both, and channels", "Timing: submission open/close dates, or a posting window"],
    worked: `<p><b>Output:</b> 3 videos, each with a different hook. 20 to 30 seconds. Output sizes: 9:16.</p><p><b>Delivery:</b> final edited video in your signature style, plus raw footage for additional usage. Channels: TikTok, Meta.</p><p><b>Timing:</b> submissions open on receipt of product, close 10 days later.</p>`,
    placeholder: `<p><b>Output:</b> [number] video(s)[, each with a different hook / plus a polished cut and a raw cut]. [duration]. Output sizes: [9:16 / 1:1 / 16:9].</p><p><b>Delivery:</b> [final edited video / raw footage / both]. Channels: [channels].</p><p><b>Timing:</b> [submissions open [date], close [date] / posting window is [window]].</p>`,
    prompt: "You are writing the Deliverables section for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator. Plain spec grouped into output, delivery, timing. UGC is a file handover on submission dates; Influencers/Affiliates/Employees post native with a posting window. Real numbers over vague ranges. No em dashes, British spelling."
  },

  {
    n: 7, name: "Hook", icon: "zap", format: "table",
    what: "The opening three seconds, built as three components that fire together: caption on screen, visual action on camera, first spoken words. Options to test.",
    why: "Three seconds decides whether the rest gets watched. The single biggest lever on whether content performs.",
    includes: ["Caption hook: on-screen text, works on mute", "Visual action hook: the first 1\u20132 seconds on camera", "Voiceover hook: the first words spoken, oddly specific", "Awareness stage + psychological trigger"],
    worked: `<p><b>Hook 1 (warm, demo led)</b></p><ul><li><b>Caption:</b> This removes oil without ruining your makeup</li><li><b>Visual action:</b> roll the stone down the T-zone, oil visibly lifting off</li><li><b>Voiceover:</b> \u201cWatch how much oil this pulls off my face.\u201d</li></ul><p><b>Hook 2 (cold, call-out)</b></p><ul><li><b>Caption:</b> If your face gets shiny by noon, you need this</li><li><b>Visual action:</b> close on a shiny T-zone in daylight, then the first roll</li><li><b>Voiceover:</b> \u201cOily skin girls, this one's for you.\u201d</li></ul><p><b>Hook 3 (warm, confession)</b></p><ul><li><b>Caption:</b> I stopped using blotting papers because of this</li><li><b>Visual action:</b> pick the roller up like you're not convinced</li><li><b>Voiceover:</b> \u201cI didn't think this would work until I tried it.\u201d</li></ul>`,
    placeholder: `<p><b>Hook [n] ([awareness stage], [trigger])</b></p><ul><li><b>Caption:</b> [on-screen text, works on mute]</li><li><b>Visual action:</b> [what's on camera in the first 1 to 2 seconds]</li><li><b>Voiceover:</b> [the first words, oddly specific]</li></ul><p>At lighter detail, drop to a list of 5 to 8 voiceover or caption lines to test, varied across types.</p>`,
    prompt: "You are writing the Hook section for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator. Creator-led only (brand-led hooks live in the Script). Three components together: caption (works on mute), visual action (first 1\u20132s), voiceover (first words). Choose by persona, then format, then awareness stage. Caption and voiceover complement, never duplicate. Oddly specific beats vague. Offer several varied options. No em dashes, British spelling."
  },

  {
    n: 8, name: "Talking Points", icon: "message-square", format: "bulletList",
    what: "Talking Points and Script are the same slot filled two ways, never both. Creator-led uses Talking Points; brand-led uses Script.",
    why: "Left to guess, a creator hits generic points that convince no one. Give them the angles that matter, without scripting every word.",
    includes: ["The buying trigger, made specific", "The honest hesitation", "The proof: material, build, guarantee", "The before and after", "A soft, conversational CTA"],
    worked: `<p><b>Talking points to hit</b></p><ul><li><b>What finally made you try it?</b> The midday shine, the makeup sliding, blotting with loo roll and lifting half your makeup off with it. Make it specific and personal.</li><li><b>What were you sceptical about?</b> Maybe you thought a stone couldn't do much, or that it'd shift your makeup. Be honest about the hesitation.</li><li><b>The material and how it works.</b> Real volcanic stone, reusable and washable, not a disposable you keep rebuying. Lifts oil, leaves makeup.</li><li><b>How your day actually changed.</b> Still matte at 3pm, no bathroom trips, one small tool that lives in your bag.</li><li><b>Soft CTA.</b> Land on something like \u201cif you're still blotting with loo roll, just try this.\u201d Conversational, not salesy.</li></ul>`,
    placeholder: `<p><b>Talking points to hit</b></p><ul><li><b>What finally made you try it?</b> [the trigger and pain, made specific]. Make it personal.</li><li><b>What were you sceptical about?</b> [the honest hesitation]. Be honest.</li><li><b>The material and how it works.</b> [build, mechanism, any guarantee].</li><li><b>How your day actually changed.</b> [the before and after, in real detail].</li><li><b>Soft CTA.</b> [conversational close].</li></ul>`,
    prompt: "You are writing the Talking Points section for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator. Creator-led only (brand-led uses Script). Second person, present tense, prompts that pull the right things out of them, not a word-for-word script. Story-led types (Customer, Influencer) get questions that draw out real experience; sell-led types (Affiliate, UGC) get the actual selling points and lines. About five points, each a clear direction. Keep the honest hesitation in. No em dashes, British spelling."
  },

  {
    n: 9, name: "Script", icon: "file-text", format: "table",
    what: "The brand-led counterpart to Talking Points. You own the words, the creator performs them. Written as a storyboard, scene by scene.",
    why: "For brand-led content, a storyboard puts the beats in order, scripts the lines that must land, and places on-screen text where it sells, so the cut comes back right first time.",
    includes: ["Three hook variants (1A/1B/1C) to test", "Beats from the menu: On-ramp, Problem, Agitation, Demonstration, Proof, Trust Builder (risk reversal), CTA, Outro", "One capture per scene: A-roll and B-roll are separate numbered scenes", "Per scene: Script, On-screen text, Visual"],
    worked: `<table><thead><tr><th>Scene</th><th>Section</th><th>Script (spoken)</th><th>On screen</th><th>Visual</th></tr></thead><tbody><tr><td>1A</td><td>Hook A</td><td>\u201cWatch how much oil this pulls off my face.\u201d</td><td>oily skin? watch this \uD83D\uDC40</td><td>Extreme close-up on the T-zone, roll the stone down, oil lifting onto it.</td></tr><tr><td>1B</td><td>Hook B</td><td>\u201cIf your face gets shiny by noon, you need this.\u201d</td><td>POV: shine-free till 5pm</td><td>Face to camera in daylight, hold the shiny cheek to lens, then the first roll.</td></tr><tr><td>1C</td><td>Hook C</td><td>\u201cI stopped using blotting papers because of this.\u201d</td><td>throw the blotting papers away \uD83D\uDDD1\uFE0F</td><td>Toss a pack of blotting papers out of frame, pick up the roller.</td></tr><tr><td>3</td><td>Problem</td><td>\u201cBy lunchtime I'm shiny, my makeup slides, and blotting lifts half of it off.\u201d</td><td></td><td>Face to camera by a window.</td></tr><tr><td>5</td><td>Demonstration</td><td>\u201cYou just roll it over the shine. No rubbing, no powder.\u201d</td><td>no powder, no touch-ups \uD83D\uDE4C</td><td>Creator doing one pass across forehead and nose, to camera.</td></tr><tr><td>9</td><td>Trust Builder</td><td>\u201cOne roller lasts months, and if it doesn't keep you matte, send it back.\u201d</td><td>washable \u00b7 reusable \u00b7 guaranteed</td><td>Creator rinsing the stone under a tap, holding it back up clean.</td></tr><tr><td>11</td><td>CTA (soft)</td><td>\u201cIf you're still blotting with loo roll at your desk, just give it a go.\u201d</td><td></td><td>Creator to camera, easy shrug, product in hand.</td></tr></tbody></table>`,
    placeholder: `<table><thead><tr><th>Scene</th><th>Section</th><th>Script (spoken)</th><th>On screen</th><th>Visual</th></tr></thead><tbody><tr><td>1A</td><td>Hook A</td><td>[hook line one]</td><td>[on-screen text, if it adds a payoff]</td><td>[the single thing filmed, with shot and framing]</td></tr><tr><td>1B</td><td>Hook B</td><td>[hook line two]</td><td>[on-screen text]</td><td>[the single thing filmed]</td></tr><tr><td>[n]</td><td>[beat]</td><td>[the words spoken, or blank for B-roll]</td><td>[strategic on-screen text]</td><td>[the single thing filmed]</td></tr><tr><td>[n]</td><td>Trust Builder</td><td>[the line that removes the risk]</td><td>[reassurance text]</td><td>[what shows the risk reversal]</td></tr><tr><td>[n]</td><td>CTA (soft)</td><td>[conversational nudge, not a hard sell]</td><td>[link prompt]</td><td>[creator with product, then a clean product shot]</td></tr></tbody></table>`,
    prompt: "You are writing the Script section for [BRAND NAME or WEBSITE URL], for a [CREATOR TYPE] creator. Brand-led only. Storyboard, scene by scene. Open with three hook variants (1A/1B/1C). Build from the beat menu (On-ramp, Problem, Agitation, Solution Intro, Product Intro, Demonstration, Proof, Trust Builder, CTA, Outro), only the beats needed. Include a risk-reversal under Trust Builder and close soft. Number every scene, one capture each; A-roll and B-roll are separate scenes. Per scene give Script, On-screen text, Visual. No em dashes, British spelling."
  },

  {
    n: 10, name: "Visual Format", icon: "layout", format: "text", special: "visual",
