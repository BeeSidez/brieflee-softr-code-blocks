function DateTimeField({ label, tooltip, value, onSave }) {
  const [draft, setDraft] = useState(toDateInput(value));
  const [saving, setSaving] = useState(false);
  useEffect(() => { setDraft(toDateInput(value)); }, [value]);
  const commit = async () => {
    if (draft === toDateInput(value)) return;
    setSaving(true);
    try { await onSave(fromDateInput(draft)); } finally { setSaving(false); }
  };
  return (
    <div className="bl-bd-field">
      <label className="bl-bd-field-label">
        {label}
        <TooltipIcon text={tooltip} />
      </label>
      <div className="bl-bd-field-value">
