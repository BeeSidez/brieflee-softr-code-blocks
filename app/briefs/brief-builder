function generateSlug(name, briefId) {
  if (!briefId) return "";
  const base = String(name || "untitled")
    .toLowerCase()
    .replace(/['‘’“”]/g, "")
    .replace(/[^\w\s-]/g, " ")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "")
