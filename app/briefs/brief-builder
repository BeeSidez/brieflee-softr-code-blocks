// ─── Section parts ────────────────────────────────────────────
// Multi-field sections are made of parts. A part knows its kind
// (how it renders) and its field aliases. These helpers answer
// "does this part hold anything", build the clear-patch used when
// a part or section is removed, and encode/decode section_order,
// which persists both the section order and the visible parts as
// "brand,offer:deal+fee,guidelines:dos+makesure".
function fieldHasValue(v) {
  if (v == null || v === "") return false;
  if (Array.isArray(v)) return v.length > 0;
  if (typeof v === "string") return !!v.trim();
  if (typeof v === "object") return !!(v.id || v.label);
  return true;
}
function partHasContent(part, f) {
  if (part.kind === "makesure") {
    if (typeof f.make_sure === "string" && f.make_sure.trim()) return true;
    if (asArray(f.qa_checklist).length) return true;
    return (part.fields || []).some((a) => {
      if (a === "qa_checklist" || a === "make_sure") return false;
      const label = f[a]?.label || "";
      return label && !/^none\b/i.test(String(label));
    });
  }
  return (part.fields || []).some((a) => fieldHasValue(f[a]));
}
function sectionHasContent(entry, f) {
  return (entry.parts || []).some((p) => partHasContent(p, f));
}
// What clearing a part means, by kind. Removal writes these values.
function partClearPatch(part) {
  const patch = {};
  (part.fields || []).forEach((a) => {
    if (part.kind === "html" || part.kind === "url" || part.kind === "urls" || part.kind === "dates") patch[a] = "";
    else if (part.kind === "select" || part.kind === "length") patch[a] = null;
    else if (part.kind === "chips-multi" || part.kind === "picks" || part.kind === "swipes" || part.kind === "format") patch[a] = [];
    else if (part.kind === "makesure") patch[a] = a === "make_sure" ? "" : a === "qa_checklist" ? [] : null;
    else if (part.kind === "document") patch[a] = a === "attachment" ? [] : "";
    else patch[a] = "";
  });
  return patch;
}
function encodeOrder(order, partsMap) {
  return order.map((k) => {
    const e = SECTIONS.find((x) => x.key === k);
    if (!e || (e.parts || []).length < 2) return k;
    const vis = partsMap[k] && partsMap[k].length ? partsMap[k] : e.parts.map((p) => p.key);
    return k + ":" + vis.join("+");
  }).join(",");
}
function parseOrder(raw) {
  const order = [];
  const partsMap = {};
  String(raw || "").split(",").map((s) => s.trim()).filter(Boolean).forEach((tok) => {
    const [k, rest] = tok.split(":");
    const e = SECTIONS.find((x) => x.key === k);
    if (!e || order.includes(k)) return;
    order.push(k);
    const all = (e.parts || []).map((p) => p.key);
    if (rest) {
      const vis = rest.split("+").filter((pk) => all.includes(pk));
      partsMap[k] = vis.length ? vis : all;
    } else {
      partsMap[k] = all;
    }
  });
  return { order, partsMap };
}
// The plain-text version of one part, for the compiled description.
function partPlainText(part, all) {
  if (part.kind === "html") {
    return (part.fields || []).map((a) => stripHtmlText(all[a])).filter(Boolean).join("\n");
  }
  if (part.kind === "url") {
