      const touched = SECTIONS.filter((e) => e.parts.some((p) => p.fields.some((a) => a in patch)));
      const nextOrder = [...order];
      const nextParts = { ...secParts };
      touched.forEach((e) => {
        if (!nextOrder.includes(e.key)) {
          nextOrder.push(e.key);
          nextParts[e.key] = e.parts.map((p) => p.key);
        }
      });
      setOrder(nextOrder);
      setSecParts(nextParts);
      setBodies((cur) => ({ ...cur, ...patch }));
      revRef.current += 1;
      patch.section_order = encodeOrder(nextOrder, nextParts);
      saveField(patch, "brief migration").then(() => toast.success("Brief upgraded to sections"));
    }
  }, [record]); // eslint-disable-line

  const persistOrder = (nextOrder, nextParts, extraPatch = {}, label = "sections") => {
    setOrder(nextOrder);
    setSecParts(nextParts);
    saveField({ section_order: encodeOrder(nextOrder, nextParts), ...extraPatch }, label);
  };
  const addSection = (key) => {
    if (order.includes(key)) { removeSection(key); return; }
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const nextParts = { ...secParts, [key]: entry.parts.map((p) => p.key) };
    persistOrder([...order, key], nextParts);
  };
  const removeSection = (key) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const nextOrder = order.filter((k) => k !== key);
    const nextParts = { ...secParts };
    delete nextParts[key];
    const patch = {};
    entry.parts.forEach((p) => Object.assign(patch, partClearPatch(p)));
    setBodies((cur) => {
      const n = { ...cur };
      entry.parts.forEach((p) => (p.fields || []).forEach((a) => { if (p.kind === "html") n[a] = ""; }));
      return n;
    });
    revRef.current += 1;
    persistOrder(nextOrder, nextParts, patch, "section removed");
  };
  const moveSection = (key, dir) => {
    const i = order.indexOf(key);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= order.length) return;
    const next = order.slice();
    const tmp = next[i]; next[i] = next[j]; next[j] = tmp;
    persistOrder(next, secParts, {}, "section order");
  };
  const addPart = (key, partKey) => ensureSectionPart(key, partKey, {}, "part added");
  const removePart = (key, partKey) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const cur = secParts[key] || entry.parts.map((p) => p.key);
    const vis = cur.filter((pk) => pk !== partKey);
    if (!vis.length) { removeSection(key); return; }
    const part = entry.parts.find((p) => p.key === partKey);
    const patch = part ? partClearPatch(part) : {};
    if (part && part.kind === "html") {
      setBodies((curB) => {
        const n = { ...curB };
        (part.fields || []).forEach((a) => { n[a] = ""; });
        return n;
      });
      revRef.current += 1;
    }
    persistOrder(order, { ...secParts, [key]: vis }, patch, "part removed");
  };
  const togglePart = (key, partKey) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const cur = order.includes(key) ? (secParts[key] || entry.parts.map((p) => p.key)) : [];
    if (cur.includes(partKey)) removePart(key, partKey);
    else addPart(key, partKey);
  };

  const setBody = (alias, html) => setBodies((cur) => ({ ...cur, [alias]: html }));
  const commitBody = (alias) => {
    const html = bodies[alias] || "";
    const saved = typeof f[alias] === "string" ? f[alias] : "";
    if (html === saved) return;
    saveField({ [alias]: stripHtmlText(html) ? html : "" }, alias);
  };

  // ─── Write with AI (useProxyFetch → OpenRouter) ────────────
  const aiWrite = async (key) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry || !entry.prompt) return;
    // Only write the parts currently on the page — a hidden part
    // must never receive invisible content.
    const visKeys = secParts[key] || (entry.parts || []).map((p) => p.key);
    const aliases = (entry.aiFields || []).filter((a) => {
      const part = (entry.parts || []).find((x) => (x.fields || [])[0] === a);
      return !part || visKeys.includes(part.key);
    });
    if (!aliases.length) return;
    setWriting((c) => ({ ...c, [key]: true }));
    try {
      const af = account?.fields || {};
      const brandName = af.accountName || "";
      const site = unwrap(af.accountWebsite) || "";
      const ct = selectLabel(f.creator_type) || "UGC";
      const fmtName = selectLabel(f.first_format) || selectLabel(f.format) || "the chosen format";
      const prompt = entry.prompt
        .replaceAll("[BRAND NAME or WEBSITE URL]", `${brandName}${site ? " (" + site + ")" : ""}` || "the brand")
        .replaceAll("[CREATOR TYPE]", ct)
        .replaceAll("[OFFER TYPE: commission-led or fee-led]", ct === "Affiliate" ? "commission-led" : "fee-led")
        .replaceAll("[VISUAL FORMAT]", fmtName);
      const context = [
        af.accountBrandBio ? "Brand bio: " + af.accountBrandBio : "",
        af.contentStyle ? "Content style: " + af.contentStyle : "",
        af.accountAudience ? "Audience: " + stripHtmlText(af.accountAudience) : "",
        af.productOrFeature1 ? "Product/feature: " + stripHtmlText(af.productOrFeature1) : "",
        typeof f.product_feature_description === "string" && f.product_feature_description ? "Brief target: " + stripHtmlText(f.product_feature_description) : "",
        selectLabel(f.channel) ? "Channel: " + selectLabel(f.channel) : "",
        selectLabel(f.awareness) ? "Awareness stage: " + selectLabel(f.awareness) : "",
      ].filter(Boolean).join("\n");
      const partLabels = aliases.map((a) => {
        const p = (entry.parts || []).find((x) => (x.fields || [])[0] === a);
        return (p && p.label) || a;
      });
      const partInstruction = aliases.length > 1
        ? "\n\nReturn exactly " + aliases.length + " parts in this order — " + partLabels.join(", ") +
        " — separated by a line containing only ===PART===. Each part is clean HTML with no heading of its own."
        : "";
      const res = await proxyFetch("https://openrouter.ai/api/v1/chat/completions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "anthropic/claude-sonnet-4.5",
          messages: [
            { role: "system", content: "You write single sections of creator briefs. Return ONLY the section content as clean HTML using <p>, <ul><li>, <b>, or a <table> if the format calls for it. No preamble, no headings, no code fences. NEVER use em dashes. British spelling." },
            { role: "user", content: prompt + "\n\nBrand context:\n" + (context || "(none on file)") + partInstruction + "\n\nWrite the section now." },
          ],
          temperature: 0.7,
        }),
      });
      if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
      const json = await res.json();
      const out = (json?.choices?.[0]?.message?.content || "").trim().replace(/^```html?/i, "").replace(/```$/, "").trim();
      if (!out) throw new Error("Empty response");
      const parts = aliases.length > 1
        ? out.split(/\n?\s*===PART===\s*\n?/).map((p) => p.trim()).filter(Boolean)
        : [out];
      const patch = {};
      const nextBodies = {};
      aliases.forEach((a, i) => {
        const html = parts.length === aliases.length ? parts[i] : (i === 0 ? out : "");
        nextBodies[a] = html;
        patch[a] = html;
      });
      setBodies((cur) => ({ ...cur, ...nextBodies }));
      revRef.current += 1;
      await saveField(patch, entry.name);
      toast.success(entry.name + " written");
    } catch (e) {
      console.error("[brief-builder] AI write failed:", e);
      toast.error("Couldn't write with AI", {
        description: (e?.message || "") + " — check the OpenRouter REST API datasource in this block's Source tab.",
        duration: 9000,
      });
    } finally {
      setWriting((c) => ({ ...c, [key]: false }));
    }
  };

  // ─── Modules ──────────────────────────────────────────────
  // Blueprint pulls append live workspace content into their section;
  // generic inserts (Embed, Media, Music, Asset Links, Variant Info,
  // Channel) append a labelled block into Extra's notes.
  const [railPrompt, setRailPrompt] = useState(null); // { mod } while an insert asks for input
  const [slotPicker, setSlotPicker] = useState(null); // { mod, slots } for Product/Feature Info
  const mediaFileRef = useRef(null);
  const [mediaSaving, setMediaSaving] = useState(false);

  const scrollToSection = (key) => {
    setTimeout(() => {
      try { document.getElementById("bl-sec-" + key)?.scrollIntoView({ behavior: "smooth", block: "start" }); } catch { }
    }, 250);
  };
  // Put a section on the page (and make one of its parts visible)
  // in a single state pass + a single save, so module clicks never
  // race two writes on stale state.
  const ensureSectionPart = (key, partKey, extraPatch = {}, label = "section") => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const inOrder = order.includes(key);
    const nextOrder = inOrder ? order : [...order, key];
    const base = inOrder ? (secParts[key] || entry.parts.map((p) => p.key)) : entry.parts.map((p) => p.key);
    const vis = partKey && !base.includes(partKey)
      ? entry.parts.map((p) => p.key).filter((pk) => base.includes(pk) || pk === partKey)
      : base;
    const nextParts = { ...secParts, [key]: vis };
    const changed = !inOrder || vis.length !== base.length;
    if (changed || Object.keys(extraPatch).length) {
      setOrder(nextOrder);
      setSecParts(nextParts);
      const patch = { ...extraPatch };
      if (changed) patch.section_order = encodeOrder(nextOrder, nextParts);
      saveField(patch, label);
    }
    scrollToSection(key);
  };
  // Append a block of html into one field of a section part.
  const appendInto = (sectionKey, partKey, alias, html, label) => {
    const existing = stripHtmlText(bodies[alias] || (typeof f[alias] === "string" ? f[alias] : "")) ? (bodies[alias] || f[alias]) : "";
    const merged = existing ? existing + html : html;
    setBodies((cur) => ({ ...cur, [alias]: merged }));
    revRef.current += 1;
    ensureSectionPart(sectionKey, partKey, { [alias]: merged }, label);
    toast.success(label + " added");
  };
  const appendExtra = (label, inner) => appendInto("extra", "notes", "extra", `<p><b>${label}:</b> ${inner}</p>`, label);
  const linkify = (v) => /^https?:\/\//i.test(v.trim()) ? `<a href="${v.trim()}" target="_blank" rel="noreferrer">${v.trim()}</a>` : v.trim();

  const handleMediaFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setMediaSaving(true);
    try {
      const uploaded = await upload.mutateAsync(file);
      const first = Array.isArray(uploaded) ? uploaded[0] : uploaded;
      const url = first?.url || first?.file?.url || "";
      if (!url) throw new Error("Upload returned no URL");
      appendExtra("Media", `<a href="${url}" target="_blank" rel="noreferrer">${file.name}</a>`);
    } catch (err) {
      console.error("Media upload failed:", err);
      toast.error("Couldn't upload media", { description: err?.message });
    } finally {
      setMediaSaving(false);
      if (mediaFileRef.current) mediaFileRef.current.value = "";
    }
  };

  // ─── Edit checks (the machinery behind Make sure you) ─────
  const [checksOpen, setChecksOpen] = useState(false);
  const [checksSaving, setChecksSaving] = useState(false);
  const openChecks = () => {
    ensureSectionPart("guidelines", "makesure", {}, "Guidelines");
    setChecksOpen(true);
  };
  const saveChecks = async (patch) => {
    setChecksSaving(true);
    setBodies((cur) => ({ ...cur, make_sure: patch.make_sure }));
    revRef.current += 1;
    await saveField(patch, "checks");
    setChecksSaving(false);
    setChecksOpen(false);
  };

  const applyModule = (mod) => {
    const af = account?.fields || {};
    if (mod.kind === "checks") { openChecks(); return; }
    if (mod.kind === "disabled") {
      toast.info("Your workspace doesn't store concepts yet.");
      return;
    }
    if (mod.kind === "prompt") { setRailPrompt({ mod }); return; }
    if (mod.kind === "media") { mediaFileRef.current?.click(); return; }
    if (mod.kind === "jump") {
      ensureSectionPart(mod.section, mod.part, {}, mod.name);
      return;
    }
    if (mod.kind === "attach") {
      ensureSectionPart("extra", "document", {}, mod.name);
      return;
    }
    if (mod.kind === "format") {
      const picks = asArray(af.preferredFormats).map((x) => (typeof x === "object" ? x : { id: x })).filter((x) => x.id);
      if (!picks.length) { toast.info("Pick preferred formats in Settings → Workspace first."); return; }
      const capped = picks.slice(0, 3);
      ensureSectionPart("visualFormat", null, {
        format: capped.map((p) => ({ id: p.id })),
        first_format: [{ id: capped[0].id }],
      }, "Format");
      toast.success("Preferred formats applied");
      return;
    }
    if (mod.kind === "slots") {
      const slots = [
        { n: 1, text: af.productOrFeature1 },
        { n: 2, text: af.productOrFeature2 },
        { n: 3, text: af.productOrFeature3 },
      ].filter((s) => typeof s.text === "string" && s.text.trim());
      if (!slots.length) { toast.info("No product or feature pages saved on the workspace yet."); return; }
      if (slots.length === 1) { insertSlot(slots[0]); return; }
      setSlotPicker({ mod, slots });
      return;
    }
    // Blueprint pulls
    let html = "";
    let sectionKey = "";
    let alias = "";
    let partKey = "body";
    if (mod.key === "brand") {
      html = af.accountBrandBio ? `<p>${af.accountBrandBio}</p>` : "";
      sectionKey = "brand"; alias = "brand";
    }
    if (mod.key === "targetAudience") {
      html = af.accountAudience ? `<p>${stripHtmlText(af.accountAudience).replace(/\n/g, "<br/>")}</p>` : "";
      sectionKey = "audienceCustomer"; alias = "audienceCustomer";
    }
    if (mod.key === "contentStyle") {
      html = af.contentStyle ? `<p><b>Content style:</b> ${af.contentStyle}</p>` : "";
      sectionKey = "extra"; alias = "extra"; partKey = "notes";
    }
    if (mod.key === "contact") {
      const socials = parseJsonList(af.socialHandles).map((x) => `${x.platform}: ${x.handle}`).join(" · ");
      const site = unwrap(af.accountWebsite);
      html = (site || socials) ? `<p><b>Get in touch.</b> ${[site, socials].filter(Boolean).join(" · ")}</p>` : "";
      sectionKey = "contactCommunity"; alias = "contactCommunity";
    }
    if (mod.key === "community") {
      const links = parseJsonList(af.communityLinks).map((x) => `<li><b>${x.label}:</b> ${x.url}</li>`).join("");
      html = links ? `<p><b>Join the community.</b></p><ul>${links}</ul>` : "";
      sectionKey = "contactCommunity"; alias = "contactCommunity";
    }
    if (!html) { toast.info("Nothing saved on the workspace for that yet — fill it in Settings → Workspace."); return; }
    appendInto(sectionKey, partKey, alias, html, mod.name);
  };
  const insertSlot = (slot) => {
    setSlotPicker(null);
    const html = `<p>${stripHtmlText(slot.text).replace(/\n/g, "<br/>")}</p>`;
    appendInto("productFeature", "description", "product_feature_description", html, "Product/Feature");
  };
  const submitRailPrompt = (value) => {
    const mod = railPrompt?.mod;
    setRailPrompt(null);
    if (!mod || !value || !value.trim()) return;
    appendExtra(mod.label, linkify(value));
  };

  const orderedSections = order.map((k) => SECTIONS.find((e) => e.key === k)).filter(Boolean);
  const [railOpen, setRailOpen] = useState({ details: true, sections: true, modules: false });

  // ─── Extra: brief document (URL or PDF upload) ────────────
  const pdfFileRef = useRef(null);
  const [pdfSaving, setPdfSaving] = useState(false);
  const handlePdfFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setPdfSaving(true);
    try {
      const uploaded = await upload.mutateAsync(file);
      const value = Array.isArray(uploaded) ? uploaded : [uploaded];
      await saveField({ attachment: value }, "PDF");
      toast.success("PDF uploaded");
    } catch (err) {
      console.error("PDF upload failed:", err);
      toast.error("Couldn't upload PDF", { description: err?.message });
    } finally {
      setPdfSaving(false);
      if (pdfFileRef.current) pdfFileRef.current.value = "";
    }
  };

  // ─── SELECT / date / text field commits ───────────────────
  const commitSelect = async (fieldAlias, value) => {
    if (value == null) {
      await saveField({ [fieldAlias]: null }, FIELD_LABELS[fieldAlias] || fieldAlias);
    } else {
      await saveField({ [fieldAlias]: { id: value.id, label: value.label } }, FIELD_LABELS[fieldAlias] || fieldAlias);
    }
  };
  const commitMultiSelect = async (fieldAlias, options) => {
    await saveField({ [fieldAlias]: options.map((o) => ({ id: o.id, label: o.label })) }, FIELD_LABELS[fieldAlias] || fieldAlias);
  };
  const commitDate = async (fieldAlias, isoString) => {
    await saveField({ [fieldAlias]: isoString }, FIELD_LABELS[fieldAlias] || fieldAlias);
  };
  const commitText = async (fieldAlias, text) => {
    await saveField({ [fieldAlias]: text }, fieldAlias);
  };

  // Everything a section body needs, bundled once.
  const ctx = {
    f, bodies, rev: revRef.current, briefId, openChecks,
    onBody: setBody, onCommitBody: commitBody,
    commitSelect, commitMultiSelect, commitDate, commitText, saveField,
    pdf: {
      url: f.brief_document_url,
      attachment: f.attachment,
      uploading: pdfSaving,
      onSaveUrl: (url) => commitText("brief_document_url", url),
      onClickUpload: () => pdfFileRef.current?.click(),
      onClear: async () => {
        await saveField({ attachment: [], brief_document_url: "" }, "brief document");
      },
    },
  };

  // ─── Render ───────────────────────────────────────────────
  return (
    <>
      <Style />

      <div className="bl-bd w-full">

        {/* Banner shown while the brief has no project linked. */}
        {isUnassigned && (
          <div className="bl-bd-assign-banner" role="status">
            <div className="bl-bd-assign-banner-icon" aria-hidden="true">
              <Inbox size={18} strokeWidth={1.75} />
            </div>
            <div className="bl-bd-assign-banner-text">
              <strong>This brief needs a project.</strong>
              <span>Assign it to one of your projects to start editing.</span>
            </div>
            <button
              type="button"
              className="bl-bd-assign-banner-btn"
              onClick={openAssignBrief}
            >
              Assign to a project
            </button>
          </div>
        )}

        {/* Top bar — the page switcher + Preview · Share · Publish */}
        <div className="bl-bd-topbar">
          <div className="bl-bd-switch">
            <button type="button" className={`bl-bd-switch-btn ${view === "brief" ? "is-active" : ""}`} onClick={() => setView("brief")}>
              Brief
            </button>
            <button type="button" className={`bl-bd-switch-btn ${view === "submissions" ? "is-active" : ""}`} onClick={() => setView("submissions")}>
              Submissions{briefSubs.length ? ` · ${briefSubs.length}` : ""}
            </button>
            <button type="button" className={`bl-bd-switch-btn ${view === "invites" ? "is-active" : ""}`} onClick={() => setView("invites")}>
              Invites{briefMembers.length ? ` · ${briefMembers.length}` : ""}
            </button>
          </div>
          <div className="bl-bd-topbar-actions">
            {nameSaving && <span className="bl-bd-saving">Saving…</span>}
            <button
              type="button"
              onClick={() => openCreatorPreview(briefId)}
              className="bl-bd-preview-btn"
              disabled={!briefId}
              title="See the creator's view of this brief"
            >
              <Eye size={14} />
              Preview
            </button>
            <SharePopover
              briefId={briefId}
              creatorUrl={creatorUrl}
              teamUrl={teamUrl}
              isPrivate={isPrivate}
              privacySaving={privacySaving}
              onTogglePrivacy={togglePrivacy}
              onAddPeople={() => openBriefInvite(briefId)}
              open={shareOpen}
              setOpen={setShareOpen}
            />
            <Button
              onClick={publish}
              disabled={publishSaving || briefStatus?.label === "Active"}
              style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
              className="bl-bd-publish-btn"
            >
              {publishSaving ? "Publishing…" : briefStatus?.label === "Active" ? "Published" : "Publish"}
            </Button>
          </div>
        </div>

        {view === "submissions" && (
          <SubmissionsView
            rows={briefSubs}
            onOpen={(id) => { (window.parent || window).location.href = "/submissions/details?recordId=" + encodeURIComponent(id); }}
            onInvite={(id) => {
              const url = "/review-invite?recordId=" + encodeURIComponent(id);
              if (typeof window.openSwModal === "function") window.openSwModal(url, "md");
              else window.location.href = url;
            }}
          />
        )}
        {view === "invites" && <InvitesView rows={briefMembers} />}

        {checksOpen && (
          <ChecksPanel f={f} saving={checksSaving} onSave={saveChecks} onClose={() => setChecksOpen(false)} />
        )}

        <div className="bl-bd-layout" style={view === "brief" ? undefined : { display: "none" }}>
          <div className="bl-bd-main">
            <div className="bl-bd-paper">
              <div className="bl-bd-title-row">
                {editingName ? (
                  <input
                    value={nameDraft}
                    autoFocus
                    disabled={nameSaving}
                    onChange={(e) => setNameDraft(e.target.value)}
                    onKeyDown={(e) => {
                      if (e.key === "Enter") commitName();
                      if (e.key === "Escape") { setNameDraft(briefName); setEditingName(false); }
                    }}
                    onBlur={commitName}
                    className="bl-bd-title-input"
                  />
                ) : (
                  <button
                    type="button"
                    className="bl-bd-title"
                    onClick={() => setEditingName(true)}
                    title="Click to rename"
                  >
                    {briefName}
                    <Pencil size={15} className="bl-bd-title-pencil" />
                  </button>
                )}
              </div>

              {record && orderedSections.length === 0 && (
                <p className="bl-bd-empty-hint">
                  This brief has no sections yet. Add them one by one from Sections in the rail, or drop in live workspace content from Modules.
                </p>
              )}

              {orderedSections.map((entry, i) => (
                <PaperSection
                  key={entry.key}
                  entry={entry}
                  index={i}
                  total={orderedSections.length}
                  visible={secParts[entry.key] || entry.parts.map((p) => p.key)}
                  collapsed={!!collapsed["s_" + entry.key]}
                  onToggle={() => toggle("s_" + entry.key)}
                  writing={!!writing[entry.key]}
                  onAi={() => aiWrite(entry.key)}
                  onMove={(dir) => moveSection(entry.key, dir)}
                  onRemove={() => removeSection(entry.key)}
                  onAddPart={(pk) => addPart(entry.key, pk)}
                  onRemovePart={(pk) => removePart(entry.key, pk)}
                  ctx={ctx}
                />
              ))}
            </div>
          </div>

          <Rail
            open={railOpen}
            setOpen={setRailOpen}
            order={order}
            secParts={secParts}
            onToggleSection={addSection}
            onTogglePart={togglePart}
            onModule={applyModule}
            accountName={account?.fields?.accountName || ""}
            accountLoaded={!!account}
            railPrompt={railPrompt}
            onSubmitPrompt={submitRailPrompt}
            onCancelPrompt={() => setRailPrompt(null)}
            slotPicker={slotPicker}
            onPickSlot={insertSlot}
            onCancelSlots={() => setSlotPicker(null)}
            mediaSaving={mediaSaving}
            details={{
              briefStatus, statusSaving, commitStatus,
              reviewModeLabel, reviewModeSaving, commitReviewMode,
              isPrivate, privacySaving, togglePrivacy,
              thumbUrl, thumbSaving, onPickThumb: () => thumbFileRef.current?.click(),
              generatedLabel,
              creatorName: typeof f.creator_name === "string" ? f.creator_name : "",
              creatorEmail: typeof f.creator_email === "string" ? f.creator_email : "",
              onSaveCreator: async ({ name, email }) => {
                const patch = {};
                if (typeof name === "string") patch.creator_name = name;
                if (typeof email === "string") patch.creator_email = email;
                await saveField(patch, "creator");
              },
              creatorTypeId: f.creator_type?.id || "",
              onCreatorType: (opt) => commitSelect("creator_type", opt),
            }}
          />
        </div>

        {/* Hidden file inputs (thumbnail · PDF · media) */}
        <input ref={thumbFileRef} type="file" accept="image/*" onChange={handleThumbnailFile} style={{ display: "none" }} />
        <input ref={pdfFileRef} type="file" accept="application/pdf" onChange={handlePdfFile} style={{ display: "none" }} />
        <input ref={mediaFileRef} type="file" accept="image/*,video/*" onChange={handleMediaFile} style={{ display: "none" }} />
      </div>
    </>
  );
}

// =====================================================================
// PAPER SECTION — one Bible section on the page. Chevron + navy title
// + short line, actions on the right (Write with AI · add part ·
// move · remove), and the section's visible parts as the body.
// =====================================================================
function PaperSection({ entry, index, total, visible, collapsed, onToggle, writing,
  onAi, onMove, onRemove, onAddPart, onRemovePart, ctx }) {
  const multi = (entry.parts || []).length > 1;
  const hidden = (entry.parts || []).filter((p) => !visible.includes(p.key));
  const canAi = !!entry.prompt && (entry.aiFields || []).length > 0;
  return (
    <section id={"bl-sec-" + entry.key} className={`bl-bd-psec ${collapsed ? "is-collapsed" : ""}`}>
      <header className="bl-bd-psec-head">
        <button
          type="button"
          className="bl-bd-psec-toggle"
          onClick={onToggle}
          aria-expanded={!collapsed}
        >
          {collapsed ? <ChevronRight size={17} /> : <ChevronDown size={17} />}
          <div className="bl-bd-psec-titles">
            <h2 className="bl-bd-psec-title">{entry.name}</h2>
            <p className="bl-bd-psec-sub">{entry.short}</p>
          </div>
        </button>
        <div className="bl-bd-psec-tip"><TooltipIcon text={entry.what} /></div>
        <div className="bl-bd-header-actions">
          {writing && <span className="bl-bd-saving">Writing…</span>}
          {canAi && (
            <button type="button" className="bl-bd-preview-btn" onClick={onAi} disabled={writing} title="Write this section with AI">
              <Wand2 size={14} />
              Write with AI
            </button>
          )}
          <AddPartMenu hidden={hidden} onAdd={onAddPart} />
          <button type="button" className="bl-bd-move-btn" onClick={() => onMove(-1)} disabled={index === 0} title="Move up">
            <ChevronUp size={14} />
          </button>
          <button type="button" className="bl-bd-move-btn" onClick={() => onMove(1)} disabled={index === total - 1} title="Move down">
            <ChevronDown size={14} />
          </button>
          <button type="button" className="bl-bd-move-btn bl-bd-remove-btn" onClick={onRemove} title="Remove section">
            <Trash2 size={14} />
          </button>
        </div>
      </header>
      {!collapsed && (
        <div className="bl-bd-psec-body">
          {(entry.parts || []).filter((p) => visible.includes(p.key)).map((p) => (
            <SectionPart
              key={p.key}
              entry={entry}
              part={p}
              removable={multi}
              onRemovePart={() => onRemovePart(p.key)}
              ctx={ctx}
            />
          ))}
        </div>
      )}
    </section>
  );
}

// The "+" menu in a section header — lists the parts not yet shown.
function AddPartMenu({ hidden, onAdd }) {
  const [open, setOpen] = useState(false);
  if (!hidden.length) return null;
  return (
    <div className="bl-bd-addpart">
      <button type="button" className="bl-bd-move-btn" onClick={() => setOpen((o) => !o)} title="Add a field to this section">
        <Plus size={14} />
      </button>
      {open && (
        <>
          <div className="bl-bd-pop-backdrop" onClick={() => setOpen(false)} />
          <div className="bl-bd-addpart-menu">
            {hidden.map((p) => (
              <button key={p.key} type="button" onClick={() => { onAdd(p.key); setOpen(false); }}>
                <Plus size={11} /> {p.label || p.key}
              </button>
            ))}
          </div>
        </>
      )}
    </div>
  );
}

// Label row above a removable part.
function PartHead({ label, removable, onRemove, action }) {
  if (!label && !removable && !action) return null;
  return (
    <div className="bl-bd-part-head">
      <span className="bl-bd-part-label">{label}</span>
      {action}
      {removable && (
        <button type="button" className="bl-bd-part-x" onClick={onRemove} title="Remove this field (clears its content)">
          <X size={12} />
        </button>
      )}
    </div>
  );
}

// Single-select / multi-select chip row (the Deliverables look).
function ChipGroup({ options, valueIds, onPick, icons }) {
  return (
    <div className="bl-bd-chiprow">
      {options.map((o) => {
        const on = valueIds.includes(o.id);
        const icon = icons && icons[o.label];
        return (
          <button
            key={o.id}
            type="button"
            className={`bl-bd-chip ${on ? "is-active" : ""}`}
            onClick={() => onPick(o, on)}
          >
            {on && <Check size={11} strokeWidth={3} />}
            {icon && <img src={icon} alt="" onError={(e) => { e.currentTarget.style.display = "none"; }} />}
            {o.label}
          </button>
        );
      })}
    </div>
  );
}

// Compact URL input used by link parts (Product link, Feature link).
function PartUrlInput({ value, placeholder, onSave }) {
  const [draft, setDraft] = useState(value || "");
  useEffect(() => { setDraft(value || ""); }, [value]);
  const commit = () => { if (draft.trim() !== (value || "").trim()) onSave(draft.trim()); };
  return (
    <input
      className="bl-bd-part-url"
      value={draft}
      placeholder={placeholder || "https://…"}
      onChange={(e) => setDraft(e.target.value)}
      onKeyDown={(e) => { if (e.key === "Enter") e.currentTarget.blur(); }}
      onBlur={commit}
    />
  );
}

// One part of a section, rendered by kind.
function SectionPart({ entry, part, removable, onRemovePart, ctx }) {
  const { f, bodies, rev } = ctx;
  const head = (label) => (
    <PartHead label={label} removable={removable} onRemove={onRemovePart} />
  );

  if (part.kind === "html") {
    const alias = part.fields[0];
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <EditableHtml
          html={bodies[alias] !== undefined ? bodies[alias] : (typeof f[alias] === "string" ? f[alias] : "")}
          rev={rev}
          placeholder={"Write " + (part.label || entry.name).toLowerCase() + "…"}
          onEdit={(html) => ctx.onBody(alias, html)}
          onCommit={() => ctx.onCommitBody(alias)}
        />
      </div>
    );
  }

  if (part.kind === "url") {
    const alias = part.fields[0];
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <PartUrlInput
          value={typeof f[alias] === "string" ? f[alias] : ""}
          placeholder={part.placeholder}
          onSave={(v) => ctx.commitText(alias, v)}
        />
      </div>
    );
  }

  if (part.kind === "select") {
    const alias = part.fields[0];
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <div className="bl-bd-part-select">
          <SelectField
            inline
            options={OPTION_SETS[part.options] || []}
            valueId={f[alias]?.id || ""}
            onChange={(opt) => ctx.commitSelect(alias, opt)}
          />
        </div>
      </div>
    );
  }

  if (part.kind === "chips-multi") {
    const alias = part.fields[0];
    const options = OPTION_SETS[part.options] || [];
    const ids = asArrayIds(f[alias]);
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <ChipGroup
          options={options}
          valueIds={ids}
          icons={part.options === "PLATFORM" ? PLATFORM_LOGOS : undefined}
          onPick={(o, on) => {
            const nextIds = on ? ids.filter((id) => id !== o.id) : [...ids, o.id];
            ctx.commitMultiSelect(alias, options.filter((x) => nextIds.includes(x.id)));
          }}
        />
      </div>
    );
  }

  if (part.kind === "length") {
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <ChipGroup
          options={DURATION_OPTIONS}
          valueIds={f.duration?.id ? [f.duration.id] : []}
          onPick={(o, on) => ctx.commitSelect("duration", on ? null : o)}
        />
        <div className="bl-bd-length-mode">
          <span>Counts as</span>
          <ChipGroup
            options={DURATION_THRESHOLD_OPTIONS}
            valueIds={f.duration_threshold?.id ? [f.duration_threshold.id] : []}
            onPick={(o, on) => ctx.commitSelect("duration_threshold", on ? null : o)}
          />
        </div>
      </div>
    );
  }

  if (part.kind === "format") {
    return (
      <div className="bl-bd-part">
        <FormatChips
          value={asArray(f.format)}
          onChange={(picks) => ctx.saveField({
            format: picks.map((x) => ({ id: x.id })),
            first_format: picks[0] ? [{ id: picks[0].id }] : [],
          }, "format")}
        />
      </div>
    );
  }

  if (part.kind === "picks" || part.kind === "swipes") {
    const isPicks = part.kind === "picks";
    const lookups = isPicks
      ? ["example_1_video_url", "example_2_video_url", "example_3_video_url"]
      : ["swipe_1_video_url", "swipe_2_video_url", "swipe_3_video_url"];
    const openPicker = isPicks ? openInspoPicker : openSwipePicker;
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <div className="bl-bd-inspo-row">
          {part.fields.map((linked, i) => (
            <InspoReviewSlot
              key={linked}
              label={(isPicks ? "Example " : "Swipe ") + (i + 1)}
              value={f[linked]}
              videoUrl={resolveLookupVideoUrl(f[lookups[i]])}
              onOpen={() => openPicker(ctx.briefId, i + 1)}
            />
          ))}
        </div>
      </div>
    );
  }

  if (part.kind === "urls") {
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <div className="bl-bd-inspo-row">
          {part.fields.map((alias, i) => (
            <UrlSlot
              key={alias}
              label={"URL " + (i + 1)}
              value={typeof f[alias] === "string" ? f[alias] : ""}
              onSave={(v) => ctx.commitText(alias, v)}
            />
          ))}
        </div>
      </div>
    );
  }

  if (part.kind === "dates") {
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <div className="bl-bd-dates-grid">
          <DateTimeField
            label="Opens"
            tooltip={TOOLTIPS.submission_open_date}
            value={f.submission_open_date || ""}
            onSave={(iso) => ctx.commitDate("submission_open_date", iso)}
          />
          <DateTimeField
            label="Closes"
            tooltip={TOOLTIPS.submission_close_date}
            value={f.submission_close_date || ""}
            onSave={(iso) => ctx.commitDate("submission_close_date", iso)}
          />
        </div>
      </div>
    );
  }

  if (part.kind === "document") {
    return (
      <div className="bl-bd-part">
        {head(part.label)}
        <PdfRow
          url={ctx.pdf.url}
          attachment={ctx.pdf.attachment}
          uploading={ctx.pdf.uploading}
          onSaveUrl={ctx.pdf.onSaveUrl}
          onClickUpload={ctx.pdf.onClickUpload}
          onClear={ctx.pdf.onClear}
        />
      </div>
    );
  }

  if (part.kind === "makesure") {
    return (
      <div className="bl-bd-part">
        <PartHead
          label="Make sure you"
          removable={removable}
          onRemove={onRemovePart}
          action={
            <button type="button" className="bl-bd-preview-btn" onClick={ctx.openChecks} title="Pick the review agents and thresholds behind these sentences">
              <Pencil size={13} />
              Edit checks
            </button>
          }
        />
        <EditableHtml
          html={bodies.make_sure !== undefined ? bodies.make_sure : (typeof f.make_sure === "string" ? f.make_sure : "")}
          rev={rev}
          placeholder="Edit checks to generate these lines, or write your own…"
          onEdit={(html) => ctx.onBody("make_sure", html)}
          onCommit={() => ctx.onCommitBody("make_sure")}
        />
      </div>
    );
  }

  return null;
}

// =====================================================================
// EDIT CHECKS — the machinery behind Make sure you. Tick agents, set
// their bars, watch the exact sentence the creator will read. Saving
// rewrites the Make sure you block.
// =====================================================================
function ChecksPanel({ f, saving, onSave, onClose }) {
  const [ids, setIds] = useState(() => {
    const s = new Set(asArrayIds(f.qa_checklist));
    // Agents whose bar is already set count as ticked.
    Object.keys(THRESHOLD_PAIR).forEach((alias) => {
      const label = f[alias]?.label || "";
      if (label && !/^none\b/i.test(label)) {
        const agent = QA_AGENT_OPTIONS.find((a) => a.label === THRESHOLD_PAIR[alias]);
        if (agent) s.add(agent.id);
      }
    });
    return s;
  });
  const [th, setTh] = useState(() => {
    const o = {};
    THRESHOLD_FIELDS.forEach(({ alias }) => {
      if (f[alias]?.id) o[alias] = { id: f[alias].id, label: f[alias].label };
    });
    return o;
  });
  const aliasFor = (label) => Object.keys(THRESHOLD_PAIR).find((k) => THRESHOLD_PAIR[k] === label);
  const save = () => {
    const agentIds = [...ids];
    const patch = {
      qa_checklist: QA_AGENT_OPTIONS.filter((a) => ids.has(a.id)).map((a) => ({ id: a.id, label: a.label })),
      make_sure: buildMakeSure(agentIds, th, f.duration, f.duration_threshold),
    };
    THRESHOLD_FIELDS.forEach(({ alias }) => {
      patch[alias] = th[alias] ? { id: th[alias].id, label: th[alias].label } : null;
    });
    onSave(patch);
  };
  return (
    <>
      <div className="bl-bd-checks-backdrop" onClick={onClose} />
      <div className="bl-bd-checks" role="dialog" aria-label="Edit checks">
        <div className="bl-bd-checks-head">
          <h3>Make sure you</h3>
          <p>Tick what every submission gets checked against. Each tick becomes a plain sentence the creator reads, shown underneath.</p>
        </div>
        <div className="bl-bd-checks-list">
          {QA_AGENT_OPTIONS.map((agent) => {
            const on = ids.has(agent.id);
            const alias = aliasFor(agent.label);
            return (
              <div key={agent.id} className={`bl-bd-check-row ${on ? "is-on" : ""}`}>
                <div className="bl-bd-check-main">
                  <button
                    type="button"
                    className={`bl-bd-check-box ${on ? "is-on" : ""}`}
                    onClick={() => setIds((cur) => {
                      const n = new Set(cur);
                      if (n.has(agent.id)) n.delete(agent.id); else n.add(agent.id);
                      return n;
                    })}
                    aria-pressed={on}
                  >
                    {on && <Check size={12} strokeWidth={3} />}
                  </button>
                  <span className="bl-bd-check-name">
                    {agent.label}
                    {AGENT_TOOLTIPS[agent.label] && <TooltipIcon text={AGENT_TOOLTIPS[agent.label]} />}
                  </span>
                  {on && alias && (
                    <span className="bl-bd-check-th">
                      <SelectField
                        inline
                        options={THRESHOLD_OPTIONS[alias]}
                        valueId={th[alias]?.id || ""}
                        onChange={(opt) => setTh((cur) => ({ ...cur, [alias]: opt ? { id: opt.id, label: opt.label } : undefined }))}
                      />
                    </span>
                  )}
                </div>
                {on && (
                  <p className="bl-bd-check-preview">
                    {makeSureLine(agent.label, th, f.duration, f.duration_threshold) || "Pick a bar to shape this sentence."}
                  </p>
                )}
              </div>
            );
          })}
        </div>
        <div className="bl-bd-checks-foot">
          <span className="bl-bd-checks-note">Saving rewrites the Make sure you block with these sentences.</span>
          <button type="button" className="bl-bd-checks-cancel" onClick={onClose} disabled={saving}>Cancel</button>
          <Button onClick={save} disabled={saving} style={{ backgroundColor: PERIWINKLE, color: "#fff" }}>
            {saving ? "Saving…" : "Save checks"}
          </Button>
        </div>
      </div>
    </>
  );
}

// =====================================================================
// STATUS PICKER
// =====================================================================
function StatusPicker({ value, saving, onChange }) {
  const [open, setOpen] = useState(false);
  const wrapRef = useRef(null);
  useEffect(() => {
    if (!open) return;
    const onDown = (e) => {
      if (wrapRef.current && !wrapRef.current.contains(e.target)) setOpen(false);
    };
    document.addEventListener("mousedown", onDown);
    return () => document.removeEventListener("mousedown", onDown);
  }, [open]);
  const current = STATUS_OPTIONS.find((o) => o.id === value) || STATUS_OPTIONS[0];
  const tone = (current.color || "#cccfd4") + "33";
  const border = (current.color || "#cccfd4") + "66";
  const label = current.label === "Archive" ? "Inactive" : current.label;
  return (
    <div className="bl-bd-status-wrap" ref={wrapRef}>
      <button
        type="button"
        className="bl-bd-status-pill"
        style={{ backgroundColor: tone, borderColor: border }}
        onClick={() => setOpen((c) => !c)}
        disabled={saving}
        title="Click to change status"
      >
        {label}{saving ? " …" : ""}
      </button>
      {open && (
        <div className="bl-bd-status-menu" role="menu">
          {STATUS_OPTIONS.map((o) => (
            <button
              key={o.id}
              type="button"
              role="menuitem"
              className={`bl-bd-status-menu-item ${o.id === value ? "is-active" : ""}`}
              onClick={() => { onChange(o.id); setOpen(false); }}
            >
              <span className="bl-bd-status-dot" style={{ backgroundColor: o.color }} />
              {o.label === "Archive" ? "Inactive" : o.label}
              {o.id === value && <Check size={12} className="bl-bd-status-check" />}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

// =====================================================================
// TOOLTIP ICON
// =====================================================================
function TooltipIcon({ text }) {
  if (!text) return null;
  return (
    <span className="bl-bd-tip-wrap" tabIndex={0}>
      <Info size={12} className="bl-bd-tip-icon" />
      <span className="bl-bd-tip-text" role="tooltip">{text}</span>
    </span>
  );
}

// =====================================================================
// SELECT FIELD (single)
// =====================================================================
function SelectField({ label, tooltip, options, valueId, onChange, inline, suffix }) {
  const [saving, setSaving] = useState(false);
  const current = options.find((o) => o.id === valueId);
  const handle = async (e) => {
    const id = e.target.value;
    const opt = options.find((o) => o.id === id);
    setSaving(true);
    try { await onChange(opt || null); } finally { setSaving(false); }
  };
  if (inline) {
    return (
      <select
        className="bl-bd-select bl-bd-select-inline"
        value={valueId}
        onChange={handle}
        disabled={saving}
      >
        <option value="">—</option>
        {options.map((o) => (
          <option key={o.id} value={o.id}>{o.label}</option>
        ))}
      </select>
    );
  }
  return (
    <div className="bl-bd-field">
      <label className="bl-bd-field-label">
        {label}
        <TooltipIcon text={tooltip} />
      </label>
      <div className="bl-bd-field-value">
        <select
          className="bl-bd-select"
          value={valueId}
          onChange={handle}
          disabled={saving}
        >
          <option value="">Pick one…</option>
          {options.map((o) => (
            <option key={o.id} value={o.id}>{o.label}</option>
          ))}
        </select>
        {suffix}
        {saving && <span className="bl-bd-saving">Saving…</span>}
      </div>
    </div>
  );
}

// =====================================================================
// DATETIME FIELD
// =====================================================================
function DateTimeField({ label, tooltip, value, onSave }) {
  const [draft, setDraft] = useState(toDateInput(value));
  const [saving, setSaving] = useState(false);
  useEffect(() => { setDraft(toDateInput(value)); }, [value]);
  const commit = async () => {
    if (draft === toDateInput(value)) return;
    setSaving(true);
    try { await onSave(fromDateInput(draft)); } finally { setSaving(false); }
  };
  return (
    <div className="bl-bd-field">
      <label className="bl-bd-field-label">
        {label}
        <TooltipIcon text={tooltip} />
      </label>
      <div className="bl-bd-field-value">
        <input
          type="datetime-local"
          className="bl-bd-input"
          value={draft}
          onChange={(e) => setDraft(e.target.value)}
          onBlur={commit}
          disabled={saving}
        />
        {saving && <span className="bl-bd-saving">Saving…</span>}
      </div>
    </div>
  );
}

// =====================================================================
// INSPIRATION SLOTS
// =====================================================================
function SharePopover({
  briefId, creatorUrl, teamUrl, isPrivate, privacySaving,
  onTogglePrivacy, onAddPeople, open, setOpen,
}) {
  const wrapRef = useRef(null);
  const [tab, setTab] = useState("creator"); // 'creator' | 'team'
  useEffect(() => {
    if (!open) return;
    const onDown = (e) => {
      if (wrapRef.current && !wrapRef.current.contains(e.target)) setOpen(false);
    };
    document.addEventListener("mousedown", onDown);
    return () => document.removeEventListener("mousedown", onDown);
  }, [open, setOpen]);

  const isCreator = tab === "creator";
  const url = isCreator ? creatorUrl : teamUrl;
  const copy = async () => {
    if (!url) return;
    const ok = await copyToClipboard(url);
    if (ok) toast.success("Link copied");
    else toast.error("Couldn't copy link", { description: url });
  };
  const openInNewTab = () => {
    if (!url) return;
    window.open(url, "_blank", "noopener,noreferrer");
  };

  return (
    <div className="bl-bd-share-wrap" ref={wrapRef}>
      <button
        type="button"
        onClick={() => setOpen((c) => !c)}
        className="bl-bd-preview-btn"
        disabled={!briefId}
        title="Share this brief"
      >
        <Share2 size={14} />
        Share
      </button>
      {open && (
        <div
          className="bl-bd-share-panel"
          role="dialog"
          aria-label="Share brief"
          // Stop native mousedown bubbling — otherwise the document-
          // level "close on outside click" listener fires before the
          // inner button's React onClick runs, the panel unmounts
          // mid-click, and the click never lands on the button.
          // This is the same fix browsers ship for dropdowns, etc.
          onMouseDown={(e) => e.stopPropagation()}
        >
          {/* Tabs */}
          <div className="bl-bd-share-tabs">
            <button
              type="button"
              className={`bl-bd-share-tab ${isCreator ? "is-active" : ""}`}
              onClick={() => setTab("creator")}
            >
              Creator
            </button>
            <button
              type="button"
              className={`bl-bd-share-tab ${!isCreator ? "is-active" : ""}`}
              onClick={() => setTab("team")}
            >
              Team
            </button>
          </div>

          {/* Description + link */}
          <div className="bl-bd-share-title">
            {isCreator ? "Public brief link" : "Editor link"}
          </div>
