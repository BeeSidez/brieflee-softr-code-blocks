            out.price = formatPrice(offer.price || spec.price, offer.priceCurrency || spec.priceCurrency);
          }
        }
      }
      Object.keys(o).forEach((k) => { const v = o[k]; if (v && typeof v === "object") stack.push(v); });
    }
  }
  return (out.name || out.description || out.image || out.price) ? out : null;
}

const BOT_WALL = /just a moment|enable javascript and cookies|checking your browser|attention required|verifying you are human|access denied|cf-browser-verification|ddos protection by/i;
const MIN_USEFUL_PAGE = 400;
// A bot wall answers 200 with a near-empty page, so a scrape of one
// reads as a success. Its title gives it away as often as its body.
function looksBlockedPage(markdown, title) {
  if (BOT_WALL.test(String(title || ""))) return true;
  const s = String(markdown || "").trim();
  if (s.length < MIN_USEFUL_PAGE) return true;
  return BOT_WALL.test(s.slice(0, 1500));
}

// Catalog copy is scraped off a live page, so an angle bracket in it
// would otherwise become markup in the body it lands in.
function escAngles(s) {
  return String(s || "").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
// One paragraph per product: its name, its own description, its own
// price. Shaped exactly like buildFormatDirection ("<b>Name.</b> body")
// and returned as an inner-html LINE, because that is what makes the
// same generated-versus-hand-written test work on it, which is what
// lets a re-pick replace the previous product instead of stacking on
// top of it. price is TEXT and already carries whatever currency the
// product page showed, so it prints as stored and never gets one
// added. A row with no name returns "", leaving the body alone.
function buildProductLine(pf) {
  if (!pf) return "";
  const name = stripHtmlText(pf.name || "").trim();
  if (!name) return "";
  const desc = stripHtmlText(pf.description || "").replace(/\s*\n+\s*/g, " ").trim();
  const price = String(pf.price || "").trim();
  const body = [desc, price ? "It sells for " + price + "." : ""].filter(Boolean).join(" ");
  const lead = "<b>" + escAngles(name) + ".</b>";
  return body ? lead + " " + escAngles(body) : lead;
}
function linesToHtml(lines) {
  return lines.length ? "<ul>" + lines.map((l) => "<li>" + l + "</li>").join("") + "</ul>" : "";
}

// LOOKUP video fields can return either a raw URL or an HTML <iframe>
// string (from a FORMULA on the linked table). Normalize both into a
// playable URL string we can drop straight into <video src=…>.
function resolveLookupVideoUrl(raw) {
  if (!raw) return "";
  const first = Array.isArray(raw) ? raw[0] : raw;
  if (!first) return "";
  const s = typeof first === "string"
    ? first
    : (first.url || first.value || first.label || "");
  if (!s || typeof s !== "string") return "";
  const trimmed = s.trim();
  if (trimmed.startsWith("<")) {
    const m = trimmed.match(/src=['"]([^'"]+)['"]/i);
    return m ? m[1] : "";
  }
  return trimmed;
}
// TikTok / Instagram / YouTube URLs need to be transformed into an
// embed iframe src. Plain hostnames (raw cloudinary mp4, vimeo plain
// URL) don't get embedded — we render them as <video> instead.
function detectExternalEmbed(url) {
  if (!url || typeof url !== "string") return null;
  const u = url.trim();
  // TikTok video page → /embed/v2/<id>
  const tt = u.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/i);
  if (tt) return { type: "tiktok", src: `https://www.tiktok.com/embed/v2/${tt[1]}`, aspect: "vertical" };
  // Instagram reel / post / igtv → /<id>/embed/
  const ig = u.match(/instagram\.com\/(?:reel|reels|p|tv)\/([A-Za-z0-9_-]+)/i);
  if (ig) return { type: "instagram", src: `https://www.instagram.com/p/${ig[1]}/embed/`, aspect: "vertical" };
  // YouTube watch / share / shorts → /embed/<id>
  const ytShorts = u.match(/youtube\.com\/shorts\/([A-Za-z0-9_-]+)/i);
  if (ytShorts) return { type: "youtube", src: `https://www.youtube.com/embed/${ytShorts[1]}`, aspect: "vertical" };
  const yt = u.match(/youtube\.com\/watch\?v=([A-Za-z0-9_-]+)/i) || u.match(/youtu\.be\/([A-Za-z0-9_-]+)/i);
  if (yt) return { type: "youtube", src: `https://www.youtube.com/embed/${yt[1]}`, aspect: "horizontal" };
  return null;
}
// Quick MP4/MOV/WebM check so we can render plain video files inline.
function isDirectVideoUrl(s) {
  if (!s || typeof s !== "string") return false;
  return /\.(mp4|mov|webm|m4v)(\?|$)/i.test(s);
}
// PDF detection — used to decide whether a brief_document_url URL can
// be embedded with an inline iframe preview.
function isPdfUrl(s) {
  if (!s || typeof s !== "string") return false;
  return /\.pdf(\?|$)/i.test(s);
}
// useRecords data arrives in several shapes depending on the runtime:
// a flat array, { records: [...] }, or an infinite-query bundle of
// pages ({ pages: [{ offset, total, items }] }). Flatten them all.
function recordsOf(raw) {
  if (!raw) return [];
  if (Array.isArray(raw)) return raw;
  if (Array.isArray(raw.records)) return raw.records;
  if (Array.isArray(raw.items)) return raw.items;
  if (Array.isArray(raw.data)) return raw.data;
  if (Array.isArray(raw.pages)) {
    return raw.pages.flatMap((p) => Array.isArray(p) ? p : (p?.items || p?.records || p?.data || []));
  }
  return [];
}
function asArray(raw) {
  if (Array.isArray(raw)) return raw;
  if (raw == null) return [];
  return [raw];
}
function asArrayIds(raw) {
  return asArray(raw).map((x) => (typeof x === "string" ? x : x?.id || "")).filter(Boolean);
}
function asArrayLabels(raw) {
  return asArray(raw).map((x) => (typeof x === "string" ? x : x?.label || "")).filter(Boolean);
}

// DATETIME → "YYYY-MM-DDTHH:mm" for <input type="datetime-local">
function toDateInput(iso) {
  if (!iso) return "";
  try {
    const d = new Date(iso);
    const pad = (n) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  } catch { return ""; }
}
function fromDateInput(local) {
  if (!local) return "";
  try { return new Date(local).toISOString(); } catch { return ""; }
}

