function CreatorRow({ name, email, onSave }) {
  const [editing, setEditing] = useState(false);
  const [nameDraft, setNameDraft] = useState(name || "");
  const [emailDraft, setEmailDraft] = useState(email || "");
  const [saving, setSaving] = useState(false);
  useEffect(() => { setNameDraft(name || ""); }, [name]);
  useEffect(() => { setEmailDraft(email || ""); }, [email]);

  const commit = async () => {
    const nextName = nameDraft.trim();
    const nextEmail = emailDraft.trim();
    if (nextName === (name || "") && nextEmail === (email || "")) {
      setEditing(false);
      return;
    }
    setSaving(true);
    try { await onSave({ name: nextName, email: nextEmail }); }
    finally { setSaving(false); setEditing(false); }
  };
  const cancel = () => {
    setNameDraft(name || "");
    setEmailDraft(email || "");
    setEditing(false);
  };

  if (editing) {
    return (
      <div className="bl-bd-creator-row bl-bd-creator-editing">
        <Input
          className="bl-bd-input bl-bd-creator-name-input"
          value={nameDraft}
          onChange={(e) => setNameDraft(e.target.value)}
          placeholder="Creator name"
          autoFocus
        />
        <Input
          className="bl-bd-input bl-bd-creator-email-input"
          value={emailDraft}
          onChange={(e) => setEmailDraft(e.target.value)}
          placeholder="email@brand.com"
          type="email"
          onKeyDown={(e) => {
            if (e.key === "Enter") commit();
            if (e.key === "Escape") cancel();
          }}
        />
        <button type="button" className="bl-bd-creator-save" onClick={commit} disabled={saving}>
          {saving ? "Saving…" : "Save"}
        </button>
        <button type="button" className="bl-bd-creator-cancel" onClick={cancel} disabled={saving}>
          Cancel
        </button>
      </div>
    );
  }

  const has = !!(name || email);
  if (!has) {
    return (
      <button
        type="button"
        className="bl-bd-creator-empty"
        onClick={() => setEditing(true)}
      >
        <UserCircle2 size={13} />
        Add a creator
      </button>
    );
  }
  return (
    <button
      type="button"
      className="bl-bd-creator-row"
      onClick={() => setEditing(true)}
      title="Click to edit"
    >
      <span className="bl-bd-creator-label">For</span>
      {name && (
        <span className="bl-bd-creator-name">
          <UserCircle2 size={11} />
          {name}
        </span>
      )}
      {email && (
        <span className="bl-bd-creator-email">
          <Mail size={11} />
          {email}
        </span>
      )}
      <Pencil size={11} className="bl-bd-creator-pencil" />
    </button>
  );
}

