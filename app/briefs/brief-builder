// Block formats for the editor — the toolbar and the "/" slash menu
// both run these. Table inserts a starter grid the user edits.
const ED_TABLE_HTML = '<table><thead><tr><th>Column 1</th><th>Column 2</th><th>Column 3</th></tr></thead><tbody><tr><td><br/></td><td><br/></td><td><br/></td></tr><tr><td><br/></td><td><br/></td><td><br/></td></tr></tbody></table><p><br/></p>';
const ED_BLOCKS = [
  { key: "h", label: "Heading", icon: <Heading2 size={13} />, run: () => document.execCommand("formatBlock", false, "h4") },
  { key: "ul", label: "Bullet list", icon: <List size={13} />, run: () => document.execCommand("insertUnorderedList") },
  { key: "ol", label: "Numbered list", icon: <ListOrdered size={13} />, run: () => document.execCommand("insertOrderedList") },
  { key: "table", label: "Table", icon: <Table size={13} />, run: () => document.execCommand("insertHTML", false, ED_TABLE_HTML) },
  { key: "quote", label: "Quote", icon: <Quote size={13} />, run: () => document.execCommand("formatBlock", false, "blockquote") },
];

// Uncontrolled contentEditable — React never wipes typing; commits on
// blur through the same per-field save path as everything else. On
// top: a slim toolbar while focused, a Notion-style "/" menu at the
// caret, optional bullet seeding (list-shaped Bible sections), and a
// muted Bible guide below empty bodies that never saves.
function EditableHtml({ html, rev, placeholder, seed, guide, onEdit, onCommit }) {
  const ref = useRef(null);
  const wrapRef = useRef(null);
  const [focused, setFocused] = useState(false);
  const [slash, setSlash] = useState(null);
  useEffect(() => {
    if (ref.current && ref.current.innerHTML !== html) ref.current.innerHTML = html;
  }, [rev]); // eslint-disable-line
  const empty = !stripHtmlText(html);
  const run = (b, viaSlash) => {
    ref.current?.focus();
    if (viaSlash) { try { document.execCommand("delete"); } catch { } }
    try { b.run(); } catch { }
    setSlash(null);
    if (ref.current) onEdit(ref.current.innerHTML);
  };
  const onKeyDown = (e) => {
    if (e.key === "Escape") { setSlash(null); return; }
    if (e.key === "/") {
      try {
        const r = window.getSelection().getRangeAt(0).getBoundingClientRect();
        const w = wrapRef.current.getBoundingClientRect();
        setSlash({ top: (r.bottom || w.top + 20) - w.top + 6, left: Math.max(0, (r.left || w.left) - w.left) });
      } catch { setSlash({ top: 26, left: 0 }); }
    } else if (slash && e.key.length === 1) {
      setSlash(null);
    }
  };
  const onFocus = () => {
    setFocused(true);
    if (seed === "ul" && ref.current && !stripHtmlText(ref.current.innerHTML)) {
      ref.current.innerHTML = "<ul><li><br/></li></ul>";
      try {
        const li = ref.current.querySelector("li");
        const sel = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(li);
        range.collapse(true);
        sel.removeAllRanges();
        sel.addRange(range);
      } catch { }
    }
  };
  return (
    <div ref={wrapRef} className="bl-bd-ed-wrap">
      {focused && (
        <div className="bl-bd-ed-toolbar" onMouseDown={(e) => e.preventDefault()}>
          {ED_BLOCKS.map((b) => (
            <button key={b.key} type="button" title={b.label} onClick={() => run(b, false)}>{b.icon}</button>
          ))}
        </div>
      )}
      <div
        ref={ref}
        className="bl-bd-editable"
        contentEditable
        suppressContentEditableWarning
        data-ph={guide ? "" : placeholder}
        onInput={(e) => onEdit(e.currentTarget.innerHTML)}
        onKeyDown={onKeyDown}
        onFocus={onFocus}
        onBlur={() => { setFocused(false); setSlash(null); onCommit(); }}
      />
      {slash && focused && (
        <div className="bl-bd-slash" style={{ top: slash.top, left: slash.left }} onMouseDown={(e) => e.preventDefault()}>
          {ED_BLOCKS.map((b) => (
            <button key={b.key} type="button" onClick={() => run(b, true)}>{b.icon}<span>{b.label}</span></button>
          ))}
        </div>
      )}
      {guide && empty && (
        <div
          className="bl-bd-guide"
          onClick={() => ref.current?.focus()}
          dangerouslySetInnerHTML={{ __html: guide }}
        />
      )}
    </div>
  );
}

// Visual Format picker — the gallery: looping video thumbs, search,
// picked chips on top, up to three picks (first drives the lookups).
function FormatGallery({ value, onChange }) {
  const [qy, setQy] = useState("");
  const pickedIds = value.map((x) => (typeof x === "string" ? x : x?.id)).filter(Boolean);
  const picked = FORMATS.filter((c) => pickedIds.includes(c.id));
  const list = FORMATS.filter((c) => c.name.toLowerCase().includes(qy.toLowerCase()));
  const toggleFmt = (c) => {
    const on = pickedIds.includes(c.id);
    let next = on ? picked.filter((p) => p.id !== c.id) : [...picked, c];
    if (next.length > 3) next = next.slice(next.length - 3);
    onChange(next);
  };
  return (
    <div className="bl-bd-format-picker">
      {picked.length > 0 && (
        <div className="bl-bd-format-picked">
          {picked.map((c) => (
            <button key={c.id} type="button" className="bl-bd-format-chip is-active" onClick={() => toggleFmt(c)} title="Remove">
              <Check size={11} strokeWidth={3} />
              {c.name}
            </button>
          ))}
        </div>
      )}
      <div className="bl-bd-format-search">
        <Search size={14} />
        <input
          value={qy}
          onChange={(e) => setQy(e.target.value)}
          placeholder={"Search " + FORMATS.length + " visual formats…"}
        />
      </div>
      <div className="bl-bd-format-grid">
        {list.map((c) => {
          const on = pickedIds.includes(c.id);
          return (
            <button key={c.id} type="button" className={`bl-bd-format-card ${on ? "is-active" : ""}`} onClick={() => toggleFmt(c)}>
              <span className="bl-bd-format-thumb">
                {c.thumb ? (
                  <video src={c.thumb} muted playsInline loop autoPlay preload="metadata" />
                ) : (
                  <ImageIcon size={22} />
                )}
                {on && <span className="bl-bd-format-tick"><Check size={12} strokeWidth={3} /></span>}
              </span>
              <span className="bl-bd-format-name">{c.name}</span>
              {c.desc && <span className="bl-bd-format-desc">{c.desc}</span>}
            </button>
          );
        })}
      </div>
      <p className="bl-bd-makesure-hint">Pick one, or up to three for a hybrid. The first pick drives the format lookups.</p>
    </div>
  );
}

// =====================================================================
// SUBMISSIONS — every hand-in for this brief. Card click opens the
// native details page; hover carries Add people (review invite) and
// Download. Deleting stays on the details page.
// =====================================================================
function SubmissionsView({ rows, onOpen, onInvite }) {
  const [qs, setQs] = useState("");
  const [status, setStatus] = useState("");
  const statuses = [...new Set(rows.map((r) => selectLabel(r.fields?.sub_status)).filter(Boolean))];
  const shown = rows.filter((r) => {
    const fl = r.fields || {};
    if (status && selectLabel(fl.sub_status) !== status) return false;
    if (qs) {
      const hay = (unwrap(fl.sub_creator) + " " + unwrap(fl.sub_name)).toLowerCase();
      if (!hay.includes(qs.toLowerCase())) return false;
    }
    return true;
  });
  const download = (fl) => {
    const att = asArray(fl.sub_video_file)[0];
    const url = (att && (att.url || att)) || (typeof fl.sub_video_url === "string" ? fl.sub_video_url : "");
    if (typeof url === "string" && url) window.open(url, "_blank", "noreferrer");
  };
  return (
    <div className="bl-bd-subs">
      <div className="bl-bd-subs-bar">
        <div className="bl-bd-rail-search bl-bd-subs-search">
          <Search size={14} />
          <input value={qs} onChange={(e) => setQs(e.target.value)} placeholder="Search submissions…" />
        </div>
        <select className="bl-bd-subs-status" value={status} onChange={(e) => setStatus(e.target.value)}>
          <option value="">All statuses</option>
          {statuses.map((s) => <option key={s} value={s}>{s}</option>)}
        </select>
      </div>
      {shown.length === 0 ? (
        <p className="bl-bd-empty-view">No submissions here yet. They land as creators hand work in against this brief.</p>
      ) : (
        <div className="bl-bd-subs-grid">
          {shown.map((r) => {
            const fl = r.fields || {};
            const thumb = extractThumbUrl(fl.sub_thumbnail);
            const st = selectLabel(fl.sub_status);
            const version = unwrap(fl.sub_version);
            return (
              <div key={r.id} className="bl-bd-sub-card" onClick={() => onOpen(r.id)} role="button" tabIndex={0}
                onKeyDown={(e) => { if (e.key === "Enter") onOpen(r.id); }}>
                <div className="bl-bd-sub-thumb">
                  {thumb && <img src={thumb} alt="" loading="lazy" draggable={false} />}
                  {st && <span className="bl-bd-sub-status">{st}</span>}
                  <div className="bl-bd-sub-actions" onClick={(e) => e.stopPropagation()}>
                    <button type="button" title="Invite a colleague to review this video" onClick={() => onInvite(r.id)}>
                      <UserPlus size={13} />
                    </button>
                    <button type="button" title="Download the video file" onClick={() => download(fl)}>
                      <UploadIcon size={13} style={{ transform: "rotate(180deg)" }} />
                    </button>
                  </div>
                </div>
                <div className="bl-bd-sub-meta">
                  <span className="bl-bd-sub-name">{unwrap(fl.sub_creator) || unwrap(fl.sub_name) || "Submission"}</span>
                  {version && <span className="bl-bd-sub-version">{version}</span>}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

// =====================================================================
// INVITES — the members-index look over this brief's people, plus the
// Add people and Share review modals. Family styling from the native
// invite form's Styles tab: #FAFBFF card, Inter, #334283 labels,
// #001364 text on a 5% black fill, no border, periwinkle once.
// =====================================================================
const INV_FONT = "'Inter', system-ui, sans-serif";
const invLabelStyle = { display: "block", fontFamily: INV_FONT, fontSize: 12, fontWeight: 500, color: "#334283", margin: "0 0 6px" };
const invInputStyle = { width: "100%", fontFamily: INV_FONT, fontSize: 13, color: "#001364", background: "rgba(0,0,0,0.05)", border: "none", borderRadius: 8, padding: "9px 12px", outline: "none", boxSizing: "border-box" };
const invButtonStyle = { fontFamily: INV_FONT, fontSize: 13, fontWeight: 600, color: "#ffffff", background: PERIWINKLE, border: "none", borderRadius: 8, padding: "9px 18px", cursor: "pointer" };
const invGhostBtnStyle = { fontFamily: INV_FONT, fontSize: 12.5, fontWeight: 600, color: NAVY_DEEP, background: "#FFFFFF", border: `1px solid ${BORDER}`, borderRadius: 8, padding: "7px 14px", cursor: "pointer" };
const invSmallBtnStyle = { ...invButtonStyle, fontSize: 12.5, padding: "7px 14px" };
const invGrid = "2.2fr 1.1fr 0.9fr 1fr 1fr";

function invStatusStyle(status) {
  if (status === "Active") return { background: "rgba(32,149,111,0.12)", color: "#1B7A5C" };
  if (status === "Invited") return { background: "rgba(135,156,247,0.16)", color: NAVY_DEEP };
  if (status === "Pending") return { background: "rgba(252,172,0,0.16)", color: "#8A5A00" };
  return { background: "rgba(107,122,153,0.14)", color: MUTED };
}
function invInitials(name) {
  const parts = String(name || "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].slice(0, 1).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function InviteFields({ draft, setDraft, disabled, messageLabel, messagePlaceholder, lockIdentity }) {
  const access = ACCESS_OPTIONS.find((o) => o.id === draft.accessId) || null;
  // Someone picked from the workspace already has these on their member
  // row, so they read rather than edit; the access and message below
  // stay editable because those are per-brief.
  const identityDisabled = disabled || !!lockIdentity;
  return (
    <>
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 12 }}>
        <div>
          <label style={invLabelStyle}>Full name *</label>
          <input style={{ ...invInputStyle, opacity: identityDisabled ? 0.7 : 1 }} value={draft.name} disabled={identityDisabled}
            onChange={(e) => setDraft((d) => ({ ...d, name: e.target.value }))} placeholder="Their name" />
        </div>
        <div>
          <label style={invLabelStyle}>Email *</label>
          <input style={{ ...invInputStyle, opacity: identityDisabled ? 0.7 : 1 }} type="email" value={draft.email} disabled={identityDisabled}
            onChange={(e) => setDraft((d) => ({ ...d, email: e.target.value }))} placeholder="name@example.com" />
        </div>
      </div>
      <div style={{ marginBottom: 12 }}>
        <label style={invLabelStyle}>{messageLabel || "Message *"}</label>
        <textarea style={{ ...invInputStyle, minHeight: 76, resize: "vertical" }} value={draft.message} disabled={disabled}
          onChange={(e) => setDraft((d) => ({ ...d, message: e.target.value }))}
          placeholder={messagePlaceholder} />
      </div>
      <div style={{ marginBottom: 16 }}>
        <label style={invLabelStyle}>Access *</label>
        <select
          style={{ ...invInputStyle, appearance: "none", cursor: "pointer" }}
          value={draft.accessId} disabled={disabled}
          onChange={(e) => setDraft((d) => ({ ...d, accessId: e.target.value }))}
        >
          {ACCESS_OPTIONS.map((o) => <option key={o.id} value={o.id}>{o.label}</option>)}
        </select>
        {access && <p style={{ margin: "6px 0 0", fontFamily: INV_FONT, fontSize: 11.5, color: MUTED }}>{access.hint}</p>}
      </div>
    </>
  );
}

// Add people — one compact modal, family style, opened from Share,
// from the Invites index, its empty state, and the rail's Creator row.
// The picker: the workspace's own people, so someone who already has a
// member row is attached rather than retyped. Filtered as you type,
// and only rendered when the workspace actually has anyone to pick.
function MemberPicker({ candidates, pickedId, disabled, onPick, onClear }) {
  const [query, setQuery] = useState("");
  const picked = candidates.find((c) => c.id === pickedId) || null;
  const shown = useMemo(() => {
    const needle = query.trim().toLowerCase();
    const list = needle
      ? candidates.filter((c) => (c.name + " " + c.email).toLowerCase().includes(needle))
      : candidates;
    return list.slice(0, 40);
  }, [candidates, query]);

  if (picked) {
    return (
      <div style={{ marginBottom: 12 }}>
        <label style={invLabelStyle}>From your workspace</label>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 10, padding: "9px 12px", background: "rgba(0,0,0,0.05)", borderRadius: 8 }}>
          <span style={{ minWidth: 0, fontFamily: INV_FONT, fontSize: 13, color: "#001364", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
            {picked.name || picked.email}
            <span style={{ color: MUTED }}>{picked.name ? "  " + picked.email : ""}</span>
          </span>
          <button type="button" onClick={onClear} disabled={disabled}
            style={{ flexShrink: 0, background: "transparent", border: "none", cursor: "pointer", fontFamily: INV_FONT, fontSize: 12, fontWeight: 600, color: PERIWINKLE_HOVER, padding: 0 }}>
            Change
          </button>
        </div>
      </div>
    );
  }

  return (
    <div style={{ marginBottom: 12 }}>
      <label style={invLabelStyle}>From your workspace</label>
      <input
        style={invInputStyle}
        value={query}
        disabled={disabled}
        onChange={(e) => setQuery(e.target.value)}
        placeholder="Search people you've worked with"
      />
      {shown.length > 0 && (
        <div style={{ marginTop: 6, maxHeight: 148, overflowY: "auto", border: `1px solid ${BORDER}`, borderRadius: 8, background: "#FFFFFF" }}>
          {shown.map((c) => (
            <button
              key={c.id}
              type="button"
              onClick={() => onPick(c)}
              disabled={disabled}
              style={{ display: "block", width: "100%", textAlign: "left", padding: "8px 12px", background: "transparent", border: "none", borderBottom: `1px solid ${BORDER}`, cursor: "pointer", fontFamily: INV_FONT }}
            >
              <span style={{ display: "block", fontSize: 13, color: "#001364" }}>{c.name || c.email}</span>
              {c.name && <span style={{ display: "block", fontSize: 11.5, color: MUTED }}>{c.email}</span>}
            </button>
          ))}
        </div>
      )}
      {query.trim() && shown.length === 0 && (
        <p style={{ margin: "6px 0 0", fontFamily: INV_FONT, fontSize: 11.5, color: MUTED }}>
          Nobody by that name yet. Fill in the details below to add them.
        </p>
      )}
    </div>
  );
}

function AddPeopleModal({ briefName, published, busy, canInvite, candidates, onInvite, onClose }) {
  const [draft, setDraft] = useState({ name: "", email: "", message: DEFAULT_INVITE_MESSAGE, accessId: ACCESS_OPTIONS[0].id });
  const [pickedId, setPickedId] = useState("");
  const people = Array.isArray(candidates) ? candidates : [];
  const pickPerson = (c) => {
    setPickedId(c.id);
    setDraft((d) => ({ ...d, name: c.name || "", email: c.email }));
  };
  const clearPerson = () => {
    setPickedId("");
    setDraft((d) => ({ ...d, name: "", email: "" }));
  };
  // The action choice follows the access level (creators default to a
  // send, everyone else to add-only) until the inviter picks one.
  const [choiceTouched, setChoiceTouched] = useState(false);
  const [sendChoice, setSendChoice] = useState(true);
  const sendNow = published && (choiceTouched ? sendChoice : draft.accessId === ACCESS_OPTIONS[0].id);
  const pickChoice = (v) => { setSendChoice(v); setChoiceTouched(true); };
  const submit = async () => {
    const access = ACCESS_OPTIONS.find((o) => o.id === draft.accessId) || null;
    const ok = await onInvite({ ...draft, access, sendNow });
    if (ok) onClose();
  };
  return (
    <>
      <div onClick={onClose} style={{ position: "fixed", inset: 0, background: "rgba(10,12,24,0.45)", zIndex: 9998 }} />
      <div style={{ position: "fixed", top: "50%", left: "50%", transform: "translate(-50%, -50%)", width: 520, maxWidth: "92vw", maxHeight: "90vh", overflowY: "auto", background: "#FAFBFF", borderRadius: 16, boxShadow: "0 24px 60px rgba(0,15,77,0.18)", zIndex: 9999, padding: "24px 26px", fontFamily: INV_FONT }}>
        <button type="button" onClick={onClose} aria-label="Close"
          style={{ position: "absolute", top: 14, right: 16, background: "transparent", border: "none", cursor: "pointer", color: MUTED, padding: 4 }}>
          <X size={16} />
        </button>
        <p style={{ margin: "0 0 2px", fontFamily: INV_FONT, fontSize: 17, fontWeight: 600, color: NAVY_DEEP }}>{"Add people to " + (briefName || "this brief")}</p>
        <p style={{ margin: "0 0 16px", fontFamily: INV_FONT, fontSize: 12.5, color: MUTED }}>
          {published
            ? "They get an email with the brief and their link. No account needed."
            : "This brief isn't published yet. People you add sit as Pending. Send their invites from the list once you publish."}
        </p>
        {canInvite ? (
          <>
            {people.length > 0 && (
              <MemberPicker
                candidates={people}
                pickedId={pickedId}
                disabled={busy}
                onPick={pickPerson}
                onClear={clearPerson}
              />
            )}
            <InviteFields draft={draft} setDraft={setDraft} disabled={busy} lockIdentity={!!pickedId} />
            {published && (
              <div style={{ marginBottom: 16 }}>
                <label style={invLabelStyle}>When you add them</label>
                <label style={{ display: "flex", alignItems: "center", gap: 8, fontFamily: INV_FONT, fontSize: 13, color: "#001364", marginBottom: 6, cursor: "pointer" }}>
                  <input type="radio" name="bl-inv-when" checked={sendNow} onChange={() => pickChoice(true)} disabled={busy}
                    style={{ accentColor: PERIWINKLE, width: 14, height: 14 }} />
                  Send the invite now
                </label>
                <label style={{ display: "flex", alignItems: "center", gap: 8, fontFamily: INV_FONT, fontSize: 13, color: "#001364", cursor: "pointer" }}>
                  <input type="radio" name="bl-inv-when" checked={!sendNow} onChange={() => pickChoice(false)} disabled={busy}
                    style={{ accentColor: PERIWINKLE, width: 14, height: 14 }} />
                  Add to the brief, send the invite later
                </label>
              </div>
            )}
            <div style={{ display: "flex", justifyContent: "flex-end" }}>
              <button type="button" style={{ ...invButtonStyle, opacity: busy ? 0.6 : 1 }} disabled={busy} onClick={submit}>
                {busy ? "Working…" : sendNow ? "Send invite" : "Add to brief"}
              </button>
            </div>
          </>
        ) : (
          <p style={{ margin: 0, fontFamily: INV_FONT, fontSize: 13, color: MUTED }}>You don't have permission to add people.</p>
        )}
      </div>
    </>
  );
}

// Invites index — the members-table look: white card, uppercase head,
// avatar rows, status pills. Send invite appears per row once the
// brief is published, for every Pending person.
const INV_PAGE_SIZE = 10;
function InvitesView({ rows, published, canInvite, onAdd, onSendRow, onSendRows, sendingRowId }) {
  const [page, setPage] = useState(0);
  const [sel, setSel] = useState([]);
  const [bulkBusy, setBulkBusy] = useState(false);
  const headCell = { fontFamily: INV_FONT, fontSize: 11, fontWeight: 600, letterSpacing: "0.05em", textTransform: "uppercase", color: MUTED };

  const pages = Math.max(1, Math.ceil(rows.length / INV_PAGE_SIZE));
  const cur = Math.min(page, pages - 1);
  const pageRows = rows.slice(cur * INV_PAGE_SIZE, cur * INV_PAGE_SIZE + INV_PAGE_SIZE);
  const eligible = (r) => {
    const fl = r.fields || {};
    return published && canInvite &&
      (selectLabel(fl.member_status) || "Invited") === "Pending";
  };
  const pageEligibleIds = pageRows.filter(eligible).map((r) => r.id);
  const showSelect = published && canInvite && rows.some(eligible);
  const grid = showSelect ? "26px " + invGrid : invGrid;
  const selectedHere = sel.filter((id) => pageEligibleIds.includes(id));
  const allHere = pageEligibleIds.length > 0 && selectedHere.length === pageEligibleIds.length;
  const toggleOne = (id) => setSel((c) => (c.includes(id) ? c.filter((x) => x !== id) : [...c, id]));
  const toggleAll = () => setSel((c) => (allHere ? c.filter((id) => !pageEligibleIds.includes(id)) : [...new Set([...c, ...pageEligibleIds])]));
  const selRows = rows.filter((r) => sel.includes(r.id) && eligible(r));
  const doBulk = async () => {
    if (!selRows.length) return;
    setBulkBusy(true);
    try { await onSendRows(selRows); setSel([]); }
    finally { setBulkBusy(false); }
  };

  return (
    <div className="bl-bd-subs" style={{ fontFamily: INV_FONT }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 12, marginBottom: 14 }}>
        <p style={{ margin: 0, fontFamily: INV_FONT, fontSize: 13, color: MUTED }}>
          {rows.length === 1 ? "1 person on this brief." : rows.length + " people on this brief."}
        </p>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          {selRows.length > 0 && (
            <button type="button" style={{ ...invSmallBtnStyle, opacity: bulkBusy ? 0.6 : 1 }} disabled={bulkBusy} onClick={doBulk}>
              {bulkBusy ? "Sending…" : selRows.length === 1 ? "Send 1 invite now" : "Send " + selRows.length + " invites now"}
            </button>
          )}
          {canInvite && rows.length > 0 && (
            <button type="button" style={invGhostBtnStyle} onClick={onAdd}>
              Add people
            </button>
          )}
        </div>
      </div>
      <div style={{ background: "#FFFFFF", border: `1px solid ${BORDER}`, borderRadius: 14, overflow: "hidden" }}>
        <div style={{ display: "grid", gridTemplateColumns: grid, gap: 8, padding: "10px 16px", background: "#FAFBFF", borderBottom: `1px solid ${BORDER}` }}>
          {showSelect && (
            <span style={{ display: "inline-flex", alignItems: "center" }}>
              <input type="checkbox" checked={allHere} onChange={toggleAll} disabled={pageEligibleIds.length === 0 || bulkBusy}
                style={{ accentColor: PERIWINKLE, width: 14, height: 14, cursor: "pointer" }} aria-label="Select everyone ready to invite on this page" />
            </span>
          )}
          <span style={headCell}>Member</span>
          <span style={headCell}>Access</span>
          <span style={headCell}>Status</span>
          <span style={headCell}>Invited</span>
          <span style={headCell} />
        </div>
        {rows.length === 0 && (
          <div style={{ padding: "48px 24px", textAlign: "center" }}>
            <span style={{ width: 44, height: 44, borderRadius: 12, background: "rgba(135,156,247,0.14)", color: NAVY_DEEP, display: "inline-flex", alignItems: "center", justifyContent: "center", marginBottom: 12 }}><UserPlus size={20} /></span>
            <p style={{ margin: "0 0 4px", fontFamily: INV_FONT, fontSize: 15, fontWeight: 600, color: NAVY_DEEP }}>Nobody on this brief yet</p>
            <p style={{ margin: "0 0 14px", fontFamily: INV_FONT, fontSize: 13, color: MUTED }}>Add the people who'll film it, review it or follow along.</p>
            {canInvite && <button type="button" style={invButtonStyle} onClick={onAdd}>Add people</button>}
          </div>
        )}
        {pageRows.map((r) => {
          const fl = r.fields || {};
          const name = unwrap(fl.member_name) || unwrap(fl.member_email) || "Member";
          const status = selectLabel(fl.member_status) || "Invited";
          const access = selectLabel(fl.member_access) || "";
          const rowEligible = eligible(r);
          const sending = sendingRowId === r.id || (bulkBusy && sel.includes(r.id));
          return (
            <div key={r.id} style={{ display: "grid", gridTemplateColumns: grid, gap: 8, alignItems: "center", padding: "12px 16px", borderTop: "1px solid rgba(217,224,255,0.35)" }}>
              {showSelect && (
                <span style={{ display: "inline-flex", alignItems: "center" }}>
                  {rowEligible && (
                    <input type="checkbox" checked={sel.includes(r.id)} onChange={() => toggleOne(r.id)} disabled={bulkBusy}
                      style={{ accentColor: PERIWINKLE, width: 14, height: 14, cursor: "pointer" }} aria-label={"Select " + name} />
                  )}
                </span>
              )}
              <div style={{ display: "flex", alignItems: "center", gap: 10, minWidth: 0 }}>
                <span style={{ width: 34, height: 34, borderRadius: 999, background: "rgba(135,156,247,0.18)", color: NAVY_DEEP, fontSize: 12, fontWeight: 600, display: "inline-flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>{invInitials(name)}</span>
                <div style={{ minWidth: 0 }}>
                  <p style={{ margin: 0, fontFamily: INV_FONT, fontSize: 13, fontWeight: 600, color: NAVY_DEEP, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{name}</p>
