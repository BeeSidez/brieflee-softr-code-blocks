function UrlSlot({ label, value, onSave }) {
  const [draft, setDraft] = useState(value || "");
  const [saving, setSaving] = useState(false);
  useEffect(() => { setDraft(value || ""); }, [value]);
  const commit = async () => {
    if ((draft || "") === (value || "")) return;
    setSaving(true);
    try { await onSave(draft.trim()); } finally { setSaving(false); }
  };
  const clear = async () => {
    if (!value) return;
    setSaving(true);
    try { await onSave(""); setDraft(""); } finally { setSaving(false); }
  };
  // Live preview off the SAVED value, not the draft — embeds shouldn't
  // jump around while the user types. Re-runs on save.
  const embed = detectExternalEmbed(value);
  const directVideo = !embed && isDirectVideoUrl(value);
  return (
    <div className="bl-bd-url-slot">
      <span className="bl-bd-url-slot-label">{label}</span>
      <div className="bl-bd-url-slot-input-row">
        <Input
          className="bl-bd-input"
          value={draft}
          onChange={(e) => setDraft(e.target.value)}
          placeholder="Paste TikTok / Instagram URL"
          onBlur={commit}
          onKeyDown={(e) => { if (e.key === "Enter") commit(); }}
          disabled={saving}
        />
        {value && (
          <button
            type="button"
            className="bl-bd-url-clear"
            onClick={clear}
            title="Clear URL"
            disabled={saving}
          >
            <X size={12} />
          </button>
        )}
      </div>
      {saving && <span className="bl-bd-saving">Saving…</span>}
      {embed && (
        <div className={`bl-bd-url-embed bl-bd-url-embed-${embed.aspect}`}>
          <iframe
            src={embed.src}
            title={label}
            allow="autoplay; encrypted-media; picture-in-picture; clipboard-write; web-share"
            allowFullScreen
            referrerPolicy="strict-origin-when-cross-origin"
            loading="lazy"
          />
        </div>
      )}
      {directVideo && (
        <div className="bl-bd-url-embed bl-bd-url-embed-vertical">
          <video src={value} controls preload="metadata" />
        </div>
      )}
      {value && !embed && !directVideo && (
        <a
          className="bl-bd-url-fallback"
          href={value}
          target="_blank"
          rel="noreferrer"
        >
          <ExternalLink size={11} />
          Open link
        </a>
      )}
    </div>
  );
}

// =====================================================================
// PDF row — alternation: URL OR file upload, with inline iframe preview
//
// PDFs render in an embedded iframe so the user doesn't have to leave
// the page to read the brief. Browsers handle application/pdf natively
// via the PDF viewer plugin. Falls back to a plain link if the pasted
// URL clearly isn't a PDF (e.g. someone drops a Notion / Google Doc).
// =====================================================================
function PdfRow({ url, attachment, uploading, onSaveUrl, onClickUpload, onClear }) {
  const [editingUrl, setEditingUrl] = useState(false);
  const [draftUrl, setDraftUrl] = useState(url || "");
  useEffect(() => { setDraftUrl(url || ""); }, [url]);
  const uploadHref = extractThumbUrl(attachment);
  const hasUpload = !!uploadHref;
  const hasUrl = !!(url && String(url).trim());
  // Prefer the uploaded file (always a PDF) over the pasted URL.
  // Pasted URLs only get embedded if we're confident they're PDFs.
  const previewSrc =
    hasUpload ? uploadHref :
      (hasUrl && isPdfUrl(url) ? url : "");
  const externalHref = hasUpload ? uploadHref : (hasUrl ? url : "");
  const linkLabel = hasUpload
    ? "Open in new tab"
    : (hasUrl && url.length > 60 ? url.slice(0, 57) + "…" : (hasUrl ? url : ""));
  return (
    <div className="bl-bd-pdf-row">
      <div className="bl-bd-pdf-label">
        Brief PDF
        <TooltipIcon text="Optional. Drop a PDF version of the brief or paste a link to one. PDFs preview inline so you don't have to leave the page." />
      </div>
      {previewSrc && (
        <div className="bl-bd-pdf-embed">
          <iframe
            src={previewSrc}
            title="Brief PDF preview"
            loading="lazy"
          />
        </div>
      )}
      {hasUpload ? (
        <div className="bl-bd-pdf-filled">
          <a className="bl-bd-pdf-link" href={externalHref} target="_blank" rel="noreferrer">
            <ExternalLink size={13} />
            {linkLabel}
          </a>
          <button
            type="button"
            className="bl-bd-pdf-clear"
            onClick={onClear}
            title="Remove PDF"
          >
            <X size={13} />
          </button>
        </div>
      ) : hasUrl && !editingUrl ? (
        <div className="bl-bd-pdf-filled">
          <a className="bl-bd-pdf-link" href={externalHref} target="_blank" rel="noreferrer">
            <Link2 size={13} />
            {linkLabel}
          </a>
          <button
            type="button"
            className="bl-bd-pdf-edit"
            onClick={() => setEditingUrl(true)}
            title="Edit URL"
          >
            <Pencil size={13} />
          </button>
          <button
            type="button"
            className="bl-bd-pdf-clear"
            onClick={onClear}
            title="Remove PDF link"
          >
            <X size={13} />
          </button>
        </div>
      ) : editingUrl ? (
        <div className="bl-bd-pdf-edit-row">
          <Input
            className="bl-bd-input"
            value={draftUrl}
            onChange={(e) => setDraftUrl(e.target.value)}
            placeholder="https://…"
            autoFocus
            onKeyDown={async (e) => {
              if (e.key === "Enter") { await onSaveUrl(draftUrl.trim()); setEditingUrl(false); }
              if (e.key === "Escape") { setDraftUrl(url || ""); setEditingUrl(false); }
            }}
          />
          <button
            type="button"
            className="bl-bd-pdf-save"
            onClick={async () => { await onSaveUrl(draftUrl.trim()); setEditingUrl(false); }}
          >
            Save
          </button>
        </div>
      ) : (
        <div className="bl-bd-pdf-empty">
          <button
            type="button"
            className="bl-bd-pdf-action"
            onClick={onClickUpload}
            disabled={uploading}
          >
            <UploadIcon size={13} /> {uploading ? "Uploading…" : "Upload PDF"}
          </button>
          <span className="bl-bd-pdf-or">or</span>
          <button
            type="button"
            className="bl-bd-pdf-action"
            onClick={() => setEditingUrl(true)}
          >
            <Link2 size={13} /> Paste a link
          </button>
        </div>
      )}
    </div>
  );
}

// Uncontrolled contentEditable — React never wipes typing; commits on
// blur through the same per-field save path as everything else.
function EditableHtml({ html, rev, placeholder, onEdit, onCommit }) {
  const ref = useRef(null);
  useEffect(() => {
    if (ref.current && ref.current.innerHTML !== html) ref.current.innerHTML = html;
  }, [rev]); // eslint-disable-line
  return (
    <div
      ref={ref}
      className="bl-bd-editable"
      contentEditable
      suppressContentEditableWarning
      data-ph={placeholder}
      onInput={(e) => onEdit(e.currentTarget.innerHTML)}
      onBlur={onCommit}
    />
  );
}

// Visual Format picker — searchable chips over the 42-format library.
function FormatChips({ value, onChange }) {
  const [qy, setQy] = useState("");
  const pickedIds = value.map((x) => (typeof x === "string" ? x : x?.id)).filter(Boolean);
  const picked = FORMAT_CHOICES.filter((c) => pickedIds.includes(c.id));
  const list = FORMAT_CHOICES.filter((c) => c.name.toLowerCase().includes(qy.toLowerCase()));
  const toggleFmt = (c) => {
    const on = pickedIds.includes(c.id);
    let next = on ? picked.filter((p) => p.id !== c.id) : [...picked, c];
    if (next.length > 3) next = next.slice(next.length - 3);
    onChange(next);
  };
  return (
    <div className="bl-bd-format-picker">
      <div className="bl-bd-format-search">
        <Search size={14} />
        <input
          value={qy}
          onChange={(e) => setQy(e.target.value)}
          placeholder={"Search " + FORMAT_CHOICES.length + " visual formats…"}
        />
      </div>
      <div className="bl-bd-format-chips">
        {list.map((c) => {
          const on = pickedIds.includes(c.id);
          return (
            <button key={c.id} type="button" className={`bl-bd-format-chip ${on ? "is-active" : ""}`} onClick={() => toggleFmt(c)}>
              {on && <Check size={11} strokeWidth={3} />}
              {c.name}
            </button>
          );
        })}
      </div>
      <p className="bl-bd-makesure-hint">Pick one, or up to three for a hybrid. The first pick drives the format lookups.</p>
    </div>
  );
}

// =====================================================================
// SUBMISSIONS — every hand-in for this brief. Card click opens the
// native details page; hover carries Add people (review invite) and
// Download. Deleting stays on the details page.
// =====================================================================
function SubmissionsView({ rows, onOpen, onInvite }) {
  const [qs, setQs] = useState("");
  const [status, setStatus] = useState("");
  const statuses = [...new Set(rows.map((r) => selectLabel(r.fields?.sub_status)).filter(Boolean))];
  const shown = rows.filter((r) => {
    const fl = r.fields || {};
    if (status && selectLabel(fl.sub_status) !== status) return false;
    if (qs) {
      const hay = (unwrap(fl.sub_creator) + " " + unwrap(fl.sub_name)).toLowerCase();
      if (!hay.includes(qs.toLowerCase())) return false;
    }
    return true;
  });
  const download = (fl) => {
    const att = asArray(fl.sub_video_file)[0];
    const url = (att && (att.url || att)) || (typeof fl.sub_video_url === "string" ? fl.sub_video_url : "");
    if (typeof url === "string" && url) window.open(url, "_blank", "noreferrer");
  };
  return (
    <div className="bl-bd-subs">
      <div className="bl-bd-subs-bar">
        <div className="bl-bd-rail-search bl-bd-subs-search">
          <Search size={14} />
          <input value={qs} onChange={(e) => setQs(e.target.value)} placeholder="Search submissions…" />
        </div>
        <select className="bl-bd-subs-status" value={status} onChange={(e) => setStatus(e.target.value)}>
          <option value="">All statuses</option>
          {statuses.map((s) => <option key={s} value={s}>{s}</option>)}
        </select>
      </div>
      {shown.length === 0 ? (
        <p className="bl-bd-empty-view">No submissions here yet. They land as creators hand work in against this brief.</p>
      ) : (
        <div className="bl-bd-subs-grid">
          {shown.map((r) => {
            const fl = r.fields || {};
            const thumb = extractThumbUrl(fl.sub_thumbnail);
            const st = selectLabel(fl.sub_status);
            const version = unwrap(fl.sub_version);
            return (
              <div key={r.id} className="bl-bd-sub-card" onClick={() => onOpen(r.id)} role="button" tabIndex={0}
                onKeyDown={(e) => { if (e.key === "Enter") onOpen(r.id); }}>
                <div className="bl-bd-sub-thumb">
                  {thumb && <img src={thumb} alt="" loading="lazy" draggable={false} />}
                  {st && <span className="bl-bd-sub-status">{st}</span>}
                  <div className="bl-bd-sub-actions" onClick={(e) => e.stopPropagation()}>
                    <button type="button" title="Invite a colleague to review this video" onClick={() => onInvite(r.id)}>
                      <UserPlus size={13} />
                    </button>
                    <button type="button" title="Download the video file" onClick={() => download(fl)}>
                      <UploadIcon size={13} style={{ transform: "rotate(180deg)" }} />
                    </button>
                  </div>
                </div>
                <div className="bl-bd-sub-meta">
                  <span className="bl-bd-sub-name">{unwrap(fl.sub_creator) || unwrap(fl.sub_name) || "Submission"}</span>
                  {version && <span className="bl-bd-sub-version">{version}</span>}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

// =====================================================================
// INVITES — everyone linked to this brief, plain: name, email,
// status, invited date. No actions by design.
// =====================================================================
function InvitesView({ rows }) {
  const fmt = (iso) => {
    if (!iso) return "";
    try {
      const d = new Date(iso);
      return d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" }) +
        ", " + d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
    } catch { return String(iso); }
  };
  return (
    <div className="bl-bd-subs">
      {rows.length === 0 ? (
        <p className="bl-bd-empty-view">Nobody has been invited to this brief yet. Use Share, then Add people.</p>
      ) : (
        <table className="bl-bd-inv-table">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Status</th><th>Invited</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => {
              const fl = r.fields || {};
              return (
                <tr key={r.id}>
                  <td>{unwrap(fl.member_name) || "—"}</td>
                  <td>{unwrap(fl.member_email)}</td>
                  <td>{selectLabel(fl.member_status) && <span className="bl-bd-inv-status">{selectLabel(fl.member_status)}</span>}</td>
                  <td>{fmt(fl.member_invited || fl.member_created)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>
  );
}

// =====================================================================
// RAIL — Details (the brief's identity), Sections (the Bible) and
// Modules (live workspace pulls + generic inserts).
// =====================================================================
function Rail({ open, setOpen, order, secParts, onToggleSection, onTogglePart, onModule,
  accountName, accountLoaded, railPrompt, onSubmitPrompt, onCancelPrompt,
  slotPicker, onPickSlot, onCancelSlots, mediaSaving, details }) {
  const [qs, setQs] = useState("");
  const secs = RAIL_SECTIONS.filter((s) => s.name.toLowerCase().includes(qs.toLowerCase()));
  const flip = (k) => setOpen((o) => ({ ...o, [k]: !o[k] }));
  return (
    <aside className="bl-bd-rail">
      <RailAccordion
        label="Details"
        icon={<Info size={15} />}
        count={0}
        open={!!open.details}
        onToggle={() => flip("details")}
      >
        <RailDetails d={details} />
      </RailAccordion>

      <RailAccordion
        label="Sections"
        icon={<LayoutTemplate size={15} />}
        count={order.length}
        open={!!open.sections}
        onToggle={() => flip("sections")}
      >
        <div className="bl-bd-rail-hint">The building blocks of the brief. Add a section to drop it into the page.</div>
        <div className="bl-bd-rail-search">
          <Search size={14} />
          <input value={qs} onChange={(e) => setQs(e.target.value)} placeholder="Search sections…" />
        </div>
        {secs.map((s) => (
          <RailSectionRow
            key={s.key}
            entry={s}
            added={order.includes(s.key)}
            visible={secParts[s.key] || []}
            onToggle={() => onToggleSection(s.key)}
            onTogglePart={(pk) => onTogglePart(s.key, pk)}
          />
        ))}
      </RailAccordion>

      <RailAccordion
        label="Modules"
        icon={<Layers size={15} />}
        count={0}
        open={!!open.modules}
        onToggle={() => flip("modules")}
      >
        <div className="bl-bd-rail-hint">
          {accountLoaded ? "Pulled live from " + (accountName || "your workspace") + ", or dropped into Extra. Click to add." : "Loading your workspace…"}
        </div>
        {MODULES.map((m) => (
          <div key={m.key} className="bl-bd-rail-mod">
            <RailRow
              name={m.name}
              sub={m.key === "media" && mediaSaving ? "Uploading…" : m.desc}
              tip={m.tip}
              added={false}
              disabled={m.kind === "disabled"}
              onClick={() => onModule(m)}
            />
            {railPrompt?.mod?.key === m.key && (
              <RailPrompt
                label={m.label || m.name}
                placeholder={m.placeholder || ""}
                onSubmit={onSubmitPrompt}
                onCancel={onCancelPrompt}
              />
            )}
            {slotPicker?.mod?.key === m.key && (
              <div className="bl-bd-rail-slots">
                {slotPicker.slots.map((s) => (
                  <button key={s.n} type="button" onClick={() => onPickSlot(s)}>
                    <Plus size={11} />
                    <span>{stripHtmlText(s.text).slice(0, 60) || "Page " + s.n}</span>
                  </button>
                ))}
                <button type="button" className="bl-bd-rail-slots-cancel" onClick={onCancelSlots}>Cancel</button>
              </div>
            )}
          </div>
        ))}
      </RailAccordion>
    </aside>
  );
}

// The old Overview, condensed into the rail: status, review mode,
// visibility, thumbnail and the creator (Creator Info, section 18).
function RailDetails({ d }) {
  return (
    <div className="bl-bd-rail-details">
      <div className="bl-bd-rd-row">
        <span className="bl-bd-rd-label">Status</span>
        <StatusPicker value={d.briefStatus?.id || ""} saving={d.statusSaving} onChange={d.commitStatus} />
