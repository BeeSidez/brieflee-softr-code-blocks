  if (thLabel) {
    const line = thresholdSentence(thAlias, thLabel);
    if (line) return line;
  }
  if (agentLabel === "Video length" && duration && duration.label) {
    const mode = durationTh && durationTh.label === "min" ? "at least" : "under";
