  const openAssignBrief = useCallback(() => {
    if (typeof window === "undefined" || !briefId) return;
    const url = `/assign-brief?recordId=${encodeURIComponent(briefId)}`;
    if (typeof window.openSwModal === "function") {
      window.openSwModal(url, "md");
    } else {
      window.open(url, "_self");
    }
  }, [briefId]);
  // No auto-popup. New briefs already arrive with a project: the
  // /new-brief form maps it, and create-brief-quick writes the link on
  // create too. The popup was firing on the race described above, not
  // on genuinely unassigned briefs. Older briefs with no project get
  // the inline banner and open the picker when the user chooses to.
  // Listen for picker success pings.
  //   brieflee:brief-assigned → refetch (assignment modal closed).
  //   brieflee:inspo-pick     → write the picked review to
  //                             example / example_2 / example_3.
  //   brieflee:swipe-pick     → write the picked video to
  //                             videos / videos_2 / videos_3.
  useEffect(() => {
    if (typeof window === "undefined" || !briefId) return;
    const INSPO_SLOT_FIELDS = ["example", "example_2", "example_3"];
    const SWIPE_SLOT_FIELDS = ["videos", "videos_2", "videos_3"];
    const onMessage = async (event) => {
      const data = event?.data;
      const t = data?.type || data;
      if (t === "brieflee:brief-assigned") {
        refetch?.();
        return;
      }
      if (t === "brieflee:inspo-pick") {
        const idx = Number(data?.slot) - 1;
        const fieldAlias = INSPO_SLOT_FIELDS[idx];
        const reviewId = data?.review?.id;
        if (!fieldAlias || !reviewId) return;
        try {
          await updateRecord.mutateAsync({
            recordId: briefId,
            fields: { [fieldAlias]: [{ id: reviewId }] },
          });
          await refetch?.();
          toast.success("Review pick saved");
        } catch (e) {
          console.error("Inspo pick save failed:", e);
          toast.error("Couldn't save pick", { description: e?.message });
        }
        return;
      }
      if (t === "brieflee:swipe-pick") {
        const idx = Number(data?.slot) - 1;
        const fieldAlias = SWIPE_SLOT_FIELDS[idx];
        const videoId = data?.video?.id;
        if (!fieldAlias || !videoId) return;
        try {
          await updateRecord.mutateAsync({
            recordId: briefId,
            fields: { [fieldAlias]: [{ id: videoId }] },
          });
          await refetch?.();
          toast.success("Swipe video saved");
        } catch (e) {
          console.error("Swipe pick save failed:", e);
          toast.error("Couldn't save pick", { description: e?.message });
        }
        return;
      }
    };
    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, [refetch, briefId, updateRecord]);

  // ─── Collapsible sections ─────────────────────────────────
  // Every section starts CLOSED (Bev, 2026-08-26): the brief reads at
  // a glance and a heading click opens it. Manual toggles still
  // persist per brief for the session.
  const STORAGE_KEY = `bl-brief-builder-collapsed:${briefId || "anon"}`;
  const [collapsed, setCollapsed] = useState(() => {
    const m = {};
    try { Object.values(SECTION_DEFS).forEach((d) => { if (d && d.key) m["s_" + d.key] = true; }); } catch (e) { }
    return m;
  });
  const collapseInitRef = useRef(false);
  useEffect(() => {
    if (collapseInitRef.current || typeof window === "undefined") return;
    collapseInitRef.current = true;
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      // Merge saved toggles OVER the closed-by-default map, so sections
      // the user never touched stay closed.
      if (raw) setCollapsed((cur) => ({ ...cur, ...JSON.parse(raw) }));
    } catch { }
  }, [STORAGE_KEY]);
  useEffect(() => {
    if (typeof window === "undefined" || !collapseInitRef.current) return;
    try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(collapsed)); } catch { }
  }, [collapsed, STORAGE_KEY]);
  const toggle = (key) => setCollapsed((c) => ({ ...c, [key]: !c[key] }));

  // ─── Inline title edit (the page's H1) ────────────────────
  const [nameDraft, setNameDraft] = useState(briefName);
  const [editingName, setEditingName] = useState(false);
  const [nameSaving, setNameSaving] = useState(false);
  useEffect(() => { setNameDraft(briefName); }, [briefName]);
  const commitName = async () => {
    const next = nameDraft.trim();
    if (!next || next === briefName) { setEditingName(false); return; }
    setNameSaving(true);
    await saveField({ name: next }, "name");
    setEditingName(false);
    setNameSaving(false);
  };

  // ─── Rail Details quick-edits ─────────────────────────────
  const [statusSaving, setStatusSaving] = useState(false);
  const commitStatus = async (optionId) => {
    if (!optionId || optionId === briefStatus?.id) return;
    const opt = STATUS_OPTIONS.find((o) => o.id === optionId);
    if (!opt) return;
    setStatusSaving(true);
    await saveField({ status: { id: opt.id, label: opt.label } }, "status");
    setStatusSaving(false);
  };
  const [privacySaving, setPrivacySaving] = useState(false);
  const togglePrivacy = async () => {
    // Keep Seo:index in lockstep with public/private.
    const nextPrivate = !isPrivate;
    setPrivacySaving(true);
    await saveField({
      private_mode: nextPrivate,
      seo_index: !nextPrivate,
    }, "privacy");
    setPrivacySaving(false);
  };
  const [reviewModeSaving, setReviewModeSaving] = useState(false);
  const reviewModeLabel = selectLabel(f.ai_mode) || "";
  const commitReviewMode = async (label) => {
    if (label === reviewModeLabel) return;
    const opt = AI_MODE_OPTIONS.find((o) => o.label === label);
    if (!opt) return;
    setReviewModeSaving(true);
    await saveField({ ai_mode: { id: opt.id, label: opt.label } }, "review mode");
    setReviewModeSaving(false);
  };

  // ─── Thumbnail upload (rail Details) ──────────────────────
  const thumbFileRef = useRef(null);
  const [thumbSaving, setThumbSaving] = useState(false);
  const handleThumbnailFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setThumbSaving(true);
    try {
      const uploaded = await (upload.uploadAsync ? upload.uploadAsync(file) : upload.mutateAsync(file));
      const arr = Array.isArray(uploaded) ? uploaded : [uploaded];
      const url = arr[0]?.url || arr[0]?.file?.url || "";
      await saveField({ thumbnail: url ? [{ filename: file.name, url }] : arr }, "thumbnail");
      toast.success("Thumbnail updated");
    } catch (err) {
      console.error("Thumbnail upload failed:", err);
      toast.error("Couldn't upload thumbnail", { description: err?.message });
    } finally {
      setThumbSaving(false);
      if (thumbFileRef.current) thumbFileRef.current.value = "";
    }
  };

  // ─── Share + publish ──────────────────────────────────────
  const existingSlug = typeof f.slug === "string" ? f.slug.trim() : "";
  const [shareOpen, setShareOpen] = useState(false);
  const creatorUrl = creatorUrlFor(existingSlug || generateSlug(unwrap(f.name), briefId));
  const teamUrl = teamUrlFor(briefId);
  const [publishSaving, setPublishSaving] = useState(false);
  const publish = async () => {
    if (briefStatus?.label === "Active") return;
    const active = STATUS_OPTIONS.find((o) => o.label === "Active");
    if (!active) return;
    setPublishSaving(true);
    await saveField({ status: { id: active.id, label: active.label } }, "publish");
    toast.success("Brief is live");
    setPublishSaving(false);
  };

  // ─── Sections on the page (order + visible parts) ─────────
  // order = section keys in display order. secParts = key → the part
  // keys currently visible. Hydrated from section_order; sections
  // holding content but missing from the stored order get appended
  // (AI workflow writes, migrations), and content-bearing parts are
  // always visible.
  const [order, setOrder] = useState([]);
  const [secParts, setSecParts] = useState({});
  const [bodies, setBodies] = useState({});   // alias → html (drafts)
  const [writing, setWriting] = useState({}); // key → true while AI writes
  const revRef = useRef(0);
  // Brief credits. One credit per successful AI section write, counted here
  // rather than read off the record each time so two quick clicks on
  // different sections cannot both read the same value and lose an
  // increment. Seeded once per brief, never re-seeded on refetch.
  const creditsRef = useRef(null);
  const sectionsHydratedRef = useRef(null);

  useEffect(() => {
    if (!record || sectionsHydratedRef.current === record.id) return;
    sectionsHydratedRef.current = record.id;
    const nextBodies = {};
    SECTIONS.forEach((e) => {
      (e.parts || []).forEach((p) => {
        if (p.kind !== "html" && p.kind !== "makesure") return;
        (p.fields || []).forEach((alias) => {
          const v = f[alias];
          if (typeof v === "string" && v.trim()) nextBodies[alias] = v;
        });
      });
    });
    setBodies(nextBodies);
    const parsed = parseOrder(typeof f.section_order === "string" ? f.section_order : "");
    const nextOrder = [...parsed.order];
    const nextParts = { ...parsed.partsMap };
    SECTIONS.forEach((e) => {
      if (!nextOrder.includes(e.key) && sectionHasContent(e, f)) {
        nextOrder.push(e.key);
        nextParts[e.key] = defaultPartKeys(e);
      }
    });
    // Content-bearing parts always show, whatever the stored list says.
    nextOrder.forEach((k) => {
      const e = SECTIONS.find((x) => x.key === k);
      if (!e) return;
      const vis = new Set(nextParts[k] || defaultPartKeys(e));
      e.parts.forEach((p) => { if (partHasContent(p, f)) vis.add(p.key); });
      nextParts[k] = e.parts.map((p) => p.key).filter((pk) => vis.has(pk));
    });
    setOrder(nextOrder);
    setSecParts(nextParts);
    revRef.current += 1;
  }, [record]); // eslint-disable-line

  // Keep the plain-text compile in sync with the latest drafts.
  compileRef.current = (patch) => compilePlainDescription({ ...f, ...bodies, ...patch }, order, secParts, patch);

  // One-time migration: old briefs stored the body as JSON inside
  // description. Move each legacy card into its section field, then
  // description becomes compiled plain text from here on.
  const migratedRef = useRef(null);
  useEffect(() => {
    if (!record || migratedRef.current === record.id) return;
    const legacy = extractJson(f.description);
    if (!legacy || typeof legacy !== "object") { migratedRef.current = record.id; return; }
    migratedRef.current = record.id;
    const asHtml = (v) => {
      if (!v) return "";
      if (Array.isArray(v)) return v.filter(Boolean).map((x) => `<p>${typeof x === "string" ? x : JSON.stringify(x)}</p>`).join("");
      if (typeof v === "string") return `<p>${v.replace(/\n/g, "<br/>")}</p>`;
      return "";
    };
    const sb = Array.isArray(legacy.storyboard)
      ? legacy.storyboard.map((r) => `<p><b>${r.section || ""}</b> — ${r.script || ""}${r.visual ? " · " + r.visual : ""}</p>`).join("")
      : "";
    const patch = {};
    const maybe = (alias, html) => { if (html && !(typeof f[alias] === "string" && f[alias].trim())) patch[alias] = html; };
    maybe("captionHooks", asHtml(legacy.hook));
    maybe("talkingPoints", asHtml(legacy.talking_points));
    maybe("script", asHtml(legacy.script) + sb);
    maybe("dos", asHtml(legacy.dos));
    maybe("donts", asHtml(legacy.donts));
    maybe("extra", [asHtml(legacy.cta) && "<p><b>CTAs</b></p>" + asHtml(legacy.cta), asHtml(legacy.personal_experiences) && "<p><b>Personal experiences</b></p>" + asHtml(legacy.personal_experiences)].filter(Boolean).join(""));
    if (Object.keys(patch).length) {
      // Surface the migrated sections on the page immediately.
      const touched = SECTIONS.filter((e) => e.parts.some((p) => p.fields.some((a) => a in patch)));
      const nextOrder = [...order];
      const nextParts = { ...secParts };
      touched.forEach((e) => {
        if (!nextOrder.includes(e.key)) {
          nextOrder.push(e.key);
          nextParts[e.key] = defaultPartKeys(e);
        }
      });
      setOrder(nextOrder);
      setSecParts(nextParts);
      setBodies((cur) => ({ ...cur, ...patch }));
      revRef.current += 1;
      patch.section_order = encodeOrder(nextOrder, nextParts);
      saveField(patch, "brief migration").then(() => toast.success("Brief upgraded to sections"));
    }
  }, [record]); // eslint-disable-line

  const persistOrder = (nextOrder, nextParts, extraPatch = {}, label = "sections") => {
    setOrder(nextOrder);
    setSecParts(nextParts);
    saveField({ section_order: encodeOrder(nextOrder, nextParts), ...extraPatch }, label);
  };
  const addSection = (key) => {
    if (order.includes(key)) { removeSection(key); return; }
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const nextParts = { ...secParts, [key]: defaultPartKeys(entry) };
    persistOrder([...order, key], nextParts);
  };
  const removeSection = (key) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const nextOrder = order.filter((k) => k !== key);
    const nextParts = { ...secParts };
    delete nextParts[key];
    const patch = {};
    entry.parts.forEach((p) => Object.assign(patch, partClearPatch(p)));
    setBodies((cur) => {
      const n = { ...cur };
      entry.parts.forEach((p) => (p.fields || []).forEach((a) => { if (p.kind === "html") n[a] = ""; }));
      return n;
    });
    revRef.current += 1;
    persistOrder(nextOrder, nextParts, patch, "section removed");
  };
  const moveSection = (key, dir) => {
    const i = order.indexOf(key);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= order.length) return;
    const next = order.slice();
    const tmp = next[i]; next[i] = next[j]; next[j] = tmp;
    persistOrder(next, secParts, {}, "section order");
  };
  const addPart = (key, partKey) => ensureSectionPart(key, partKey, {}, "part added");
  const removePart = (key, partKey) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const cur = secParts[key] || defaultPartKeys(entry);
    const vis = cur.filter((pk) => pk !== partKey);
    if (!vis.length) { removeSection(key); return; }
    const part = entry.parts.find((p) => p.key === partKey);
    const patch = part ? partClearPatch(part) : {};
    if (part && part.kind === "html") {
      setBodies((curB) => {
        const n = { ...curB };
        (part.fields || []).forEach((a) => { n[a] = ""; });
        return n;
      });
      revRef.current += 1;
    }
    persistOrder(order, { ...secParts, [key]: vis }, patch, "part removed");
  };
  const togglePart = (key, partKey) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const cur = order.includes(key) ? (secParts[key] || defaultPartKeys(entry)) : [];
    if (cur.includes(partKey)) removePart(key, partKey);
    else addPart(key, partKey);
  };

  const setBody = (alias, html) => setBodies((cur) => ({ ...cur, [alias]: html }));
  const commitBody = (alias) => {
    const html = bodies[alias] || "";
    const saved = typeof f[alias] === "string" ? f[alias] : "";
    if (html === saved) return;
    saveField({ [alias]: stripHtmlText(html) ? html : "" }, alias);
  };

  // ─── Section → model routing ───────────────────────────────
  // Every section used to call the same model. They don't need the
  // same model. Craft sections carry the creative weight and are what
  // a brand judges the brief on; assembly sections mostly restate
  // facts already sitting in the workspace.
  //
  // Bev's call 2026-07-30: craft moves off Sonnet onto DeepSeek V4 Pro,
  // so there is no Anthropic model left in this block. The bench that
  // decided the workspace-creation model had V4 Pro writing better
  // hooks than Sonnet 4.5 on that prompt. It has NOT been benched on
  // brief sections, which are a different task, so watch the four
  // craft sections on first use. Promoting them back is one line.
  //
  // A full 15-section brief now costs about $0.0062, against $0.025
  // with Sonnet 5 on craft and $0.117 on the original all-Sonnet-4.5
  // setup. At 1,000 briefs that is $6 against $117.
  const CRAFT_MODEL = "deepseek/deepseek-v4-pro";   // creative lift, judged output
  const MID_MODEL = "deepseek/deepseek-v4-pro";     // persuasive, grounded in supplied context
  const LEAN_MODEL = "deepseek/deepseek-v4-flash";  // restating workspace facts cleanly
  const SECTION_MODEL = {
    hook: CRAFT_MODEL,             // the first three seconds, and 3 parts in one call
    script: CRAFT_MODEL,           // scene by scene, longest output in the brief
    talkingPoints: CRAFT_MODEL,    // has to land in the creator's voice
    visualFormat: CRAFT_MODEL,     // creative direction plus real format tags
    brand: MID_MODEL,              // persuasive, but written off the brand bio
    creatorBenefits: MID_MODEL,    // needs an angle, has the offer to work from
    guidelines: MID_MODEL,         // dos and donts, 2 parts in one call
    productionNotes: MID_MODEL,    // practical, some judgement
    offer: LEAN_MODEL,             // restates the deal terms
    audienceCustomer: LEAN_MODEL,  // restates workspace audience data
    productFeature: LEAN_MODEL,    // the product, said plainly
    props: LEAN_MODEL,             // a list, drawn from the script context
    usageRights: LEAN_MODEL,       // close to boilerplate
    submissions: LEAN_MODEL,       // process instructions
    contactCommunity: LEAN_MODEL,  // pure assembly of workspace links
  };

  // ─── Write with AI (useProxyFetch → OpenRouter) ────────────
  const aiWrite = async (key) => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry || !entry.prompt) return;
    // Don't write blind. With no product linked, no written target and
    // no channel on file, the model has nothing to be specific about,
    // so ask what this brief is for instead of inventing one.
    const hasTarget = !!linkedProductId
      || (typeof f.product_feature_description === "string" && f.product_feature_description.trim())
      || !!selectLabel(f.channel);
    if (!hasTarget) {
      setProductPickerOpen(true);
      toast.info("What is this brief promoting?", {
        description: "Pick a product, or say it's brand and organic content.",
      });
      return;
    }
    // Only write the parts currently on the page — a hidden part
    // must never receive invisible content.
    const visKeys = secParts[key] || (entry.parts || []).map((p) => p.key);
    const aliases = (entry.aiFields || []).filter((a) => {
      const part = (entry.parts || []).find((x) => (x.fields || [])[0] === a);
      return !part || visKeys.includes(part.key);
    });
    if (!aliases.length) return;
    setWriting((c) => ({ ...c, [key]: true }));
    try {
      const af = account?.fields || {};
      const brandName = af.accountName || "";
      const site = unwrap(af.accountWebsite) || "";
      const ct = selectLabel(f.creator_type) || "UGC";
      const fmtName = selectLabel(f.first_format) || selectLabel(f.format) || "the chosen format";
      const prompt = entry.prompt
        .replaceAll("[BRAND NAME or WEBSITE URL]", `${brandName}${site ? " (" + site + ")" : ""}` || "the brand")
        .replaceAll("[CREATOR TYPE]", ct)
        .replaceAll("[OFFER TYPE: commission-led or fee-led]", ct === "Affiliate" ? "commission-led" : "fee-led")
        .replaceAll("[VISUAL FORMAT]", fmtName);
      // What this brief promotes, from the catalog. The scrape is
      // trimmed: the model needs the gist of the page, not all of it,
      // and the whole capture would crowd out the brand context.
      const lp = linkedProduct?.fields || null;
      const productContext = lp
        ? [
          "Product: " + (lp.name || ""),
          selectLabel(lp.type) ? "Type: " + selectLabel(lp.type) : "",
          lp.description ? "Product description: " + stripHtmlText(lp.description) : "",
          lp.price ? "Price: " + lp.price : "",
          lp.url ? "Product page: " + lp.url : "",
          lp.scrape ? "From the product page: " + stripHtmlText(lp.scrape).slice(0, 1500) : "",
        ].filter(Boolean).join("\n")
        : "";
      const context = [
        af.accountBrandBio ? "Brand bio: " + af.accountBrandBio : "",
        af.contentStyle ? "Content style: " + af.contentStyle : "",
        af.accountAudience ? "Audience: " + stripHtmlText(af.accountAudience) : "",
        // The linked product wins over the workspace's first text field.
        // When one is linked the model gets its real description, its
        // price and an excerpt of the scraped page, which is the whole
        // point of the catalog. `product_or_feature_1` stays as the
        // fallback for briefs created before the picker existed.
        productContext || (af.productOrFeature1 ? "Product/feature: " + stripHtmlText(af.productOrFeature1) : ""),
        typeof f.product_feature_description === "string" && f.product_feature_description ? "Brief target: " + stripHtmlText(f.product_feature_description) : "",
        selectLabel(f.channel) ? "Channel: " + selectLabel(f.channel) : "",
        selectLabel(f.awareness) ? "Awareness stage: " + selectLabel(f.awareness) : "",
      ].filter(Boolean).join("\n");
      const partLabels = aliases.map((a) => {
        const p = (entry.parts || []).find((x) => (x.fields || [])[0] === a);
        return (p && p.label) || a;
      });
      const partInstruction = aliases.length > 1
        ? "\n\nReturn exactly " + aliases.length + " parts in this order — " + partLabels.join(", ") +
        " — separated by a line containing only ===PART===. Each part is clean HTML with no heading of its own."
        : "";
      const res = await proxyFetch("https://openrouter.ai/api/v1/chat/completions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: SECTION_MODEL[key] || MID_MODEL,
          messages: [
            { role: "system", content: "You write single sections of creator briefs. Return ONLY the section content as clean HTML using <p>, <ul><li>, <b>, or a <table> if the format calls for it. No preamble, no headings, no code fences. NEVER use em dashes." },
            { role: "user", content: prompt + "\n\nBrand context:\n" + (context || "(none on file)") + partInstruction + "\n\nWrite the section now." },
          ],
          temperature: 0.7,
        }),
      });
      if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
      const json = await res.json();
      const raw = (json?.choices?.[0]?.message?.content || "").trim().replace(/^```html?/i, "").replace(/```$/, "").trim();
      // House style guard. The leaner models reach for em dashes far more
      // readily than Sonnet did, and one landing in a client's brief costs
      // more than the routing saves. Swap to a comma, then tidy doubles.
      const out = raw.replace(/\s*—\s*/g, ", ").replace(/,\s*,/g, ",");
      if (!out) throw new Error("Empty response");
      const parts = aliases.length > 1
        ? out.split(/\n?\s*===PART===\s*\n?/).map((p) => p.trim()).filter(Boolean)
        : [out];
      const patch = {};
      const nextBodies = {};
      aliases.forEach((a, i) => {
        const html = parts.length === aliases.length ? parts[i] : (i === 0 ? out : "");
        nextBodies[a] = html;
        patch[a] = html;
      });
      // One credit per section write, whatever the section returns. Hook
      // writes three fields in this single call and guidelines two, and
      // both are still one OpenRouter request, so both cost one credit.
      // Only counted once the call has come back with usable content.
      if (creditsRef.current === null) creditsRef.current = Number(f.credits_used) || 0;
      creditsRef.current += 1;
      patch.credits_used = creditsRef.current;
      setBodies((cur) => ({ ...cur, ...nextBodies }));
      revRef.current += 1;
      await saveField(patch, entry.name);
      toast.success(entry.name + " written");
    } catch (e) {
      console.error("[brief-builder] AI write failed:", e);
      toast.error("Couldn't write with AI", {
        description: (e?.message || "") + " — check the OpenRouter REST API datasource in this block's Source tab.",
        duration: 9000,
      });
    } finally {
      setWriting((c) => ({ ...c, [key]: false }));
    }
  };

  // ─── Modules ──────────────────────────────────────────────
  // Blueprint pulls append live workspace content into their section;
  // generic inserts (Embed, Media, Music, Asset Links, Variant Info,
  // Channel) append a labelled block into Extra's notes.
  const [railPrompt, setRailPrompt] = useState(null); // { mod } while an insert asks for input
  const [slotPicker, setSlotPicker] = useState(null); // { mod, slots } for Product/Feature Info
  const mediaFileRef = useRef(null);
  const [mediaSaving, setMediaSaving] = useState(false);

  const scrollToSection = (key) => {
    setTimeout(() => {
      try { document.getElementById("bl-sec-" + key)?.scrollIntoView({ behavior: "smooth", block: "start" }); } catch { }
    }, 250);
  };
  // Put a section on the page (and make one of its parts visible)
  // in a single state pass + a single save, so module clicks never
  // race two writes on stale state.
  const ensureSectionPart = (key, partKey, extraPatch = {}, label = "section") => {
    const entry = SECTIONS.find((e) => e.key === key);
    if (!entry) return;
    const inOrder = order.includes(key);
    const nextOrder = inOrder ? order : [...order, key];
    const base = inOrder ? (secParts[key] || defaultPartKeys(entry)) : defaultPartKeys(entry);
    // partKey takes one part or a list of them: picking a product
    // reveals the description AND the product link in a single save.
    // A single string behaves exactly as it always did.
    const want = (Array.isArray(partKey) ? partKey : [partKey]).filter(Boolean);
    const missing = want.filter((pk) => !base.includes(pk));
    const vis = missing.length
      ? entry.parts.map((p) => p.key).filter((pk) => base.includes(pk) || missing.includes(pk))
      : base;
    const nextParts = { ...secParts, [key]: vis };
    const changed = !inOrder || vis.length !== base.length;
    if (changed || Object.keys(extraPatch).length) {
      setOrder(nextOrder);
      setSecParts(nextParts);
      const patch = { ...extraPatch };
      if (changed) patch.section_order = encodeOrder(nextOrder, nextParts);
      saveField(patch, label);
    }
    scrollToSection(key);
  };
  // Append a block of html into one field of a section part.
  const appendInto = (sectionKey, partKey, alias, html, label) => {
    const existing = stripHtmlText(bodies[alias] || (typeof f[alias] === "string" ? f[alias] : "")) ? (bodies[alias] || f[alias]) : "";
    const merged = existing ? existing + html : html;
    setBodies((cur) => ({ ...cur, [alias]: merged }));
    revRef.current += 1;
    ensureSectionPart(sectionKey, partKey, { [alias]: merged }, label);
    toast.success(label + " added");
  };
  const appendExtra = (label, inner) => appendInto("extra", "notes", "extra", `<p><b>${label}:</b> ${inner}</p>`, label);
  const linkify = (v) => /^https?:\/\//i.test(v.trim()) ? `<a href="${v.trim()}" target="_blank" rel="noreferrer">${v.trim()}</a>` : v.trim();

  const handleMediaFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setMediaSaving(true);
    try {
      const uploaded = await (upload.uploadAsync ? upload.uploadAsync(file) : upload.mutateAsync(file));
      const first = Array.isArray(uploaded) ? uploaded[0] : uploaded;
      const url = first?.url || first?.file?.url || "";
      if (!url) throw new Error("Upload returned no URL");
      appendExtra("Media", `<a href="${url}" target="_blank" rel="noreferrer">${file.name}</a>`);
    } catch (err) {
      console.error("Media upload failed:", err);
      toast.error("Couldn't upload media", { description: err?.message });
    } finally {
      setMediaSaving(false);
      if (mediaFileRef.current) mediaFileRef.current.value = "";
    }
  };

  // ─── Edit checks (the machinery behind Make sure you) ─────
  const [checksOpen, setChecksOpen] = useState(false);
  const [checksSaving, setChecksSaving] = useState(false);
  // ─── The product this brief promotes ──────────────────────
  // Pick from the workspace catalog, or paste a URL and let Firecrawl
  // read the page once. Adding here writes the product to the account,
  // so the catalog builds itself as briefs get made.

  // Picking a product does three things in one save: links the catalog
  // row, puts the product's own URL in the Product link part, and maps
  // its detail into the section body. Same contract as
  // applyFormatPicks, one setBodies plus one rev bump plus one save,
  // because the editor is an uncontrolled contentEditable that only
  // re-reads its html when rev changes. Saving alone looks broken
  // until a reload, and worse, the stale draft gets written back on
  // the next blur.
  //
  // OVERWRITE RULE: the body is never wiped. The previous product's
  // paragraph is recognised and replaced; anything a person wrote is
  // kept, below it. The new paragraph leads because the creator page
  // renders this body as one unlabelled block, so the first paragraph
  // is what reads as "the product".
  const linkProduct = async (productId, picked) => {
    setProductPickerOpen(false);
    if (!productId) { await saveField({ product_link: null }, "Product"); return; }
    const pf = picked || products.find((it) => it.id === productId)?.fields || null;
    const patch = { product_link: [{ id: productId }] };
    const parts = ["description"];
    const line = buildProductLine(pf);
    if (line) {
      const existing = bodies.product_feature_description !== undefined
        ? bodies.product_feature_description
        : (typeof f.product_feature_description === "string" ? f.product_feature_description : "");
      const merged = parasToHtml([line, ...handLines(existing, knownProductParas)]);
      patch.product_feature_description = merged;
      setBodies((cur) => ({ ...cur, product_feature_description: merged }));
      revRef.current += 1;
    }
    // products.url is the only URL the catalog holds, so it goes to
    // `product`, the section's Product link part. feature and
    // feature_url stay untouched: the catalog has no feature of its
    // own, and copying the same text twice renders the product twice.
    const url = pf && typeof pf.url === "string" ? pf.url.trim() : "";
    if (url) { patch.product = url; parts.push("productLink"); }
    ensureSectionPart("productFeature", parts, patch, "Product");
  };

  // "No product" is a real answer, not a skipped question. Recording it
  // as organic stops the AI inventing a product it was never given, and
  // that means taking back what a previous pick mapped in, by the same
  // rule: the generated paragraph goes, hand-written copy stays.
  const markBrandOnly = async () => {
    setProductPickerOpen(false);
    const patch = {
      product_link: null,
      channel: { id: CHANNEL_ORGANIC_ID, label: "Organic" },
    };
    const existing = bodies.product_feature_description !== undefined
      ? bodies.product_feature_description
      : (typeof f.product_feature_description === "string" ? f.product_feature_description : "");
    if (stripHtmlText(existing).trim()) {
      const next = parasToHtml(handLines(existing, knownProductParas));
      if (next !== existing) {
        patch.product_feature_description = next;
        setBodies((cur) => ({ ...cur, product_feature_description: next }));
        revRef.current += 1;
      }
    }
    // Only the URL this picker wrote. One typed in by hand stays.
    const lastUrl = String(linkedProduct?.fields?.url || "").trim();
    if (lastUrl && typeof f.product === "string" && f.product.trim() === lastUrl) patch.product = "";
    await saveField(patch, "Channel");
  };

  const addProductByUrl = async () => {
    const url = newProductUrl.trim();
    if (!url) return;
    if (!createProduct.enabled) { toast.error("You don't have permission to add products."); return; }
    setScraping(true);
    try {
      // rawHtml is what makes the page's own structured data visible.
      // markdown alone only ever exposed the SEO meta tags, which is how
      // a retailer's title became a product name and its delivery blurb
      // became the copy a creator reads in the brief.
      let md = "", ld = null, title = "", desc = "", img = "", reached = false;
      try {
        const res = await scrapeFetch("https://api.firecrawl.dev/v1/scrape", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url, formats: ["markdown", "rawHtml"], onlyMainContent: true }),
        });
        if (res.ok) {
          const j = await res.json();
          const d = j?.data || j || {};
          const meta = d.metadata || {};
          const gotMd = String(d.markdown || "");
          const gotTitle = String(meta.title || meta.ogTitle || "").trim();
          // A bot wall answers 200 with a near-empty page, and its title
          // and JSON-LD describe the challenge. Keep none of it.
          if (!looksBlockedPage(gotMd, gotTitle)) {
            md = gotMd;
            title = gotTitle;
            ld = jsonLdProduct(d.rawHtml);
            desc = String(meta.description || meta.ogDescription || "").trim();
            img = String(meta.ogImage || "").trim();
            reached = true;
          }
        }
      } catch (e) {
        // A failed scrape must not lose the product. It gets saved with
        // the URL and can be refreshed later.
        console.warn("Firecrawl scrape failed:", e?.message);
      }
      // name: the retailer's own Product.name, then the page title with
      // its retail furniture cut away, then the host.
      const pname = (
        (ld && ld.name) || cleanProductTitle(title, url) ||
        url.replace(/^https?:\/\//, "").split("/")[0]
      );
      // description: structured data, then the meta tag, each only when
      // it is about the PRODUCT and not the shop; then a paragraph out
      // of the page; then nothing. Nothing is a real answer, because
      // buildProductLine renders the name alone and a person writes the
      // rest, which beats handing a creator a delivery promise.
      const pdesc =
        cleanDescription(ld && ld.description) ||
        cleanDescription(desc) ||
        descriptionFromMarkdown(md);
      // price comes from offers.price or not at all. Every other number
      // on a retail page is an MRP, a promotion or an instalment, and
      // taking one of those is how a brief said 599 off a page selling
      // a 799 kit.
      const pprice = (ld && ld.price) || "";
      const pimg = (ld && ld.image) || img || "";
      const created = await createProduct.mutateAsync({
        name: pname,
        accounts: accountId ? [{ id: accountId }] : null,
        type: PRODUCT_TYPE_PRODUCT_ID,
        url,
        description: pdesc,
        image_url: pimg,
        price: pprice,
        scrape: md ? md.slice(0, 20000) : "",
        scraped_at: md ? new Date().toISOString() : null,
        status: PRODUCT_STATUS_ACTIVE_ID,
      });
      const newId = created?.id || created?.recordId || "";
      // The catalog memo has not refetched yet, so hand linkProduct the
      // row it just made rather than making it look for one.
      if (newId) await linkProduct(newId, { name: pname, description: pdesc, url, price: pprice });
      setNewProductUrl("");
      toast.success(
        reached ? "Product added and page read" : "Product added (page could not be read)",
        reached && !pdesc
          ? { description: "The page gave no usable description, so write one on the product." }
          : undefined
      );
    } catch (e) {
      console.error("Add product failed:", e);
      toast.error("Couldn't add that product", { description: e?.message || "Try again." });
    } finally {
      setScraping(false);
    }
  };

  const openChecks = () => {
    ensureSectionPart("guidelines", "makesure", {}, "Guidelines");
    setChecksOpen(true);
  };
  const saveChecks = async (patch) => {
    setChecksSaving(true);
    setBodies((cur) => ({ ...cur, dos: patch.dos, donts: patch.donts, make_sure: patch.make_sure }));
    revRef.current += 1;
    // Blocks that just received agent lines must be visible parts.
    const entry = SECTIONS.find((e) => e.key === "guidelines");
    const base = order.includes("guidelines")
      ? (secParts.guidelines || entry.parts.map((p) => p.key))
      : entry.parts.map((p) => p.key);
    const need = [];
    if (stripHtmlText(patch.dos)) need.push("dos");
    if (stripHtmlText(patch.donts)) need.push("donts");
    const vis = entry.parts.map((p) => p.key).filter((pk) => base.includes(pk) || need.includes(pk));
    const inOrder = order.includes("guidelines");
    const nextOrder = inOrder ? order : [...order, "guidelines"];
    if (!inOrder || vis.length !== base.length) {
      const nextParts = { ...secParts, guidelines: vis };
      setOrder(nextOrder);
      setSecParts(nextParts);
      patch.section_order = encodeOrder(nextOrder, nextParts);
    }
    await saveField(patch, "Review Agents");
    setChecksSaving(false);
    setChecksOpen(false);
  };

  const applyModule = (mod) => {
    const af = account?.fields || {};
    if (mod.kind === "checks") { openChecks(); return; }
    if (mod.kind === "disabled") {
      toast.info("Your workspace doesn't store concepts yet.");
      return;
    }
    if (mod.kind === "prompt") { setRailPrompt({ mod }); return; }
    if (mod.kind === "media") { mediaFileRef.current?.click(); return; }
    if (mod.kind === "jump") {
      ensureSectionPart(mod.section, mod.part, {}, mod.name);
      return;
    }
    if (mod.kind === "attach") {
      ensureSectionPart("extra", "document", {}, mod.name);
      return;
    }
    if (mod.kind === "format") {
      const picks = asArray(af.preferredFormats).map((x) => (typeof x === "object" ? x : { id: x })).filter((x) => x.id);
      if (!picks.length) { toast.info("Pick preferred formats in Settings → Workspace first."); return; }
      const capped = picks.slice(0, 3).map((p) => FORMATS.find((c) => c.id === p.id) || { id: p.id, name: p.label || "" });
      const existing = bodies.visual_format !== undefined ? bodies.visual_format : (typeof f.visual_format === "string" ? f.visual_format : "");
      const merged = parasToHtml([...handLines(existing, KNOWN_FORMAT_PARAS), ...buildFormatDirection(capped)]);
      setBodies((cur) => ({ ...cur, visual_format: merged }));
      revRef.current += 1;
      ensureSectionPart("visualFormat", "direction", {
        format: capped.map((p) => ({ id: p.id })),
        first_format: [{ id: capped[0].id }],
        visual_format: merged,
      }, "Format");
      toast.success("Preferred formats applied");
      return;
    }
    if (mod.kind === "slots") {
      const slots = [
        { n: 1, text: af.productOrFeature1 },
        { n: 2, text: af.productOrFeature2 },
        { n: 3, text: af.productOrFeature3 },
      ].filter((s) => typeof s.text === "string" && s.text.trim());
      if (!slots.length) { toast.info("No product or feature pages saved on the workspace yet."); return; }
      if (slots.length === 1) { insertSlot(slots[0]); return; }
      setSlotPicker({ mod, slots });
      return;
    }
    // Blueprint pulls
    let html = "";
    let sectionKey = "";
    let alias = "";
    let partKey = "body";
    if (mod.key === "brand") {
      html = af.accountBrandBio ? `<p>${af.accountBrandBio}</p>` : "";
      sectionKey = "brand"; alias = "brand";
    }
    if (mod.key === "targetAudience") {
      html = af.accountAudience ? `<p>${stripHtmlText(af.accountAudience).replace(/\n/g, "<br/>")}</p>` : "";
      sectionKey = "audienceCustomer"; alias = "audienceCustomer";
    }
    if (mod.key === "contentStyle") {
      html = af.contentStyle ? `<p><b>Content style:</b> ${af.contentStyle}</p>` : "";
      sectionKey = "extra"; alias = "extra"; partKey = "notes";
    }
    if (mod.key === "contact") {
      const socials = parseJsonList(af.socialHandles).map((x) => `${x.platform}: ${x.handle}`).join(" · ");
      const site = unwrap(af.accountWebsite);
      html = (site || socials) ? `<p><b>Get in touch.</b> ${[site, socials].filter(Boolean).join(" · ")}</p>` : "";
      sectionKey = "contactCommunity"; alias = "contactCommunity";
    }
    if (mod.key === "community") {
      const links = parseJsonList(af.communityLinks).map((x) => `<li><b>${x.label}:</b> ${x.url}</li>`).join("");
      html = links ? `<p><b>Join the community.</b></p><ul>${links}</ul>` : "";
      sectionKey = "contactCommunity"; alias = "contactCommunity";
    }
    if (!html) { toast.info("Nothing saved on the workspace for that yet — fill it in Settings → Workspace."); return; }
    appendInto(sectionKey, partKey, alias, html, mod.name);
  };
  const insertSlot = (slot) => {
    setSlotPicker(null);
    const html = `<p>${stripHtmlText(slot.text).replace(/\n/g, "<br/>")}</p>`;
    appendInto("productFeature", "description", "product_feature_description", html, "Product/Feature");
  };
  const submitRailPrompt = (value) => {
    const mod = railPrompt?.mod;
    setRailPrompt(null);
    if (!mod || !value || !value.trim()) return;
    appendExtra(mod.label, linkify(value));
  };

  const orderedSections = order.map((k) => SECTIONS.find((e) => e.key === k)).filter(Boolean);
  const [railOpen, setRailOpen] = useState({ details: false, sections: false, modules: false }); // all closed by default (Bev, 2026-08-26)

  // ─── Extra: brief document (URL or PDF upload) ────────────
  const pdfFileRef = useRef(null);
  const [pdfSaving, setPdfSaving] = useState(false);
  const handlePdfFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setPdfSaving(true);
    try {
      const uploaded = await (upload.uploadAsync ? upload.uploadAsync(file) : upload.mutateAsync(file));
      const arr = Array.isArray(uploaded) ? uploaded : [uploaded];
      const url = arr[0]?.url || arr[0]?.file?.url || "";
      await saveField({ attachment: url ? [{ filename: file.name, url }] : arr }, "PDF");
      toast.success("PDF uploaded");
    } catch (err) {
      console.error("PDF upload failed:", err);
      toast.error("Couldn't upload PDF", { description: err?.message });
    } finally {
      setPdfSaving(false);
      if (pdfFileRef.current) pdfFileRef.current.value = "";
    }
  };

  // ─── SELECT / date / text field commits ───────────────────
  const commitSelect = async (fieldAlias, value) => {
    if (value == null) {
      await saveField({ [fieldAlias]: null }, FIELD_LABELS[fieldAlias] || fieldAlias);
    } else {
      await saveField({ [fieldAlias]: { id: value.id, label: value.label } }, FIELD_LABELS[fieldAlias] || fieldAlias);
    }
  };
  const commitMultiSelect = async (fieldAlias, options) => {
    await saveField({ [fieldAlias]: options.map((o) => ({ id: o.id, label: o.label })) }, FIELD_LABELS[fieldAlias] || fieldAlias);
  };
  const commitDate = async (fieldAlias, isoString) => {
    await saveField({ [fieldAlias]: isoString }, FIELD_LABELS[fieldAlias] || fieldAlias);
  };
  const commitText = async (fieldAlias, text) => {
    await saveField({ [fieldAlias]: text }, fieldAlias);
  };

  // Picking formats writes the creator direction, Guidelines-style:
  // generated paragraphs refresh with the picks, hand-written ones stay.
  const applyFormatPicks = (picks) => {
    const existing = bodies.visual_format !== undefined ? bodies.visual_format : (typeof f.visual_format === "string" ? f.visual_format : "");
    const merged = parasToHtml([...handLines(existing, KNOWN_FORMAT_PARAS), ...buildFormatDirection(picks)]);
    setBodies((cur) => ({ ...cur, visual_format: merged }));
    revRef.current += 1;
    saveField({
      format: picks.map((x) => ({ id: x.id })),
      first_format: picks[0] ? [{ id: picks[0].id }] : [],
      visual_format: merged,
    }, "format");
  };

  // Everything a section body needs, bundled once.
  const ctx = {
    f, bodies, rev: revRef.current, briefId, openChecks, applyFormatPicks,
    product: {
      linked: linkedProduct,
      catalog: products,
      open: productPickerOpen,
      setOpen: setProductPickerOpen,
      onPick: linkProduct,
      onBrandOnly: markBrandOnly,
      newUrl: newProductUrl,
      setNewUrl: setNewProductUrl,
      onAddUrl: addProductByUrl,
      scraping,
    },
    onBody: setBody, onCommitBody: commitBody,
    commitSelect, commitMultiSelect, commitDate, commitText, saveField,
    pdf: {
      url: f.brief_document_url,
      attachment: f.attachment,
      uploading: pdfSaving,
      onSaveUrl: (url) => commitText("brief_document_url", url),
      onClickUpload: () => pdfFileRef.current?.click(),
      onClear: async () => {
        await saveField({ attachment: [], brief_document_url: "" }, "brief document");
      },
    },
  };

  // ─── Render ───────────────────────────────────────────────
  return (
    <>
      <Style />

      <div className="bl-bd w-full">

        {/* Back to the briefs list, above the tabs. A real link, so a
            middle click opens the list in a new tab. */}
        <a className="bl-bd-back" href="/briefs" target="_top">
          <ChevronLeft size={15} strokeWidth={2} />
          Back to briefs
        </a>

        {/* Banner shown while the brief has no project linked. */}
        {isUnassigned && (
          <div className="bl-bd-assign-banner" role="status">
            <div className="bl-bd-assign-banner-icon" aria-hidden="true">
              <Inbox size={18} strokeWidth={1.75} />
            </div>
            <div className="bl-bd-assign-banner-text">
              <strong>This brief needs a project.</strong>
              <span>Assign it to one of your projects to start editing.</span>
            </div>
            <button
              type="button"
              className="bl-bd-assign-banner-btn"
              onClick={openAssignBrief}
            >
              Assign to a project
            </button>
          </div>
        )}

        {/* Top bar — the page switcher + Preview · Share · Publish */}
        <div className="bl-bd-topbar">
          <div className="bl-bd-switch">
            <button type="button" className={`bl-bd-switch-btn ${view === "brief" ? "is-active" : ""}`} onClick={() => setView("brief")}>
              Brief
            </button>
            <button type="button" className={`bl-bd-switch-btn ${view === "submissions" ? "is-active" : ""}`} onClick={() => setView("submissions")}>
              Submissions{briefSubs.length ? ` · ${briefSubs.length}` : ""}
            </button>
            <button type="button" className={`bl-bd-switch-btn ${view === "invites" ? "is-active" : ""}`} onClick={() => setView("invites")}>
              Invites{briefMembers.length ? ` · ${briefMembers.length}` : ""}
            </button>
          </div>
          <div className="bl-bd-topbar-actions">
            {nameSaving && <span className="bl-bd-saving">Saving…</span>}
            <button
              type="button"
              onClick={() => openBriefComments(briefId)}
              className="bl-bd-preview-btn"
              disabled={!briefId}
              title="Comments on this brief"
            >
              <MessageSquare size={14} />
              Comments
            </button>
            <button
              type="button"
              onClick={() => openCreatorPreview(briefId)}
              className="bl-bd-preview-btn"
              disabled={!briefId}
              title="See the creator's view of this brief"
            >
              <Eye size={14} />
              Preview
            </button>
            <SharePopover
              briefId={briefId}
              creatorUrl={creatorUrl}
              teamUrl={teamUrl}
              isPrivate={isPrivate}
              privacySaving={privacySaving}
              onTogglePrivacy={togglePrivacy}
              onAddPeople={() => setInviteOpen(true)}
              open={shareOpen}
              setOpen={setShareOpen}
            />
            <Button
              onClick={publish}
              disabled={publishSaving || briefStatus?.label === "Active"}
              style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
              className="bl-bd-publish-btn"
            >
              {publishSaving ? "Publishing…" : briefStatus?.label === "Active" ? "Published" : "Publish"}
            </Button>
          </div>
        </div>

        {view === "submissions" && (
          <SubmissionsView
            rows={briefSubs}
            onOpen={(id) => { (window.parent || window).open("/submissions/details?recordId=" + encodeURIComponent(id), "_self"); }}
            onInvite={(id) => setReviewShareFor(id)}
          />
        )}
        {view === "invites" && (
          <InvitesView
            rows={briefMembers}
            published={briefStatus?.label === "Active"}
            canInvite={createMember.enabled && updateMember.enabled}
            onAdd={() => setInviteOpen(true)}
            onSendRow={handleSendRowInvite}
            onSendRows={handleSendRows}
            sendingRowId={sendingRowId}
          />
        )}
        {inviteOpen && (
          <AddPeopleModal
            briefName={briefName}
            published={briefStatus?.label === "Active"}
            busy={inviteBusy}
            canInvite={createMember.enabled && updateMember.enabled}
            candidates={inviteCandidates}
            onInvite={handleBriefInvite}
            onClose={() => setInviteOpen(false)}
          />
        )}
        {reviewShareFor && (
          <ReviewShareModal
            sub={recordsOf(subsRaw).find((r) => r.id === reviewShareFor) || null}
            busy={inviteBusy}
            canInvite={createMember.enabled && updateMember.enabled}
            onShare={handleReviewShare}
            onClose={() => setReviewShareFor(null)}
          />
        )}

        {checksOpen && (
          <ChecksPanel f={f} saving={checksSaving} onSave={saveChecks} onClose={() => setChecksOpen(false)} />
        )}

        <div className="bl-bd-layout" style={view === "brief" ? undefined : { display: "none" }}>
          <div className="bl-bd-main">
            <div className="bl-bd-paper">
              <div className="bl-bd-title-row">
                {editingName ? (
                  <input
                    value={nameDraft}
                    autoFocus
                    disabled={nameSaving}
                    onChange={(e) => setNameDraft(e.target.value)}
                    onKeyDown={(e) => {
                      if (e.key === "Enter") commitName();
                      if (e.key === "Escape") { setNameDraft(briefName); setEditingName(false); }
                    }}
                    onBlur={commitName}
                    className="bl-bd-title-input"
                  />
                ) : (
                  <button
                    type="button"
                    className="bl-bd-title"
                    onClick={() => setEditingName(true)}
                    title="Click to rename"
                  >
                    {briefName}
                    <Pencil size={15} className="bl-bd-title-pencil" />
                  </button>
                )}
              </div>

              {record && orderedSections.length === 0 && (
                <p className="bl-bd-empty-hint">
                  This brief has no sections yet. Add them one by one from Sections in the rail, or drop in live workspace content from Modules.
                </p>
              )}

              {orderedSections.map((entry, i) => (
                <PaperSection
                  key={entry.key}
                  entry={entry}
                  index={i}
                  total={orderedSections.length}
                  visible={secParts[entry.key] || defaultPartKeys(entry)}
                  collapsed={!!collapsed["s_" + entry.key]}
                  onToggle={() => toggle("s_" + entry.key)}
                  writing={!!writing[entry.key]}
                  onAi={() => aiWrite(entry.key)}
                  onMove={(dir) => moveSection(entry.key, dir)}
                  onRemove={() => removeSection(entry.key)}
                  onAddPart={(pk) => addPart(entry.key, pk)}
                  onRemovePart={(pk) => removePart(entry.key, pk)}
                  ctx={ctx}
                />
              ))}
            </div>
          </div>

          <Rail
            open={railOpen}
            setOpen={setRailOpen}
            order={order}
            secParts={secParts}
            onToggleSection={addSection}
            onTogglePart={togglePart}
            onModule={applyModule}
            accountName={account?.fields?.accountName || ""}
            accountLoaded={!!account}
            railPrompt={railPrompt}
            onSubmitPrompt={submitRailPrompt}
            onCancelPrompt={() => setRailPrompt(null)}
            slotPicker={slotPicker}
            onPickSlot={insertSlot}
            onCancelSlots={() => setSlotPicker(null)}
            mediaSaving={mediaSaving}
            details={{
              briefStatus, statusSaving, commitStatus,
              reviewModeLabel, reviewModeSaving, commitReviewMode,
              isPrivate, privacySaving, togglePrivacy,
              thumbUrl, thumbSaving, onPickThumb: () => thumbFileRef.current?.click(),
              generatedLabel,
              creatorNames: unwrap(f.creator_name) || "",
              onAddCreator: () => setInviteOpen(true),
              creatorTypeId: f.creator_type?.id || "",
              onCreatorType: (opt) => commitSelect("creator_type", opt),
            }}
          />
        </div>

        {/* Hidden file inputs (thumbnail · PDF · media) */}
        <input ref={thumbFileRef} type="file" accept="image/*" onChange={handleThumbnailFile} style={{ display: "none" }} />
        <input ref={pdfFileRef} type="file" accept="application/pdf" onChange={handlePdfFile} style={{ display: "none" }} />
        <input ref={mediaFileRef} type="file" accept="image/*,video/*" onChange={handleMediaFile} style={{ display: "none" }} />
      </div>
    </>
  );
}

// =====================================================================
// PAPER SECTION — one Bible section on the page. Chevron + navy title
// + short line, actions on the right (Write with AI · add part ·
// move · remove), and the section's visible parts as the body.
// =====================================================================
function PaperSection({ entry, index, total, visible, collapsed, onToggle, writing,
  onAi, onMove, onRemove, onAddPart, onRemovePart, ctx }) {
  const multi = (entry.parts || []).length > 1;
  const hidden = (entry.parts || []).filter((p) => !visible.includes(p.key));
  const canAi = !!entry.prompt && (entry.aiFields || []).length > 0;
  return (
    <section id={"bl-sec-" + entry.key} className={`bl-bd-psec ${collapsed ? "is-collapsed" : ""}`}>
      <header className="bl-bd-psec-head">
        <button
          type="button"
          className="bl-bd-psec-toggle"
          onClick={onToggle}
          aria-expanded={!collapsed}
        >
          {collapsed ? <ChevronRight size={17} /> : <ChevronDown size={17} />}
          <div className="bl-bd-psec-titles">
            <h2 className="bl-bd-psec-title">{entry.name}</h2>
            <p className="bl-bd-psec-sub">{entry.short}</p>
          </div>
        </button>
        <div className="bl-bd-psec-tip"><TooltipIcon text={entry.what} /></div>
        <div className="bl-bd-header-actions">
          {writing && <span className="bl-bd-saving">Writing…</span>}
          {entry.key === "guidelines" && (
            <button type="button" className="bl-bd-preview-btn" onClick={ctx.openChecks} title="Pick the review agents and thresholds; each becomes a Do or Don't line">
              <Pencil size={13} />
              Edit checks
            </button>
          )}
          {canAi && (
            <button type="button" className="bl-bd-preview-btn" onClick={onAi} disabled={writing} title="Write this section with AI">
              <Wand2 size={14} />
              Write with AI
            </button>
          )}
          <AddPartMenu hidden={hidden} onAdd={onAddPart} />
          <button type="button" className="bl-bd-move-btn" onClick={() => onMove(-1)} disabled={index === 0} title="Move up">
            <ChevronUp size={14} />
          </button>
          <button type="button" className="bl-bd-move-btn" onClick={() => onMove(1)} disabled={index === total - 1} title="Move down">
            <ChevronDown size={14} />
          </button>
          <button type="button" className="bl-bd-move-btn bl-bd-remove-btn" onClick={onRemove} title="Remove section">
            <Trash2 size={14} />
          </button>
        </div>
      </header>
      {!collapsed && (
        <div className="bl-bd-psec-body">
          {entry.key === "guidelines" && <GuidelineBars f={ctx.f} onOpen={ctx.openChecks} />}
          {entry.key === "offer" && (
            <OfferNote html={ctx.f.offer_notes} onDismiss={() => ctx.saveField({ offer_notes: "" }, "offer note")} />
          )}
          {entry.key === "productFeature" && <ProductPicker p={ctx.product} />}
          {(entry.parts || []).filter((p) => visible.includes(p.key)).map((p) => (
            <SectionPart
              key={p.key}
              entry={entry}
              part={p}
              removable={multi}
              onRemovePart={() => onRemovePart(p.key)}
              ctx={ctx}
            />
          ))}
        </div>
      )}
    </section>
  );
}

// Lee's note on the offer, written by the create chat's Offer Builder:
// why this offer suits the goal and the approach, and which figures are
// estimates. Brand-only: the live brief never reads offer_notes, and
// Dismiss clears it.
function OfferNote({ html, onDismiss }) {
  const [busy, setBusy] = useState(false);
  if (typeof html !== "string" || !html.replace(/<[^>]*>/g, "").trim()) return null;
  return (
    <div className="bl-bd-offer-note" role="note">
      <div className="bl-bd-offer-note-head">
        <span>Lee's note · only you see this</span>
        <button
          type="button"
          disabled={busy}
          onClick={async () => { setBusy(true); await onDismiss(); setBusy(false); }}
        >
          Dismiss
        </button>
      </div>
      <div className="bl-bd-offer-note-body" dangerouslySetInnerHTML={{ __html: html }} />
    </div>
  );
}

// The "+" menu in a section header — lists the parts not yet shown.
function AddPartMenu({ hidden, onAdd }) {
