// Review share — same family modal, opened from a submission card.
function ReviewShareModal({ sub, busy, canInvite, onShare, onClose }) {
  const [draft, setDraft] = useState({ name: "", email: "", message: "", accessId: "e6d835d4-7486-4c86-862d-dacea2908f2c" });
  const creator = unwrap(sub?.fields?.sub_creator) || "";
  const video = unwrap(sub?.fields?.sub_name) || "this video";
  const submit = async () => {
    const access = ACCESS_OPTIONS.find((o) => o.id === draft.accessId) || null;
    await onShare({ ...draft, access });
  };
  return (
    <>
      <div onClick={onClose} style={{ position: "fixed", inset: 0, background: "rgba(10,12,24,0.45)", zIndex: 9998 }} />
      <div style={{ position: "fixed", top: "50%", left: "50%", transform: "translate(-50%, -50%)", width: 480, maxWidth: "92vw", background: "#FAFBFF", borderRadius: 16, boxShadow: "0 24px 60px rgba(0,15,77,0.18)", zIndex: 9999, padding: "24px 26px", fontFamily: INV_FONT }}>
        <button type="button" onClick={onClose} aria-label="Close"
          style={{ position: "absolute", top: 14, right: 16, background: "transparent", border: "none", cursor: "pointer", color: MUTED, padding: 4 }}>
          <X size={16} />
        </button>
        <p style={{ margin: "0 0 2px", fontFamily: INV_FONT, fontSize: 17, fontWeight: 600, color: NAVY_DEEP }}>Share this review</p>
        <p style={{ margin: "0 0 16px", fontFamily: INV_FONT, fontSize: 12.5, color: MUTED }}>
          {(creator ? creator + "'s " : "") + video + " and its review, by link. No account needed."}
        </p>
        {canInvite ? (
          <>
            <InviteFields draft={draft} setDraft={setDraft} disabled={busy} messageLabel="Message" messagePlaceholder="A line or two for their email" />
            <div style={{ display: "flex", justifyContent: "flex-end" }}>
              <button type="button" style={{ ...invButtonStyle, opacity: busy ? 0.6 : 1 }} disabled={busy} onClick={submit}>
                {busy ? "Working…" : "Share review"}
              </button>
            </div>
          </>
        ) : (
          <p style={{ margin: 0, fontFamily: INV_FONT, fontSize: 13, color: MUTED }}>You don't have permission to share reviews.</p>
        )}
      </div>
    </>
  );
}

