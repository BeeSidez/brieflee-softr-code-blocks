function GuidelineBars({ f, onOpen }) {
  const bars = [];
  const active = (alias) => {
    const l = f[alias] && f[alias].label;
    return l && !/^none\b/i.test(l) ? l : "";
  };
  const push = (label, value) => bars.push({ label, value });
  let v;
  if ((v = active("hook_speed_threshold"))) push("Hook", "first " + v.toLowerCase());
  if ((v = active("visual_hook_threshold"))) push("Visual hook", v);
  if ((v = active("product_screen_time_threshold"))) push("Product on screen", v);
  if ((v = active("face_time_threshold"))) push("Creator on camera", v);
  if ((v = active("engagement_pacing_threshold"))) push("New scene", v.toLowerCase());
  if ((v = active("cta_placement_threshold"))) push("CTA", v.toLowerCase().replace(" (no cta required)", ""));
  if ((v = active("brand_mention_count_threshold")) && v !== "0") push("Brand mentions", v);
  if ((v = active("text_legibility_threshold"))) push("Text legibility", v);
  if ((v = active("audio_clarity_threshold"))) push("Audio clarity", v);
  if (f.duration && f.duration.label) push("Length", (f.duration_threshold?.label === "min" ? "at least " : "under ") + f.duration.label);
  const sentenceAgents = asArrayLabels(f.qa_checklist).filter((label) => {
    if (label === "Video length" && f.duration && f.duration.label) return false;
    const thAlias = Object.keys(THRESHOLD_PAIR).find((k) => THRESHOLD_PAIR[k] === label);
    return !(thAlias && active(thAlias));
  });
  if (!bars.length && !sentenceAgents.length) return null;
  return (
    <div className="bl-bd-checkchips">
      {bars.map((b, i) => (
        <button key={"b" + i} type="button" className="bl-bd-chip is-active" onClick={onOpen} title="Edit checks">
          {b.label} · {b.value}
        </button>
      ))}
      {sentenceAgents.map((label, i) => (
        <button key={"a" + i} type="button" className="bl-bd-chip" onClick={onOpen} title="Edit checks">
          {label}
        </button>
      ))}
    </div>
  );
}

// =====================================================================
// EDIT CHECKS — the machinery behind Make sure you. Tick agents, set
// their bars, watch the exact sentence the creator will read. Saving
// rewrites the Make sure you block.
// =====================================================================
function ChecksPanel({ f, saving, onSave, onClose }) {
  const [ids, setIds] = useState(() => {
    const s = new Set(asArrayIds(f.qa_checklist));
    // Agents whose bar is already set count as ticked.
    Object.keys(THRESHOLD_PAIR).forEach((alias) => {
      const label = f[alias]?.label || "";
      if (label && !/^none\b/i.test(label)) {
        const agent = QA_AGENT_OPTIONS.find((a) => a.label === THRESHOLD_PAIR[alias]);
        if (agent) s.add(agent.id);
      }
    });
    return s;
  });
  const [th, setTh] = useState(() => {
    const o = {};
    THRESHOLD_FIELDS.forEach(({ alias }) => {
      if (f[alias]?.id) o[alias] = { id: f[alias].id, label: f[alias].label };
    });
    return o;
  });
  const aliasFor = (label) => Object.keys(THRESHOLD_PAIR).find((k) => THRESHOLD_PAIR[k] === label);
  const save = () => {
    const agentIds = [...ids];
    const gen = buildGuidelineBlocks(agentIds, th, f.duration, f.duration_threshold);
    const patch = {
      qa_checklist: QA_AGENT_OPTIONS.filter((a) => ids.has(a.id)).map((a) => ({ id: a.id, label: a.label })),
      // Hand-written lines survive; anything left in the old Make sure
      // you block folds into Do and the field empties out.
      dos: linesToHtml([...handLines(f.dos), ...handLines(f.make_sure), ...gen.do]),
      donts: linesToHtml([...handLines(f.donts), ...gen.dont]),
      make_sure: "",
    };
    THRESHOLD_FIELDS.forEach(({ alias }) => {
      patch[alias] = th[alias] ? { id: th[alias].id, label: th[alias].label } : null;
    });
    onSave(patch);
  };
  return (
    <>
      <div className="bl-bd-checks-backdrop" onClick={onClose} />
      <div className="bl-bd-checks" role="dialog" aria-label="Review Agents">
        <div className="bl-bd-checks-hero">
          <img src={AGENTS_ICON_URL} alt="" draggable={false} />
          <div className="bl-bd-checks-hero-text">
            <h3>Review Agents</h3>
            <p>
              AI agents watch every video submitted against this brief. Pick what
              they check and set the bar they hold it to. Each agent writes itself
              onto the paper as a plain Do or Don't line; the agents do the
              enforcing.
            </p>
          </div>
