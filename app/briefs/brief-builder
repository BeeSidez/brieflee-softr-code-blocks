// Label row above a removable part.
function PartHead({ label, icon, removable, onRemove, action }) {
  if (!label && !removable && !action) return null;
  return (
    <div className="bl-bd-part-head">
      {icon && <img className="bl-bd-part-ico" src={icon} alt="" draggable={false} />}
