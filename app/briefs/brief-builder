// A section in the rail: short line + tooltip with the full Bible
// explanation. Added multi-field sections expand into their parts so
// briefs can be composed from the nav too.
function RailSectionRow({ entry, added, visible, onToggle, onTogglePart }) {
  return (
    <div className={`bl-bd-rail-sec ${added ? "is-added" : ""}`}>
      <RailRow
        name={entry.name}
        sub={entry.short}
        tip={entry.what}
        icon={SECTION_ICONS[entry.rawName]}
        added={added}
        onClick={onToggle}
      />
      {added && (entry.parts || []).length > 1 && (
        <div className="bl-bd-rail-parts">
          {entry.parts.map((p) => {
            const on = visible.includes(p.key);
            return (
              <button key={p.key} type="button" className={`bl-bd-rail-part ${on ? "is-on" : ""}`} onClick={() => onTogglePart(p.key)}>
                <span className="bl-bd-rail-part-mark">{on ? <Check size={11} /> : <Plus size={11} />}</span>
                {p.label || p.key}
              </button>
            );
          })}
        </div>
      )}
    </div>
  );
}

function RailRow({ name, sub, tip, icon, added, disabled, onClick }) {
  return (
    <button type="button" className={`bl-bd-rail-row ${added ? "is-added" : ""} ${disabled ? "is-disabled" : ""}`} onClick={onClick}>
      <span className="bl-bd-rail-row-icon">
        {icon || SECTION_ICONS[name]
          ? <img src={icon || SECTION_ICONS[name]} alt="" />
          : <Layers size={14} />}
      </span>
      <span className="bl-bd-rail-row-text">
        <span className="bl-bd-rail-row-name">{name}{tip ? <TooltipIcon text={tip} /> : null}</span>
        {sub && <span className="bl-bd-rail-row-sub">{sub}</span>}
      </span>
      <span className="bl-bd-rail-row-mark">{added ? <Check size={13} /> : <Plus size={13} />}</span>
    </button>
  );
}

// Inline input popover for the generic inserts (Embed, Music, Asset
// Links, Variant Info, Channel) — submits into Extra's notes.
function RailPrompt({ label, placeholder, onSubmit, onCancel }) {
  const [val, setVal] = useState("");
  return (
    <div className="bl-bd-rail-prompt">
      <input
        autoFocus
        value={val}
        placeholder={placeholder}
        onChange={(e) => setVal(e.target.value)}
        onKeyDown={(e) => {
          if (e.key === "Enter") onSubmit(val);
          if (e.key === "Escape") onCancel();
        }}
      />
      <div className="bl-bd-rail-prompt-actions">
        <button type="button" className="bl-bd-rail-prompt-add" onClick={() => onSubmit(val)}>Add {label}</button>
        <button type="button" className="bl-bd-rail-prompt-cancel" onClick={onCancel}>Cancel</button>
      </div>
    </div>
  );
}

