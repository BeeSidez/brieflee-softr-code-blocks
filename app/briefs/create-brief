// useState initialiser stops Softr's analyzer registering the create
// actions on this block.
function hostnameOf(url) {
  const m = String(url || "").replace(/^https?:\/\//i, "").split(/[/?#]/)[0];
  return m.replace(/^www\./, "") || String(url || "");
}
