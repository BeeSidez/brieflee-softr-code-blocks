      if (urlProjectId) {
        askPdfAttach();
      } else {
        say(<span>Which project should it live in?</span>);
        setStep("project");
      }
    } catch (e) {
      console.error("PDF upload failed:", e);
      setBusy(false);
      histRef.current.pop();
      toast.error("Couldn't upload that PDF", { description: (e && e.message) || "Try again." });
      say(<span>The upload didn't go through. Try again, or start from scratch.</span>);
      setStep("pdfUpload");
    }
  };

  const askPdfAttach = () => {
