        .cbc .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes blSpin { to { transform: rotate(360deg); } }
        @keyframes blFade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes blFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
        .cbc input, .cbc textarea { outline: none; }
        @media (max-width: 640px) { .cbc.cbc-home { padding-top: clamp(26px, 6vh, 56px) !important; } }
      `}</style>

      {isInactive ? (
        <UpgradeCard />
      ) : scene ? (
