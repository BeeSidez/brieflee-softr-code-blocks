export default function Block() {
  const user = useCurrentUser({
    properties: {
      status: "kClk9",          // users.status: Active / Inactive / Pending
      workspaceStatus: "DdZZr", // status (accounts) lookup: active, trial, inactive, suspended, cancelled
    },
  });
  const isInactive = isInactiveUser(user && user.properties);

  // Top space above the chat, editable from Content > Settings. With
  // centring on, it scales with the viewport so the chat opens mid-screen;
  // switch it off to use the pixel value typed below. Phones get a small
  // fixed space (.cbc-home in the style tag). When the page is open as the
  // New brief side panel (parent URL carries ?modal=, or the frame sits in
  // a dialog) the settings are skipped and the top stays at 26px.
  const [inPanel] = useState(() => {
    if (typeof window === "undefined") return false;
    try {
      if (window.parent === window) return false;
      if (/[?&]modal=/.test(window.parent.location.search)) return true;
      const fe = window.frameElement;
      return !!(fe && fe.closest && fe.closest('[role="dialog"]'));
    } catch (e) {
      return false;
    }
  });
  const heroAutoCentre = useBooleanSetting({
    name: "heroAutoCentre",
    label: "Centre the chat on screen",
    initialValue: true,
  });
  const heroTopSpace = useTextSetting({
    name: "heroTopSpace",
    label: "Top space in px (used when centring is off)",
    initialValue: "200",
  });
  const typedTop = parseInt(String(heroTopSpace ?? "").replace(/[^0-9]/g, ""), 10);
  const heroTop = inPanel
    ? "26px"
    : heroAutoCentre
      ? "clamp(26px, calc(50vh - 285px), 280px)"
      : `${Number.isFinite(typedTop) ? Math.min(typedTop, 600) : 200}px`;

  // URL params are read ONCE in inline useState initialisers. URL
  // parsing in the render body, a useMemo or a named helper stops
  // Softr's analyzer registering the create actions.
  const [urlWorkspaceId] = useState(() => {
    if (typeof window === "undefined") return "";
    try {
      return new URL(window.location.href).searchParams.get("workspace") || "";
    } catch (e) {
      return "";
    }
  });
  const [urlProjectId] = useState(() => {
    if (typeof window === "undefined") return "";
    try {
      return new URL(window.location.href).searchParams.get("recordId") || "";
    } catch (e) {
      return "";
    }
  });

  // The user's workspaces, scoped IN THE QUERY, not after it.
  // Filtering client-side would pull other brands' rows into this
  // browser first.
  const accountsQ = useRecords({
    select: accountSelect,
    from: ds.accounts,
    count: 20,
    enabled: !!(user && user.id),
    where: q.array("users").is((user && user.id) || ""),
  });
  const accounts = useMemo(() => {
    const items = accountsQ.data ? accountsQ.data.pages.flatMap((p) => (p && p.items) || []) : [];
    if (!user || !user.id) return items;
    return items.filter((it) => linkIds(it.fields && it.fields.users).includes(user.id));
  }, [accountsQ.data, user]);

  // Conversation state
  const [creatorIds, setCreatorIds] = useState([]);
  const [step, setStep] = useState("boot"); // boot | workspace | source | pdfUpload | pdfAttach | project | product | productUrl | basics | goal | offer | creators | mode | dead-end
  const [msgs, setMsgs] = useState([]);
  const [busy, setBusy] = useState(false);
  const [workspaceId, setWorkspaceId] = useState("");
  const [projectId, setProjectId] = useState("");
  const [product, setProduct] = useState(null); // { id, name, url, description, price, scrape } | null
  const [briefName, setBriefName] = useState("");
  const [creatorType, setCreatorType] = useState(CREATOR_TYPES[0]);
  const [channel, setChannel] = useState(CHANNELS[0]);
  const [goalInput, setGoalInput] = useState("");
  const [goals, setGoals] = useState([]);            // GOALS keys, any mix
  const [offer, setOffer] = useState(EMPTY_OFFER);   // the Offer Builder's answers
  const [more, setMore] = useState({});              // which optional groups are open
  const [urlInput, setUrlInput] = useState("");
  const [pdf, setPdf] = useState(null); // { filename, url, sections | null, attach }
  const [scene, setScene] = useState(""); // "" | "ai" | "quick" — the centered writing scene
  const [genIdx, setGenIdx] = useState(0);
  const [overtime, setOvertime] = useState(false);
  const endRef = useRef(null);
  const fileRef = useRef(null);
  const bootedRef = useRef(false);
  // Back navigation: every forward transition snapshots the state it
  // leaves behind; Back pops one snapshot, trims the thread to that
  // point, and restores the picks made since.
  const histRef = useRef([]);

  const say = (node) => setMsgs((m) => [...m, { who: "lee", node }]);
  const mine = (text) => setMsgs((m) => [...m, { who: "me", node: text }]);

  const remember = () => {
    histRef.current.push({
      step, msgsLen: msgs.length, workspaceId, projectId, product, pdf,
      briefName, creatorType, channel, goalInput, goals, offer,
    });
  };
  const goBack = () => {
    const h = histRef.current.pop();
    if (!h) return;
    setMsgs((m) => m.slice(0, h.msgsLen));
    setWorkspaceId(h.workspaceId);
    setProjectId(h.projectId);
    setProduct(h.product);
    setPdf(h.pdf);
    setBriefName(h.briefName);
    setCreatorType(h.creatorType);
    setChannel(h.channel);
    setGoalInput(h.goalInput);
    setGoals(h.goals || []);
    // Details typed since stay put, so stepping back never wipes them.
    setOffer((cur) => ({ ...h.offer, d: cur.d, limits: cur.limits, rights: cur.rights, currency: cur.currency }));
    setStep(h.step);
  };

  useEffect(() => {
    const el = endRef.current;
    if (el && el.scrollIntoView) el.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }, [msgs, busy, step]);

  // Rotate the writing scene's status line; flag overtime past 45s.
  useEffect(() => {
    if (scene !== "ai" && scene !== "offer") { setGenIdx(0); setOvertime(false); return; }
    const rot = setInterval(() => setGenIdx((i) => i + 1), 3500);
    const late = setTimeout(() => setOvertime(true), 45000);
    return () => { clearInterval(rot); clearTimeout(late); };
  }, [scene]);

  const projectsQ = useRecords({
    select: projectSelect,
    from: ds.projects,
    count: 100,
    enabled: !!workspaceId,
    where: q.array("accounts").is(workspaceId || ""),
    orderBy: q.desc("createdAt"),
  });
  const projects = useMemo(
    () => (projectsQ.data ? projectsQ.data.pages.flatMap((p) => (p && p.items) || []) : []),
    [projectsQ.data]
  );

  const membersQ = useRecords({
    select: memberSelect,
    from: ds.members,
    count: 100,
    enabled: !!workspaceId,
    where: q.array("memberAccounts").is(workspaceId || ""),
  });
  const workspaceMembers = useMemo(
    () => (membersQ.data ? membersQ.data.pages.flatMap((p) => (p && p.items) || []) : []),
    [membersQ.data]
  );

  const productsQ = useRecords({
    select: productSelect,
    from: ds.products,
    count: 100,
    enabled: !!workspaceId,
    where: q.array("accounts").is(workspaceId || ""),
  });
  const products = useMemo(() => {
    const items = productsQ.data ? productsQ.data.pages.flatMap((p) => (p && p.items) || []) : [];
    return items.filter((it) => {
      const pf = it.fields || {};
      if (selectLabel(pf.status) === "Archived") return false;
      const ids = linkIds(pf.accounts);
      return !workspaceId || !ids.length || ids.includes(workspaceId);
    });
  }, [productsQ.data, workspaceId]);

  const createRecord  = useRecordCreate({ fields: createFields, from: ds.briefs });
  const createProduct = useRecordCreate({ fields: productCreate, from: ds.products });
  const aiFetch       = useProxyFetch(ds.openrouter);
  const scrapeFetch   = useProxyFetch(ds.firecrawl);
  const upload        = useUpload();

  const account = useMemo(
    () => accounts.find((a) => a.id === workspaceId) || null,
    [accounts, workspaceId]
  );

  // ── Boot: greet once the accounts have resolved ────────────────
  useEffect(() => {
    if (bootedRef.current) return;
    if (!user) return;
    if (accountsQ.status === "pending") return;
    bootedRef.current = true;

    const first = user.firstName ? `, ${user.firstName}` : "";
    say(<span>Hey{first}. Let's set up a new brief. A few quick picks and I'll take it from there.</span>);

    if (accounts.length === 0) {
      say(
        <span>
          I can't find a workspace on your account yet. Finish setting up your workspace first, then come back
          and I'll build the brief with your brand context.
        </span>
      );
      setStep("dead-end");
      return;
    }

    const urlMatch = urlWorkspaceId ? accounts.find((a) => a.id === urlWorkspaceId) : null;
    if (urlMatch) {
      pickWorkspace(urlMatch, true);
    } else if (accounts.length === 1) {
      pickWorkspace(accounts[0], true);
    } else {
      say(<span>Which workspace is this brief for?</span>);
      setStep("workspace");
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [user, accountsQ.status, accounts.length]);

  // ── Step handlers ──────────────────────────────────────────────
  const pickWorkspace = (acc, silent) => {
    if (!silent) remember();
    setWorkspaceId(acc.id);
    const accName = String((acc.fields && acc.fields.name) || "your workspace");
    if (!silent) mine(accName);
    if (silent) say(<span>This brief goes in <b>{accName}</b>.</span>);
    askSource();
  };

  const askSource = () => {
    say(<span>Already have this brief written? Upload the PDF and I'll build the brief from it, or we can set it up from scratch.</span>);
    setStep("source");
  };

  const chooseScratch = () => {
    remember();
    mine("Start from scratch");
    if (urlProjectId) {
      // Opened from a project page: the project is already decided.
      askProduct();
    } else {
      say(<span>Which project should it live in?</span>);
      setStep("project");
    }
  };

  const choosePdf = () => {
    remember();
    mine("Upload a PDF");
    say(<span>Drop it in. I read PDFs up to 10MB.</span>);
    setStep("pdfUpload");
  };

  const pickProject = (proj) => {
    if (!proj) return;
    remember();
    setProjectId(proj.id);
    mine(String((proj.fields && proj.fields.name) || "Project"));
    if (pdf) {
      askPdfAttach();
    } else {
      askProduct();
    }
  };

  // Every brief belongs to a project. With none on the workspace there
  // is nothing to attach it to, so the chat stops here and sends the
  // user to make one rather than writing a brief with no home.
  const goCreateProject = () => {
    if (typeof window === "undefined") return;
    try {
      if (window.parent && window.parent.closeSwModal) window.parent.closeSwModal();
    } catch (e) { /* not in a modal */ }
    (window.parent || window).open("/create-project", "_self");
  };

  const askProduct = () => {
    say(<span>Is this brief for a specific product? Pick one from your catalog, paste a product link, or skip it.</span>);
    setStep("product");
  };

  const pickCatalogProduct = (p) => {
    remember();
    const pf = p.fields || {};
    mine(String(pf.name || "Product"));
    setProduct({
      id: p.id,
      name: String(pf.name || ""),
      url: String(pf.url || ""),
      description: String(pf.description || ""),
      price: String(pf.price || ""),
      scrape: String(pf.scrape || ""),
    });
    askBasics();
  };

  const pickNoProduct = () => {
    remember();
    mine("No product, brand content");
    setProduct(null);
    askBasics();
  };

  const addProductByUrl = async () => {
    const url = urlInput.trim();
    if (!url) return;
    if (!createProduct.enabled) {
      toast.error("You don't have permission to add products.");
      return;
    }
    remember();
    mine(url);
    setUrlInput("");
    setBusy(true);
    say(<span>Reading that page…</span>);
    try {
      let md = "", title = "", desc = "", img = "";
      try {
        const res = await withTimeout(
          scrapeFetch(FIRECRAWL_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ url, formats: ["markdown"], onlyMainContent: true }),
          }),
          SCRAPE_TIMEOUT_MS,
          "Scrape"
        );
        if (res.ok) {
          const j = await res.json();
          const d = (j && j.data) || j || {};
          md = d.markdown || "";
          title = (d.metadata && (d.metadata.title || d.metadata.ogTitle)) || "";
          desc = (d.metadata && (d.metadata.description || d.metadata.ogDescription)) || "";
          img = (d.metadata && d.metadata.ogImage) || "";
        }
      } catch (e) {
        // A failed scrape must not lose the product.
        console.warn("Firecrawl scrape failed:", e && e.message);
      }
      const created = await createProduct.mutateAsync({
        name: title || hostnameOf(url),
        accounts: workspaceId ? [{ id: workspaceId }] : null,
        type: PRODUCT_TYPE_PRODUCT_ID,
        url,
        description: desc || (md ? md.slice(0, 600) : ""),
        image_url: img || "",
        price: "",
        scrape: md ? md.slice(0, 20000) : "",
        scraped_at: md ? new Date().toISOString() : null,
        status: PRODUCT_STATUS_ACTIVE_ID,
      });
      const newId = (created && (created.id || created.recordId)) || "";
      setProduct({
        id: newId,
        name: title || hostnameOf(url),
        url,
        description: desc,
        price: "",
        scrape: md,
      });
      setBusy(false);
      say(
        md ? (
          <span>Got it. <b>{title || hostnameOf(url)}</b> is saved to your catalog and I'll use the page content for the brief.</span>
        ) : (
          <span>I couldn't read that page, but I've saved <b>{title || hostnameOf(url)}</b> to your catalog with the link so nothing is lost.</span>
        )
      );
      askBasics();
    } catch (e) {
      console.error("Add product failed:", e);
      setBusy(false);
      histRef.current.pop();
      toast.error("Couldn't add that product", { description: (e && e.message) || "Try again." });
      say(<span>I couldn't save that product. Pick it from the catalog, try the link again, or skip it.</span>);
      setStep("product");
    }
  };

  const askBasics = () => {
    say(
      pdf ? (
        <span>Nearly there. Check the name and the details, I've filled what I could from the document.</span>
      ) : (
        <span>Name the brief and pick who's filming and the channel.</span>
      )
    );
    setStep("basics");
  };

  // Creators is OPTIONAL and only appears when the workspace actually
  // has people, so a first brief is exactly as short as it was.
  const askCreators = () => {
    say(<span>Is this brief for anyone in particular? Pick who's making it, or skip and add people later.</span>);
    setStep("creators");
  };

  const toggleCreator = (id) => {
    setCreatorIds((c) => (c.includes(id) ? c.filter((x) => x !== id) : [...c, id]));
  };

  const submitCreators = () => {
    remember();
    if (creatorIds.length) {
      const names = workspaceMembers
        .filter((m) => creatorIds.includes(m.id))
        .map((m) => String((m.fields && (m.fields.memberName || m.fields.memberEmail)) || ""))
        .filter(Boolean);
      mine(names.join(", "));
    } else {
      mine("Skip for now");
    }
    if (pdf) {
      submit("pdf");
      return;
    }
    askMode();
  };

  const askMode = () => {
    say(<span>Last one. Want me to write the brief from your brand context, or go straight to the builder and write it there?</span>);
    setStep("mode");
  };

  // The PDF route goes straight on: the document holds its own goal
  // and offer. From scratch, the goal comes next, then the offer.
  const submitBasics = () => {
    const nm = briefName.trim();
    if (!nm) return;
    remember();
    mine(nm);
    if (pdf) {
      if (workspaceMembers.length) askCreators();
      else submit("pdf");
      return;
    }
    say(<span>What should this brief achieve? Pick everything that applies.</span>);
    setStep("goal");
  };

  const submitGoal = () => {
    if (!goals.length) return;
    remember();
    mine(goalLabels(goals).join(", ") + (goalInput.trim() ? ": " + goalInput.trim() : ""));
    say(
      <span>
        What is the creator receiving? Tick what applies and fill in what you know. Anything you leave empty, I'll
        suggest. No offer on this one? Skip it.
      </span>
    );
    setStep("offer");
  };

  const toggleModule = (key) =>
    setOffer((o) => ({ ...o, mods: o.mods.includes(key) ? o.mods.filter((k) => k !== key) : [...o.mods, key] }));
  // With nothing ticked, an approach also picks the mix and hands every
  // part to Lee. With parts ticked it only sets how generous he is.
  const pickApproach = (a) =>
    setOffer((o) => {
      if (o.mods.length) return { ...o, approach: a.key };
      const d = { ...o.d };
      a.mods.forEach((k) => { d[k] = { ...(d[k] || {}), depth: "help" }; });
      return { ...o, approach: a.key, mods: a.mods.slice(), d };
    });
  const setMod = (key, patch) =>
    setOffer((o) => ({ ...o, d: { ...o.d, [key]: { ...modOf(o, key), ...patch } } }));
  const setLimits = (patch) => setOffer((o) => ({ ...o, limits: { ...o.limits, ...patch } }));
  const setRights = (patch) => setOffer((o) => ({ ...o, rights: { ...o.rights, ...patch } }));

  const submitOffer = () => {
    const needsAi = offerNeedsAi(offer);
    if (!offer.mods.length || (needsAi && !offer.approach)) return;
    remember();
    const ap = APPROACHES.find((a) => a.key === offer.approach);
    mine(offerSummary(offer, product && product.name) + (ap && needsAi ? " · " + ap.label : ""));
    setOffer((o) => ({ ...o, skipped: false }));
    afterOffer();
  };

  const skipOffer = () => {
    remember();
    mine("Skip the offer");
    setOffer((o) => ({ ...o, skipped: true }));
    afterOffer();
  };

  const afterOffer = () => {
    if (workspaceMembers.length) askCreators();
    else askMode();
  };

  // ── Read an uploaded PDF and map it into the section fields ────
  const mapPdf = async (fileData, filename) => {
    const sys =
      "You turn brand briefing documents into structured creator briefs. Pull content VERBATIM from the document wherever possible; tidy lightly, never invent. Return ONLY a JSON object, no prose, no code fences. " +
      "Every section value is clean HTML using <p>, <ul><li> or <b>. No headings. NEVER use em dashes. " +
      "A key the document does not cover MUST be an empty string. Never pad a key by repeating the document's " +
      "title, its headings, or lines that belong to another key: an empty section is correct and expected.";
    const callPdf = async (model, keys, note) => {
      const res = await withTimeout(
        aiFetch(OPENROUTER_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            model,
            plugins: [{ id: "file-parser", pdf: { engine: "cloudflare-ai" } }],
            messages: [
              { role: "system", content: sys },
              {
                role: "user",
                content: [
                  {
                    type: "text",
                    text:
                      "The attached document is an existing creator brief or campaign document.\n" +
                      `Map its content into a JSON object with exactly these keys: ${keys.join(", ")}.\n` +
                      note,
                  },
                  { type: "file", file: { filename: filename || "brief.pdf", file_data: fileData } },
                ],
              },
            ],
            temperature: 0.3,
            max_tokens: 8000,
          }),
        }),
        MODEL_TIMEOUT_MS,
        "Reading"
      );
      if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
      const json = await res.json();
      const raw = ((json && json.choices && json.choices[0] && json.choices[0].message && json.choices[0].message.content) || "")
        .trim()
        .replace(/^```json/i, "").replace(/^```/, "").replace(/```$/, "").trim();
      let obj = {};
      try {
        obj = JSON.parse(raw);
      } catch (e) {
        // Salvage the object if the model wrapped it in anything.
        const a = raw.indexOf("{"), b = raw.lastIndexOf("}");
        if (a >= 0 && b > a) obj = JSON.parse(raw.slice(a, b + 1));
        else throw new Error("The AI response could not be read");
      }
      return obj;
    };
    // Mapping a document is verbatim sorting, not writing, so the
    // CHEAP model leads (Bev, 2026-08-27: keep the AI spend down) and
    // the big one is only the retry. The PDF-to-text parsing itself
    // is free either way (cloudflare-ai engine).
    const mapSet = async (keys, note) => {
      try {
        return await callPdf(WRITE_FALLBACK_MODEL, keys, note);
      } catch (e1) {
        console.warn("PDF read failed on the fast model, retrying on the bigger one:", e1 && e1.message);
        try {
          return await callPdf(WRITE_MODEL, keys, note);
        } catch (e2) {
          console.error("PDF read failed on both models:", e2 && e2.message);
          return {};
        }
      }
    };
    const metaNote =
      PROSE_NOTE +
      '\nAlso include "suggested_name" (a short 3 to 6 word title for this brief, plain text), ' +
      '"creator_type" (exactly one of: UGC, Influencer, Affiliate, Customer, Employee Ambassador, Founder; or "") ' +
      'and "channel" (Organic or Paid; or "").';
    const [proseObj, listsObj] = await Promise.all([
      mapSet(KEYS_PROSE, metaNote),
      mapSet(KEYS_LISTS, LISTS_NOTE),
    ]);
    const sections = {};
    KEYS_PROSE.forEach((k) => { const v = cleanHtml(proseObj[k]); if (v) sections[k] = v; });
    KEYS_LISTS.forEach((k) => { const v = cleanHtml(listsObj[k]); if (v) sections[k] = v; });
    if (Object.keys(sections).length < 2) throw new Error("The document could not be read");
    // Formats come AFTER the mapping, off the extracted sections
    // rather than the file. The mapper's own system prompt forbids
    // inventing and demands an empty string for anything the
    // document does not cover: exactly right for pulling content,
    // exactly wrong for naming a format. One short extra call, and
    // it reads what the document actually yielded.
    const readBack = KEYS_PROSE.concat(KEYS_LISTS)
      .map((k) => (sections[k] ? k + ": " + String(sections[k]).replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() : ""))
      .filter(Boolean).join("\n").slice(0, 6000);
    Object.assign(sections, formatFields(
      await pickFormatsWithFallback(aiFetch, readBack + "\n\n" + FORMAT_PDF_NOTE)
    ));
    const plain = (v) => String(v == null ? "" : v).replace(/<[^>]*>/g, "").trim();
    const ct = CREATOR_TYPES.find((o) => o.label.toLowerCase() === plain(proseObj.creator_type).toLowerCase());
    const ch = CHANNELS.find((o) => o.label.toLowerCase() === plain(proseObj.channel).toLowerCase());
    return {
      sections,
      suggestedName: plain(proseObj.suggested_name).slice(0, 80),
      creatorTypeId: ct ? ct.id : "",
      channelId: ch ? ch.id : "",
    };
  };

  const onPdfChosen = async (file) => {
    if (!file) return;
    if (!(file.type === "application/pdf" || /\.pdf$/i.test(file.name || ""))) {
      toast.error("That needs to be a PDF.");
      return;
    }
    if (file.size > PDF_MAX_BYTES) {
      toast.error("That PDF is over 10MB", { description: "Export a lighter copy and try again." });
      return;
    }
    if (!(upload && upload.uploadAsync)) {
      toast.error("Uploads aren't available here.");
      return;
    }
    remember();
    mine(file.name);
    setBusy(true);
    say(<span>Reading your PDF. This can take a minute…</span>);
    try {
      const results = await upload.uploadAsync(file);
      const first = Array.isArray(results) ? results[0] : results;
      if (!first || (first.status && first.status !== "completed") || !first.url) {
        throw new Error((first && first.error && first.error.message) || "Upload failed");
      }
      const hostedUrl = first.url;
      const filename = (first.file && first.file.name) || file.name;

      // base64 is the transport that works: OpenRouter's parser
      // returns 400 for the Softr-hosted upload URL (verified live
      // 2026-08-26). Files over the base64 cap still try the URL
      // rather than giving up.
      let mapped = null;
      if (file.size <= PDF_BASE64_MAX_BYTES) {
        try {
          const dataUrl = await readAsDataUrl(file);
          mapped = await mapPdf(dataUrl, filename);
        } catch (e1) {
          console.error("PDF mapping from the file data failed:", e1 && e1.message);
        }
      } else {
        try {
          mapped = await mapPdf(hostedUrl, filename);
        } catch (e1) {
          console.warn("PDF mapping from the hosted URL failed:", e1 && e1.message);
        }
      }

      if (mapped) {
        setPdf({ filename, url: hostedUrl, sections: mapped.sections, attach: true });
        if (mapped.suggestedName) setBriefName(mapped.suggestedName);
        const ct = CREATOR_TYPES.find((o) => o.id === mapped.creatorTypeId);
        if (ct) setCreatorType(ct);
        const ch = CHANNELS.find((o) => o.id === mapped.channelId);
        if (ch) setChannel(ch);
        say(<span>Got it. I've read <b>{filename}</b> and drafted the brief from it.</span>);
      } else {
        setPdf({ filename, url: hostedUrl, sections: null, attach: true });
        say(<span>I couldn't read the text in that one, so I'll attach the file to the brief and you can write the sections in the builder.</span>);
      }
      setBusy(false);
      if (urlProjectId) {
        askPdfAttach();
      } else {
        say(<span>Which project should it live in?</span>);
        setStep("project");
      }
    } catch (e) {
      console.error("PDF upload failed:", e);
      setBusy(false);
      histRef.current.pop();
      toast.error("Couldn't upload that PDF", { description: (e && e.message) || "Try again." });
      say(<span>The upload didn't go through. Try again, or start from scratch.</span>);
      setStep("pdfUpload");
    }
  };

  const askPdfAttach = () => {
    say(<span>Want the original PDF attached to the brief so creators can open it, or should I just use it as my source?</span>);
    setStep("pdfAttach");
  };

  const choosePdfAttach = (attach) => {
    remember();
    mine(attach ? "Attach it to the brief" : "Just use it as your source");
    setPdf((p) => (p ? { ...p, attach } : p));
    askBasics();
  };

  // ── The AI write (same section model as create-brief-quick) ────
  // The context every writing leg reads, the offer leg included.
  const briefContext = () => {
    const af = (account && account.fields) || {};
    const brandContext = [
      af.name ? "Brand: " + af.name : "",
      af.website ? "Website: " + af.website : "",
      af.blueprint ? String(af.blueprint) : "",
      af.brand_voice ? "Brand voice: " + af.brand_voice : "",
    ].filter(Boolean).join("\n");
    const productContext = product
      ? [
          "Product: " + (product.name || ""),
          product.description ? "Description: " + product.description : "",
          product.price ? "Price: " + product.price : "",
          product.url ? "Page: " + product.url : "",
          product.scrape ? "From the product page: " + String(product.scrape).slice(0, 4000) : "",
        ].filter(Boolean).join("\n")
      : "This brief is NOT about a specific product. It is brand or organic content. Do not invent a product.";
    return (
      `Brief name: ${briefName.trim()}\n` +
      `Who is filming: ${creatorType.label}\n` +
      `Channel: ${channel.label}\n` +
      goalLine(goals, goalInput, creatorType, channel) +
      `\nBrand context:\n${brandContext || "(none on file)"}\n\n` +
      `What this brief promotes:\n${productContext}\n\n`
    );
  };

  const writeBrief = async () => {
    const sys =
      "You write creator briefs. Return ONLY a JSON object, no prose, no code fences. " +
      "Every value is clean HTML using <p>, <ul><li> or <b>. No headings. NEVER use em dashes. " +
      "Write to the creator in second person. Be specific to the brand and product given; " +
      "if something is not in the context, leave that field as an empty string rather than inventing it.";
    // Two parallel calls (prose + lists), Pro first, Flash retry per
    // call, results merged. A set that fails on both models resolves
    // empty rather than sinking the other set.
    const context = briefContext();

    const callOnce = async (model, keys, note) => {
      const usr =
        context +
        `Return a JSON object with exactly these keys: ${keys.join(", ")}.\n` +
        note;
      const res = await withTimeout(
        aiFetch(OPENROUTER_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            model,
            messages: [{ role: "system", content: sys }, { role: "user", content: usr }],
            temperature: 0.7,
            max_tokens: 8000,
          }),
        }),
        MODEL_TIMEOUT_MS,
        "Writing"
      );
      if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
      const json = await res.json();
      const raw = ((json && json.choices && json.choices[0] && json.choices[0].message && json.choices[0].message.content) || "")
        .trim()
        .replace(/^```json/i, "").replace(/^```/, "").replace(/```$/, "").trim();
      let obj = {};
      try {
        obj = JSON.parse(raw);
      } catch (e) {
        // Salvage the object if the model wrapped it in anything.
        const a = raw.indexOf("{"), b = raw.lastIndexOf("}");
        if (a >= 0 && b > a) obj = JSON.parse(raw.slice(a, b + 1));
        else throw new Error("The AI response could not be read");
      }
      const out = {};
      keys.forEach((k) => { const v = cleanHtml(obj[k]); if (v) out[k] = v; });
      return out;
    };

    const writeSet = async (keys, note) => {
      try {
        return await callOnce(WRITE_MODEL, keys, note);
      } catch (e1) {
        console.warn("Primary model failed, retrying on fallback:", e1 && e1.message);
        try {
          return await callOnce(WRITE_FALLBACK_MODEL, keys, note);
        } catch (e2) {
          console.error("Fallback model failed too:", e2 && e2.message);
          return {};
        }
      }
    };

    // The offer is the Offer Builder's own leg (writeOffer), so the
    // prose set leaves it out. The PDF mapper still reads it verbatim.
    const [prose, lists, picks] = await Promise.all([
      writeSet(KEYS_PROSE.filter((k) => k !== "offer"), PROSE_NOTE),
      writeSet(KEYS_LISTS, LISTS_NOTE),
      pickFormatsWithFallback(aiFetch, context + FORMAT_NOTE),
    ]);
    const merged = { ...prose, ...lists };
    // The throw stays on prose+lists alone. A run where only the
    // format leg came back is still a failed write, and the brief
    // should open empty in the builder rather than carrying a
    // visual format and nothing else.
    if (!Object.keys(merged).length) throw new Error("The AI response could not be read");
    Object.assign(merged, formatFields(picks));
    return merged;
  };

  // The Offer Builder's leg. V4 Pro reasons before it answers and the
  // reasoning counts against max_tokens, hence the 20k budget and
  // json_object. It never throws: when both models fail, the brand's
  // own details still land in their parts.
  const writeOffer = async () => {
    const octx = { product, channel, creatorType };
    const usr = briefContext() + offerRequest(offer, octx);
    const once = async (model) => {
      const res = await withTimeout(
        aiFetch(OPENROUTER_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            model,
            messages: [{ role: "system", content: OFFER_SYS }, { role: "user", content: usr }],
            temperature: 0.4,
            max_tokens: 20000,
            response_format: { type: "json_object" },
          }),
        }),
        MODEL_TIMEOUT_MS,
        "Offer"
      );
      if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
      const json = await res.json();
      const choice = (json && json.choices && json.choices[0]) || {};
      const msg = choice.message || {};
      if (!msg.content && choice.finish_reason === "length") throw new Error("The offer ran out of room");
      return parseModelJson(msg.content || msg.reasoning || "");
    };
    let obj = null;
    try {
      obj = await once(WRITE_MODEL);
    } catch (e1) {
      console.warn("Offer: primary model failed, retrying on fallback:", e1 && e1.message);
      try {
        obj = await once(WRITE_FALLBACK_MODEL);
      } catch (e2) {
        console.error("Offer: fallback model failed too:", e2 && e2.message);
      }
    }
    return finishOffer(obj, offer, octx);
  };

  // ── Create ─────────────────────────────────────────────────────
  const submit = async (route) => {
    if (!user || !user.id) { toast.error("You need to be signed in."); return; }
    if (!createRecord.enabled) { toast.error("You don't have permission to create briefs."); return; }
    if (route !== "pdf") mine(route === "ai" ? "Write it with AI" : "Open the builder");
    const withOffer = route !== "pdf" && offerOn(offer);
    setScene(route === "ai" ? "ai" : withOffer ? "offer" : "quick");
    setBusy(true);
    try {
      let sections = {};
      let offerParts = {};
      if (route === "ai") {
        say(<span>Writing the brief from your brand context. This can take a minute or two.</span>);
        // The offer leg runs alongside the brief's own legs. A failed
        // brief write still keeps the offer.
        const [written, offered] = await Promise.all([
          writeBrief().catch((e) => {
            console.error("AI write failed:", e);
            toast.error("The AI couldn't write this one", {
              description: "Creating the brief anyway so you can write it in the builder.",
            });
            return {};
          }),
          withOffer ? writeOffer() : Promise.resolve({}),
        ]);
        sections = written;
        offerParts = offered;
      } else if (route === "pdf" && pdf && pdf.sections) {
        say(<span>Setting it up…</span>);
        sections = pdf.sections;
      } else if (withOffer) {
        say(<span>Writing your offer…</span>);
        offerParts = await writeOffer();
      } else {
        say(<span>Setting it up…</span>);
      }
      const finalProjectId = projectId || urlProjectId || "";
      const created = await createRecord.mutateAsync({
        name: briefName.trim() || "Untitled brief",
        users: [{ id: user.id }],
        projects: finalProjectId ? [{ id: finalProjectId }] : null,
        members: creatorIds.length ? creatorIds.map((id) => ({ id })) : null,
        product_link: product && product.id ? [{ id: product.id }] : null,
        attachment: pdf && pdf.attach && pdf.url ? [{ filename: pdf.filename, url: pdf.url }] : null,
        description: "",
        status: STATUS_DRAFT_ID,
        generated: route === "ai" || (route === "pdf" && pdf && pdf.sections) ? GENERATED_AI_ID : GENERATED_MANUAL_ID,
        section_order: withOffer ? sectionOrderFor(offer, offerParts) : STARTER_SECTIONS,
        creator_type: creatorType.id,
        channel: channel.id,
        ...sections,
        ...offerParts,
      });
      const newId = (created && (created.id || created.recordId)) || "";
      if (!newId) throw new Error("Create returned no record id");

      say(<span>Done. Opening your brief…</span>);
      const url = `${DETAIL_PATH}/?recordId=${encodeURIComponent(newId)}`;
      try {
        if (window.parent && window.parent.closeSwModal) window.parent.closeSwModal();
      } catch (e) { /* not in a modal */ }
      (window.parent || window).open(url, "_self");
    } catch (e) {
      console.error("[create-brief] failed:", e);
      toast.error("Couldn't create the brief", { description: (e && e.message) || "Try again." });
      setBusy(false);
      setScene("");
      say(<span>That didn't go through. Try again?</span>);
      setStep(route === "pdf" ? "basics" : "mode");
    }
  };

  // ── Render ─────────────────────────────────────────────────────
  const showLoading = !bootedRef.current;
  const lastWho = msgs.length ? msgs[msgs.length - 1].who : "";

  return (
    <div className={inPanel ? "cbc" : "cbc cbc-home"} style={{ maxWidth: 620, margin: "0 auto", padding: `${heroTop} 20px 30px` }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;500;600;700&display=swap');
        .cbc, .cbc * { font-family: 'League Spartan', sans-serif; }
        @keyframes bounce { 0%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-8px); } }
        .cbc .typing-dot { animation: bounce 1.4s infinite; }
        .cbc .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .cbc .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes blSpin { to { transform: rotate(360deg); } }
        @keyframes blFade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes blFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
        .cbc input, .cbc textarea { outline: none; }
        @media (max-width: 640px) { .cbc.cbc-home { padding-top: clamp(26px, 6vh, 56px) !important; } }
      `}</style>

      {isInactive ? (
        <UpgradeCard />
      ) : scene ? (
        <WritingScene mode={scene} genIdx={genIdx} overtime={overtime} withOffer={offerOn(offer)} />
      ) : (
        <div>
          {msgs.map((m, i) => {
            if (m.who === "me") return <MeMsg key={i}>{m.node}</MeMsg>;
            const prev = msgs[i - 1];
            return <LeeMsg key={i} withAvatar={!prev || prev.who !== "lee"}>{m.node}</LeeMsg>;
          })}
          {(busy || showLoading) && <Typing withAvatar={lastWho !== "lee"} />}

          {!busy && step === "workspace" && (
            <StepArea>
              <div className="space-y-2">
                {accounts.map((a) => (
                  <CardBtn
                    key={a.id}
                    onClick={() => pickWorkspace(a, false)}
                    title={String((a.fields && a.fields.name) || "Workspace")}
                    sub={String((a.fields && a.fields.website) || "")}
                    img={workspaceLogo(a.fields)}
                  />
                ))}
              </div>
            </StepArea>
          )}

          {!busy && step === "source" && (
            <StepArea>
              <div className="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  onClick={choosePdf}
                  className="rounded-xl px-4 py-3.5 text-left shadow-sm hover:shadow-md transition-all duration-200"
                  style={{ background: "#879CF7", color: "#fff" }}
                >
                  <span className="block text-[13px]" style={{ fontWeight: 700 }}>Upload a PDF</span>
                  <span className="block text-[11px] mt-0.5" style={{ opacity: 0.85 }}>I'll read it and build the brief from it</span>
                </button>
                <button
                  type="button"
                  onClick={chooseScratch}
                  className="rounded-xl px-4 py-3.5 text-left bg-white shadow-sm hover:shadow-md transition-all duration-200"
                  style={{ border: CHIP_BORDER, color: NAVY }}
                >
                  <span className="block text-[13px]" style={{ fontWeight: 700 }}>Start from scratch</span>
                  <span className="block text-[11px] mt-0.5" style={{ color: "#6B7A99" }}>Pick the product, then write it or have me write it</span>
                </button>
              </div>
              {histRef.current.length > 0 && (
                <div className="mt-2">
                  <Chip on={false} onClick={goBack}>Back</Chip>
                </div>
              )}
            </StepArea>
          )}

          {!busy && step === "pdfUpload" && (
            <StepArea>
              <input
                ref={fileRef}
                type="file"
                accept="application/pdf,.pdf"
                className="hidden"
                onChange={(e) => {
                  const f = e.target.files && e.target.files[0];
                  e.target.value = "";
                  if (f) onPdfChosen(f);
                }}
              />
              <button
                type="button"
                onClick={() => { if (fileRef.current) fileRef.current.click(); }}
                className="w-full rounded-xl px-4 py-6 text-center bg-white shadow-sm hover:shadow-md transition-all duration-200"
                style={{ border: "1.5px dashed rgba(122, 147, 255, 0.6)", color: NAVY }}
