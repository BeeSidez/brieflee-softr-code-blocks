              <TextIn value={v.to} onChange={(x) => set({ to: x })} placeholder="To" suffix="%" />
            </Row>
          )}
          <SubLabel>Flat or tiered</SubLabel>
          <ChipPick options={["Flat", "Tiered"]} value={v.structure} onChange={(x) => set({ structure: x })} />
          {v.structure === "Tiered" && (
            <Row><TextIn grow value={v.tiers} onChange={(x) => set({ tiers: x })} placeholder="Sales or GMV thresholds, e.g. 20% after $2,000 GMV" /></Row>
