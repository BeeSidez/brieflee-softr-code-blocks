                    ))}
                  </div>
                </div>
                <div>
                  <div className="text-[11px] mb-1.5" style={{ color: NAVY, fontWeight: 600, textTransform: "uppercase", letterSpacing: "0.04em" }}>Channel</div>
                  <div className="flex flex-wrap gap-2">
                    {CHANNELS.map((o) => (
                      <Chip key={o.id} on={channel.id === o.id} onClick={() => setChannel(o)}>{o.label}</Chip>
