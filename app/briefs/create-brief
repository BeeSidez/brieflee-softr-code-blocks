// ─── Helpers ──────────────────────────────────────────────────────
function linkIds(raw) {
  const arr = Array.isArray(raw) ? raw : raw == null ? [] : [raw];
  return arr.map((x) => (x && typeof x === "object" ? x.id : x)).filter(Boolean);
}
function selectLabel(raw) {
  if (!raw) return "";
  if (typeof raw === "string") return raw;
  if (Array.isArray(raw)) return raw.map(selectLabel).filter(Boolean).join(", ");
  return raw.label || "";
}
// The model returns HTML per section. Strip anything that is not a
// simple block so a bad response can never inject markup.
function cleanHtml(v) {
  if (typeof v !== "string") return "";
  return v
    .replace(/```html?/gi, "")
    .replace(/```/g, "")
    .replace(/<(script|style|iframe)[^>]*>[\s\S]*?<\/\1>/gi, "")
    .replace(/\s*[—–]\s*/g, ", ")
    .replace(/\s*&(?:mdash|ndash|#8212|#8211);\s*/gi, ", ")
    .trim();
}
// Model output to an object, fences stripped, salvaging the object
// if the model wrapped it in anything. callOnce and callPdf keep
// their own inline copies: they are near-clones of each other and
// editing either risks hitting the wrong one.
function parseModelJson(text) {
  const raw = String(text || "").trim()
    .replace(/^```json/i, "").replace(/^```/, "").replace(/```$/, "").trim();
  try {
    return JSON.parse(raw);
  } catch (e) {
    const open = raw.indexOf("{"), close = raw.lastIndexOf("}");
    if (open >= 0 && close > open) return JSON.parse(raw.slice(open, close + 1));
    throw new Error("The AI response could not be read");
  }
}
// No `new URL()` here on purpose: URL parsing outside an inline
// useState initialiser stops Softr's analyzer registering the create
// actions on this block.
function hostnameOf(url) {
  const m = String(url || "").replace(/^https?:\/\//i, "").split(/[/?#]/)[0];
  return m.replace(/^www\./, "") || String(url || "");
}
const withTimeout = (promise, ms, label) =>
  Promise.race([
    promise,
    new Promise((_, reject) => setTimeout(() => reject(new Error(`${label} timed out`)), ms)),
  ]);
const readAsDataUrl = (file) =>
  new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(String(r.result || ""));
    r.onerror = () => reject(new Error("Could not read the file"));
    r.readAsDataURL(file);
  });

