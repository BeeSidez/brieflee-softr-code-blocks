  // ── Read an uploaded PDF and map it into the section fields ────
  const mapPdf = async (fileData, filename) => {
    const sys =
      "You turn brand briefing documents into structured creator briefs. Pull content VERBATIM from the document wherever possible; tidy lightly, never invent. Return ONLY a JSON object, no prose, no code fences. " +
      "Every section value is clean HTML using <p>, <ul><li> or <b>. No headings. NEVER use em dashes. " +
      "A key the document does not cover MUST be an empty string. Never pad a key by repeating the document's " +
      "title, its headings, or lines that belong to another key: an empty section is correct and expected.";
    const callPdf = async (model, keys, note) => {
      const res = await withTimeout(
        aiFetch(OPENROUTER_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            model,
            plugins: [{ id: "file-parser", pdf: { engine: "cloudflare-ai" } }],
            messages: [
              { role: "system", content: sys },
              {
                role: "user",
                content: [
                  {
                    type: "text",
                    text:
                      "The attached document is an existing creator brief or campaign document.\n" +
                      `Map its content into a JSON object with exactly these keys: ${keys.join(", ")}.\n` +
                      note,
                  },
                  { type: "file", file: { filename: filename || "brief.pdf", file_data: fileData } },
                ],
              },
            ],
            temperature: 0.3,
            max_tokens: 8000,
          }),
        }),
        MODEL_TIMEOUT_MS,
        "Reading"
      );
      if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
      const json = await res.json();
      const raw = ((json && json.choices && json.choices[0] && json.choices[0].message && json.choices[0].message.content) || "")
        .trim()
        .replace(/^```json/i, "").replace(/^```/, "").replace(/```$/, "").trim();
      let obj = {};
      try {
        obj = JSON.parse(raw);
      } catch (e) {
        // Salvage the object if the model wrapped it in anything.
        const a = raw.indexOf("{"), b = raw.lastIndexOf("}");
        if (a >= 0 && b > a) obj = JSON.parse(raw.slice(a, b + 1));
        else throw new Error("The AI response could not be read");
      }
      return obj;
    };
    // Mapping a document is verbatim sorting, not writing, so the
    // CHEAP model leads (Bev, 2026-08-27: keep the AI spend down) and
    // the big one is only the retry. The PDF-to-text parsing itself
    // is free either way (cloudflare-ai engine).
    const mapSet = async (keys, note) => {
      try {
        return await callPdf(WRITE_FALLBACK_MODEL, keys, note);
      } catch (e1) {
        console.warn("PDF read failed on the fast model, retrying on the bigger one:", e1 && e1.message);
        try {
          return await callPdf(WRITE_MODEL, keys, note);
        } catch (e2) {
          console.error("PDF read failed on both models:", e2 && e2.message);
          return {};
        }
      }
    };
    const metaNote =
      PROSE_NOTE +
      '\nAlso include "suggested_name" (a short 3 to 6 word title for this brief, plain text), ' +
      '"creator_type" (exactly one of: UGC, Influencer, Affiliate, Customer, Employee Ambassador, Founder; or "") ' +
      'and "channel" (Organic or Paid; or "").';
    const [proseObj, listsObj] = await Promise.all([
      mapSet(KEYS_PROSE, metaNote),
      mapSet(KEYS_LISTS, LISTS_NOTE),
    ]);
    const sections = {};
    KEYS_PROSE.forEach((k) => { const v = cleanHtml(proseObj[k]); if (v) sections[k] = v; });
    KEYS_LISTS.forEach((k) => { const v = cleanHtml(listsObj[k]); if (v) sections[k] = v; });
    if (Object.keys(sections).length < 2) throw new Error("The document could not be read");
    // Formats come AFTER the mapping, off the extracted sections
    // rather than the file. The mapper's own system prompt forbids
    // inventing and demands an empty string for anything the
    // document does not cover: exactly right for pulling content,
    // exactly wrong for naming a format. One short extra call, and
    // it reads what the document actually yielded.
    const readBack = KEYS_PROSE.concat(KEYS_LISTS)
      .map((k) => (sections[k] ? k + ": " + String(sections[k]).replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() : ""))
      .filter(Boolean).join("\n").slice(0, 6000);
    Object.assign(sections, formatFields(
      await pickFormatsWithFallback(aiFetch, readBack + "\n\n" + FORMAT_PDF_NOTE)
    ));
    const plain = (v) => String(v == null ? "" : v).replace(/<[^>]*>/g, "").trim();
    const ct = CREATOR_TYPES.find((o) => o.label.toLowerCase() === plain(proseObj.creator_type).toLowerCase());
    const ch = CHANNELS.find((o) => o.label.toLowerCase() === plain(proseObj.channel).toLowerCase());
    return {
      sections,
      suggestedName: plain(proseObj.suggested_name).slice(0, 80),
      creatorTypeId: ct ? ct.id : "",
      channelId: ch ? ch.id : "",
    };
  };

  const onPdfChosen = async (file) => {
