// Resolution key: lowercase, & to and, drop a leading "the", strip
// anything that is not a letter or a digit. Over the 42 names this
// gives 42 unique keys and no canonical key contains another, so the
// containment step below can never fire on two library names at once.
function formatKey(s) {
  return String(s || "").toLowerCase()
    .replace(/&/g, " and ")
    .replace(/^\s*the\s+/, "")
    .replace(/[^a-z0-9]/g, "");
}
// One name to one library entry, or null. Order matters: id, exact,
// alias, singular, then containment accepted ONLY on a single match,
// which catches "Unboxing Video" without opening a fuzzy-match hole
// ("Demo and Review" hits two, so it is refused).
function resolveFormat(v) {
  const raw = String(v == null ? "" : v).trim();
  if (!raw) return null;
  const byId = FORMATS.find((f) => f.id === raw);
  if (byId) return byId;
  const k = formatKey(raw);
  if (!k) return null;
  const exact = FORMATS.find((f) => formatKey(f.name) === k);
  if (exact) return exact;
  const aliased = FORMAT_ALIASES[k] || FORMAT_ALIASES[k.replace(/s$/, "")];
  if (aliased) {
    const hit = FORMATS.find((f) => f.name === aliased);
    if (hit) return hit;
  }
  const singular = k.replace(/es$/, "").replace(/s$/, "");
  const plural = FORMATS.find((f) => formatKey(f.name) === singular || formatKey(f.name) === k.replace(/s$/, ""));
  if (plural) return plural;
  const near = FORMATS.filter((f) => {
    const c = formatKey(f.name);
    return c.length > 3 && (k.includes(c) || c.includes(k));
  });
  return near.length === 1 ? near[0] : null;
}
// The direction arrives as plain text and is asked to arrive without
// the format name on the front. cleanHtml takes the fences and the em
// dashes; this takes the wrappers and the bold the model adds back
// anyway, and the leading name it repeats however often it is told not
// to. An empty direction falls back to the library's own line, because
// a named format with no instruction under it is worse than a short one.
function cleanFormatDirection(v, fmt) {
  let t = cleanHtml(v).replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
  const lead = fmt.name.toLowerCase();
  if (t.toLowerCase().indexOf(lead) === 0) {
    t = t.slice(lead.length).replace(/^\s*[.:,-]\s*/, "").trim();
  }
  return t || (fmt.desc + ".");
}
// Whatever came back, into at most three real library picks. Every
// branch is a bad-model case: the array arrives as an object, an item
// arrives as a bare string, the name is spelled the model's way, the
// same format comes back twice, six come back when three were asked
// for. A name that does not resolve is DROPPED WITH ITS DIRECTION and
// never reassigned: direction written for one format contradicts
// another format's heading, which is worse than no direction at all.
function normaliseFormatPicks(obj) {
  const rawList = obj && obj.formats;
  const items = Array.isArray(rawList)
    ? rawList
    : (rawList && typeof rawList === "object" ? Object.values(rawList) : []);
  const out = [];
  const seen = {};
  items.forEach((item) => {
    const it = (item && typeof item === "object") ? item : { name: item };
    const hit = resolveFormat(it.name != null ? it.name : it.format);
    if (!hit) { console.warn("[create-brief] format not in the library, dropped:", it && it.name); return; }
    if (seen[hit.id]) return;
    seen[hit.id] = 1;
    out.push({ id: hit.id, name: hit.name, direction: cleanFormatDirection(it.direction, hit) });
  });
  return out.slice(0, 3);
}
// One paragraph per pick, the shape the builder's own format writer
// produces: <p><b>Name.</b> direction</p>.
function formatDirectionHtml(picks) {
  return picks.map((p) => "<p><b>" + p.name + ".</b> " + p.direction + "</p>").join("");
}
// The three writable fields a set of picks turns into. Returned as
// field aliases so both routes can merge it straight into `sections`
// and let the existing `...sections` spread do the write.
function formatFields(picks) {
  if (!picks.length) return {};
  return {
    format: picks.map((p) => ({ id: p.id })),
    first_format: [{ id: picks[0].id }],
    visual_format: formatDirectionHtml(picks),
  };
}

// ─── The format call ──────────────────────────────────────────────
// Its OWN call, never a third key on the lists set: KEYS_LISTS and
// LISTS_NOTE are shared with the PDF mapper, both `sys` messages demand
// clean HTML for every value, and callOnce's key loop runs cleanHtml,
// which returns "" for anything that is not a string, so an array of
// picks would vanish without a sound. Output is short, so this leg is
// never the slow one and Promise.all waits for the longest, not the sum.
const FORMAT_SYS =
  "You choose the visual format for a creator brief. Return ONLY a JSON object, " +
  "no prose, no code fences. NEVER use em dashes.";
const FORMAT_RULES =
  'Return a JSON object with exactly one key, "formats": an ARRAY of two or three objects,\n' +
  "most important first. The first is the format this video mainly is. The rest are what the\n" +
  "creator could shoot instead, not extra videos.\n" +
  "Each object has exactly two keys:\n" +
  '  "name": plain text, copied character for character from the library below. Never an id,\n' +
  "  never a format that is not on the list, never one you invented.\n" +
  '  "direction": plain text, two or three sentences. No HTML, no headings, no bullets, no\n' +
  "  bold, and do not open with the format name, that gets added for you.\n" +
  "Write each direction to the creator in second person and make it specific to THIS brand and\n" +
  "THIS product. Say what they actually do: the opening shot, what is in their hands, where\n" +
  "they are, what the product does on camera, what has to be visible, how much freedom they\n" +
  "have with the rest. Use the real details you were given, the product's own parts, its\n" +
  "price, the occasion, who buys it.\n" +
  "The short line after each format below is a menu label, not copy. Never repeat it and never\n" +
  "write the generic explanation of what the format is. If a direction would read the same for\n" +
  "a different brand, it is wrong; rewrite it.\n" +
  "Choose only from this library:\n";
const FORMAT_NOTE = FORMAT_RULES + FORMAT_MENU;
// The document route. A brief that lists "content hooks" or "video
// ideas" is usually describing FORMATS without naming them, which is
// the one thing the extraction pass cannot do: it is told to pull
// verbatim and never invent, and naming the format is a judgement.
const FORMAT_PDF_NOTE =
  "The brief below was read out of the brand's own document.\n" +
  "Whatever it calls them, its hooks, ideas and references usually DESCRIBE a format without\n" +
  "naming one: a nostalgic cut is Transformation, getting ready on camera is Try-On, two\n" +
  "people playing a scene is Skit. Name what the document is already asking for, first.\n" +
  "Only where it describes nothing shootable, choose from the product and the occasion.\n" +
  FORMAT_RULES + FORMAT_MENU;

// aiFetch is the component's useProxyFetch handle, passed in so both
// routes share one implementation.
async function requestFormatPicks(fetcher, model, userContent) {
  const res = await withTimeout(
    fetcher(OPENROUTER_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model,
        messages: [
          { role: "system", content: FORMAT_SYS },
          { role: "user", content: userContent },
        ],
        temperature: 0.7,
        max_tokens: 1200,
      }),
    }),
    MODEL_TIMEOUT_MS,
    "Picking the format"
  );
  if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
  const json = await res.json();
  const picks = normaliseFormatPicks(parseModelJson(
    (json && json.choices && json.choices[0] && json.choices[0].message && json.choices[0].message.content) || ""
  ));
  // Nothing resolved against the library. Throw so the fallback model
  // gets its turn rather than settling for no format at all.
  if (!picks.length) throw new Error("No format on the list came back");
  return picks;
}
// Pro first, Flash retry, then give up quietly. A brief with no visual
// format is fine; a brief that failed to create is not.
async function pickFormatsWithFallback(fetcher, userContent) {
  try {
    return await requestFormatPicks(fetcher, WRITE_MODEL, userContent);
  } catch (e1) {
    console.warn("Format pick failed, retrying on the fallback model:", e1 && e1.message);
    try {
      return await requestFormatPicks(fetcher, WRITE_FALLBACK_MODEL, userContent);
    } catch (e2) {
      console.error("Format pick failed on both models:", e2 && e2.message);
      return [];
    }
  }
}
