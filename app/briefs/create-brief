                  </div>
                </div>
                <textarea
                  value={goalInput}
                  onChange={(e) => setGoalInput(e.target.value)}
                  placeholder="What should this brief achieve? (optional)"
                  rows={2}
                  className="w-full rounded-xl px-3.5 py-2.5 text-sm resize-none"
                  style={{ border: CHIP_BORDER, color: NAVY, background: "#fff" }}
                />
                <button
                  type="button"
                  onClick={submitBasics}
                  disabled={!briefName.trim()}
                  className="w-full py-2.5 rounded-xl text-sm shadow-sm hover:shadow-md transition-all duration-200 disabled:opacity-50"
                  style={{ background: "#879CF7", color: "#fff", fontWeight: 600 }}
                >
                  Continue
                </button>
              </div>
              <div className="mt-2">
                <Chip on={false} onClick={goBack}>Back</Chip>
              </div>
            </StepArea>
          )}

          {!busy && step === "creators" && (
            <StepArea>
              <div className="space-y-2" style={{ maxHeight: 240, overflowY: "auto" }}>
                {workspaceMembers.map((m) => {
                  const mf = m.fields || {};
                  const nm = String(mf.memberName || "");
                  const em = String(mf.memberEmail || "");
                  const on = creatorIds.includes(m.id);
                  return (
                    <button
                      key={m.id}
                      type="button"
                      onClick={() => toggleCreator(m.id)}
                      className="w-full rounded-xl px-4 py-3 text-left bg-white shadow-sm hover:shadow-md transition-all duration-200"
                      style={{ border: on ? "1px solid #879CF7" : CHIP_BORDER, color: NAVY }}
                    >
                      <span className="block text-[13px]" style={{ fontWeight: on ? 700 : 400 }}>{nm || em}</span>
                      {nm && em ? <span className="block text-[11px] mt-0.5" style={{ color: "#6B7A99" }}>{em}</span> : null}
                    </button>
                  );
                })}
              </div>
              <div className="flex justify-between mt-2">
                <Chip on={false} onClick={goBack}>Back</Chip>
                <Chip on={false} onClick={submitCreators}>
                  {creatorIds.length ? "Continue with " + creatorIds.length : "Skip for now"}
                </Chip>
              </div>
            </StepArea>
          )}

          {!busy && step === "mode" && (
            <StepArea>
              <div className="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  onClick={() => submit("ai")}
                  className="rounded-xl px-4 py-3.5 text-left shadow-sm hover:shadow-md transition-all duration-200"
                  style={{ background: "#879CF7", color: "#fff" }}
                >
                  <span className="block text-[13px]" style={{ fontWeight: 700 }}>Write it with AI</span>
                  <span className="block text-[11px] mt-0.5" style={{ opacity: 0.85 }}>Brand context + product, every section drafted</span>
                </button>
                <button
                  type="button"
                  onClick={() => submit("builder")}
                  className="rounded-xl px-4 py-3.5 text-left bg-white shadow-sm hover:shadow-md transition-all duration-200"
                  style={{ border: CHIP_BORDER, color: NAVY }}
                >
                  <span className="block text-[13px]" style={{ fontWeight: 700 }}>Open the builder</span>
                  <span className="block text-[11px] mt-0.5" style={{ color: "#6B7A99" }}>Your picks saved, write it yourself</span>
                </button>
              </div>
              <div className="mt-2">
                <Chip on={false} onClick={goBack}>Back</Chip>
              </div>
            </StepArea>
          )}

          <div ref={endRef} />
        </div>
      )}
    </div>
  );
}


