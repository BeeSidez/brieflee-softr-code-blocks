          <SubLabel>Attribution period</SubLabel>
          <ChipPick options={ATTRIBUTION} value={v.attribution} onChange={(x) => set({ attribution: x })} />
        </>
      );
    } else if (mod.key === "gift") {
      body = known ? (
        <Row><TextIn grow value={v.details} onChange={(x) => set({ details: x })} placeholder="What is it? e.g. a $50 gift card, or the full bundle" /></Row>
      ) : (
        <Row><TextIn value={v.budget} onChange={(x) => set({ budget: x })} placeholder="Worth up to" prefix={sym} /></Row>
      );
    } else if (mod.key === "sample") {
      body = (
        <>
          <Row><TextIn grow value={v.product != null ? v.product : productName || ""} onChange={(x) => set({ product: x })} placeholder="Product" /></Row>
          {known ? (
            <Row>
              <TextIn value={v.qty} onChange={(x) => set({ qty: x })} placeholder="Quantity" />
              <TextIn value={v.value} onChange={(x) => set({ value: x })} placeholder="Value, roughly" prefix={sym} />
            </Row>
          ) : (
            <Row>
              <TextIn value={v.qty} onChange={(x) => set({ qty: x })} placeholder="Quantity, e.g. 1 to 3" />
              <TextIn value={v.valueTo} onChange={(x) => set({ valueTo: x })} placeholder="Value up to" prefix={sym} />
            </Row>
          )}
        </>
      );
    } else if (mod.key === "bonus") {
      body = (
        <>
          <SubLabel>Based on</SubLabel>
          <ChipPick options={BONUS_BASIS} value={v.basis} onChange={(x) => set({ basis: x })} />
          <SubLabel>Reward type</SubLabel>
          <ChipMulti options={REWARD_TYPES} value={v.rewards} onChange={(x) => set({ rewards: x })} />
          {known ? (
            <Row>
              <TextIn grow value={v.target} onChange={(x) => set({ target: x })} placeholder="Target, e.g. 50 sales in 30 days" />
              <TextIn grow value={v.reward} onChange={(x) => set({ reward: x })} placeholder="Reward, e.g. $100 or 20% commission" />
            </Row>
          ) : (
            <Row><TextIn value={v.budget} onChange={(x) => set({ budget: x })} placeholder="Reward budget" prefix={sym} /></Row>
          )}
        </>
      );
    } else if (mod.key === "competition") {
      body = (
        <>
          <SubLabel>Ranked by</SubLabel>
          <ChipPick options={COMP_METRICS} value={v.metric} onChange={(x) => set({ metric: x })} />
          <Row>
            <TextIn value={v.winners} onChange={(x) => set({ winners: x })} placeholder="Winners" />
            <TextIn grow value={v.period} onChange={(x) => set({ period: x })} placeholder="Period, e.g. the first 30 days" />
          </Row>
          {known ? (
            <Row><TextIn grow value={v.prizes} onChange={(x) => set({ prizes: x })} placeholder="Prize for each position, e.g. 1st $500, 2nd $250" /></Row>
          ) : (
            <Row><TextIn value={v.budget} onChange={(x) => set({ budget: x })} placeholder="Prize budget" prefix={sym} /></Row>
          )}
        </>
      );
    }
  }
  return (
    <div className="rounded-xl p-3" style={{ border: CHIP_BORDER, background: "#FAFBFF" }}>
      <div className="flex flex-wrap items-center justify-between gap-2">
        <span className="text-[13px]" style={{ color: NAVY, fontWeight: 700 }}>{mod.label}</span>
        <Segmented options={DEPTHS} value={depth} onChange={(d) => set({ depth: d })} />
      </div>
      {body ? (
        <div className="mt-2.5 space-y-2">{body}</div>
      ) : (
        <div className="text-[11px] mt-1.5" style={{ color: "#6B7A99" }}>I'll suggest this one.</div>
      )}
      {body && needsAi ? (
        <div className="text-[11px] mt-2" style={{ color: "#6B7A99" }}>Nothing filled in yet, so I'll suggest it.</div>
      ) : null}
    </div>
  );
}
