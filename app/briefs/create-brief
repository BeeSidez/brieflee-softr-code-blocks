  // ── The AI write (same section model as create-brief-quick) ────
  const writeBrief = async () => {
    const af = (account && account.fields) || {};
    const brandContext = [
      af.name ? "Brand: " + af.name : "",
      af.website ? "Website: " + af.website : "",
      af.blueprint ? String(af.blueprint) : "",
      af.brand_voice ? "Brand voice: " + af.brand_voice : "",
    ].filter(Boolean).join("\n");
    const productContext = product
      ? [
          "Product: " + (product.name || ""),
          product.description ? "Description: " + product.description : "",
          product.price ? "Price: " + product.price : "",
          product.url ? "Page: " + product.url : "",
          product.scrape ? "From the product page: " + String(product.scrape).slice(0, 4000) : "",
        ].filter(Boolean).join("\n")
      : "This brief is NOT about a specific product. It is brand or organic content. Do not invent a product.";

    const sys =
      "You write creator briefs. Return ONLY a JSON object, no prose, no code fences. " +
      "Every value is clean HTML using <p>, <ul><li> or <b>. No headings. NEVER use em dashes. " +
      "Write to the creator in second person. Be specific to the brand and product given; " +
      "if something is not in the context, leave that field as an empty string rather than inventing it.";
    // Two parallel calls (prose + lists), Pro first, Flash retry per
    // call, results merged. A set that fails on both models resolves
    // empty rather than sinking the other set.
    const context =
      `Brief name: ${briefName.trim()}\n` +
      `Who is filming: ${creatorType.label}\n` +
      `Channel: ${channel.label}\n` +
      (goalInput.trim() ? `What the brand wants from this brief: ${goalInput.trim()}\n` : "") +
      `\nBrand context:\n${brandContext || "(none on file)"}\n\n` +
      `What this brief promotes:\n${productContext}\n\n`;

    const callOnce = async (model, keys, note) => {
      const usr =
        context +
        `Return a JSON object with exactly these keys: ${keys.join(", ")}.\n` +
        note;
      const res = await withTimeout(
        aiFetch(OPENROUTER_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            model,
            messages: [{ role: "system", content: sys }, { role: "user", content: usr }],
            temperature: 0.7,
            max_tokens: 8000,
          }),
        }),
        MODEL_TIMEOUT_MS,
        "Writing"
      );
      if (!res.ok) throw new Error(`OpenRouter returned HTTP ${res.status}`);
      const json = await res.json();
      const raw = ((json && json.choices && json.choices[0] && json.choices[0].message && json.choices[0].message.content) || "")
        .trim()
        .replace(/^```json/i, "").replace(/^```/, "").replace(/```$/, "").trim();
      let obj = {};
      try {
        obj = JSON.parse(raw);
      } catch (e) {
        // Salvage the object if the model wrapped it in anything.
        const a = raw.indexOf("{"), b = raw.lastIndexOf("}");
        if (a >= 0 && b > a) obj = JSON.parse(raw.slice(a, b + 1));
        else throw new Error("The AI response could not be read");
      }
      const out = {};
      keys.forEach((k) => { const v = cleanHtml(obj[k]); if (v) out[k] = v; });
      return out;
    };

    const writeSet = async (keys, note) => {
      try {
        return await callOnce(WRITE_MODEL, keys, note);
      } catch (e1) {
        console.warn("Primary model failed, retrying on fallback:", e1 && e1.message);
        try {
          return await callOnce(WRITE_FALLBACK_MODEL, keys, note);
        } catch (e2) {
          console.error("Fallback model failed too:", e2 && e2.message);
          return {};
        }
      }
    };

    const [prose, lists, picks] = await Promise.all([
      writeSet(KEYS_PROSE, PROSE_NOTE),
      writeSet(KEYS_LISTS, LISTS_NOTE),
      pickFormatsWithFallback(aiFetch, context + FORMAT_NOTE),
    ]);
    const merged = { ...prose, ...lists };
    // The throw stays on prose+lists alone. A run where only the
    // format leg came back is still a failed write, and the brief
    // should open empty in the builder rather than carrying a
    // visual format and nothing else.
    if (!Object.keys(merged).length) throw new Error("The AI response could not be read");
    Object.assign(merged, formatFields(picks));
    return merged;
  };

  // ── Create ─────────────────────────────────────────────────────
  const submit = async (route) => {
    if (!user || !user.id) { toast.error("You need to be signed in."); return; }
    if (!createRecord.enabled) { toast.error("You don't have permission to create briefs."); return; }
    if (route !== "pdf") mine(route === "ai" ? "Write it with AI" : "Open the builder");
    setScene(route === "ai" ? "ai" : "quick");
    setBusy(true);
    try {
      let sections = {};
      if (route === "ai") {
        say(<span>Writing the brief from your brand context. This can take a minute or two.</span>);
        try {
          sections = await writeBrief();
        } catch (e) {
          console.error("AI write failed:", e);
          toast.error("The AI couldn't write this one", {
            description: "Creating the brief anyway so you can write it in the builder.",
          });
        }
      } else if (route === "pdf" && pdf && pdf.sections) {
        say(<span>Setting it up…</span>);
        sections = pdf.sections;
      } else {
        say(<span>Setting it up…</span>);
      }
      const finalProjectId = projectId || urlProjectId || "";
      const created = await createRecord.mutateAsync({
        name: briefName.trim() || "Untitled brief",
        users: [{ id: user.id }],
        projects: finalProjectId ? [{ id: finalProjectId }] : null,
        members: creatorIds.length ? creatorIds.map((id) => ({ id })) : null,
        product_link: product && product.id ? [{ id: product.id }] : null,
        attachment: pdf && pdf.attach && pdf.url ? [{ filename: pdf.filename, url: pdf.url }] : null,
        description: "",
        status: STATUS_DRAFT_ID,
        generated: route === "ai" || (route === "pdf" && pdf && pdf.sections) ? GENERATED_AI_ID : GENERATED_MANUAL_ID,
        section_order: STARTER_SECTIONS,
        creator_type: creatorType.id,
        channel: channel.id,
        ...sections,
      });
      const newId = (created && (created.id || created.recordId)) || "";
      if (!newId) throw new Error("Create returned no record id");

      say(<span>Done. Opening your brief…</span>);
      const url = `${DETAIL_PATH}/?recordId=${encodeURIComponent(newId)}`;
      try {
        if (window.parent && window.parent.closeSwModal) window.parent.closeSwModal();
      } catch (e) { /* not in a modal */ }
      (window.parent || window).open(url, "_self");
    } catch (e) {
      console.error("[create-brief] failed:", e);
      toast.error("Couldn't create the brief", { description: (e && e.message) || "Try again." });
      setBusy(false);
      setScene("");
      say(<span>That didn't go through. Try again?</span>);
      setStep(route === "pdf" ? "basics" : "mode");
    }
  };

  // ── Render ─────────────────────────────────────────────────────
  const showLoading = !bootedRef.current;
