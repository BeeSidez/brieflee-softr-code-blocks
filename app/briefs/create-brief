function finishOffer(obj, o, octx) {
  const fb = offerFallback(o, octx);
  if (!obj || typeof obj !== "object") {
    return { ...fb, offer_notes: "<p>Lee couldn't draft this offer, so it holds only the details you gave. Fill in the rest here.</p>" };
  }
  const cur = currencyOf(o.currency);
  const productName = octx.product ? octx.product.name : "";
  const out = {};
  OFFER_KEYS.forEach((k) => {
    const v = cleanHtml(obj[k]);
    if (v) out[k] = /^\s*</.test(v) ? v : `<p>${escHtml(v)}</p>`;
  });
  OFFER_MODULES.forEach((mod) => {
    if (!o.mods.includes(mod.key)) { delete out[mod.field]; return; }
    const v = modOf(o, mod.key);
    const need = v.depth === "know"
      ? numbersIn(moduleFacts(mod, v, cur, productName).filter((f) => f.exact).map((f) => f.text).join(" "))
      : [];
    const have = numbersIn(out[mod.field]);
    if (fb[mod.field] && (!out[mod.field] || need.some((n) => !have.includes(n)))) out[mod.field] = fb[mod.field];
  });
  const r = o.rights || {};
  if (r.depth === "none") delete out.usage_rights;
  if (r.depth === "know") {
    const need = numbersIn([r.usageTerm, r.paidTerm, r.exclTerm].filter(Boolean).join(" "));
    const have = numbersIn(out.usage_rights);
    if (!out.usage_rights || need.some((n) => !have.includes(n))) out.usage_rights = fb.usage_rights;
  }
