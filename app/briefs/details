function extractJson(raw) {
  if (!raw) return null;
  const s = String(raw);
  const match = s.match(/\{[\s\S]*\}/);
  if (!match) return null;
  try { return JSON.parse(match[0]); } catch { return null; }
}
// Pull just the "Brand bio" section out of the brand_blueprint
// LOOKUP, which concatenates `Brand bio: … \n\nCTA: … \n\nBrand
// voice: …` etc on the accounts table.
function extractBrandBio(blueprint) {
  const s = unwrap(blueprint);
  if (!s) return "";
  const m = s.match(/Brand bio:\s*([\s\S]*?)(?:\n\s*(?:CTA|Brand voice|Niche|Audience|Pain points|Target audience):|$)/i);
  return m ? m[1].trim() : s.trim();
}
// LOOKUP video fields can return either a raw URL or an HTML <iframe>
// string (from a FORMULA on the linked table). Normalise both into a
// playable URL string we can drop straight into <video src=…>.
function resolveLookupVideoUrl(raw) {
  if (!raw) return "";
  const first = Array.isArray(raw) ? raw[0] : raw;
  if (!first) return "";
  const s = typeof first === "string"
    ? first
    : (first.url || first.value || first.label || "");
  if (!s || typeof s !== "string") return "";
  const trimmed = s.trim();
  if (trimmed.startsWith("<")) {
    const m = trimmed.match(/src=['"]([^'"]+)['"]/i);
    return m ? m[1] : "";
  }
  return trimmed;
}
// TikTok / Instagram / YouTube URLs need to be transformed into an
// embed iframe src. Plain hostnames (raw cloudinary mp4, vimeo plain
// URL) don't get embedded — we render them as <video> instead.
function detectExternalEmbed(url) {
  if (!url || typeof url !== "string") return null;
  const u = url.trim();
  // TikTok video page → /embed/v2/<id>
  const tt = u.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/i);
  if (tt) return { type: "tiktok", src: `https://www.tiktok.com/embed/v2/${tt[1]}`, aspect: "vertical" };
  // Instagram reel / post / igtv → /<id>/embed/
  const ig = u.match(/instagram\.com\/(?:reel|reels|p|tv)\/([A-Za-z0-9_-]+)/i);
  if (ig) return { type: "instagram", src: `https://www.instagram.com/p/${ig[1]}/embed/`, aspect: "vertical" };
  // YouTube watch / share / shorts → /embed/<id>
  const ytShorts = u.match(/youtube\.com\/shorts\/([A-Za-z0-9_-]+)/i);
  if (ytShorts) return { type: "youtube", src: `https://www.youtube.com/embed/${ytShorts[1]}`, aspect: "vertical" };
  const yt = u.match(/youtube\.com\/watch\?v=([A-Za-z0-9_-]+)/i) || u.match(/youtu\.be\/([A-Za-z0-9_-]+)/i);
  if (yt) return { type: "youtube", src: `https://www.youtube.com/embed/${yt[1]}`, aspect: "horizontal" };
  return null;
}
// Quick MP4/MOV/WebM check so we can render plain video files inline.
function isDirectVideoUrl(s) {
  if (!s || typeof s !== "string") return false;
  return /\.(mp4|mov|webm|m4v)(\?|$)/i.test(s);
}
// PDF detection — used to decide whether a brief_document_url URL can
// be embedded with an inline iframe preview.
function isPdfUrl(s) {
  if (!s || typeof s !== "string") return false;
  return /\.pdf(\?|$)/i.test(s);
}
function asArray(raw) {
  if (Array.isArray(raw)) return raw;
  if (raw == null) return [];
  return [raw];
}
function asArrayIds(raw) {
  return asArray(raw).map((x) => (typeof x === "string" ? x : x?.id || "")).filter(Boolean);
}
function asArrayLabels(raw) {
  return asArray(raw).map((x) => (typeof x === "string" ? x : x?.label || "")).filter(Boolean);
}
// Used to decide which sections auto-collapse on first load. Returns
// true when the section has no meaningful content to show. Treats
// "None" threshold options as empty since they're the defaults.
function isSectionEmpty(sectionKey, f) {
  if (!f) return false;
  if (sectionKey === "brief") {
    return !f.description || !String(f.description).trim();
  }
  if (sectionKey === "inspiration") {
    const linked = ["example", "example_2", "example_3", "videos", "videos_2", "videos_3"];
    const urls = ["example_video_1", "example_video_2", "example_video_3"];
    const anyLinked = linked.some((k) => asArray(f[k]).length > 0);
    const anyUrl = urls.some((k) => typeof f[k] === "string" && f[k].trim());
    return !anyLinked && !anyUrl;
  }
  if (sectionKey === "details") {
    const fields = ["platform", "duration", "duration_threshold", "aspect_ratio",
                    "content_type", "content_delivery", "submission_open_date",
                    "submission_close_date"];
    return fields.every((k) => {
      const v = f[k];
      if (v == null || v === "") return true;
      if (Array.isArray(v) && v.length === 0) return true;
      return false;
    });
  }
  if (sectionKey === "qa") {
    const hasAgents = asArray(f.qa_checklist).length > 0;
    const hasThresholds = ["product_screen_time_threshold", "hook_speed_threshold",
                           "visual_hook_threshold", "cta_placement_threshold",
                           "face_time_threshold", "text_legibility_threshold",
                           "audio_clarity_threshold", "engagement_pacing_threshold",
                           "brand_mention_count_threshold"].some((k) => {
      const v = f[k];
      if (!v) return false;
      const label = (v && (v.label || v)) || "";
      // Treat "None" / "None (no CTA required)" as empty defaults.
      return label && !/^none\b/i.test(String(label));
    });
    return !hasAgents && !hasThresholds;
  }
  return false;
}
// DATETIME → "YYYY-MM-DDTHH:mm" for <input type="datetime-local">
function toDateInput(iso) {
  if (!iso) return "";
  try {
    const d = new Date(iso);
    const pad = (n) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  } catch { return ""; }
}
function fromDateInput(local) {
  if (!local) return "";
  try { return new Date(local).toISOString(); } catch { return ""; }
}

