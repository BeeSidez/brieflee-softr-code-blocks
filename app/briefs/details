      .bl-bd-header-actions { display: inline-flex; align-items: center; gap: 8px; }

      /* Share popover */
      .bl-bd-share-wrap { position: relative; }
      .bl-bd-share-panel {
        position: absolute; top: calc(100% + 8px); right: 0;
        width: 360px; max-width: calc(100vw - 32px);
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        border-radius: 14px;
        box-shadow: 0 24px 60px -16px rgba(0, 15, 77, 0.30);
        padding: 16px;
        z-index: 60;
      }
      .bl-bd-share-tabs {
        display: flex;
        gap: 4px;
        padding: 3px;
        margin: -4px -4px 14px;
        background: ${TAG_BG};
        border-radius: 999px;
      }
      .bl-bd-share-tab {
        flex: 1 1 auto;
        padding: 6px 12px;
        background: transparent;
        border: none;
        border-radius: 999px;
        font-size: 12px; font-weight: 500;
        color: ${MUTED};
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
      }
      .bl-bd-share-tab:hover:not(.is-active) { color: ${NAVY_DEEP}; }
      .bl-bd-share-tab.is-active {
        background: #FFFFFF;
        color: ${NAVY_DEEP};
        box-shadow: 0 2px 6px -2px rgba(0, 15, 77, 0.18);
      }
      .bl-bd-share-team-note {
        margin-top: 14px;
        padding: 10px 12px;
        background: ${SUBTLE_BG};
        border: 1px solid ${BORDER};
        border-radius: 10px;
        font-size: 11px;
        line-height: 1.45;
        color: ${MUTED};
      }
      .bl-bd-share-title {
        font-size: 13px; font-weight: 600; color: ${NAVY_DEEP};
        margin: 0 0 2px;
      }
      .bl-bd-share-helper {
        font-size: 11px; color: ${MUTED}; margin-bottom: 10px;
      }
      .bl-bd-share-link-row {
        display: flex; align-items: stretch; gap: 6px;
      }
      .bl-bd-share-link-input {
        flex: 1 1 auto; min-width: 0;
        height: 34px; padding: 0 10px;
        background: ${SURFACE};
        border: 1px solid ${BORDER};
        border-radius: 8px;
        font-size: 12px; color: ${NAVY_DEEP};
        outline: none;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      .bl-bd-share-link-input:focus { border-color: ${PERIWINKLE}; }
      .bl-bd-share-icon-btn {
        flex: 0 0 34px;
        width: 34px; height: 34px;
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        border-radius: 8px;
        color: ${NAVY_DEEP};
        cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: border-color 0.15s, color 0.15s;
      }
      .bl-bd-share-icon-btn:hover:not(:disabled) {
        border-color: ${PERIWINKLE}; color: ${PERIWINKLE_HOVER};
      }
      .bl-bd-share-icon-btn:disabled { opacity: 0.55; cursor: not-allowed; }
      .bl-bd-share-divider {
        height: 1px;
        background: ${BORDER};
        margin: 14px -16px;
      }
      .bl-bd-share-row {
        display: flex; align-items: center; gap: 12px;
        justify-content: space-between;
      }
      .bl-bd-share-row-title {
        display: flex; flex-direction: column; gap: 2px;
        font-size: 12px; font-weight: 500; color: ${NAVY_DEEP};
      }
      .bl-bd-share-row-helper {
        font-size: 11px; color: ${MUTED}; font-weight: 400;
      }
      .bl-bd-share-invite-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%;
        height: 38px;
        background: ${PERIWINKLE};
        color: #FFFFFF;
        border: none;
        border-radius: 10px;
        font-size: 13px; font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
      }
      .bl-bd-share-invite-btn:hover:not(:disabled) { background: ${PERIWINKLE_HOVER}; }
      .bl-bd-share-invite-btn:disabled { opacity: 0.55; cursor: not-allowed; }

      .bl-bd-preview-btn {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 14px;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 10px; color: ${NAVY_DEEP};
        font-size: 13px; font-weight: 500; cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .bl-bd-preview-btn:hover:not(:disabled) {
        border-color: ${PERIWINKLE}; color: ${PERIWINKLE_HOVER};
      }
      .bl-bd-preview-btn:disabled { opacity: 0.55; cursor: not-allowed; }
      .bl-bd-publish-btn {
        height: 36px; border-radius: 10px;
        font-size: 13px; font-weight: 500; padding: 0 16px;
      }
      .bl-bd-publish-btn:hover:not(:disabled) {
        background-color: ${PERIWINKLE_HOVER} !important;
      }
      .bl-bd-publish-btn:disabled { opacity: 0.55; }

      /* Tooltip */
      .bl-bd-tip-wrap { position: relative; display: inline-flex; align-items: center; margin-left: 4px; }
      .bl-bd-tip-icon { color: ${MUTED}; cursor: help; transition: color 0.15s; }
      .bl-bd-tip-wrap:hover .bl-bd-tip-icon,
      .bl-bd-tip-wrap:focus .bl-bd-tip-icon { color: ${PERIWINKLE_HOVER}; }
      .bl-bd-tip-text {
        position: absolute; bottom: calc(100% + 6px); left: 50%;
        transform: translateX(-50%);
        background: ${NAVY_DEEP}; color: #FFFFFF;
        font-size: 11px; font-weight: 400; line-height: 1.4;
        padding: 6px 10px; border-radius: 8px;
        white-space: normal; width: 240px;
        opacity: 0; visibility: hidden; pointer-events: none; z-index: 100;
        box-shadow: 0 12px 28px -12px rgba(0, 15, 77, 0.55);
      }
      .bl-bd-tip-wrap:hover .bl-bd-tip-text,
      .bl-bd-tip-wrap:focus .bl-bd-tip-text { opacity: 1; visibility: visible; }

      /* Field grid */
      .bl-bd-fields-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }
      .bl-bd-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        position: relative; /* anchor for absolute-positioned popovers (multi-select menu, agents menu) */
      }
      .bl-bd-field.is-full { grid-column: span 2; }
      .bl-bd-field-label {
        font-size: 12px; font-weight: 500; color: ${NAVY_DEEP};
        display: inline-flex; align-items: center; gap: 4px;
        letter-spacing: 0.01em;
      }
      .bl-bd-field-value {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      }
      .bl-bd-input {
        height: 36px; font-size: 13px;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 10px; padding: 0 12px; color: ${NAVY_DEEP};
        outline: none; transition: border-color 0.15s; width: 100%;
      }
      .bl-bd-input:focus { border-color: ${PERIWINKLE}; }
      .bl-bd-textarea {
        font-size: 13px; line-height: 1.45;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 10px; padding: 10px 12px; color: ${NAVY_DEEP};
        width: 100%; outline: none; transition: border-color 0.15s;
        font-family: inherit; resize: vertical;
      }
      .bl-bd-textarea:focus { border-color: ${PERIWINKLE}; }
      .bl-bd-select {
        height: 36px; font-size: 13px;
        background: #FFFFFF url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B7A99' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>") no-repeat right 10px center / 14px;
        border: 1px solid ${BORDER}; border-radius: 10px;
        padding: 0 32px 0 12px; color: ${NAVY_DEEP};
        outline: none; appearance: none; cursor: pointer;
        transition: border-color 0.15s;
        flex: 1 1 auto; min-width: 0;
      }
      .bl-bd-select:focus { border-color: ${PERIWINKLE}; }
      .bl-bd-select-inline {
        flex: 0 0 100px; height: 36px; max-width: 100px;
      }

      /* Multi-select */
      .bl-bd-multi { position: relative; width: 100%; }
      .bl-bd-multi-trigger {
        display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
        width: 100%; min-height: 36px;
        padding: 5px 36px 5px 10px;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 10px; cursor: pointer; text-align: left;
        position: relative;
        transition: border-color 0.15s;
      }
      .bl-bd-multi-trigger:hover { border-color: ${PERIWINKLE}; }
      .bl-bd-multi-placeholder { color: ${SOFT_MUTED}; font-size: 12px; }
      .bl-bd-multi-caret {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        color: ${MUTED};
      }
      .bl-bd-chip {
        display: inline-flex; align-items: center;
        padding: 3px 10px; background: ${TAG_BG};
        color: ${PERIWINKLE_HOVER}; font-size: 11px; font-weight: 500;
        border-radius: 999px;
      }
      .bl-bd-multi-menu, .bl-bd-agents-menu {
        position: absolute; top: calc(100% + 6px); left: 0;
        max-height: 360px; overflow: auto;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 12px;
        box-shadow: 0 16px 36px -16px rgba(0, 15, 77, 0.30);
        padding: 6px; z-index: 40;
      }
      .bl-bd-multi-menu { min-width: 100%; max-width: 100%; }
      .bl-bd-agents-menu {
        /* Wider than the multi-select menu since each agent renders as
           a card with icon + name + description. Caps at viewport so
           it never escapes a narrow tab. */
        width: 720px;
        max-width: calc(100vw - 48px);
        max-height: 480px;
        padding: 10px;
      }
      .bl-bd-agents-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 8px;
      }
      .bl-bd-agent-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 6px;
        padding: 14px 12px 12px;
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        border-radius: 12px;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s, transform 0.15s;
      }
      .bl-bd-agent-card:hover {
        border-color: ${PERIWINKLE};
        background: ${SUBTLE_BG};
        transform: translateY(-1px);
      }
      .bl-bd-agent-card.is-active {
        border-color: ${PERIWINKLE};
        background: ${TAG_BG};
        box-shadow: 0 0 0 1px ${PERIWINKLE} inset;
      }
      .bl-bd-agent-card-check {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 18px;
        height: 18px;
        border-radius: 6px;
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #FFFFFF;
        transition: background 0.15s, border-color 0.15s;
      }
      .bl-bd-agent-card.is-active .bl-bd-agent-card-check {
        background: ${PERIWINKLE};
        border-color: ${PERIWINKLE};
      }
      .bl-bd-agent-card-icon {
        width: 56px;
        height: 56px;
        margin-top: 2px;
        flex-shrink: 0;
        filter: drop-shadow(0 6px 12px rgba(135, 156, 247, 0.25));
      }
      .bl-bd-agent-card-name {
        font-size: 13px;
        font-weight: 600;
        color: ${NAVY_DEEP};
        line-height: 1.25;
        letter-spacing: -0.005em;
      }
      .bl-bd-agent-card-desc {
        font-size: 11px;
        color: ${MUTED};
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .bl-bd-multi-item {
        display: inline-flex; align-items: center; gap: 8px;
        width: 100%; padding: 8px 10px;
        background: transparent; border: none; border-radius: 8px;
        font-size: 13px; font-weight: 500; color: ${NAVY_DEEP};
        text-align: left; cursor: pointer; transition: background 0.12s;
      }
      .bl-bd-multi-item:hover { background: rgba(135, 156, 247, 0.10); }
      .bl-bd-multi-item.is-active { color: ${PERIWINKLE_HOVER}; }
      .bl-bd-check-box {
        width: 14px; height: 14px; border-radius: 4px;
        border: 1px solid ${BORDER}; background: #FFFFFF;
        display: inline-flex; align-items: center; justify-content: center;
        color: ${PERIWINKLE_HOVER}; flex-shrink: 0;
      }
      .bl-bd-multi-item.is-active .bl-bd-check-box {
        background: ${PERIWINKLE}; border-color: ${PERIWINKLE}; color: #FFFFFF;
      }

      /* Review Agents */
      .bl-bd-agents-field { grid-column: span 2; }
      .bl-bd-agents-trigger {
        display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
        width: 100%; min-height: 44px;
        padding: 8px 36px 8px 10px;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 12px; cursor: pointer; text-align: left;
        position: relative; transition: border-color 0.15s;
      }
      .bl-bd-agents-trigger:hover { border-color: ${PERIWINKLE}; }
      .bl-bd-agent-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 4px 10px 4px 4px;
        background: ${TAG_BG}; color: ${NAVY_DEEP};
        font-size: 11px; font-weight: 500; border-radius: 999px;
      }
      .bl-bd-agent-icon {
        width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
      }
      .bl-bd-agent-row {
        display: flex; align-items: center; gap: 10px;
        width: 100%; padding: 8px 10px;
        background: transparent; border: none; border-radius: 8px;
        font-size: 13px; color: ${NAVY_DEEP};
        text-align: left; cursor: pointer; transition: background 0.12s;
      }
      .bl-bd-agent-row:hover { background: rgba(135, 156, 247, 0.08); }
      .bl-bd-agent-row .bl-bd-agent-icon {
        width: 22px; height: 22px;
      }
      .bl-bd-agent-name {
        font-weight: 500;
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .bl-bd-agent-tip {
        /* Hidden inline — tooltip text now shows via the row's title=
           attribute on hover (native browser tooltip), keeping the
           menu compact and readable at any width. */
        display: none;
      }
      .bl-bd-agent-row.is-active { background: ${SUBTLE_BG}; }

      /* Thresholds grid (subset of fields grid) */
      .bl-bd-thresholds {
        margin-top: 16px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
      .bl-bd-thresholds .bl-bd-field { gap: 4px; }

      /* Brief body */
      .bl-bd-brief-body { display: flex; flex-direction: column; gap: 14px; }
      .bl-bd-brief-plain { margin-top: 4px; }
      .bl-bd-brief-card {
        background: ${SURFACE}; border: 1px solid ${BORDER};
        border-radius: 12px; padding: 14px 16px;
      }
      .bl-bd-brief-card-head {
        display: flex; flex-direction: column; gap: 2px; margin-bottom: 10px;
      }
      .bl-bd-brief-card-title {
        font-size: 14px; font-weight: 600; color: ${NAVY_DEEP}; margin: 0;
      }
      .bl-bd-brief-card-helper {
        font-size: 11px; color: ${MUTED};
      }
      .bl-bd-brief-list {
        list-style: none; padding: 0; margin: 0;
        display: flex; flex-direction: column; gap: 8px;
      }
      .bl-bd-brief-line {
        display: flex; align-items: flex-start; gap: 8px;
      }
      .bl-bd-textarea-line { min-height: 38px; }
      .bl-bd-line-delete {
        flex: 0 0 28px; height: 28px; border-radius: 6px;
        background: transparent; border: none; color: ${MUTED};
        cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
        margin-top: 4px;
        transition: background 0.12s, color 0.12s;
      }
      .bl-bd-line-delete:hover { background: rgba(217, 38, 38, 0.08); color: #d92626; }
      .bl-bd-brief-empty {
        padding: 10px 4px; font-size: 12px; color: ${SOFT_MUTED}; font-style: italic;
      }
      .bl-bd-add-line {
        margin-top: 10px;
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 10px; font-size: 12px; font-weight: 500;
        background: transparent; color: ${PERIWINKLE_HOVER};
        border: 1px dashed rgba(135, 156, 247, 0.55);
        border-radius: 999px; cursor: pointer;
        transition: background 0.12s, border-color 0.12s;
      }
      .bl-bd-add-line:hover { background: rgba(135, 156, 247, 0.08); border-color: ${PERIWINKLE}; }

      /* Storyboard */
      .bl-bd-storyboard {
        display: flex; flex-direction: column; gap: 10px;
      }
      .bl-bd-storyboard-row {
        display: grid;
        grid-template-columns: 140px 1fr 1fr 28px;
        gap: 8px; align-items: start;
      }
      .bl-bd-storyboard-section { height: 38px; }
      .bl-bd-storyboard-visual { min-height: 38px; }
      .bl-bd-storyboard-script { height: 38px; }

      /* Brief section card stack — ensures Brand bio + Product
         summary + the brief body editor all sit with the same 14px
         gap that bl-bd-brief-body uses internally between Personal
         experiences / Hook / etc. */
      .bl-bd-brief-stack {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      /* Context cards (Brand bio + Product summary) — visually
         identical to bl-bd-brief-card, so they sit inline with the
         Personal experiences / Hook / Talking points cards. */
      .bl-bd-context-paragraph {
        font-size: 13px; line-height: 1.5;
        color: ${NAVY_DEEP};
        margin: 0;
        white-space: pre-wrap;
      }
      .bl-bd-context-trigger {
        width: 100%;
        background: transparent;
        border: none;
        padding: 0;
        text-align: left;
        cursor: pointer;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        position: relative;
      }
      .bl-bd-context-trigger.is-empty .bl-bd-context-paragraph {
        color: ${SOFT_MUTED};
        font-style: italic;
      }
      .bl-bd-context-pencil {
        flex: 0 0 12px;
        margin-top: 4px;
        color: ${MUTED};
        opacity: 0;
        transition: opacity 0.15s;
      }
      .bl-bd-context-trigger:hover .bl-bd-context-pencil { opacity: 1; }
      .bl-bd-context-edit {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .bl-bd-context-edit-actions {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        align-self: flex-end;
      }
      .bl-bd-context-cancel {
        height: 32px;
        padding: 0 12px;
        background: transparent;
        color: ${MUTED};
        border: none;
        border-radius: 8px;
        font-size: 12px; font-weight: 500;
        cursor: pointer;
      }
      .bl-bd-context-cancel:hover:not(:disabled) { color: ${NAVY_DEEP}; }
      .bl-bd-context-cancel:disabled { opacity: 0.55; cursor: not-allowed; }
      .bl-bd-context-save {
        height: 32px;
        padding: 0 14px;
        background: ${PERIWINKLE};
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        font-size: 12px; font-weight: 500;
        cursor: pointer;
      }
      .bl-bd-context-save:hover:not(:disabled) { background: ${PERIWINKLE_HOVER}; }
      .bl-bd-context-save:disabled { opacity: 0.55; cursor: not-allowed; }

      /* PDF row */
      .bl-bd-pdf-row {
        margin-top: 14px;
        background: ${SURFACE}; border: 1px solid ${BORDER};
        border-radius: 12px; padding: 12px 14px;
        display: flex; flex-direction: column; gap: 8px;
      }
      .bl-bd-pdf-label {
        font-size: 12px; font-weight: 500; color: ${NAVY_DEEP};
        display: inline-flex; align-items: center;
      }
      .bl-bd-pdf-filled {
        display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap;
      }
      .bl-bd-pdf-link {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 10px;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 8px; color: ${NAVY_DEEP};
        font-size: 12px; font-weight: 500; text-decoration: none;
        transition: border-color 0.15s, color 0.15s;
      }
      .bl-bd-pdf-link:hover { border-color: ${PERIWINKLE}; color: ${PERIWINKLE_HOVER}; }
      .bl-bd-pdf-edit, .bl-bd-pdf-clear {
        width: 28px; height: 28px; border-radius: 6px;
        background: transparent; border: 1px solid ${BORDER};
        color: ${MUTED}; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: border-color 0.15s, color 0.15s;
      }
      .bl-bd-pdf-edit:hover { border-color: ${PERIWINKLE}; color: ${PERIWINKLE_HOVER}; }
      .bl-bd-pdf-clear:hover { border-color: #d92626; color: #d92626; }
      .bl-bd-pdf-edit-row { display: inline-flex; gap: 8px; align-items: center; flex: 1; }
      .bl-bd-pdf-edit-row .bl-bd-input { flex: 1; }
      .bl-bd-pdf-save {
        height: 36px; padding: 0 14px;
        background: ${PERIWINKLE}; color: #FFFFFF;
        border: none; border-radius: 8px;
        font-size: 12px; font-weight: 500; cursor: pointer;
      }
      .bl-bd-pdf-save:hover { background: ${PERIWINKLE_HOVER}; }
      .bl-bd-pdf-empty { display: inline-flex; align-items: center; gap: 8px; }
      .bl-bd-pdf-action {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 10px;
        background: #FFFFFF; border: 1px dashed rgba(135, 156, 247, 0.55);
        border-radius: 8px; color: ${PERIWINKLE_HOVER};
        font-size: 12px; font-weight: 500; cursor: pointer;
        transition: background 0.12s, border-color 0.12s;
      }
      .bl-bd-pdf-action:hover { background: rgba(135, 156, 247, 0.08); border-color: ${PERIWINKLE}; }
      .bl-bd-pdf-action:disabled { opacity: 0.55; cursor: not-allowed; }
      .bl-bd-pdf-or { font-size: 12px; color: ${SOFT_MUTED}; }

      /* Creator row in Overview */
      .bl-bd-creator-row {
        display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap;
        background: transparent; border: none;
        padding: 4px 8px; margin: -4px -8px;
        border-radius: 10px; cursor: pointer;
        font-size: 12px; color: ${MUTED};
        text-align: left;
        transition: background 0.12s;
      }
      .bl-bd-creator-row:hover { background: rgba(135, 156, 247, 0.08); }
      .bl-bd-creator-label {
        font-size: 11px; font-weight: 500; color: ${SOFT_MUTED};
        text-transform: uppercase; letter-spacing: 0.06em;
      }
      .bl-bd-creator-name {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: 12px; font-weight: 500; color: ${NAVY_DEEP};
      }
      .bl-bd-creator-email {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: 12px; color: ${MUTED};
      }
      .bl-bd-creator-pencil { opacity: 0; transition: opacity 0.15s; color: ${MUTED}; }
      .bl-bd-creator-row:hover .bl-bd-creator-pencil { opacity: 1; }
      .bl-bd-creator-empty {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 4px 12px;
        background: transparent;
        color: ${PERIWINKLE_HOVER};
        font-size: 12px; font-weight: 500;
        border: 1px dashed rgba(135, 156, 247, 0.55);
        border-radius: 999px; cursor: pointer;
        transition: background 0.12s, border-color 0.12s;
        align-self: flex-start;
      }
      .bl-bd-creator-empty:hover {
        background: rgba(135, 156, 247, 0.08); border-color: ${PERIWINKLE};
      }
      .bl-bd-creator-editing {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        background: ${SUBTLE_BG}; padding: 8px 10px; border-radius: 10px;
        cursor: default;
      }
      .bl-bd-creator-editing:hover { background: ${SUBTLE_BG}; }
      .bl-bd-creator-name-input  { flex: 1 1 160px; min-width: 140px; }
      .bl-bd-creator-email-input { flex: 1 1 200px; min-width: 180px; }
      .bl-bd-creator-save {
        height: 32px; padding: 0 14px;
        background: ${PERIWINKLE}; color: #FFFFFF;
        border: none; border-radius: 8px;
        font-size: 12px; font-weight: 500; cursor: pointer;
      }
      .bl-bd-creator-save:hover:not(:disabled) { background: ${PERIWINKLE_HOVER}; }
      .bl-bd-creator-save:disabled { opacity: 0.6; }
      .bl-bd-creator-cancel {
        height: 32px; padding: 0 12px;
        background: transparent; color: ${MUTED};
        border: none; border-radius: 8px;
        font-size: 12px; font-weight: 500; cursor: pointer;
      }
      .bl-bd-creator-cancel:hover:not(:disabled) { color: ${NAVY_DEEP}; }

      /* Inspiration */
      .bl-bd-inspo { display: flex; flex-direction: column; gap: 14px; }
      .bl-bd-inspo-video {
        position: relative;
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid ${BORDER};
      }
      .bl-bd-inspo-video-el {
        display: block;
        width: 100%;
        aspect-ratio: 9 / 16;
        object-fit: cover;
        background: #000;
      }
      .bl-bd-inspo-video-change {
        position: absolute; top: 8px; right: 8px;
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 9px; border-radius: 999px;
        background: rgba(255, 255, 255, 0.92);
        color: ${NAVY_DEEP}; border: none;
        font-size: 10px; font-weight: 500; cursor: pointer;
        backdrop-filter: blur(8px);
        opacity: 0; transition: opacity 0.15s;
      }
      .bl-bd-inspo-video:hover .bl-bd-inspo-video-change { opacity: 1; }
      .bl-bd-inspo-video-caption {
        position: absolute; left: 0; right: 0; bottom: 0;
        padding: 6px 10px;
        background: linear-gradient(to top, rgba(0,0,0,0.65), rgba(0,0,0,0));
        color: #FFFFFF;
        font-size: 11px; font-weight: 500;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        pointer-events: none;
      }
      .bl-bd-inspo-group {
        background: ${SURFACE}; border: 1px solid ${BORDER};
        border-radius: 12px; padding: 12px 14px;
      }
      .bl-bd-inspo-label {
        font-size: 12px; font-weight: 500; color: ${NAVY_DEEP};
        margin-bottom: 8px;
      }
      .bl-bd-inspo-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
      }
      .bl-bd-inspo-slot {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 12px;
        background: #FFFFFF; border: 1px dashed rgba(135, 156, 247, 0.55);
        border-radius: 10px; color: ${PERIWINKLE_HOVER};
        font-size: 12px; font-weight: 500; cursor: pointer;
        transition: background 0.12s, border-color 0.12s, border-style 0.12s;
        text-align: left; min-width: 0;
      }
      .bl-bd-inspo-slot.is-filled {
        background: ${TAG_BG}; border-style: solid; border-color: ${BORDER};
        color: ${NAVY_DEEP};
      }
      .bl-bd-inspo-slot:hover { border-color: ${PERIWINKLE}; }
      .bl-bd-inspo-slot-label {
        flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .bl-bd-inspo-edit-icon { color: ${MUTED}; flex-shrink: 0; }
      .bl-bd-url-slot {
        display: flex; flex-direction: column; gap: 6px;
      }
      .bl-bd-url-slot-label {
        font-size: 11px; font-weight: 500; color: ${MUTED};
      }
      .bl-bd-url-slot-input-row {
        display: flex; align-items: stretch; gap: 6px;
      }
      .bl-bd-url-slot-input-row .bl-bd-input { flex: 1 1 auto; min-width: 0; }
      .bl-bd-url-clear {
        flex: 0 0 32px;
        width: 32px; height: 36px;
        background: #FFFFFF; border: 1px solid ${BORDER};
        border-radius: 8px; color: ${MUTED};
        cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: border-color 0.15s, color 0.15s;
      }
      .bl-bd-url-clear:hover:not(:disabled) {
        border-color: #d92626; color: #d92626;
      }
      .bl-bd-url-clear:disabled { opacity: 0.5; cursor: not-allowed; }
      /* Embed wrappers — TikTok / Instagram / YouTube vertical formats
         render at 9:16; YouTube long-form renders at 16:9. Inline
         <video> for raw .mp4 URLs uses the same vertical wrapper. */
      .bl-bd-url-embed {
        position: relative;
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid ${BORDER};
        width: 100%;
      }
      .bl-bd-url-embed-vertical { aspect-ratio: 9 / 16; }
      .bl-bd-url-embed-horizontal { aspect-ratio: 16 / 9; }
      .bl-bd-url-embed > iframe,
      .bl-bd-url-embed > video {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
        border: none; background: #000;
        display: block;
      }
      .bl-bd-url-fallback {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: 11px; color: ${PERIWINKLE_HOVER}; text-decoration: none;
        align-self: flex-start;
      }
      .bl-bd-url-fallback:hover { text-decoration: underline; }

      /* Inline PDF preview iframe — sits above the URL/clear row.
         Tall enough to read without scrolling the page, but capped so
         it doesn't dominate the brief body. */
      .bl-bd-pdf-embed {
        width: 100%;
        height: 540px;
        border: 1px solid ${BORDER};
        border-radius: 10px;
        overflow: hidden;
        background: ${SURFACE};
        margin-bottom: 4px;
      }
      .bl-bd-pdf-embed iframe {
        width: 100%; height: 100%; border: none; display: block;
      }
      @media (max-width: 720px) {
        .bl-bd-pdf-embed { height: 380px; }
      }

      /* Inline assignment banner — pinned at the top of the brief
         detail page when the brief has no project. The /assign-brief
         Softr modal auto-opens on first detection; if dismissed, the
         banner stays so the user can reopen it. */
      .bl-bd-assign-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 16px;
        background: ${TAG_BG};
        border: 1px solid rgba(135, 156, 247, 0.45);
        border-radius: 12px;
        margin-bottom: 12px;
      }
      .bl-bd-assign-banner-icon {
        flex: 0 0 32px;
        width: 32px; height: 32px;
        border-radius: 10px;
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        color: ${PERIWINKLE_HOVER};
        display: inline-flex; align-items: center; justify-content: center;
      }
      .bl-bd-assign-banner-text {
        flex: 1 1 auto; min-width: 0;
        display: flex; flex-direction: column; gap: 1px;
        font-size: 12px; color: ${NAVY_DEEP};
      }
      .bl-bd-assign-banner-text strong {
        font-size: 13px; font-weight: 600;
      }
      .bl-bd-assign-banner-text span { color: ${MUTED}; }
      .bl-bd-assign-banner-btn {
        flex: 0 0 auto;
        height: 34px; padding: 0 14px;
        background: ${PERIWINKLE}; color: #FFFFFF;
        border: none; border-radius: 10px;
        font-size: 12px; font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
      }
      .bl-bd-assign-banner-btn:hover { background: ${PERIWINKLE_HOVER}; }
      @media (max-width: 640px) {
        .bl-bd-assign-banner { flex-wrap: wrap; }
        .bl-bd-assign-banner-btn { width: 100%; }
      }

      /* Responsive */
      @media (max-width: 720px) {
        .bl-bd-fields-grid { grid-template-columns: 1fr; }
        .bl-bd-field.is-full { grid-column: span 1; }
        .bl-bd-thresholds { grid-template-columns: 1fr; }
        .bl-bd-inspo-row { grid-template-columns: 1fr; }
        .bl-bd-storyboard-row { grid-template-columns: 1fr; }
        .bl-bd-section-head { padding: 14px 14px 12px; }
        .bl-bd-section-body { padding: 0 14px 16px; padding-top: 14px; }
        .bl-bd-overview { flex-direction: column; }
        .bl-bd-thumb-wrap { flex: 0 0 auto; width: 100%; height: 180px; }
        .bl-bd-section-title { font-size: 16px; }
        .bl-bd-name { font-size: 18px; }
      }
    `}</style>
  );
}
