// =====================================================================
// Product summary card — Claude-generated 1-2 sentence summary of what
// this brief targets. Editable on click. Visually matches the other
// brief body cards (Personal experiences, Hook, Talking points, etc).
// =====================================================================
function ProductSummaryCard({ value, onSave }) {
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(value || "");
  const [saving, setSaving] = useState(false);
  useEffect(() => { setDraft(value || ""); }, [value]);
  const commit = async () => {
    const next = draft.trim();
    if (next === (value || "").trim()) { setEditing(false); return; }
    setSaving(true);
    try { await onSave(next); } finally { setSaving(false); setEditing(false); }
  };
  const cancel = () => { setDraft(value || ""); setEditing(false); };
  return (
    <div className="bl-bd-brief-card">
      <div className="bl-bd-brief-card-head">
        <h3 className="bl-bd-brief-card-title">About the product / feature</h3>
        <span className="bl-bd-brief-card-helper">A short summary of what this brief is targeting.</span>
      </div>
      {editing ? (
        <div className="bl-bd-context-edit">
          <Textarea
            className="bl-bd-textarea"
            value={draft}
            onChange={(e) => setDraft(e.target.value)}
            rows={3}
            autoFocus
            disabled={saving}
            placeholder="1-2 sentence summary of the product or feature this brief is about."
            onKeyDown={(e) => {
              if (e.key === "Escape") cancel();
              if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) commit();
            }}
          />
          <div className="bl-bd-context-edit-actions">
            <button type="button" className="bl-bd-context-cancel" onClick={cancel} disabled={saving}>
              Cancel
            </button>
            <button type="button" className="bl-bd-context-save" onClick={commit} disabled={saving}>
              {saving ? "Saving…" : "Save"}
            </button>
          </div>
        </div>
      ) : (
        <button
          type="button"
          className={`bl-bd-context-trigger ${value ? "" : "is-empty"}`}
          onClick={() => setEditing(true)}
          title="Click to edit"
        >
          <span className="bl-bd-context-paragraph">
            {value || "Click to add a summary."}
          </span>
          <Pencil size={12} className="bl-bd-context-pencil" />
        </button>
      )}
    </div>
  );
}

// =====================================================================
// PDF row — alternation: URL OR file upload, with inline iframe preview
//
// PDFs render in an embedded iframe so the user doesn't have to leave
// the page to read the brief. Browsers handle application/pdf natively
// via the PDF viewer plugin. Falls back to a plain link if the pasted
// URL clearly isn't a PDF (e.g. someone drops a Notion / Google Doc).
// =====================================================================
function PdfRow({ url, attachment, uploading, onSaveUrl, onClickUpload, onClear }) {
  const [editingUrl, setEditingUrl] = useState(false);
  const [draftUrl, setDraftUrl] = useState(url || "");
  useEffect(() => { setDraftUrl(url || ""); }, [url]);
  const uploadHref = extractThumbUrl(attachment);
  const hasUpload = !!uploadHref;
  const hasUrl = !!(url && String(url).trim());
  // Prefer the uploaded file (always a PDF) over the pasted URL.
  // Pasted URLs only get embedded if we're confident they're PDFs.
  const previewSrc =
    hasUpload ? uploadHref :
    (hasUrl && isPdfUrl(url) ? url : "");
  const externalHref = hasUpload ? uploadHref : (hasUrl ? url : "");
  const linkLabel = hasUpload
    ? "Open in new tab"
    : (hasUrl && url.length > 60 ? url.slice(0, 57) + "…" : (hasUrl ? url : ""));
  return (
    <div className="bl-bd-pdf-row">
      <div className="bl-bd-pdf-label">
        Brief PDF
        <TooltipIcon text="Optional. Drop a PDF version of the brief or paste a link to one. PDFs preview inline so you don't have to leave the page." />
      </div>
      {previewSrc && (
        <div className="bl-bd-pdf-embed">
          <iframe
            src={previewSrc}
            title="Brief PDF preview"
            loading="lazy"
          />
        </div>
      )}
      {hasUpload ? (
        <div className="bl-bd-pdf-filled">
          <a className="bl-bd-pdf-link" href={externalHref} target="_blank" rel="noreferrer">
            <ExternalLink size={13} />
            {linkLabel}
          </a>
          <button
            type="button"
            className="bl-bd-pdf-clear"
            onClick={onClear}
            title="Remove PDF"
          >
            <X size={13} />
          </button>
        </div>
      ) : hasUrl && !editingUrl ? (
        <div className="bl-bd-pdf-filled">
          <a className="bl-bd-pdf-link" href={externalHref} target="_blank" rel="noreferrer">
            <Link2 size={13} />
            {linkLabel}
          </a>
          <button
            type="button"
            className="bl-bd-pdf-edit"
            onClick={() => setEditingUrl(true)}
            title="Edit URL"
          >
            <Pencil size={13} />
          </button>
          <button
            type="button"
            className="bl-bd-pdf-clear"
            onClick={onClear}
            title="Remove PDF link"
          >
            <X size={13} />
          </button>
        </div>
      ) : editingUrl ? (
        <div className="bl-bd-pdf-edit-row">
          <Input
            className="bl-bd-input"
            value={draftUrl}
            onChange={(e) => setDraftUrl(e.target.value)}
            placeholder="https://…"
            autoFocus
            onKeyDown={async (e) => {
              if (e.key === "Enter") { await onSaveUrl(draftUrl.trim()); setEditingUrl(false); }
              if (e.key === "Escape") { setDraftUrl(url || ""); setEditingUrl(false); }
            }}
          />
          <button
            type="button"
            className="bl-bd-pdf-save"
            onClick={async () => { await onSaveUrl(draftUrl.trim()); setEditingUrl(false); }}
          >
            Save
          </button>
        </div>
      ) : (
        <div className="bl-bd-pdf-empty">
          <button
            type="button"
            className="bl-bd-pdf-action"
            onClick={onClickUpload}
            disabled={uploading}
          >
            <UploadIcon size={13} /> {uploading ? "Uploading…" : "Upload PDF"}
          </button>
          <span className="bl-bd-pdf-or">or</span>
          <button
            type="button"
            className="bl-bd-pdf-action"
            onClick={() => setEditingUrl(true)}
          >
            <Link2 size={13} /> Paste a link
          </button>
        </div>
      )}
    </div>
  );
}

