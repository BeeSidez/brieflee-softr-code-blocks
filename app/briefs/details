          placeholder="Paste TikTok / Instagram URL"
          onBlur={commit}
          onKeyDown={(e) => { if (e.key === "Enter") commit(); }}
          disabled={saving}
        />
        {value && (
          <button
            type="button"
            className="bl-bd-url-clear"
            onClick={clear}
            title="Clear URL"
            disabled={saving}
          >
            <X size={12} />
          </button>
        )}
      </div>
      {saving && <span className="bl-bd-saving">Saving…</span>}
      {embed && (
        <div className={`bl-bd-url-embed bl-bd-url-embed-${embed.aspect}`}>
          <iframe
            src={embed.src}
            title={label}
            allow="autoplay; encrypted-media; picture-in-picture; clipboard-write; web-share"
            allowFullScreen
            referrerPolicy="strict-origin-when-cross-origin"
            loading="lazy"
          />
        </div>
      )}
      {directVideo && (
        <div className="bl-bd-url-embed bl-bd-url-embed-vertical">
          <video src={value} controls preload="metadata" />
        </div>
      )}
      {value && !embed && !directVideo && (
        <a
          className="bl-bd-url-fallback"
          href={value}
          target="_blank"
          rel="noreferrer"
        >
          <ExternalLink size={11} />
          Open link
        </a>
      )}
    </div>
  );
}

// =====================================================================
// BRIEF BODY EDITOR — parses description JSON, renders editable cards
// for each sub-section. Saves the whole JSON back on every edit.
// =====================================================================
function BriefBodyEditor({ description, onSave }) {
  const parsed = useMemo(() => {
    if (!description || typeof description !== "string" || !description.trim()) return null;
    return extractJson(description);
  }, [description]);

  // Fallback for non-JSON descriptions: single textarea.
  if (!parsed) {
    return (
      <BriefBodyPlainText
        description={description}
        onSave={(text) => onSave({ description: text })}
      />
    );
  }

  // Pull each known sub-section. Defensive on missing.
  const sections = [
    { key: "personal_experiences", title: "Personal experiences",   helper: "First-person scenarios in the buyer's voice." },
    { key: "hook",                 title: "Hooks",                  helper: "Three opening lines for the first 3 seconds." },
    { key: "talking_points",       title: "Talking points",         helper: "Bullet points to say in the creator's own words." },
    { key: "cta",                  title: "CTAs",                   helper: "Three ways to close the video." },
    { key: "dos",                  title: "Dos",                    helper: "Best practices when filming this format." },
    { key: "donts",                title: "Don'ts",                 helper: "What to avoid. Compliance and brand safety." },
  ];

  const patchKey = async (key, nextArr) => {
    const next = { ...parsed, [key]: nextArr };
    await onSave(next);
  };
  const patchStoryboard = async (nextArr) => {
    const next = { ...parsed, storyboard: nextArr };
    await onSave(next);
  };

  return (
    <div className="bl-bd-brief-body">
      {sections.map(({ key, title, helper }) => (
        <StringArrayCard
          key={key}
          title={title}
          helper={helper}
          items={asArray(parsed[key])}
          onChange={(items) => patchKey(key, items)}
        />
      ))}
      <StoryboardCard
        items={asArray(parsed.storyboard)}
        onChange={patchStoryboard}
      />
    </div>
  );
}

function BriefBodyPlainText({ description, onSave }) {
  const [draft, setDraft] = useState(description || "");
  const [saving, setSaving] = useState(false);
  useEffect(() => { setDraft(description || ""); }, [description]);
  const commit = async () => {
    if ((draft || "") === (description || "")) return;
    setSaving(true);
    try { await onSave(draft); } finally { setSaving(false); }
  };
  return (
    <div className="bl-bd-brief-plain">
      <Textarea
        className="bl-bd-textarea"
        value={draft}
        onChange={(e) => setDraft(e.target.value)}
        rows={12}
        placeholder="Write the brief here, or use the AI route to generate one."
        onBlur={commit}
        disabled={saving}
      />
      {saving && <span className="bl-bd-saving">Saving…</span>}
    </div>
  );
}

function StringArrayCard({ title, helper, items, onChange }) {
  const [busy, setBusy] = useState(false);
  const update = async (next) => {
    setBusy(true);
    try { await onChange(next); } finally { setBusy(false); }
  };
  const addItem = () => update([...(items || []), ""]);
  const editItem = (idx, text) => {
    const next = [...items];
    next[idx] = text;
    update(next);
  };
  const removeItem = (idx) => {
    const next = items.filter((_, i) => i !== idx);
    update(next);
  };
  return (
    <div className="bl-bd-brief-card">
      <div className="bl-bd-brief-card-head">
        <h3 className="bl-bd-brief-card-title">{title}</h3>
        <span className="bl-bd-brief-card-helper">{helper}</span>
      </div>
      <ul className="bl-bd-brief-list">
        {items.map((text, i) => (
          <BriefArrayItem
            key={i}
            value={text}
            onSave={(v) => editItem(i, v)}
            onDelete={() => removeItem(i)}
          />
        ))}
        {items.length === 0 && (
          <li className="bl-bd-brief-empty">Nothing here yet.</li>
        )}
      </ul>
      <button
        type="button"
        className="bl-bd-add-line"
        onClick={addItem}
        disabled={busy}
      >
        <Plus size={12} /> Add line
      </button>
    </div>
  );
}

function BriefArrayItem({ value, onSave, onDelete }) {
  const [draft, setDraft] = useState(value);
  const [saving, setSaving] = useState(false);
  useEffect(() => { setDraft(value); }, [value]);
  const commit = async () => {
    if (draft === value) return;
    setSaving(true);
    try { await onSave(draft); } finally { setSaving(false); }
  };
  return (
    <li className="bl-bd-brief-line">
      <Textarea
        className="bl-bd-textarea bl-bd-textarea-line"
        value={draft}
        onChange={(e) => setDraft(e.target.value)}
        rows={2}
        onBlur={commit}
        disabled={saving}
      />
      <button
        type="button"
        className="bl-bd-line-delete"
        onClick={onDelete}
        title="Delete this line"
        aria-label="Delete"
      >
        <Trash2 size={13} />
      </button>
    </li>
  );
}

function StoryboardCard({ items, onChange }) {
  const [busy, setBusy] = useState(false);
  const update = async (next) => {
    setBusy(true);
    try { await onChange(next); } finally { setBusy(false); }
  };
  const editRow = (idx, key, val) => {
    const next = [...items];
    next[idx] = { ...next[idx], [key]: val };
    update(next);
  };
  const addRow = () => update([...items, { section: "Hook", visual: "", script: "" }]);
  const removeRow = (idx) => update(items.filter((_, i) => i !== idx));
  return (
    <div className="bl-bd-brief-card">
      <div className="bl-bd-brief-card-head">
        <h3 className="bl-bd-brief-card-title">Storyboard</h3>
        <span className="bl-bd-brief-card-helper">Shot by shot. Each row tagged by scene type.</span>
      </div>
      <div className="bl-bd-storyboard">
        {items.map((row, i) => (
          <StoryboardRow
            key={i}
            row={row}
            onSection={(v) => editRow(i, "section", v)}
            onVisual={(v) => editRow(i, "visual", v)}
            onScript={(v) => editRow(i, "script", v)}
            onDelete={() => removeRow(i)}
          />
        ))}
        {items.length === 0 && (
          <div className="bl-bd-brief-empty">No shots yet.</div>
        )}
      </div>
      <button
        type="button"
        className="bl-bd-add-line"
        onClick={addRow}
        disabled={busy}
      >
        <Plus size={12} /> Add shot
      </button>
    </div>
  );
}

function StoryboardRow({ row, onSection, onVisual, onScript, onDelete }) {
  const [visualDraft, setVisualDraft] = useState(row.visual || "");
  const [scriptDraft, setScriptDraft] = useState(row.script || "");
  useEffect(() => { setVisualDraft(row.visual || ""); }, [row.visual]);
  useEffect(() => { setScriptDraft(row.script || ""); }, [row.script]);
  return (
    <div className="bl-bd-storyboard-row">
      <select
        className="bl-bd-select bl-bd-storyboard-section"
        value={row.section || "Hook"}
        onChange={(e) => onSection(e.target.value)}
      >
        {STORYBOARD_SECTIONS.map((s) => (
          <option key={s} value={s}>{s}</option>
        ))}
      </select>
      <Textarea
        className="bl-bd-textarea bl-bd-storyboard-visual"
        value={visualDraft}
        onChange={(e) => setVisualDraft(e.target.value)}
        onBlur={() => visualDraft !== row.visual && onVisual(visualDraft)}
        rows={2}
        placeholder="Visual direction"
      />
      <Input
        className="bl-bd-input bl-bd-storyboard-script"
        value={scriptDraft}
        onChange={(e) => setScriptDraft(e.target.value)}
        onBlur={() => scriptDraft !== row.script && onScript(scriptDraft)}
        placeholder="Script line"
      />
      <button
        type="button"
        className="bl-bd-line-delete"
        onClick={onDelete}
        title="Delete this shot"
        aria-label="Delete"
      >
        <Trash2 size={13} />
      </button>
    </div>
  );
}

