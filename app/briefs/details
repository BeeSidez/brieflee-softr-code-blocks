  const user = useCurrentUser();
  const briefId = useCurrentRecordId() || "";
  const { data: record, refetch } = useRecord({ recordId: briefId, select });
  const updateRecord = useRecordUpdate({ fields: updateFields });
  const upload = useUpload();

  const f = record?.fields || {};
  const briefName       = unwrap(f.name) || "Untitled brief";
  const briefStatus     = statusFor(record);
  const isPrivate       = f.private_mode === true;
  const generatedId     = (f.generated && (f.generated.id || f.generated)) || "";
  const generatedLabel  = GENERATED_LABEL[generatedId] || "";
  const firstFormatLabel = selectLabel(f.first_format) || selectLabel(f.format);
  const thumbUrl        = resolveBriefThumb(f);

  // ─── Generic field-save helper ────────────────────────────
  // Single entry point for every per-field write. Wraps the mutate
  // with optimistic refetch + toast on error.
  const saveField = async (patch, label = "") => {
    try {
      await updateRecord.mutateAsync({ recordId: briefId, fields: patch });
      await refetch?.();
    } catch (e) {
      console.error(`${label} save failed:`, e);
      toast.error(`Couldn't save${label ? ` ${label}` : ""}`, { description: e?.message });
    }
  };

  // ─── Project assignment (Softr /assign-brief modal) ──────
  // Vibe Code can't auto-map a project linked record on create, so
  // briefs created via the chat land here unassigned. We open Bev's
  // Softr-native /assign-brief page in a modal, which is sourced
  // from projects so its form can write `projects: [{id}]` straight
  // onto the brief via the project linked-record field. The page
  // postMessages `brieflee:brief-assigned` back on success.
  //
  // Behaviour:
  //   - Brief loads with no project → modal opens automatically.
  //   - User picks + assigns → page posts back → brief refetches →
  //     modal closes (Softr) and the page becomes editable.
  //   - User dismisses without assigning → an inline banner stays
  //     pinned at the top with a button to reopen the modal, so we
  //     never trap them but also never let them edit unassigned.
  const isUnassigned = useMemo(() => {
    if (!record) return false; // wait for brief to load before deciding
    const raw = f.projects;
    if (!raw) return true;
    if (Array.isArray(raw)) return raw.length === 0;
    return false;
  }, [record, f.projects]);
  const openAssignBrief = useCallback(() => {
    if (typeof window === "undefined" || !briefId) return;
    const url = `/assign-brief?recordId=${encodeURIComponent(briefId)}`;
    if (typeof window.openSwModal === "function") {
      window.openSwModal(url, "md");
    } else {
      window.location.href = url;
    }
  }, [briefId]);
  // Auto-open the picker the first time we detect an unassigned brief
  // on this page load. Tracked via a ref so we don't reopen on every
  // refetch — once the user dismisses the modal, the banner takes over.
  const assignOpenedRef = useRef(false);
  useEffect(() => {
    if (!isUnassigned || assignOpenedRef.current) return;
    assignOpenedRef.current = true;
    openAssignBrief();
  }, [isUnassigned, openAssignBrief]);
  // Listen for picker success pings.
  //   brieflee:brief-assigned → refetch (assignment modal closed).
  //   brieflee:inspo-pick     → write the picked review to
  //                             example / example_2 / example_3.
  //   brieflee:swipe-pick     → write the picked video to
  //                             videos / videos_2 / videos_3.
  // Slot is 1-indexed from this page (matches what openInspoPicker /
  // openSwipePicker pass), so slot N → field at index N-1.
  useEffect(() => {
    if (typeof window === "undefined" || !briefId) return;
    const INSPO_SLOT_FIELDS = ["example", "example_2", "example_3"];
    const SWIPE_SLOT_FIELDS = ["videos", "videos_2", "videos_3"];
    const onMessage = async (event) => {
      const data = event?.data;
      const t = data?.type || data;
      if (t === "brieflee:brief-assigned") {
        refetch?.();
        return;
      }
      if (t === "brieflee:inspo-pick") {
        const idx = Number(data?.slot) - 1;
        const fieldAlias = INSPO_SLOT_FIELDS[idx];
        const reviewId = data?.review?.id;
        if (!fieldAlias || !reviewId) return;
        try {
          await updateRecord.mutateAsync({
            recordId: briefId,
            fields: { [fieldAlias]: [{ id: reviewId }] },
          });
          await refetch?.();
          toast.success("Review pick saved");
        } catch (e) {
          console.error("Inspo pick save failed:", e);
          toast.error("Couldn't save pick", { description: e?.message });
        }
        return;
      }
      if (t === "brieflee:swipe-pick") {
        const idx = Number(data?.slot) - 1;
        const fieldAlias = SWIPE_SLOT_FIELDS[idx];
        const videoId = data?.video?.id;
        if (!fieldAlias || !videoId) return;
        try {
          await updateRecord.mutateAsync({
            recordId: briefId,
            fields: { [fieldAlias]: [{ id: videoId }] },
          });
          await refetch?.();
          toast.success("Swipe video saved");
        } catch (e) {
          console.error("Swipe pick save failed:", e);
          toast.error("Couldn't save pick", { description: e?.message });
        }
        return;
      }
    };
    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, [refetch, briefId, updateRecord]);

  // ─── Collapsible section state ────────────────────────────
  // Initial state respects sessionStorage if the user has toggled
  // anything on this brief. Otherwise empty sections auto-collapse so
  // the page opens focused on the parts that actually have content.
  const STORAGE_KEY = `bl-brief-details-collapsed:${briefId || "anon"}`;
  const [collapsed, setCollapsed] = useState({ context: true });
  const initRef = useRef(false);
  useEffect(() => {
    if (initRef.current) return;
    if (typeof window === "undefined") return;
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (raw) {
        setCollapsed(JSON.parse(raw));
        initRef.current = true;
        return;
      }
    } catch {}
    // No saved state — wait for record to load, then auto-collapse empties.
    if (!record) return;
    setCollapsed({
      context:     true,
      brief:       isSectionEmpty("brief",       record.fields),
      inspiration: isSectionEmpty("inspiration", record.fields),
      details:     isSectionEmpty("details",     record.fields),
      qa:          isSectionEmpty("qa",          record.fields),
    });
    initRef.current = true;
  }, [STORAGE_KEY, record]);
  useEffect(() => {
    if (typeof window === "undefined" || !initRef.current) return;
    try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(collapsed)); } catch {}
  }, [collapsed, STORAGE_KEY]);
  const toggle = (key) => setCollapsed((c) => ({ ...c, [key]: !c[key] }));

  // ─── Inline name edit ────────────────────────────────────
  const [nameDraft, setNameDraft] = useState(briefName);
  const [editingName, setEditingName] = useState(false);
  const [nameSaving, setNameSaving] = useState(false);
  useEffect(() => { setNameDraft(briefName); }, [briefName]);
  const commitName = async () => {
    const next = nameDraft.trim();
    if (!next || next === briefName) { setEditingName(false); return; }
    setNameSaving(true);
    await saveField({ name: next }, "name");
    setEditingName(false);
    setNameSaving(false);
  };

  // ─── Overview quick-edits ────────────────────────────────
  const [statusSaving, setStatusSaving] = useState(false);
  const commitStatus = async (optionId) => {
    if (!optionId || optionId === briefStatus?.id) return;
    const opt = STATUS_OPTIONS.find((o) => o.id === optionId);
    if (!opt) return;
    setStatusSaving(true);
    await saveField({ status: { id: opt.id, label: opt.label } }, "status");
    setStatusSaving(false);
  };
  const [privacySaving, setPrivacySaving] = useState(false);
  const togglePrivacy = async () => {
    // Keep Seo:index in lockstep with public/private. A private brief
    // shouldn't be SEO-indexed; making one public flips it on, making
    // it private flips it off. The user can still override Seo:index
    // independently in Softr Tables if they really need the edge case.
    const nextPrivate = !isPrivate;
    setPrivacySaving(true);
    await saveField({
      private_mode: nextPrivate,
      seo_index:    !nextPrivate,
    }, "privacy");
    setPrivacySaving(false);
  };
  const [reviewModeSaving, setReviewModeSaving] = useState(false);
  const reviewModeLabel = selectLabel(f.ai_mode) || "";
  const commitReviewMode = async (label) => {
    if (label === reviewModeLabel) return;
    const opt = AI_MODE_OPTIONS.find((o) => o.label === label);
    if (!opt) return;
    setReviewModeSaving(true);
    await saveField({ ai_mode: { id: opt.id, label: opt.label } }, "review mode");
    setReviewModeSaving(false);
  };

  // ─── Thumbnail upload ────────────────────────────────────
  const thumbFileRef = useRef(null);
  const [thumbSaving, setThumbSaving] = useState(false);
  const handleThumbnailFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setThumbSaving(true);
    try {
      const uploaded = await upload.mutateAsync(file);
      const value = Array.isArray(uploaded) ? uploaded : [uploaded];
      await saveField({ thumbnail: value }, "thumbnail");
      toast.success("Thumbnail updated");
    } catch (err) {
      console.error("Thumbnail upload failed:", err);
      toast.error("Couldn't upload thumbnail", { description: err?.message });
    } finally {
      setThumbSaving(false);
      if (thumbFileRef.current) thumbFileRef.current.value = "";
    }
  };

  // ─── Slug auto-generation ────────────────────────────────
  // Seo:slug is now a FORMULA on the briefs table — kebab-case of
  // the brief name. No JS auto-generation, no manual editor. If you
  // need a custom slug per brief, add a SINGLE_LINE_TEXT override
  // field and update the formula to prefer it.
  const existingSlug = typeof f.slug === "string" ? f.slug.trim() : "";

  // ─── Share popover ───────────────────────────────────────
  // Tabbed: Team (editor URL for collaborators) + Creator (live
  // SEO URL for submitters). Each tab shows the right link with copy
  // + open actions, plus access toggle and Add people on the
  // Creator tab (which is the audience that needs invites).
  const [shareOpen, setShareOpen] = useState(false);
  const creatorUrl = creatorUrlFor(existingSlug || generateSlug(unwrap(f.name), briefId));
  const teamUrl    = teamUrlFor(briefId);

  // ─── Publish ─────────────────────────────────────────────
  const [publishSaving, setPublishSaving] = useState(false);
  const publish = async () => {
    if (briefStatus?.label === "Active") return;
    const active = STATUS_OPTIONS.find((o) => o.label === "Active");
    if (!active) return;
    setPublishSaving(true);
    await saveField({ status: { id: active.id, label: active.label } }, "publish");
    toast.success("Brief is live");
    setPublishSaving(false);
  };

  // ─── Brief body (description JSON) ───────────────────────
  const saveDescription = async (nextJson) => {
    await saveField({ description: JSON.stringify(nextJson) }, "brief body");
  };

  // ─── Brief document (URL or PDF upload) ──────────────────
  const pdfFileRef = useRef(null);
  const [pdfSaving, setPdfSaving] = useState(false);
  const handlePdfFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setPdfSaving(true);
    try {
      const uploaded = await upload.mutateAsync(file);
      const value = Array.isArray(uploaded) ? uploaded : [uploaded];
      await saveField({ attachment: value }, "PDF");
      toast.success("PDF uploaded");
    } catch (err) {
      console.error("PDF upload failed:", err);
      toast.error("Couldn't upload PDF", { description: err?.message });
    } finally {
      setPdfSaving(false);
      if (pdfFileRef.current) pdfFileRef.current.value = "";
    }
  };

  // ─── Details section: SELECT field commits ───────────────
  const commitSelect = async (fieldAlias, value) => {
    // value is a single { id, label } or null
    if (value == null) {
      await saveField({ [fieldAlias]: null }, FIELD_LABELS[fieldAlias] || fieldAlias);
    } else {
      await saveField({ [fieldAlias]: { id: value.id, label: value.label } }, FIELD_LABELS[fieldAlias] || fieldAlias);
    }
  };
  const commitMultiSelect = async (fieldAlias, options) => {
    // options is an array of { id, label }
    await saveField({ [fieldAlias]: options.map((o) => ({ id: o.id, label: o.label })) }, FIELD_LABELS[fieldAlias] || fieldAlias);
  };
  const commitDate = async (fieldAlias, isoString) => {
    await saveField({ [fieldAlias]: isoString }, FIELD_LABELS[fieldAlias] || fieldAlias);
  };
  const commitText = async (fieldAlias, text) => {
    await saveField({ [fieldAlias]: text }, fieldAlias);
  };

  // ─── Render ───────────────────────────────────────────────
  return (
    <>
      <Style />

      <div className="bl-bd container mx-auto px-4 w-full">

        {/* Inline banner shown when the brief has no project linked.
            The picker modal auto-opens on page load; if the user
            dismisses it, this banner stays visible until they pick
            a project. Clicking reopens the modal. */}
        {isUnassigned && (
          <div className="bl-bd-assign-banner" role="status">
            <div className="bl-bd-assign-banner-icon" aria-hidden="true">
              <Inbox size={18} strokeWidth={1.75} />
            </div>
            <div className="bl-bd-assign-banner-text">
              <strong>This brief needs a project.</strong>
              <span>Assign it to one of your projects to start editing.</span>
            </div>
            <button
              type="button"
              className="bl-bd-assign-banner-btn"
              onClick={openAssignBrief}
            >
              Assign to a project
            </button>
          </div>
        )}


        {/* ============ 1. Overview ============ */}
        <SectionCard
          title={SECTION_INTRO.overview[0]}
          subtitle={SECTION_INTRO.overview[1]}
          collapsed={!!collapsed.overview}
          onToggle={() => toggle("overview")}
          right={
            <div className="bl-bd-header-actions">
              <button
                type="button"
                onClick={() => openCreatorPreview(briefId)}
                className="bl-bd-preview-btn"
                disabled={!briefId}
                title="See the creator's view of this brief"
              >
                <Eye size={14} />
                Preview
              </button>
              <SharePopover
                briefId={briefId}
                creatorUrl={creatorUrl}
                teamUrl={teamUrl}
                isPrivate={isPrivate}
                privacySaving={privacySaving}
                onTogglePrivacy={togglePrivacy}
                onAddPeople={() => openBriefInvite(briefId)}
                open={shareOpen}
                setOpen={setShareOpen}
              />
              <Button
                onClick={publish}
                disabled={publishSaving || briefStatus?.label === "Active"}
                style={{ backgroundColor: PERIWINKLE, color: "#fff" }}
                className="bl-bd-publish-btn"
              >
                {publishSaving ? "Publishing…" : briefStatus?.label === "Active" ? "Published" : "Publish"}
              </Button>
            </div>
          }
        >
          <div className="bl-bd-overview">
            <div className="bl-bd-thumb-wrap">
              <img src={thumbUrl} alt={briefName} className="bl-bd-thumb" draggable={false} />
              <input
                ref={thumbFileRef}
                type="file"
                accept="image/*"
                onChange={handleThumbnailFile}
                style={{ display: "none" }}
              />
              <button
                type="button"
                className="bl-bd-thumb-edit"
                onClick={() => thumbFileRef.current?.click()}
                disabled={thumbSaving}
                aria-label="Replace thumbnail"
                title="Replace thumbnail"
              >
                {thumbSaving ? "…" : <UploadIcon size={14} />}
              </button>
            </div>

            <div className="bl-bd-identity">
              <div className="bl-bd-name-row">
                {editingName ? (
                  <>
                    <Input
                      value={nameDraft}
                      onChange={(e) => setNameDraft(e.target.value)}
                      autoFocus
                      disabled={nameSaving}
                      onKeyDown={(e) => {
                        if (e.key === "Enter") commitName();
                        if (e.key === "Escape") { setNameDraft(briefName); setEditingName(false); }
                      }}
                      onBlur={commitName}
                      className="bl-bd-name-input"
                    />
                    {nameSaving && <span className="bl-bd-saving">Saving…</span>}
                  </>
                ) : (
                  <button
                    type="button"
                    className="bl-bd-name"
                    onClick={() => setEditingName(true)}
                    title="Click to rename"
                  >
                    {briefName}
                    <Pencil size={13} className="bl-bd-name-pencil" />
                  </button>
                )}
              </div>

              <div className="bl-bd-tag-row">
                {firstFormatLabel && <span className="bl-bd-tag">{firstFormatLabel}</span>}
                <StatusPicker
                  value={briefStatus?.id || ""}
                  saving={statusSaving}
                  onChange={commitStatus}
                />
                <button
                  type="button"
                  className={`bl-bd-priv ${isPrivate ? "is-private" : "is-public"}`}
                  onClick={togglePrivacy}
                  disabled={privacySaving}
                  title="Click to toggle privacy"
                >
                  {isPrivate ? <Lock size={11} /> : <LockOpen size={11} />}
                  {isPrivate ? "Private" : "Public"}
                </button>
                {generatedLabel && (
                  <span className="bl-bd-gen-badge" title={`Generated via ${generatedLabel}`}>
                    {generatedLabel}
                  </span>
                )}
              </div>

              <CreatorRow
                name={typeof f.creator_name === "string" ? f.creator_name : ""}
                email={typeof f.creator_email === "string" ? f.creator_email : ""}
                onSave={async ({ name, email }) => {
                  const patch = {};
                  if (typeof name === "string")  patch.creator_name = name;
                  if (typeof email === "string") patch.creator_email = email;
                  await saveField(patch, "creator");
                }}
              />

              <div className="bl-bd-review-row">
                <span className="bl-bd-row-label">
                  Review Mode
                  <TooltipIcon text={TOOLTIPS.ai_mode} />
                </span>
                <div className="bl-bd-segmented">
                  {AI_MODE_OPTIONS.map((o) => (
                    <button
                      key={o.id}
                      type="button"
                      className={`bl-bd-segmented-btn ${o.label === reviewModeLabel ? "is-active" : ""}`}
                      onClick={() => commitReviewMode(o.label)}
                      disabled={reviewModeSaving}
                    >
                      {o.label}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </SectionCard>

        {/* ============ 2. Brief body ============ */}
        <SectionCard
          title={SECTION_INTRO.brief[0]}
          subtitle={SECTION_INTRO.brief[1]}
          collapsed={!!collapsed.brief}
          onToggle={() => toggle("brief")}
        >
          <div className="bl-bd-brief-stack">
            <BrandBioCard value={extractBrandBio(f.brand_blueprint)} />
            <ProductSummaryCard
              value={typeof f.product_feature_description === "string" ? f.product_feature_description : ""}
              onSave={(v) => commitText("product_feature_description", v)}
            />
            <BriefBodyEditor
              description={f.description}
              onSave={saveDescription}
            />
          </div>
          <PdfRow
            url={f.brief_document_url}
            attachment={f.attachment}
            uploading={pdfSaving}
            onSaveUrl={(url) => commitText("brief_document_url", url)}
            onClickUpload={() => pdfFileRef.current?.click()}
            onClear={async () => {
              if (f.attachment) await saveField({ attachment: null }, "PDF");
              if (f.brief_document_url) await saveField({ brief_document_url: "" }, "PDF link");
            }}
          />
          <input
            ref={pdfFileRef}
            type="file"
            accept="application/pdf"
            onChange={handlePdfFile}
            style={{ display: "none" }}
          />
        </SectionCard>

        {/* ============ 3. Inspiration ============ */}
        <SectionCard
          title={SECTION_INTRO.inspiration[0]}
          subtitle={SECTION_INTRO.inspiration[1]}
          collapsed={!!collapsed.inspiration}
          onToggle={() => toggle("inspiration")}
        >
          <div className="bl-bd-inspo">
            <div className="bl-bd-inspo-group">
              <div className="bl-bd-inspo-label">Brieflee examples (review picks)</div>
              <div className="bl-bd-inspo-row">
                {[
                  { linked: "example",   videoLookup: "example_1_video_url" },
                  { linked: "example_2", videoLookup: "example_2_video_url" },
                  { linked: "example_3", videoLookup: "example_3_video_url" },
                ].map(({ linked, videoLookup }, i) => (
                  <InspoReviewSlot
                    key={linked}
                    label={`Example ${i + 1}`}
                    value={f[linked]}
                    videoUrl={resolveLookupVideoUrl(f[videoLookup])}
                    onOpen={() => openInspoPicker(briefId, i + 1)}
                  />
                ))}
              </div>
            </div>
            <div className="bl-bd-inspo-group">
              <div className="bl-bd-inspo-label">Swipe file picks (videos)</div>
              <div className="bl-bd-inspo-row">
                {[
                  { linked: "videos",   videoLookup: "swipe_1_video_url" },
                  { linked: "videos_2", videoLookup: "swipe_2_video_url" },
                  { linked: "videos_3", videoLookup: "swipe_3_video_url" },
                ].map(({ linked, videoLookup }, i) => (
                  <InspoReviewSlot
                    key={linked}
                    label={`Swipe ${i + 1}`}
                    value={f[linked]}
                    videoUrl={resolveLookupVideoUrl(f[videoLookup])}
                    onOpen={() => openSwipePicker(briefId, i + 1)}
                  />
                ))}
              </div>
            </div>
            <div className="bl-bd-inspo-group">
              <div className="bl-bd-inspo-label">External URLs (TikTok, Instagram, etc.)</div>
              <div className="bl-bd-inspo-row">
                {[
                  { alias: "example_video_1", label: "URL 1" },
                  { alias: "example_video_2", label: "URL 2" },
                  { alias: "example_video_3", label: "URL 3" },
                ].map(({ alias, label }) => (
                  <UrlSlot
                    key={alias}
                    label={label}
                    value={typeof f[alias] === "string" ? f[alias] : ""}
                    onSave={(v) => commitText(alias, v)}
                  />
                ))}
              </div>
            </div>
          </div>
        </SectionCard>

        {/* ============ 4. Details ============ */}
        <SectionCard
          title={SECTION_INTRO.details[0]}
          subtitle={SECTION_INTRO.details[1]}
          collapsed={!!collapsed.details}
          onToggle={() => toggle("details")}
        >
          <div className="bl-bd-fields-grid">
            <MultiSelectField
              label={FIELD_LABELS.platform}
              tooltip={TOOLTIPS.platform}
              options={PLATFORM_OPTIONS}
              value={asArrayIds(f.platform)}
              onChange={(ids) => commitMultiSelect("platform", PLATFORM_OPTIONS.filter((o) => ids.includes(o.id)))}
            />
            <SelectField
              label="Video length"
              tooltip="Target length for the finished video."
              options={DURATION_OPTIONS}
              valueId={f.duration?.id || ""}
              onChange={(opt) => commitSelect("duration", opt)}
              suffix={
                <SelectField
                  inline
                  options={DURATION_THRESHOLD_OPTIONS}
                  valueId={f.duration_threshold?.id || ""}
                  onChange={(opt) => commitSelect("duration_threshold", opt)}
                />
              }
            />
            <SelectField
              label={FIELD_LABELS.aspect_ratio}
              tooltip={TOOLTIPS.aspect_ratio}
              options={ASPECT_RATIO_OPTIONS}
              valueId={f.aspect_ratio?.id || ""}
              onChange={(opt) => commitSelect("aspect_ratio", opt)}
            />
            <SelectField
              label={FIELD_LABELS.content_delivery}
              tooltip={TOOLTIPS.content_delivery}
              options={CONTENT_DELIVERY_OPTIONS}
              valueId={f.content_delivery?.id || ""}
              onChange={(opt) => commitSelect("content_delivery", opt)}
            />
            <MultiSelectField
              label={FIELD_LABELS.content_type}
              tooltip={TOOLTIPS.content_type}
              options={CONTENT_TYPE_OPTIONS}
              value={asArrayIds(f.content_type)}
              onChange={(ids) => commitMultiSelect("content_type", CONTENT_TYPE_OPTIONS.filter((o) => ids.includes(o.id)))}
            />
            <DateTimeField
              label={FIELD_LABELS.submission_open_date}
              tooltip={TOOLTIPS.submission_open_date}
              value={f.submission_open_date || ""}
              onSave={(iso) => commitDate("submission_open_date", iso)}
            />
            <DateTimeField
              label={FIELD_LABELS.submission_close_date}
              tooltip={TOOLTIPS.submission_close_date}
              value={f.submission_close_date || ""}
              onSave={(iso) => commitDate("submission_close_date", iso)}
            />
          </div>
        </SectionCard>

        {/* ============ 5. Quality Assurance ============ */}
        <SectionCard
          title={SECTION_INTRO.qa[0]}
          subtitle={SECTION_INTRO.qa[1]}
          collapsed={!!collapsed.qa}
          onToggle={() => toggle("qa")}
        >
          <ReviewAgentsField
            tooltip={TOOLTIPS.qa_checklist}
            options={QA_AGENT_OPTIONS}
            value={asArrayIds(f.qa_checklist)}
            onChange={(ids) => commitMultiSelect("qa_checklist", QA_AGENT_OPTIONS.filter((o) => ids.includes(o.id)))}
          />
          <div className="bl-bd-thresholds">
            {THRESHOLD_FIELDS.map(({ alias }) => (
              <SelectField
                key={alias}
                label={FIELD_LABELS[alias]}
                tooltip={TOOLTIPS[alias]}
                options={THRESHOLD_OPTIONS[alias]}
                valueId={f[alias]?.id || ""}
                onChange={(opt) => commitSelect(alias, opt)}
              />
            ))}
          </div>
        </SectionCard>

        {/* ============ 6. Brief context (collapsed by default) ============ */}
        <SectionCard
          title={SECTION_INTRO.context[0]}
          subtitle={SECTION_INTRO.context[1]}
          collapsed={!!collapsed.context}
          onToggle={() => toggle("context")}
        >
          <div className="bl-bd-fields-grid">
            <SelectField
              label="Filmer"
              tooltip="Who's filming this brief — UGC Creator, Influencer, Founder, Customer, or Employee."
              options={CREATOR_TYPE_OPTIONS}
              valueId={f.creator_type?.id || ""}
              onChange={(opt) => commitSelect("creator_type", opt)}
            />
            <SelectField
              label="Channel"
              tooltip="Paid runs ad-style with disclosures. Organic feels native to the creator's feed."
              options={CHANNEL_OPTIONS}
              valueId={f.channel?.id || ""}
              onChange={(opt) => commitSelect("channel", opt)}
            />
            <SelectField
              label="Awareness stage"
              tooltip="Where the viewer is in their journey — affects how the hook is written."
              options={AWARENESS_OPTIONS}
              valueId={f.awareness?.id || ""}
              onChange={(opt) => commitSelect("awareness", opt)}
            />
            <SelectField
              label="Angle"
              tooltip="The through-line that ties the hook, talking points, and CTA together."
              options={ANGLE_OPTIONS}
              valueId={f.angle?.id || ""}
              onChange={(opt) => commitSelect("angle", opt)}
            />
            <TextSlot
              label="Product URL"
