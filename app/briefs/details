// kebab-case the name + append a 6-char briefId suffix for uniqueness.
// Same shape as the backfill script that ran when the slug field was added.
function generateSlug(name, briefId) {
  if (!briefId) return "";
  const base = String(name || "untitled")
    .toLowerCase()
    .replace(/['‘’“”]/g, "")
    .replace(/[^\w\s-]/g, " ")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 60);
  const suffix = briefId.slice(-6).toLowerCase();
  return base ? `${base}-${suffix}` : suffix;
}
async function copyToClipboard(text) {
  if (!text) return false;
  try {
    if (navigator?.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.left = "-9999px";
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
    return true;
  } catch (e) {
    console.error("Copy failed:", e);
    return false;
  }
}
// Softr's openSwModal strips query strings on modals, so the picker
// can't read `?slot=` reliably from the URL. We persist the context
// to sessionStorage first; the picker reads sessionStorage primarily
// and falls back to URL. Same convention used by /swipe-picker and
// /briefs/inspo-picker today.
function persistPickerCtx(storageKey, slot) {
  if (typeof window === "undefined") return;
  try {
    sessionStorage.setItem(storageKey, JSON.stringify({ slot }));
  } catch { /* sessionStorage disabled */ }
}
