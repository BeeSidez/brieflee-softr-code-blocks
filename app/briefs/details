  if (typeof fields.image_url === "string" && fields.image_url) return fields.image_url;
  const proj = extractThumbUrl(fields.project_thumbnail);
  if (proj) return proj;
  const logoFile = extractThumbUrl(fields.logo_file);
  if (logoFile) return logoFile;
  return DEFAULT_THUMB;
}
