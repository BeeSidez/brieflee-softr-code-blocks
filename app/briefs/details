function SharePopover({
  briefId, creatorUrl, teamUrl, isPrivate, privacySaving,
  onTogglePrivacy, onAddPeople, open, setOpen,
}) {
  const wrapRef = useRef(null);
  const [tab, setTab] = useState("creator"); // 'creator' | 'team'
  useEffect(() => {
    if (!open) return;
    const onDown = (e) => {
      if (wrapRef.current && !wrapRef.current.contains(e.target)) setOpen(false);
    };
    document.addEventListener("mousedown", onDown);
    return () => document.removeEventListener("mousedown", onDown);
  }, [open, setOpen]);

  const isCreator = tab === "creator";
  const url = isCreator ? creatorUrl : teamUrl;
  const copy = async () => {
    if (!url) return;
    const ok = await copyToClipboard(url);
    if (ok) toast.success("Link copied");
    else toast.error("Couldn't copy link", { description: url });
  };
  const openInNewTab = () => {
    if (!url) return;
    window.open(url, "_blank", "noopener,noreferrer");
  };

  return (
    <div className="bl-bd-share-wrap" ref={wrapRef}>
      <button
        type="button"
        onClick={() => setOpen((c) => !c)}
        className="bl-bd-preview-btn"
        disabled={!briefId}
        title="Share this brief"
      >
        <Share2 size={14} />
        Share
      </button>
      {open && (
        <div
          className="bl-bd-share-panel"
          role="dialog"
          aria-label="Share brief"
          // Stop native mousedown bubbling — otherwise the document-
          // level "close on outside click" listener fires before the
          // inner button's React onClick runs, the panel unmounts
          // mid-click, and the click never lands on the button.
          // This is the same fix browsers ship for dropdowns, etc.
          onMouseDown={(e) => e.stopPropagation()}
        >
          {/* Tabs */}
          <div className="bl-bd-share-tabs">
            <button
              type="button"
              className={`bl-bd-share-tab ${isCreator ? "is-active" : ""}`}
              onClick={() => setTab("creator")}
            >
              Creator
            </button>
            <button
              type="button"
              className={`bl-bd-share-tab ${!isCreator ? "is-active" : ""}`}
              onClick={() => setTab("team")}
            >
              Team
            </button>
          </div>

          {/* Description + link */}
          <div className="bl-bd-share-title">
            {isCreator ? "Public brief link" : "Editor link"}
          </div>
          <div className="bl-bd-share-helper">
            {isCreator
              ? "For people who'll film and submit. SEO-friendly, public unless you set it to Private."
              : "For team members on this account. They land in the editable view and can change anything."}
          </div>
          <div className="bl-bd-share-link-row">
            <input
              type="text"
              readOnly
              value={url || ""}
              className="bl-bd-share-link-input"
              onClick={(e) => e.target.select()}
            />
            <button
              type="button"
              className="bl-bd-share-icon-btn"
              onClick={copy}
              title="Copy link"
              disabled={!url}
            >
              <Copy size={13} />
            </button>
            <button
              type="button"
              className="bl-bd-share-icon-btn"
              onClick={openInNewTab}
              title="Open in new tab"
              disabled={!url}
            >
              <ExternalLink size={13} />
            </button>
          </div>

          {/* Creator-tab-only: access toggle + add-people */}
          {isCreator && (
            <>
              <div className="bl-bd-share-divider" />
              <div className="bl-bd-share-row">
                <div className="bl-bd-share-row-title">
                  <span>Access</span>
                  <span className="bl-bd-share-row-helper">
                    {isPrivate
                      ? "Only people you add can open the link."
                      : "Anyone with the link can open the brief."}
                  </span>
                </div>
                <div className="bl-bd-segmented">
                  <button
                    type="button"
                    className={`bl-bd-segmented-btn ${!isPrivate ? "is-active" : ""}`}
                    onClick={() => { if (isPrivate) onTogglePrivacy(); }}
                    disabled={privacySaving}
                  >
                    Public
                  </button>
                  <button
                    type="button"
                    className={`bl-bd-segmented-btn ${isPrivate ? "is-active" : ""}`}
                    onClick={() => { if (!isPrivate) onTogglePrivacy(); }}
                    disabled={privacySaving}
                  >
                    Private
                  </button>
                </div>
              </div>
              <div className="bl-bd-share-divider" />
              <button
                type="button"
                className="bl-bd-share-invite-btn"
                onClick={() => { onAddPeople(); setOpen(false); }}
                disabled={!briefId}
              >
                <UserPlus size={14} />
                Add people to this brief
              </button>
            </>
          )}

          {/* Team-tab-only: helper note about access */}
          {!isCreator && (
            <div className="bl-bd-share-team-note">
              Team members already have access. They'll find this brief in their dashboard — this is just the direct link.
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function CreatorRow({ name, email, onSave }) {
  const [editing, setEditing] = useState(false);
  const [nameDraft, setNameDraft] = useState(name || "");
  const [emailDraft, setEmailDraft] = useState(email || "");
  const [saving, setSaving] = useState(false);
  useEffect(() => { setNameDraft(name || ""); }, [name]);
  useEffect(() => { setEmailDraft(email || ""); }, [email]);

  const commit = async () => {
    const nextName = nameDraft.trim();
    const nextEmail = emailDraft.trim();
    if (nextName === (name || "") && nextEmail === (email || "")) {
      setEditing(false);
      return;
    }
    setSaving(true);
    try { await onSave({ name: nextName, email: nextEmail }); }
    finally { setSaving(false); setEditing(false); }
  };
  const cancel = () => {
    setNameDraft(name || "");
    setEmailDraft(email || "");
    setEditing(false);
  };

  if (editing) {
    return (
      <div className="bl-bd-creator-row bl-bd-creator-editing">
        <Input
          className="bl-bd-input bl-bd-creator-name-input"
          value={nameDraft}
          onChange={(e) => setNameDraft(e.target.value)}
          placeholder="Creator name"
          autoFocus
        />
        <Input
          className="bl-bd-input bl-bd-creator-email-input"
          value={emailDraft}
          onChange={(e) => setEmailDraft(e.target.value)}
          placeholder="email@brand.com"
          type="email"
          onKeyDown={(e) => {
            if (e.key === "Enter") commit();
            if (e.key === "Escape") cancel();
          }}
        />
        <button type="button" className="bl-bd-creator-save" onClick={commit} disabled={saving}>
          {saving ? "Saving…" : "Save"}
        </button>
        <button type="button" className="bl-bd-creator-cancel" onClick={cancel} disabled={saving}>
          Cancel
        </button>
      </div>
    );
  }

  const has = !!(name || email);
  if (!has) {
    return (
      <button
        type="button"
        className="bl-bd-creator-empty"
        onClick={() => setEditing(true)}
      >
        <UserCircle2 size={13} />
        Add a creator
      </button>
    );
  }
  return (
    <button
      type="button"
      className="bl-bd-creator-row"
      onClick={() => setEditing(true)}
      title="Click to edit"
    >
      <span className="bl-bd-creator-label">For</span>
      {name && (
        <span className="bl-bd-creator-name">
          <UserCircle2 size={11} />
          {name}
        </span>
      )}
      {email && (
        <span className="bl-bd-creator-email">
          <Mail size={11} />
          {email}
        </span>
      )}
      <Pencil size={11} className="bl-bd-creator-pencil" />
    </button>
  );
}

