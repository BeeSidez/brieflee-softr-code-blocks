// ─── Helpers ──────────────────────────────────────────────────────
function linkIds(raw) {
  const arr = Array.isArray(raw) ? raw : raw == null ? [] : [raw];
  return arr.map((x) => (x && typeof x === "object" ? x.id : x)).filter(Boolean);
}
function asArray(raw) {
  return Array.isArray(raw) ? raw : raw == null ? [] : [raw];
}
function cleanHtml(v) {
  if (typeof v !== "string") return "";
  return v
    .replace(/```html?/gi, "")
    .replace(/```/g, "")
    .replace(/<(script|style|iframe)[^>]*>[\s\S]*?<\/\1>/gi, "")
    .replace(/\s*[—–]\s*/g, ", ")
    .replace(/\s*&(?:mdash|ndash|#8212|#8211);\s*/gi, ", ")
    .trim();
}
// Filename → a human brief name: strip extension, underscores and
// dashes to spaces, collapse whitespace.
function nameFromFilename(fn) {
  return String(fn || "")
    .replace(/\.pdf$/i, "")
    .replace(/[_\-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 80) || "Untitled brief";
}
// Normalised token set for filename → brief-name matching.
function normTokens(s) {
  return String(s || "")
    .toLowerCase()
    .replace(/\.pdf$/i, "")
    .replace(/[^a-z0-9]+/g, " ")
    .split(" ")
    .filter(Boolean);
}
function matchScore(filename, briefName) {
  const a = normTokens(filename);
  const b = normTokens(briefName);
  if (!a.length || !b.length) return 0;
  const aj = a.join(" "), bj = b.join(" ");
  // Longer matched names outrank shorter ones at the same tier, so a
  // file called "glow coffee scrub brief extra" prefers the brief
  // "glow coffee scrub brief" over one just called "glow" (found the
  // hard way against a brief named "Test").
  const bonus = Math.min(0.9, b.length / 10);
  if (aj === bj) return 4;
  if (aj.includes(bj) || bj.includes(aj)) return 2 + bonus;
  const setB = {};
  b.forEach((t) => { setB[t] = true; });
  const overlap = a.filter((t) => setB[t]).length;
  return overlap / Math.max(a.length, b.length) >= 0.5 ? 1 + bonus : 0;
}
const withTimeout = (promise, ms, label) =>
  Promise.race([
    promise,
    new Promise((_, reject) => setTimeout(() => reject(new Error(`${label} timed out`)), ms)),
  ]);
const readAsDataUrl = (file) =>
  new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(String(r.result || ""));
    r.onerror = () => reject(new Error("Could not read the file"));
    r.readAsDataURL(file);
  });

