        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
      }
      .bl-projects-cta {
        height: 38px;
        border-radius: 10px;
        font-weight: 500;
        font-size: 13px;
        padding: 0 16px;
      }
      .bl-projects-cta:hover:not(:disabled) {
        background-color: ${PERIWINKLE_HOVER} !important;
      }
      .bl-projects-cta-secondary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 38px;
        padding: 0 14px;
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        border-radius: 10px;
        color: ${NAVY_DEEP};
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s, color 0.15s;
      }
      .bl-projects-cta-secondary:hover {
        border-color: ${PERIWINKLE};
        color: ${PERIWINKLE};
        background: #FFFFFF;
      }

      /* Status pill */
      .bl-status-pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      /* Privacy overlay on card — clickable to toggle private_mode */
      .bl-privacy-overlay {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(0, 15, 77, 0.72);
        color: #FFFFFF;
        font-size: 10px;
        font-weight: 500;
        padding: 3px 8px;
        border: none;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        backdrop-filter: blur(8px);
        cursor: pointer;
        transition: background 0.15s;
      }
      .bl-privacy-overlay:hover { background: rgba(0, 15, 77, 0.9); }

      /* Grid view */
      .bl-projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 16px;
      }
      .bl-card {
        display: flex;
        flex-direction: column;
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        border-radius: 14px;
        overflow: visible;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        cursor: pointer;
        position: relative;
      }
      .bl-card:hover {
        transform: translateY(-2px);
        border-color: rgba(135, 156, 247, 0.7);
        box-shadow: 0 12px 28px -16px rgba(0, 15, 77, 0.25);
      }
      .bl-card-thumb {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: linear-gradient(135deg, rgba(135, 156, 247, 0.10), rgba(135, 156, 247, 0.02));
        overflow: hidden;
        border-radius: 14px 14px 0 0;
      }
      /* Brand-mark fallback: the account favicon is only 128px, so it
         sits centred at its own size on the tinted panel rather than
         being stretched to fill the card. */
      .bl-card-thumb.is-mark {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .bl-card-thumb.is-mark img {
        width: 56px;
        height: 56px;
        object-fit: contain;
        border-radius: 12px;
        background: #FFFFFF;
        padding: 8px;
        box-shadow: 0 2px 10px rgba(0, 19, 100, 0.06);
      }
      .bl-card-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .bl-card-status {
        position: absolute;
        bottom: 8px;
        right: 8px;
      }
      .bl-card-body {
        padding: 12px 14px 14px;
      }
      .bl-card-name {
        font-size: 14px;
        font-weight: 500;
        color: ${NAVY_DEEP};
        line-height: 1.3;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        margin-bottom: 6px;
      }
      .bl-card-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        color: ${MUTED};
      }
      .bl-card-pending {
        color: #C97D3F;
        font-weight: 500;
      }
      .bl-card-invite {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        background: transparent;
        color: ${PERIWINKLE};
        border: 1px dashed rgba(135, 156, 247, 0.55);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
      }
      .bl-card-invite:hover {
        background: rgba(135, 156, 247, 0.10);
        border-color: ${PERIWINKLE};
        color: ${PERIWINKLE_HOVER};
      }

      /* List view */
      .bl-projects-list {
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        border-radius: 14px;
        overflow: visible;
      }
      .bl-projects-list-head,
      .bl-projects-list-row {
        display: grid;
        grid-template-columns: 1.8fr 0.8fr 0.6fr 0.7fr 0.7fr 44px;
        gap: 12px;
        align-items: center;
        padding: 12px 18px;
        font-size: 13px;
      }
      .bl-projects-list-head {
        background: rgba(135, 156, 247, 0.05);
        color: ${MUTED};
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-bottom: 1px solid ${BORDER};
      }
      .bl-projects-list-row {
        text-decoration: none;
        color: ${NAVY_DEEP};
        border-bottom: 1px solid ${BORDER};
        transition: background 0.15s;
      }
      .bl-projects-list-row:last-child { border-bottom: none; }
      .bl-projects-list-row:hover {
        background: rgba(135, 156, 247, 0.05);
      }
      .bl-projects-list-name {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
      }
      .bl-projects-list-thumb {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        object-fit: cover;
        background: ${TRACK};
      }
      .bl-projects-list-priv {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 999px;
        color: ${MUTED};
        font-size: 12px;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
      }
      .bl-projects-list-priv:hover {
        background: rgba(135, 156, 247, 0.10);
        border-color: ${BORDER};
        color: ${NAVY_DEEP};
      }

      /* Loading skeleton */
      .bl-projects-loading {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 16px;
      }
      .bl-projects-skeleton {
        aspect-ratio: 1 / 1.3;
        background: linear-gradient(120deg, ${TRACK} 30%, #f0f4ff 50%, ${TRACK} 70%);
        background-size: 200% 100%;
        animation: blShimmer 1.2s ease-in-out infinite;
        border-radius: 14px;
      }
      @keyframes blShimmer {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      /* Empty state */
      .bl-projects-empty {
        text-align: center;
        padding: 64px 20px;
        background: #FFFFFF;
        border: 1px dashed ${BORDER};
        border-radius: 14px;
      }
      .bl-projects-empty-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 12px;
        background: rgba(135, 156, 247, 0.10);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: ${PERIWINKLE};
      }
      .bl-projects-empty-title {
        font-size: 16px;
        font-weight: 500;
        color: ${NAVY_DEEP};
        margin: 0 0 4px;
      }
      .bl-projects-empty-body {
        font-size: 13px;
        color: ${MUTED};
        margin: 0;
      }

      /* Modal */
      @keyframes blBackdropFade { from { opacity: 0; } to { opacity: 1; } }
      @keyframes blModalRise    { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

      .bl-modal-backdrop {
        position: fixed;
        inset: 0;
        /* Softr's own modals dim with neutral black at 60%. Matching it
           stops these in-block modals reading as a different app. */
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        animation: blBackdropFade 0.16s ease-out;
      }
      .bl-modal {
        width: 100%;
        max-width: 480px;
        background: #FAFBFF;
        border: 1px solid ${BORDER};
        border-radius: 16px;
        padding: 22px 24px 18px;
        box-shadow: 0 24px 60px -20px rgba(0, 15, 77, 0.30);
        animation: blModalRise 0.18s ease-out;
        max-height: calc(100vh - 40px);
        overflow-y: auto;
      }
      .bl-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }
      .bl-modal-title {
        font-size: 18px;
        font-weight: 500;
        color: ${NAVY_DEEP};
        margin: 0;
      }
      .bl-modal-sub {
        font-size: 12px;
        color: ${MUTED};
        margin: 4px 0 0;
      }
      .bl-modal-close {
        width: 30px;
        height: 30px;
        background: transparent;
        color: ${MUTED};
        border: none;
        border-radius: 999px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: background 0.15s;
      }
      .bl-modal-close:hover { background: rgba(135, 156, 247, 0.10); color: ${NAVY_DEEP}; }

      .bl-modal-body { display: flex; flex-direction: column; gap: 14px; }
      .bl-modal-field { display: flex; flex-direction: column; gap: 6px; }
      .bl-modal-label {
        font-size: 12px;
        font-weight: 500;
        color: ${NAVY_DEEP};
        letter-spacing: 0.01em;
      }
      .bl-modal-optional {
        color: ${MUTED};
        font-weight: 400;
      }
      .bl-modal-static {
        padding: 9px 12px;
        background: #F7F9FF;
        border: 1px solid ${BORDER};
        border-radius: 10px;
        font-size: 13px;
        color: ${NAVY_DEEP};
        line-height: 1.3;
      }
      .bl-modal-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
        padding-top: 16px;
        border-top: 1px solid ${BORDER};
      }
      .bl-modal-cancel {
        background: transparent;
        color: ${MUTED};
        border: none;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 14px;
        border-radius: 8px;
        cursor: pointer;
        transition: color 0.15s;
      }
      .bl-modal-cancel:hover:not(:disabled) { color: ${NAVY_DEEP}; }
      .bl-modal-cancel:disabled { color: #C5CFE8; cursor: not-allowed; }

      /* ===== Card actions menu trigger + dropdown ===== */
      .bl-card-menu-wrap {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 5;
      }
      .bl-card-menu-trigger {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.92);
        color: ${NAVY_DEEP};
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px -2px rgba(0, 15, 77, 0.18);
        opacity: 0;
        transition: opacity 0.15s, background 0.15s, color 0.15s;
      }
      .bl-card:hover .bl-card-menu-trigger,
      .bl-card-menu-trigger:focus,
      .bl-card-menu-trigger.is-open,
      .bl-projects-list-row:hover .bl-card-menu-trigger,
      .bl-projects-list-row.is-menu-open .bl-card-menu-trigger {
        opacity: 1;
      }
      .bl-card-menu-trigger:hover {
        background: #FFFFFF;
      }
      @media (hover: none) {
        .bl-card-menu-trigger { opacity: 1; }
      }
      .bl-card-menu {
        position: absolute;
        top: 32px;
        right: 0;
        min-width: 200px;
        background: #FFFFFF;
        border: 1px solid ${BORDER};
        border-radius: 12px;
        box-shadow: 0 16px 36px -16px rgba(0, 15, 77, 0.30);
        padding: 6px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        animation: blModalRise 0.14s ease-out;
        z-index: 20;
      }
      .bl-menu-item {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        background: transparent;
        color: ${NAVY_DEEP};
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        transition: background 0.12s;
      }
      .bl-menu-item:hover {
        background: rgba(135, 156, 247, 0.10);
      }
      .bl-menu-item.is-danger {
        color: #d92626;
      }
      .bl-menu-item.is-danger:hover {
        background: rgba(217, 38, 38, 0.08);
      }
      .bl-menu-divider {
        height: 1px;
        background: ${BORDER};
        margin: 4px 2px;
      }

      /* ===== Card-body meta-row actions (Grid view) ===== */
      .bl-card-meta-actions {
        margin-left: auto;
        position: relative;
        display: inline-flex;
      }
      .bl-card-meta-actions .bl-card-menu-wrap {
        position: relative;
        top: auto;
        right: auto;
        z-index: 5;
      }
      .bl-card-meta-actions .bl-card-menu-trigger {
        width: 24px;
        height: 24px;
        background: transparent;
        color: ${MUTED};
        box-shadow: none;
        border-radius: 6px;
      }
      .bl-card:hover .bl-card-meta-actions .bl-card-menu-trigger,
      .bl-card-meta-actions .bl-card-menu-trigger.is-open {
        background: rgba(135, 156, 247, 0.10);
        color: ${NAVY_DEEP};
      }
      .bl-card-meta-actions .bl-card-menu {
        top: 28px;
        bottom: auto;
        right: 0;
      }

      /* List row actions cell */
      .bl-projects-list-row { position: relative; }
      .bl-projects-list-actions {
        position: relative;
        display: flex;
        justify-content: flex-end;
      }
      .bl-projects-list-actions .bl-card-menu-wrap {
        position: relative;
        top: auto;
        right: auto;
      }

      /* ===== Settings modal: privacy toggle row ===== */
      .bl-toggle-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px;
        background: #F7F9FF;
        border: 1px solid ${BORDER};
        border-radius: 10px;
        cursor: pointer;
      }
      .bl-toggle-row input[type="checkbox"] {
        margin-top: 2px;
        width: 18px;
        height: 18px;
        accent-color: ${PERIWINKLE};
        cursor: pointer;
      }
      .bl-toggle-label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        color: ${NAVY_DEEP};
      }
      .bl-toggle-hint {
        display: block;
        font-size: 12px;
        color: ${MUTED};
        margin-top: 2px;
      }

      /* ===== Settings modal: thumbnail uploader ===== */
      .bl-thumb-row {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .bl-thumb-preview {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background: #F2F4FB url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23BFC6E0' stroke-width='1.5'><rect x='3' y='3' width='18' height='18' rx='2'/><circle cx='9' cy='9' r='2'/><path d='m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21'/></svg>") center / 24px no-repeat;
        border: 1px solid ${BORDER};
        overflow: hidden;
        flex-shrink: 0;
      }
      .bl-thumb-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .bl-thumb-empty {
        display: none;
      }
      .bl-thumb-actions {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .bl-thumb-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 32px;
        padding: 0 12px;
        background: #FFFFFF;
        color: ${NAVY_DEEP};
        border: 1px solid ${BORDER};
        border-radius: 8px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: border-color 0.15s;
      }
      .bl-thumb-btn:hover:not(:disabled) {
        border-color: ${PERIWINKLE};
      }
      .bl-thumb-btn:disabled { opacity: 0.55; cursor: not-allowed; }
      .bl-thumb-btn-ghost {
        background: transparent;
        color: ${MUTED};
        border-color: transparent;
      }
      .bl-thumb-btn-ghost:hover:not(:disabled) {
        color: ${NAVY_DEEP};
        background: rgba(135, 156, 247, 0.08);
        border-color: transparent;
      }

      /* Responsive tweaks */
      @media (max-width: 640px) {
        .bl-projects-controls { gap: 8px; }
        .bl-projects-cta { margin-left: 0; width: 100%; justify-content: center; }
        .bl-projects-list-head { display: none; }
        .bl-projects-list-row {
          grid-template-columns: 1fr;
          gap: 6px;
        }
        .bl-card-menu { right: -4px; }
      }
    `}</style>
  );
}
