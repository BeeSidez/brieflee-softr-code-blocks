export default function Block() {
  const user = useCurrentUser();
  // The decision made on this screen, so the bar updates before the refetch lands.
  const [localDecision, setLocalDecision] = useState(null); // { human, at, by, request }
  const submissionId = useCurrentRecordId() || "";
  const { data: submission } = useRecord({ recordId: submissionId, select: subSelect, from: ds.submissions });
  // Scoped server-side to this submission. Unscoped, only the first 100
  // reviews ever arrived, so a newer video's review could go missing.
  const { data: reviewsRaw } = useRecords({
    select: reviewSelect,
    from: ds.reviews,
    count: 100,
    where: q.array("rv_submissions").is(submissionId),
    enabled: !!submissionId,
  });
  // review_report rows are fetched further down, once the review id is known.
  // Account-wide roster. Add people dedupes against it on email, so a
  // single page would hand anyone past the first 100 a second member
  // row. Drained a page at a time up to 1,000.
  const membersQ = useRecords({ select: memberSelect, from: ds.members, count: 100, enabled: !!submissionId });
  const membersRaw = membersQ.data;
  const refetchMembers = membersQ.refetch;
  useEffect(() => {
    const loaded = membersQ.data?.pages?.length || 0;
    if (membersQ.hasNextPage && !membersQ.isFetchingNextPage && loaded < 10) {
      membersQ.fetchNextPage();
    }
  }, [membersQ.hasNextPage, membersQ.isFetchingNextPage, membersQ.data]); // eslint-disable-line
  const { data: commentsRaw } = useRecords({ select: commentSelect, from: ds.comments, count: 100, enabled: !!submissionId });
  const updateReview = useRecordUpdate({ fields: reviewWrite, from: ds.reviews });
  const createComment = useRecordCreate({ fields: commentCreate, from: ds.comments });
  const createMember = useRecordCreate({ fields: memberCreate, from: ds.members });
  const proxyFetch = useProxyFetch(ds.openrouter);
  const twilioFetch = useProxyFetch(ds.twilio);

  const sf = submission?.fields || {};
  const subName = unwrap(sf.sub_name) || "Submission";
  const creatorName = unwrap(sf.sub_creator) || "Creator";
  const briefName = unwrap(sf.sub_brief_name);

  // ─── The review + its report rows, scoped to this submission ─
  const review = useMemo(() => {
    const list = recordsOf(reviewsRaw).filter((r) => linkedTo(r?.fields?.rv_submissions, submissionId, subName));
    return list[0] || null;
  }, [reviewsRaw, submissionId, subName]);
  const rf = review?.fields || {};
  const reviewId = review?.id || "";
  // This review's own check rows, filtered server-side. Unfiltered, only the
  // first 100 rows of review_report arrived, so a recent video never found
  // its rows and fell back to the 12 flat columns ("12 of 12 passed" on a
  // flagged video). Rows that carry only the submission link still match.
  const { data: reportRaw } = useRecords({
    select: reportSelect,
    from: ds.report,
    count: 100,
    where: reviewId
      ? q.or(q.array("rp_review").is(reviewId), q.array("rp_submissions").is(submissionId))
      : q.array("rp_submissions").is(submissionId),
    enabled: !!submissionId,
  });

  const checks = useMemo(() => {
    const fromReport = recordsOf(reportRaw)
      .filter((r) => {
        const fl = r?.fields || {};
        if (reviewId && linkedTo(fl.rp_review, reviewId, "")) return true;
        return linkedTo(fl.rp_submissions, submissionId, subName);
      })
      .map((r) => {
        const fl = r.fields || {};
        return {
          id: r.id,
          criteria: unwrap(fl.rp_criteria) || "Check",
          score: unwrap(fl.rp_score) || unwrap(fl.rp_threshold),
          status: selectLabel(fl.rp_status),
          severity: selectLabel(fl.rp_severity),
          rating: Number(fl.rp_rating) || 0,
          comment: unwrap(fl.rp_comment),
          screenshot: typeof fl.rp_screenshot === "string" ? fl.rp_screenshot : "",
          sec: momentSec(fl.rp_moment),
          group: checkGroup(unwrap(fl.rp_criteria)),
        };
      });
    if (fromReport.length) return fromReport;

    // Nothing in review_report, so read the review's own per-criterion
    // columns. Written out statically rather than looped over a table of
    // alias names, so the block's field analyser can see each one is used
    // and keeps it in the fetch.
    const flat = [
      ["hook",    "Hook speed",              rf.c_hook_score,    rf.c_hook_status,    rf.c_hook_comment,    rf.c_hook_shot],
      ["vhook",   "Visual hook",             rf.c_vhook_score,   rf.c_vhook_status,   rf.c_vhook_comment,   rf.c_vhook_shot],
      ["pacing",  "Engagement pacing",       rf.c_pacing_score,  rf.c_pacing_status,  rf.c_pacing_comment,  rf.c_pacing_shot],
      ["product", "Product screen time",     rf.c_product_score, rf.c_product_status, rf.c_product_comment, rf.c_product_shot],
      ["audio",   "Audio clarity",           rf.c_audio_score,   rf.c_audio_status,   rf.c_audio_comment,   rf.c_audio_shot],
      ["face",    "Face time",               rf.c_face_score,    rf.c_face_status,    rf.c_face_comment,    rf.c_face_shot],
      ["text",    "Text legibility",         rf.c_text_score,    rf.c_text_status,    rf.c_text_comment,    rf.c_text_shot],
      ["cta",     "CTA placement",           rf.c_cta_score,     rf.c_cta_status,     rf.c_cta_comment,     rf.c_cta_shot],
      ["mention", "Brand mentions",          rf.c_mention_score, rf.c_mention_status, rf.c_mention_comment, rf.c_mention_shot],
      ["mod",     "Content moderation",      null,               rf.c_mod_status,     rf.c_mod_comment,     rf.c_mod_shot],
      ["copy",    "Copyright",               null,               rf.c_copy_status,    rf.c_copy_comment,    rf.c_copy_shot],
      ["align",   "Brand & brief alignment", null,               rf.c_align_status,   rf.c_align_comment,   rf.c_align_shot],
    ];
    return flat
      .map((row) => {
        const status = selectLabel(row[3]);
        const comment = unwrap(row[4]);
        const raw = unwrap(row[2]);
        const shotRaw = unwrap(row[5]);
        const score = raw === null || raw === undefined || raw === "" ? "" : String(raw);
        // A criterion the review never filled in is left out entirely
        // rather than shown as a blank row.
        if (!status && !comment && !score) return null;
        const shot = typeof shotRaw === "string" ? shotRaw : "";
        return {
          id: (reviewId || "rv") + ":" + row[0],
          criteria: row[1],
          score,
          status,
          severity: "",
          rating: 0,
          comment: comment || "",
          screenshot: shot,
          sec: soSec(shot),
          group: checkGroup(row[1]),
        };
      })
      .filter(Boolean);
  }, [reportRaw, reviewId, submissionId, subName, review]);

  const passCount = checks.filter((c) => isPassStatus(c.status)).length;
  // Only percentage-like scores count towards the overall number —
  // second-counts and mention-counts (1, 2, 4) would drag it down.
  const numericScores = checks.map((c) => parseInt(c.score, 10)).filter((n) => Number.isFinite(n) && n >= 10 && n <= 100);
  const overallScore = numericScores.length
    ? Math.round(numericScores.reduce((a, b) => a + b, 0) / numericScores.length)
    : null;
  const humanLabel = localDecision ? localDecision.human : selectLabel(rf.rv_human);
  const decisionLabel = (humanLabel && humanLabel !== "Pending")
    ? humanLabel
    : (selectLabel(rf.rv_ai) || selectLabel(rf.rv_status) || "In review");

  // Flagged view. When any check was flagged or failed, or the verdict itself
  // is a flag, the AI review leads with what was flagged and folds the rest
  // behind a toggle. A clean pass keeps the full grouped list.
  const flaggedChecks = checks.filter((c) => /FLAG|FAIL|REJECT|MISALIGN|ADJUST|WARN/i.test(String(c.status || "")));
  const restChecks = checks.filter((c) => !flaggedChecks.includes(c));
  const restAllPass = restChecks.every((c) => isPassStatus(c.status));
  const flaggedView = flaggedChecks.length > 0 || /FLAG|FAIL|REJECT|CHANGE/i.test(decisionLabel);
  const summaryText = !checks.length
    ? "No checks yet"
    : flaggedChecks.length
      ? flaggedChecks.length + " flagged · " + passCount + " passed"
      : flaggedView
        ? "Flagged for review · " + passCount + " of " + checks.length + " checks passed"
        : passCount + " of " + checks.length + " checks passed";

  const members = useMemo(
    () => recordsOf(membersRaw).filter((r) => linkedTo(r?.fields?.mb_submissions, submissionId, subName)),
    [membersRaw, submissionId, subName]
  );
  const comments = useMemo(() => {
    return recordsOf(commentsRaw)
      .filter((r) => linkedTo(r?.fields?.cm_submissions, submissionId, subName))
      .map((r) => {
        const fl = r.fields || {};
        return {
          id: r.id,
          text: unwrap(fl.cm_text),
          sec: Number(fl.cm_sec) || 0,
          author: unwrap(fl.cm_author) || "Someone",
          email: unwrap(fl.cm_email),
          created: fl.cm_created || "",
        };
      })
      .sort((a, b) => a.sec - b.sec);
  }, [commentsRaw, submissionId, subName]);

  const transcript = useMemo(() => parseScript(rf.rv_transcript), [rf.rv_transcript]);
  const remix = useMemo(() => parseScript(rf.rv_adapted), [rf.rv_adapted]);

  // ─── Video + timeline ─────────────────────────────────────
  const videoRef = useRef(null);
  const [nowSec, setNowSec] = useState(0);
  const [duration, setDuration] = useState(0);
  // What the player gets. A submission that came from a link holds the
  // page URL, not a video, so it can never be a <video> src. The Review
  // Agents already made a playable copy on Cloudinary while they watched
  // it, and the review carries it, so that is what plays.
  const playUrl = (() => {
    const att = asArray(sf.sub_video_file)[0];
    const fromFile = att && (att.url || (typeof att === "string" ? att : ""));
    if (fromFile) return fromFile;
    const copy = typeof rf.rv_display_url === "string" ? rf.rv_display_url.trim() : "";
    if (copy) return copy;
    const direct = typeof sf.sub_video_url === "string" ? sf.sub_video_url : "";
    return /\.(mp4|mov|webm|m4v)(\?|$)/i.test(direct) ? direct : "";
  })();
  // Where it came from, for the button that opens the original.
  const videoUrl = (() => {
    const att = asArray(sf.sub_video_file)[0];
    const fromFile = att && (att.url || (typeof att === "string" ? att : ""));
    if (fromFile) return fromFile;
    const direct = typeof sf.sub_video_url === "string" ? sf.sub_video_url : "";
    return direct || playUrl;
  })();
  const poster = typeof rf.rv_thumbnail === "string" ? rf.rv_thumbnail.trim() : "";
  const onTime = (e) => {
    const s = Math.floor(e.currentTarget.currentTime || 0);
    if (s !== nowSec) setNowSec(s);
  };
  const [portrait, setPortrait] = useState(true);
  const onMeta = (e) => {
    setDuration(Math.max(1, Math.ceil(e.currentTarget.duration || 0)));
    setPortrait((e.currentTarget.videoHeight || 1) >= (e.currentTarget.videoWidth || 0));
  };
  const seek = (sec) => {
    const v = videoRef.current;
    if (!v || sec == null) return;
    try { v.currentTime = sec; v.play?.(); } catch {}
  };

  // ─── Panel state ──────────────────────────────────────────
  // Always opens on the AI review. The tab used to be remembered across
  // submissions, so opening a fresh one could land on People, which is
  // empty on almost every submission and reads as "nothing happened".
  const [tab, setTab] = useState("review");
  const pickTab = (k) => setTab(k);
  const [reportView, setReportView] = useState("list");
  const [openGroups, setOpenGroups] = useState({ "Hook & attention": true });
  const [showPassed, setShowPassed] = useState(false);
  const flipGroup = (g) => setOpenGroups((o) => ({ ...o, [g]: !o[g] }));
  const [ratePop, setRatePop] = useState(false);
  const panelRef = useRef(null);
  const startDrag = (e) => {
    e.preventDefault();
    const panel = panelRef.current;
    if (!panel) return;
    const startX = e.clientX;
    const startW = panel.getBoundingClientRect().width;
    let lastW = startW;
    const move = (ev) => {
      let w = startW - (ev.clientX - startX);
      w = Math.max(320, Math.min(760, w));
      lastW = w;
      panel.style.flex = "0 0 " + w + "px";
    };
    const up = () => {
      window.removeEventListener("mousemove", move);
      window.removeEventListener("mouseup", up);
      document.body.style.userSelect = "";
      try { localStorage.setItem("bl-sr-panelW", String(Math.round(lastW))); } catch {}
    };
    document.body.style.userSelect = "none";
    window.addEventListener("mousemove", move);
    window.addEventListener("mouseup", up);
  };
  useEffect(() => {
    try {
      const w = localStorage.getItem("bl-sr-panelW");
      if (w && panelRef.current) panelRef.current.style.flex = "0 0 " + w + "px";
    } catch {}
  }, []);

  // ─── Timeline markers per tab ──────────────────────────────
  const markers = useMemo(() => {
    if (tab === "comments") {
      return comments.map((c, i) => ({
        sec: c.sec, letter: String.fromCharCode(65 + (i % 26)),
        title: c.author, text: c.text,
      }));
    }
    if (tab === "transcript") return transcript.filter((r) => r.sec != null).map((r) => ({ sec: r.sec, title: fmtTime(r.sec), text: r.text }));
    if (tab === "remix") return remix.filter((r) => r.sec != null).map((r) => ({ sec: r.sec, title: fmtTime(r.sec), text: r.text }));
    return checks.filter((c) => c.sec != null).map((c) => ({ sec: c.sec, title: c.criteria, text: c.comment }));
  }, [tab, checks, comments, transcript, remix]);
  const stripLabel = tab === "comments" ? "Team comments"
    : tab === "transcript" ? "Transcript"
    : tab === "remix" ? "Remixed script"
    : "Lee's timestamps";
  const markerSecs = markers.map((m) => m.sec).sort((a, b) => a - b);
  const nextFlag = () => {
    const v = videoRef.current; if (!v || !markerSecs.length) return;
    const t = v.currentTime || 0;
    const n = markerSecs.find((s) => s > t + 0.25);
    seek(n != null ? n : markerSecs[0]);
  };
  const prevFlag = () => {
    const v = videoRef.current; if (!v || !markerSecs.length) return;
    const t = v.currentTime || 0;
    const before = markerSecs.filter((s) => s < t - 0.4);
    seek(before.length ? before[before.length - 1] : markerSecs[markerSecs.length - 1]);
  };

  // ─── The decision ────────────────────────────────────────
  // Approve, Request changes and Reject live on the tool rail, each behind a
  // small confirm modal. Every decision writes reviews.human_decision plus who
  // and when, Request changes carries the note the creator reads, and the
  // toast offers Undo for a few seconds (Undo puts the review back to Pending).
  const [ask, setAsk] = useState(null); // approve | reject | changes | invite | null
  const [deciding, setDeciding] = useState(false);
  const [changeNote, setChangeNote] = useState("");
  const humanDecided = !!humanLabel && humanLabel !== "Pending";
  const decidedAtIso = localDecision ? localDecision.at : unwrap(rf.rv_decided_at);
  const decidedBy = localDecision ? localDecision.by : unwrap(rf.rv_decided_by);
  const decidedMs = decidedAtIso ? new Date(decidedAtIso).getTime() : NaN;
  const agoText = (ms) => {
    if (!Number.isFinite(ms)) return "";
    const m = Math.max(0, Math.round((Date.now() - ms) / 60000));
    if (m < 1) return "just now"; if (m < 60) return m + " minute" + (m === 1 ? "" : "s") + " ago";
    const h = Math.round(m / 60); if (h < 48) return h + " hour" + (h === 1 ? "" : "s") + " ago";
    return Math.round(h / 24) + " days ago";
  };
  const decidedWord = humanLabel === "Approve" ? "Approved" : humanLabel === "Reject" ? "Rejected" : humanLabel === "Changes Requested" ? "Changes requested" : "";
  const decidedLine = humanDecided ? [decidedWord, agoText(decidedMs), decidedBy ? "by " + decidedBy : ""].filter(Boolean).join(" ") : "";
  const prefillNote = () => {
    const kept = localDecision ? localDecision.request : unwrap(rf.rv_request);
    if (kept) return kept;
    return flaggedChecks.map((c) => c.criteria + (c.comment ? ": " + c.comment : "")).join("\n");
  };
  const decide = async (opt, message) => {
    if (!reviewId) { toast.error("No review on this submission yet."); return; }
    setDeciding(true);
    const at = new Date().toISOString();
    const by = opt === HUMAN_PENDING ? "" : (unwrap(user?.fullName) || unwrap(user?.name) || unwrap(user?.email) || "");
    try {
      const fields = { rv_human: { id: opt.id, label: opt.label }, rv_decided_at: opt === HUMAN_PENDING ? null : at, rv_decided_by: by };
      if (message !== undefined) fields.rv_request = message;
      await updateReview.mutateAsync({ recordId: reviewId, fields });
      setLocalDecision({ human: opt.label, at, by, request: message !== undefined ? message : (localDecision ? localDecision.request : unwrap(rf.rv_request)) });
      setAsk(null);
      if (opt === HUMAN_PENDING) { toast.success("Decision undone"); return; }
      // The creator hears about it on WhatsApp when they asked to.
      // Wrapped: the decision is saved either way, and a messaging
      // failure must never look like a failed decision.
      if (opt === HUMAN_APPROVE || opt === HUMAN_CHANGES) {
        try {
          await notifyCreator(opt, message !== undefined ? message : prefillNote());
        } catch (e) {
          console.error("WhatsApp notify failed:", e);
        }
      }
      toast.success(opt === HUMAN_APPROVE ? subName + " approved" : opt === HUMAN_REJECT ? subName + " rejected" : "Changes requested on " + subName, {
        duration: 8000,
        action: { label: "Undo", onClick: () => decide(HUMAN_PENDING, message !== undefined ? "" : undefined) },
      });
    } catch (e) {
      console.error("Decision failed:", e);
      toast.error("Couldn't save the decision", { description: e?.message });
    } finally { setDeciding(false); }
  };
  // Approved and Changes requested are the two decisions a creator has
  // to act on, so they are the two that reach WhatsApp. A rejection is
  // a conversation, not a notification.
  const notifyCreator = async (opt, note) => {
    if (!truthyFlag(sf.sub_whatsapp)) return;
    const mobile = unwrap(sf.sub_mobile) || "";
    if (!mobile) return;
    const creator = firstNameOf(unwrap(sf.sub_creator));
    // The link arrives as an object on its own or wrapped in an array,
    // depending on the read, so take both.
    const accLink = Array.isArray(sf.sub_accounts) ? sf.sub_accounts[0] : sf.sub_accounts;
    const brand = (accLink && accLink.label) || "the brand";
    if (opt === HUMAN_APPROVE) {
      await sendWhatsApp(twilioFetch, {
        to: mobile,
        template: WA_TEMPLATE.approved,
        variables: { "1": creator, "2": briefName || subName, "3": brand },
      });
      return;
    }
    // A template variable cannot carry a newline, and the note is often
    // a list of flagged checks.
    const flat = String(note || "").replace(/\s*\n+\s*/g, " ").trim().slice(0, 600);
    await sendWhatsApp(twilioFetch, {
      to: mobile,
      template: WA_TEMPLATE.changes,
      variables: {
        "1": creator,
        "2": brand,
        "3": briefName || subName,
        "4": flat || "See the notes on your video.",
      },
    });
  };

  const openAsk = (kind) => {
    if (!reviewId) { toast.error("No review on this submission yet."); return; }
    if (kind === "changes") setChangeNote(prefillNote());
    setAsk(kind);
  };

  // ─── Add people ──────────────────────────────────────────
  const [inv, setInv] = useState({ name: "", email: "", access: "comment", message: "" });
  const [inviting, setInviting] = useState(false);
  const sendInvite = async () => {
    const email = inv.email.trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { toast.error("Enter an email address."); return; }
    const access = ACCESS[inv.access] || ACCESS.comment;
    setInviting(true);
    try {
      await createMember.mutateAsync({
        mb_name: inv.name.trim() || email.split("@")[0],
        mb_email: email,
        mb_status: { id: MEMBER_INVITED.id, label: MEMBER_INVITED.label },
        mb_access: { id: access.id, label: access.label },
        mb_message: inv.message.trim(),
        mb_invited: new Date().toISOString(),
        mb_submissions: [{ id: submissionId }],
        mb_accounts: asArray(sf.sub_accounts).map((a) => ({ id: typeof a === "string" ? a : (a && a.id) || "" })).filter((a) => a.id),
        mb_users: user?.id ? [{ id: user.id }] : [],
      });
      toast.success("Added " + email, { description: "They show up under People." });
      setInv({ name: "", email: "", access: "comment", message: "" });
      setAsk(null);
      await refetchMembers?.();
    } catch (e) {
      console.error("Invite failed:", e);
      toast.error("Couldn't add them", { description: e?.message });
    } finally { setInviting(false); }
  };
  const [rating, setRating] = useState(0);
  useEffect(() => { setRating(Number(rf.rv_rating) || 0); }, [rf.rv_rating]);
  const rate = async (n) => {
    if (!reviewId) return;
    setRating(n);
    try {
      await updateReview.mutateAsync({ recordId: reviewId, fields: { rv_rating: n } });
      toast.success("Rated " + n + " star" + (n === 1 ? "" : "s"));
    } catch (e) {
      console.error("Rating failed:", e);
      toast.error("Couldn't save the rating", { description: e?.message });
    }
  };
  const download = () => {
    if (videoUrl) window.open(videoUrl, "_blank", "noreferrer");
    else toast.info("No video file on this submission.");
  };
  const copyText = async (text, label) => {
    try {
      await navigator.clipboard.writeText(text);
      toast.success(label + " copied");
    } catch { toast.error("Couldn't copy"); }
  };
  const exportCsv = () => {
    const csv = reportCsv(checks);
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
    a.download = (subName || "review") + " report.csv";
    a.click();
    URL.revokeObjectURL(a.href);
  };

  // ─── Comment composer ─────────────────────────────────────
  const [draft, setDraft] = useState("");
  const [posting, setPosting] = useState(false);
  const postComment = async () => {
    const text = draft.trim();
    if (!text) return;
    setPosting(true);
    try {
      await createComment.mutateAsync({
        cm_text: text,
        cm_sec: Math.floor(videoRef.current?.currentTime || 0),
        cm_author: unwrap(user?.fullName) || unwrap(user?.name) || "Team member",
        cm_email: unwrap(user?.email),
        cm_users: user?.id ? [{ id: user.id }] : [],
        cm_submissions: [{ id: submissionId }],
      });
      setDraft("");
      toast.success("Comment pinned at " + fmtTime(videoRef.current?.currentTime || 0));
    } catch (e) {
      console.error("Comment failed:", e);
      toast.error("Couldn't post the comment", { description: e?.message });
    } finally { setPosting(false); }
  };

  // ─── Ask Lee ──────────────────────────────────────────────
  const [chat, setChat] = useState([]);
  const [chatBusy, setChatBusy] = useState(false);
  const askRef = useRef(null);
  const chatScrollRef = useRef(null);
  useEffect(() => {
    if (chatScrollRef.current) chatScrollRef.current.scrollTop = chatScrollRef.current.scrollHeight;
  }, [chat, chatBusy]);
  const askLee = async (question) => {
    const qText = (question || "").trim();
    if (!qText || chatBusy) return;
    setChat((c) => c.concat([{ role: "user", text: qText }]));
    setChatBusy(true);
    try {
      const context = [
        "Submission: " + subName + " by " + creatorName + (briefName ? " against the brief \"" + briefName + "\"" : ""),
        "Decision: " + decisionLabel + (overallScore != null ? " · score " + overallScore + "/100" : "") + " · " + passCount + " of " + checks.length + " checks passed",
        "Checks:",
        checks.map((c) => "- " + c.criteria + ": " + (c.score || c.status) + " (" + c.status + (c.severity ? ", " + c.severity : "") + ") — " + c.comment).join("\n"),
        rf.rv_reasoning ? "Decision reasoning: " + stripHtmlText(rf.rv_reasoning) : "",
        rf.rv_action ? "Recommended action: " + stripHtmlText(rf.rv_action) : "",
        "Transcript:\n" + transcript.map((r) => (r.sec != null ? "[" + fmtTime(r.sec) + "] " : "") + r.text).join("\n").slice(0, 6000),
      ].filter(Boolean).join("\n\n");
      const res = await proxyFetch("https://openrouter.ai/api/v1/chat/completions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          // Ask Lee. Heaviest recurring AI call in the app: carries up to
          // 6,000 chars of transcript plus the full check list, and replays
          // the last 8 turns on every question. DeepSeek V4 Pro from
          // 2026-07-30, benched at ~90% under Sonnet 4.5.
          model: "deepseek/deepseek-v4-pro",
          messages: [
            { role: "system", content: "You are Lee, Brieflee's AI review assistant. You have reviewed this creator video and the data below is your review. Answer the brand's questions plainly and concretely, referencing timestamps like 0:12 where useful. Keep answers short (under 120 words unless asked for a draft). No em dashes. British spelling.\n\n" + context },
            ...chat.slice(-8).map((m) => ({ role: m.role === "lee" ? "assistant" : "user", content: m.text })),
            { role: "user", content: qText },
          ],
          temperature: 0.4,
        }),
      });
      if (!res.ok) throw new Error("OpenRouter returned HTTP " + res.status);
      const json = await res.json();
      // House style guard, same as brief-builder. The system prompt already
      // says no em dashes; DeepSeek reaches for them more readily than
      // Sonnet did, and Lee's answers are read by the brand.
      const out = (json?.choices?.[0]?.message?.content || "").trim()
        .replace(/\s*—\s*/g, ", ").replace(/,\s*,/g, ",");
      setChat((c) => c.concat([{ role: "lee", text: out || "I couldn't put an answer together. Try again?" }]));
    } catch (e) {
      console.error("Ask Lee failed:", e);
      setChat((c) => c.concat([{ role: "lee", text: "Something went wrong reaching the review engine. Check the OpenRouter datasource on this block and try again." }]));
    } finally { setChatBusy(false); }
  };
  const welcome = "Hi" + (unwrap(user?.firstName) ? " " + unwrap(user.firstName) : "") + " — I've reviewed " + creatorName + "'s video." +
    (overallScore != null ? " It scored " + overallScore + "/100" : "") +
    (checks.length ? " and passed " + passCount + " of " + checks.length + " checks." : "") +
    " Ask me anything, or try a shortcut below.";

  // Remix belongs only on remix submissions. On a content review the
  // adapted script is empty, so the tab was offering a blank script to copy.
  const isRemix = /remix/i.test(selectLabel(sf.sub_type) || "");
  const TABS = [
    { key: "review", label: "AI review" },
    { key: "report", label: "Report", count: checks.length },
    { key: "ask", label: "Ask Lee" },
    { key: "comments", label: "Comments", count: comments.length },
    { key: "transcript", label: "Transcript" },
    { key: "remix", label: "Remix" },
    { key: "details", label: "Details" },
    { key: "people", label: "People", count: members.length },
  ].filter((t) => t.key !== "remix" || isRemix);

  // ─── Render ───────────────────────────────────────────────
  const dur = duration || 39;
  const pct = (s) => Math.min(100, (s / dur) * 100).toFixed(1) + "%";
  const activeIdx = (() => {
    let idx = -1;
    markerSecs.forEach((s, i) => { if (s <= nowSec) idx = i; });
    return idx;
  })();
  const nearestIdx = (rows) => {
    let idx = -1;
    rows.forEach((r, i) => { if (r.sec != null && r.sec <= nowSec) idx = i; });
    return idx;
  };
  const tone = statusTone(decisionLabel);
  const groupIcon = (g) => (
    g === "Hook & attention" ? <Sparkles size={14} />
    : g === "Production quality" ? <Camera size={14} />
    : g === "Compliance & safety" ? <ShieldCheck size={14} />
    : <ListChecks size={14} />
  );
  // One check card for the flagged list, with the check's own status pill.
  const renderCheck = (c) => {
    const st = statusTone(c.status);
    return (
      <div key={c.id} className="bl-sr-check">
        {c.screenshot
          ? <img className="bl-sr-check-shot" src={c.screenshot} alt="" loading="lazy" onClick={() => c.sec != null && seek(c.sec)} />
          : <span className="bl-sr-check-shot is-empty" />}
        <div className="bl-sr-check-main">
          <div className="bl-sr-check-top">
            <b>{c.criteria}</b>
            <span className="bl-sr-check-flag" style={{ background: st.bg, color: st.fg }}>{c.status}</span>
            {c.score ? <span className="bl-sr-check-score" style={{ color: st.fg }}>● {c.score}</span> : null}
          </div>
          {c.comment ? <p>{c.comment}</p> : null}
          {c.sec != null && (
            <button type="button" className="bl-sr-time" onClick={() => seek(c.sec)}>
              <Play size={9} /> {fmtTime(c.sec)}
            </button>
          )}
        </div>
      </div>
    );
  };
  const groupsShort = GROUP_ORDER
    .filter((g) => checks.some((c) => c.group === g))
    .map((g) => g.split(" ")[0])
    .join(" · ");

  return (
    <>
      <Style />
      <div className="bl-sr w-full">
        <div className="bl-sr-layout">

          {/* ── Player column ── */}
          <div className="bl-sr-player">
            <div className="bl-sr-head">
              <h1 className="bl-sr-title">{subName}</h1>
              <p className="bl-sr-sub">
                {creatorName}{briefName ? " · " + briefName : ""}{duration ? " · " + fmtTime(duration) : ""}
              </p>
            </div>
            <div className="bl-sr-stage">
              <div className="bl-sr-tools">
                <button type="button" onClick={() => openAsk("changes")} disabled={deciding} title={humanLabel === "Changes Requested" ? decidedLine : "Request changes"} className={humanLabel === "Changes Requested" ? "is-changes" : ""}><Pencil size={15} /></button>
                <button type="button" onClick={() => openAsk("approve")} disabled={deciding} title={humanLabel === "Approve" ? decidedLine : "Approve"} className={humanLabel === "Approve" ? "is-approved" : ""}><Check size={15} /></button>
                <button type="button" onClick={() => openAsk("reject")} disabled={deciding} title={humanLabel === "Reject" ? decidedLine : "Reject"} className={humanLabel === "Reject" ? "is-rejected" : ""}><X size={15} /></button>
                <span className="bl-sr-rate">
                  <button type="button" onClick={() => setRatePop(!ratePop)} title="Rate this submission" className={rating ? "is-on" : ""}>
                    <Star size={15} fill={rating ? "currentColor" : "none"} />
                  </button>
                  {ratePop && (
                    <span className="bl-sr-rate-pop">
                      {[1, 2, 3, 4, 5].map((n) => (
                        <button key={n} type="button" onClick={() => { rate(n); setRatePop(false); }} className={n <= rating ? "is-on" : ""}>
                          <Star size={14} fill={n <= rating ? "currentColor" : "none"} />
                        </button>
                      ))}
                    </span>
                  )}
                </span>
                <button type="button" onClick={download} title="Download the video"><DownloadIcon size={15} /></button>
                <button type="button" onClick={() => setAsk("invite")} title="Add people"><UserPlus size={15} /></button>
                <button type="button" onClick={() => pickTab("comments")} title="Comments"><MessageCircle size={15} /></button>
              </div>
              <div className={`bl-sr-video ${portrait ? "is-portrait" : ""}`}>
                {playUrl ? (
                  <video
                    ref={videoRef}
                    src={playUrl}
                    poster={poster || undefined}
                    controls
                    playsInline
                    preload="metadata"
                    onTimeUpdate={onTime}
                    onLoadedMetadata={onMeta}
                  />
                ) : (
                  <div className="bl-sr-novideo">No video file on this submission yet.</div>
                )}
              </div>
            </div>
            <div className="bl-sr-strip">
              <div className="bl-sr-track">
                <div className="bl-sr-track-fill" style={{ width: pct(nowSec) }} />
                {markers.map((m, i) => (
                  <button
                    key={i}
                    type="button"
                    className={`bl-sr-mkr ${i === activeIdx ? "is-active" : ""}`}
                    style={{ left: pct(m.sec) }}
                    onClick={() => seek(m.sec)}
                  >
                    {m.letter ? <span className="bl-sr-mkr-letter">{m.letter}</span> : <Flag size={9} />}
                    <span className="bl-sr-mkr-tip">
                      <b>{m.title}</b>
                      <i>{fmtTime(m.sec)}</i>
                      {m.text ? <em>{String(m.text).slice(0, 120)}</em> : null}
                    </span>
                  </button>
                ))}
              </div>
              <div className="bl-sr-strip-times">
                <span>0:00</span>
                <span className="bl-sr-strip-label">{stripLabel}</span>
                <span>{fmtTime(dur)}</span>
              </div>
              <div className="bl-sr-flagrow">
                <button type="button" className="bl-sr-flagprev" onClick={prevFlag} title="Previous flag"><SkipBack size={13} /></button>
                <button type="button" className="bl-sr-nextflag" onClick={nextFlag}>Next flag <SkipForward size={13} /></button>
              </div>
            </div>
          </div>

          {/* ── Review panel ── */}
          <div className="bl-sr-panel" ref={panelRef}>
            <div className="bl-sr-drag" onMouseDown={startDrag} title="Drag to resize" />

            <div className="bl-sr-tabs">
              {TABS.map((t) => (
                <button
                  key={t.key}
                  type="button"
                  className={`bl-sr-tab ${tab === t.key ? "is-active" : ""}`}
                  onClick={() => pickTab(t.key)}
                >
                  {t.label}{t.count ? <span className="bl-sr-tab-count">{t.count}</span> : null}
                </button>
              ))}
            </div>

            <div className="bl-sr-body">

              {tab === "review" && (
                <div>
                  <div className="bl-sr-score">
                    <div className="bl-sr-score-top">
                      <div className="bl-sr-score-num">{overallScore != null ? overallScore : "–"}<span>/ 100</span></div>
                      <span className="bl-sr-chip" style={{ background: tone.bg, color: tone.fg }}>{decisionLabel}</span>
                    </div>
                    <div className="bl-sr-scorebar">
                      <div style={{ width: (overallScore != null ? overallScore : 0) + "%" }} />
                    </div>
                    <div className="bl-sr-score-meta">
                      <span className={"bl-sr-passdot" + (flaggedView ? " is-flag" : "")}>● {summaryText}</span>
                      <span>{groupsShort}</span>
                    </div>
                    {rf.rv_reasoning ? <p className="bl-sr-score-note">{stripHtmlText(rf.rv_reasoning)}</p> : null}
                  </div>
                  {checks.length ? null : (
                    <p className="bl-sr-empty">
                      This submission has not been checked yet. Once the review runs, every
                      criterion appears here with its score, its verdict and the frame it was judged on.
                    </p>
                  )}
                  {flaggedView && (
                    <div className="bl-sr-flagged">
                      <div className="bl-sr-flagged-head"><Flag size={13} /> {flaggedChecks.length ? "What was flagged" : "Why it was flagged"}</div>
                      {flaggedChecks.map((c) => renderCheck(c))}
                      {!flaggedChecks.length && !rf.rv_action ? (
                        <p className="bl-sr-flagged-action">The summary above explains why the review flagged this video.</p>
                      ) : null}
                      {rf.rv_action ? (
                        <p className="bl-sr-flagged-action"><b>What to do:</b> {stripHtmlText(rf.rv_action)}</p>
                      ) : null}
                    </div>
                  )}
                  {flaggedView && restChecks.length > 0 && (
                    <button type="button" className="bl-sr-passtoggle" onClick={() => setShowPassed((v) => !v)}>
                      <span>{showPassed ? "Hide" : "Show"} {restAllPass ? "the " + restChecks.length + (restChecks.length === 1 ? " check that passed" : " checks that passed") : "the other " + restChecks.length + (restChecks.length === 1 ? " check" : " checks")}</span>
                      <ChevronDown size={15} className={"bl-sr-chev" + (showPassed ? " is-open" : "")} />
                    </button>
                  )}
                  {(!flaggedView || showPassed) && GROUP_ORDER.map((g) => {
                    const rows = (flaggedView ? restChecks : checks).filter((c) => c.group === g);
                    if (!rows.length) return null;
                    const gPass = rows.filter((c) => isPassStatus(c.status)).length;
                    const open = !!openGroups[g];
                    return (
                      <div key={g} className="bl-sr-group">
                        <button type="button" className="bl-sr-group-head" onClick={() => flipGroup(g)}>
                          <span className="bl-sr-group-ic">{groupIcon(g)}</span>
                          <span className="bl-sr-group-name">{g}</span>
                          <span className="bl-sr-group-pass">{gPass} pass</span>
                          <ChevronDown size={15} className={`bl-sr-chev ${open ? "is-open" : ""}`} />
                        </button>
                        {open && rows.map((c) => {
                          const st = statusTone(c.status);
                          return (
                            <div key={c.id} className="bl-sr-check">
                              {c.screenshot
                                ? <img className="bl-sr-check-shot" src={c.screenshot} alt="" loading="lazy" onClick={() => c.sec != null && seek(c.sec)} />
                                : <span className="bl-sr-check-shot is-empty" />}
                              <div className="bl-sr-check-main">
                                <div className="bl-sr-check-top">
                                  <b>{c.criteria}</b>
                                  {c.score ? <span className="bl-sr-check-score" style={{ color: st.fg }}>● {c.score}</span> : null}
                                </div>
                                {c.comment ? <p>{c.comment}</p> : null}
                                {c.sec != null && (
                                  <button type="button" className="bl-sr-time" onClick={() => seek(c.sec)}>
                                    <Play size={9} /> {fmtTime(c.sec)}
                                  </button>
                                )}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    );
                  })}

                  <div className="bl-sr-decide">
                    <span className="bl-sr-decide-lab">{humanDecided ? decidedLine : "Your decision"}</span>
                    <div className="bl-sr-decide-row">
                      <button
                        type="button"
                        className={"bl-sr-decide-btn is-changes" + (humanLabel === "Changes Requested" ? " is-on" : "")}
                        onClick={() => openAsk("changes")}
                        disabled={deciding}
                      >
                        <Pencil size={14} /> Revise
                      </button>
                      <button
                        type="button"
                        className={"bl-sr-decide-btn is-approve" + (humanLabel === "Approve" ? " is-on" : "")}
                        onClick={() => openAsk("approve")}
                        disabled={deciding}
                      >
                        <Check size={14} /> Approve
                      </button>
                      <button
                        type="button"
                        className={"bl-sr-decide-btn is-reject" + (humanLabel === "Reject" ? " is-on" : "")}
                        onClick={() => openAsk("reject")}
                        disabled={deciding}
                      >
                        <X size={14} /> Reject
                      </button>
                    </div>
                  </div>
                </div>
              )}

              {tab === "report" && (
                <div>
                  <div className="bl-sr-report-bar">
                    <span className="bl-sr-muted">{passCount} / {checks.length} criteria passed</span>
                    <span className="bl-sr-report-tools">
                      <button type="button" className={`bl-sr-mini ${reportView === "list" ? "is-on" : ""}`} onClick={() => setReportView("list")} title="List"><ListIcon size={13} /></button>
                      <button type="button" className={`bl-sr-mini ${reportView === "grid" ? "is-on" : ""}`} onClick={() => setReportView("grid")} title="Grid"><LayoutGrid size={13} /></button>
                      <button type="button" className="bl-sr-mini" onClick={exportCsv} title="Export CSV">CSV</button>
                    </span>
                  </div>
                  {!checks.length ? (
                    <p className="bl-sr-empty">
                      No criteria to report on yet. This fills in as soon as the submission has been reviewed.
                    </p>
                  ) : reportView === "list" ? (
                    <table className="bl-sr-table">
                      <thead><tr><th></th><th>Criteria</th><th>Score</th><th>Status</th><th>Severity</th><th>Comment</th></tr></thead>
                      <tbody>
                        {checks.map((c) => {
                          const st = statusTone(c.status), sv = severityTone(c.severity);
                          return (
                            <tr key={c.id} onClick={() => c.sec != null && seek(c.sec)}>
                              <td>{c.screenshot ? <img src={c.screenshot} alt="" loading="lazy" /> : null}</td>
                              <td><b>{c.criteria}</b>{c.sec != null ? <span className="bl-sr-muted"> · {fmtTime(c.sec)}</span> : null}</td>
                              <td>{c.score}</td>
                              <td><span className="bl-sr-pill" style={{ background: st.bg, color: st.fg }}>{c.status}</span></td>
                              <td>{c.severity ? <span className="bl-sr-pill" style={{ background: sv.bg, color: sv.fg }}>{c.severity}</span> : <span className="bl-sr-muted">—</span>}</td>
                              <td className="bl-sr-td-comment">{c.comment}</td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  ) : (
                    <div className="bl-sr-cards">
                      {checks.map((c) => {
                        const st = statusTone(c.status);
                        return (
                          <div key={c.id} className="bl-sr-card" onClick={() => c.sec != null && seek(c.sec)}>
                            <div className="bl-sr-card-thumb">
                              {c.screenshot ? <img src={c.screenshot} alt="" loading="lazy" /> : null}
                              <span className="bl-sr-pill" style={{ background: st.bg, color: st.fg }}>{c.status}</span>
                            </div>
                            <div className="bl-sr-card-meta">
                              <b>{c.criteria}</b>
                              {c.score ? <span>{c.score}</span> : null}
                              <p>{c.comment}</p>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              )}

              {tab === "ask" && (
                <div className="bl-sr-ask">
                  <div className="bl-sr-ask-scroll" ref={chatScrollRef}>
                    {[{ role: "lee", text: welcome }].concat(chat).map((m, i) => (
                      <div key={i} className={`bl-sr-msg ${m.role === "lee" ? "is-lee" : "is-user"}`}>
                        {m.role === "lee" && <span className="bl-sr-msg-ava"><Sparkles size={11} /></span>}
                        <p>{m.text}</p>
                      </div>
                    ))}
                    {chatBusy && <div className="bl-sr-msg is-lee"><span className="bl-sr-msg-ava"><Sparkles size={11} /></span><p className="bl-sr-dots"><i>·</i><i>·</i><i>·</i></p></div>}
                  </div>
                  <div className="bl-sr-chips">
                    {["Compare to my brief", "Draft revision notes", "Rewrite the CTA"].map((c) => (
                      <button key={c} type="button" onClick={() => askLee(c)} disabled={chatBusy}>{c}</button>
                    ))}
                  </div>
                  <div className="bl-sr-ask-input">
                    <input
                      ref={askRef}
                      placeholder="Ask anything about this video…"
                      onKeyDown={(e) => {
                        if (e.key === "Enter") { askLee(e.currentTarget.value); e.currentTarget.value = ""; }
                      }}
                      disabled={chatBusy}
                    />
                    <button type="button" onClick={() => { askLee(askRef.current?.value); if (askRef.current) askRef.current.value = ""; }} disabled={chatBusy}>
                      <Send size={13} />
                    </button>
                  </div>
                </div>
              )}

              {tab === "comments" && (
                <div className="bl-sr-comments">
                  <p className="bl-sr-muted bl-sr-thread-note">{comments.length ? comments.length + " comment" + (comments.length === 1 ? "" : "s") + ", sorted by time in video" : "No comments yet. Pause the video where you have a note and write the first one."}</p>
                  {comments.map((c, i) => (
                    <div key={c.id} className={`bl-sr-comment ${i === nearestIdx(comments) ? "is-active" : ""}`}>
                      <span className="bl-sr-ava">{initialsOf(c.author)}</span>
                      <div className="bl-sr-comment-main">
                        <div className="bl-sr-comment-top">
                          <b>{c.author}</b>
                          <button type="button" className="bl-sr-time" onClick={() => seek(c.sec)}>
                            <Play size={9} /> {fmtTime(c.sec)}
                          </button>
                          <span className="bl-sr-muted">{agoLabel(c.created)}</span>
                        </div>
                        <p>{c.text}</p>
                      </div>
                    </div>
                  ))}
                  <div className="bl-sr-composer">
                    <textarea
                      value={draft}
                      placeholder={"Comment at " + fmtTime(nowSec) + "…"}
                      onChange={(e) => setDraft(e.target.value)}
                      onKeyDown={(e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); postComment(); } }}
                      disabled={posting}
                    />
                    <button type="button" onClick={postComment} disabled={posting || !draft.trim()}>
                      <Send size={13} /> {posting ? "Posting…" : "Comment"}
                    </button>
                  </div>
                </div>
              )}

              {(tab === "transcript" || tab === "remix") && (
                <div>
                  <div className="bl-sr-report-bar">
                    <span className="bl-sr-muted">{tab === "transcript" ? "What the creator said in their video" : "Their script rewritten for your brand"}</span>
                    <button
                      type="button"
                      className="bl-sr-mini"
                      onClick={() => copyText(
                        (tab === "transcript" ? transcript : remix).map((r) => (r.sec != null ? "[" + fmtTime(r.sec) + "] " : "") + r.text).join("\n"),
                        tab === "transcript" ? "Transcript" : "Script"
                      )}
                    >
                      <Copy size={12} /> Copy {tab === "transcript" ? "transcript" : "script"}
                    </button>
                  </div>
                  {(tab === "transcript" ? transcript : remix).length ? (
                    (tab === "transcript" ? transcript : remix).map((r, i) => (
                      <div
                        key={i}
                        className={`bl-sr-line ${i === nearestIdx(tab === "transcript" ? transcript : remix) ? "is-active" : ""}`}
                        onClick={() => r.sec != null && seek(r.sec)}
                      >
                        {r.sec != null && <span className="bl-sr-line-time">{fmtTime(r.sec)}</span>}
                        <p>{r.text}</p>
                      </div>
                    ))
                  ) : (
                    <p className="bl-sr-muted">{tab === "transcript" ? "No transcript yet." : "No script yet."}</p>
                  )}
                </div>
              )}

              {tab === "details" && (
                <div className="bl-sr-details">
                  <div className="bl-sr-submitter">
                    <span className="bl-sr-ava is-big">{initialsOf(creatorName)}</span>
                    <div>
                      <b>{creatorName}</b>
                      <span className="bl-sr-muted">{unwrap(sf.sub_email)}</span>
                    </div>
                    <span className="bl-sr-chip" style={{ background: tone.bg, color: tone.fg }}>{decisionLabel}</span>
                  </div>
                  {[
                    ["Submission type", selectLabel(sf.sub_type)],
                    ["Campaign", briefName],
                    ["Submitted", fmtDate(sf.sub_created)],
                    ["Version", unwrap(sf.sub_version)],
                    ["Video length", duration ? fmtTime(duration) : unwrap(sf.sub_duration)],
                    ["Overall rating", rating ? "★".repeat(rating) + "☆".repeat(5 - rating) : ""],
                  ].filter(([, v]) => v).map(([k, v]) => (
                    <div key={k} className="bl-sr-field"><span>{k}</span><b>{v}</b></div>
                  ))}
                </div>
              )}

              {tab === "people" && (
                <div>
                  <div className="bl-sr-report-bar">
                    <span className="bl-sr-muted">{members.length} {members.length === 1 ? "person" : "people"} on this submission</span>
                    <button type="button" className="bl-sr-mini" onClick={() => setAsk("invite")}><UserPlus size={12} /> Invite</button>
                  </div>
                  {members.length ? members.map((r) => {
                    const fl = r.fields || {};
                    const you = unwrap(fl.mb_email) && unwrap(fl.mb_email) === unwrap(user?.email);
                    const st = statusTone(selectLabel(fl.mb_status));
                    return (
                      <div key={r.id} className="bl-sr-member">
                        <span className="bl-sr-ava">{initialsOf(unwrap(fl.mb_name))}</span>
                        <div className="bl-sr-member-main">
                          <b>{unwrap(fl.mb_name) || "Invited"}{you ? <span className="bl-sr-you">YOU</span> : null}</b>
                          <span className="bl-sr-muted">{unwrap(fl.mb_email)}</span>
                        </div>
                        <span className="bl-sr-pill" style={{ background: st.bg, color: st.fg }}>{selectLabel(fl.mb_status)}</span>
                        <span className="bl-sr-muted">{selectLabel(fl.mb_access)}</span>
                      </div>
                    );
                  }) : <p className="bl-sr-muted">Nobody has been invited to this submission yet.</p>}
                </div>
              )}

            </div>
          </div>
        </div>
        {ask ? (
          <SmallModal
            title={ask === "approve" ? "Approve this video?" : ask === "reject" ? "Reject this video?" : ask === "changes" ? "Request changes" : "Add people to this video"}
            helper={ask === "invite" ? "They get the link to this review and show up under People." : subName + " from " + creatorName}
            onClose={() => { if (!deciding && !inviting) setAsk(null); }}
          >
            {ask === "approve" ? (
              <>
                <p>The video is marked approved and the creator hears it is good to go. You can undo for a few seconds after.</p>
                <div className="bl-sr-modal-actions">
                  <button type="button" className="bl-sr-mbtn" onClick={() => setAsk(null)} disabled={deciding}>Cancel</button>
                  <button type="button" className="bl-sr-mbtn is-primary" onClick={() => decide(HUMAN_APPROVE)} disabled={deciding}>{deciding ? "Saving…" : "Approve"}</button>
                </div>
              </>
            ) : ask === "reject" ? (
              <>
                <p>The video is marked rejected and the creator sees "Not approved". You can undo for a few seconds after.</p>
                <div className="bl-sr-modal-actions">
                  <button type="button" className="bl-sr-mbtn" onClick={() => setAsk(null)} disabled={deciding}>Cancel</button>
                  <button type="button" className="bl-sr-mbtn is-danger" onClick={() => decide(HUMAN_REJECT)} disabled={deciding}>{deciding ? "Saving…" : "Reject"}</button>
                </div>
              </>
            ) : ask === "changes" ? (
              <>
                <p>What should change in the next cut? The creator reads this on their result page.</p>
                <textarea className="bl-sr-textarea" rows={5} value={changeNote} onChange={(e) => setChangeNote(e.target.value)} placeholder="One line per change." />
                <div className="bl-sr-modal-actions">
                  <button type="button" className="bl-sr-mbtn" onClick={() => setAsk(null)} disabled={deciding}>Cancel</button>
                  <button type="button" className="bl-sr-mbtn is-primary" onClick={() => decide(HUMAN_CHANGES, changeNote.trim())} disabled={deciding || !changeNote.trim()}>{deciding ? "Sending…" : "Send to the creator"}</button>
                </div>
              </>
            ) : (
              <>
                <label className="bl-sr-field-label">Email</label>
                <input className="bl-sr-input" type="email" value={inv.email} onChange={(e) => setInv({ ...inv, email: e.target.value })} placeholder="name@company.com" />
                <label className="bl-sr-field-label">Name <span>optional</span></label>
                <input className="bl-sr-input" type="text" value={inv.name} onChange={(e) => setInv({ ...inv, name: e.target.value })} placeholder="Their name" />
                <label className="bl-sr-field-label">Access</label>
                <select className="bl-sr-input" value={inv.access} onChange={(e) => setInv({ ...inv, access: e.target.value })}>
                  <option value="comment">Comment only</option>
                  <option value="view">View only</option>
                  <option value="full">Full access</option>
                </select>
                <label className="bl-sr-field-label">Message <span>optional</span></label>
                <textarea className="bl-sr-textarea" rows={3} value={inv.message} onChange={(e) => setInv({ ...inv, message: e.target.value })} placeholder="A line on why you're sharing this." />
                <div className="bl-sr-modal-actions">
                  <button type="button" className="bl-sr-mbtn" onClick={() => setAsk(null)} disabled={inviting}>Cancel</button>
                  <button type="button" className="bl-sr-mbtn is-primary" onClick={sendInvite} disabled={inviting || !inv.email.trim()}><UserPlus size={14} /> {inviting ? "Adding…" : "Add them"}</button>
                </div>
              </>
            )}
          </SmallModal>
        ) : null}
      </div>
    </>
  );
}

