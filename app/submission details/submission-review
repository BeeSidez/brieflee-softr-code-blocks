// ─── Helpers ──────────────────────────────────────────────────
function unwrap(raw) {
  if (raw == null) return "";
  if (typeof raw === "string") return raw.trim();
  if (Array.isArray(raw)) return raw.map(unwrap).filter(Boolean).join(", ");
  if (typeof raw === "object") return raw.label || raw.value || raw.name || "";
  return String(raw);
}
function selectLabel(raw) {
  if (!raw) return "";
  if (typeof raw === "string") return raw;
  if (Array.isArray(raw)) return raw.map(selectLabel).filter(Boolean).join(", ");
  return raw.label || "";
}
function asArray(raw) {
  if (Array.isArray(raw)) return raw;
  if (raw == null) return [];
  return [raw];
}
// useRecords data arrives flat, wrapped, or as infinite-query pages
// ({ pages: [{ offset, total, items }] }). Flatten every shape.
function recordsOf(raw) {
  if (!raw) return [];
  if (Array.isArray(raw)) return raw;
  if (Array.isArray(raw.records)) return raw.records;
  if (Array.isArray(raw.items)) return raw.items;
  if (Array.isArray(raw.data)) return raw.data;
  if (Array.isArray(raw.pages)) {
    return raw.pages.flatMap((p) => Array.isArray(p) ? p : (p?.items || p?.records || p?.data || []));
  }
  return [];
}
// Linked entries arrive as {id,label} pairs or plain labels — match
// either against a record id or its primary-field name.
function linkedTo(raw, id, name) {
  return asArray(raw).some((x) => {
    if (!x) return false;
    const xid = typeof x === "string" ? x : (x.id || "");
    if (xid && xid === id) return true;
    const label = typeof x === "string" ? x : (x.label || "");
    return !!name && label.trim() === name;
  });
}
function stripHtmlText(html) {
  if (!html) return "";
  return String(html)
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/(p|div|li|tr|h[1-6])>/gi, "\n")
    .replace(/<[^>]+>/g, "")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}
function fmtTime(sec) {
  const s = Math.max(0, Math.floor(Number(sec) || 0));
  return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
}
function fmtDate(iso) {
  if (!iso) return "";
  try {
    return new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
  } catch { return String(iso); }
}
function agoLabel(iso) {
  if (!iso) return "";
  try {
    const mins = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
    if (mins < 60) return mins + "m";
    const hrs = Math.round(mins / 60);
    if (hrs < 24) return hrs + "h";
    return Math.round(hrs / 24) + "d";
  } catch { return ""; }
}
function initialsOf(name) {
  return String(name || "?").split(/\s+/).map((w) => w[0]).filter(Boolean).slice(0, 2).join("").toUpperCase();
}
// Status + severity pills (labels vary across the flows).
function statusTone(label) {
  const s = String(label || "").toUpperCase();
  if (/PASS|ALIGNED|APPROVE|CLEAR|SAFE/.test(s)) return { bg: PASS_BG, fg: PASS_FG };
  if (/FAIL|REJECT|MISALIGNED/.test(s)) return { bg: FAIL_BG, fg: FAIL_FG };
  return { bg: WARN_BG, fg: WARN_FG };
}
function severityTone(label) {
  const s = String(label || "").toLowerCase();
  if (/critical|major/.test(s)) return { bg: FAIL_BG, fg: FAIL_FG };
  if (/warn|adjust|medium/.test(s)) return { bg: WARN_BG, fg: WARN_FG };
  return { bg: "rgba(154,166,195,0.14)", fg: MUTED };
}
const isPassStatus = (label) => /PASS|ALIGNED|APPROVE|CLEAR|SAFE/.test(String(label || "").toUpperCase());
// The seconds hiding in key_moment_timestamp select labels ("0","33").
function momentSec(raw) {
  const label = selectLabel(raw);
  const n = parseInt(label, 10);
  return Number.isFinite(n) ? n : null;
}
// Group the agent checks the way the design does.
// The AI stores the frame it judged a criterion on as a Cloudinary
// screenshot whose transform carries the second: ".../so_8/c_fill,...".
// That offset IS the moment, so rows stay clickable-to-seek without a
// separate moment field.
function soSec(url) {
  const m = /\/so_(\d+)[,/]/.exec(String(url || ""));
  return m ? Number(m[1]) : null;
}

function checkGroup(criteria) {
  const c = String(criteria || "").toLowerCase();
  if (/hook|pacing|scene/.test(c)) return "Hook & attention";
  if (/energy|authentic|wardrobe|appearance|audio|legibility|light|face|creator visib|product/.test(c)) return "Production quality";
  if (/copyright|moderation|brand|alignment|safe/.test(c)) return "Compliance & safety";
  return "Other checks";
}
const GROUP_ORDER = ["Hook & attention", "Production quality", "Compliance & safety", "Other checks"];
// Parse a transcript / adapted script into timestamped rows.
// Handles "[12s]", "[0:12]", "[12]" markers; text between markers is
// the row body. Falls back to one plain row when no markers exist.
function parseScript(rawText) {
  const text = stripHtmlText(rawText);
  if (!text) return [];
  const re = /\[(\d+):(\d{1,2})\]|\[(\d+)\s*s?\]/g;
  const marks = [];
  let m;
  while ((m = re.exec(text))) {
    const sec = m[1] != null ? Number(m[1]) * 60 + Number(m[2]) : Number(m[3]);
    marks.push({ sec, at: m.index, len: m[0].length });
  }
  if (!marks.length) return [{ sec: null, text }];
  const rows = [];
  for (let i = 0; i < marks.length; i++) {
    const start = marks[i].at + marks[i].len;
    const end = i + 1 < marks.length ? marks[i + 1].at : text.length;
    const body = text.slice(start, end).replace(/^[\s:·—-]+/, "").trim();
    if (body) rows.push({ sec: marks[i].sec, text: body });
  }
  return rows.length ? rows : [{ sec: null, text }];
}
// Client-side CSV for the report tab.
function reportCsv(rows) {
  const esc = (v) => '"' + String(v == null ? "" : v).replace(/"/g, '""') + '"';
  const head = ["Criteria", "Score", "Status", "Severity", "Rating", "Moment", "Comment"];
  const lines = [head.join(",")].concat(rows.map((r) => [
    r.criteria, r.score, r.status, r.severity, r.rating, r.sec == null ? "" : fmtTime(r.sec), r.comment,
  ].map(esc).join(",")));
  return lines.join("\n");
}

// A small centred modal in the brief page's Share panel style: one card,
// a title, a helper line, the content, the buttons.
function SmallModal({ title, helper, children, onClose }) {
  useEffect(() => {
    const onKey = (e) => { if (e.key === "Escape") onClose(); };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [onClose]);
  return (
    <div className="bl-sr-overlay" onMouseDown={(e) => { if (e.target === e.currentTarget) onClose(); }}>
      <div className="bl-sr-modal" role="dialog" aria-modal="true" aria-label={title}>
        <div className="bl-sr-modal-title">{title}</div>
        {helper ? <div className="bl-sr-modal-helper">{helper}</div> : null}
        <div className="bl-sr-modal-body">{children}</div>
      </div>
    </div>
  );
}

