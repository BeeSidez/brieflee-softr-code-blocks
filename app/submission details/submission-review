// A number with no country code cannot be dialled from here, and
// guessing one from the workspace would text a stranger. Skip it.
function toE164(raw) {
  const v = String(raw || "").trim();
  if (!v) return "";
  const digits = v.replace(/[^\d]/g, "");
  if (v.startsWith("+")) return digits ? "+" + digits : "";
  if (v.startsWith("00")) return digits.length > 2 ? "+" + digits.slice(2) : "";
  return "";
}
// A checkbox arrives as true, "true", or a one-item array of either.
function truthyFlag(raw) {
  if (Array.isArray(raw)) return raw.some(truthyFlag);
  return raw === true || raw === "true" || raw === 1;
}
function firstNameOf(full) {
  return String(full || "").trim().split(/\s+/)[0] || "there";
}
async function sendWhatsApp(proxy, { to, template, variables }) {
  const num = toE164(to);
  if (!proxy || !num || !template) return false;
  const body = new URLSearchParams({
    To: "whatsapp:" + num,
    From: WA_FROM,
    ContentSid: template,
    ContentVariables: JSON.stringify(variables || {}),
  });
  const res = await proxy(
    "https://api.twilio.com/2010-04-01/Accounts/" + TWILIO_ACCOUNT + "/Messages.json",
    {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: body.toString(),
    }
  );
  return !!(res && res.ok);
}

