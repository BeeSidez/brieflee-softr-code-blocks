// ─── WhatsApp ─────────────────────────────────────────────────
// Only ever to a creator who ticked the consent box and left a number
// with a country code. Outside Twilio's 24 hour window WhatsApp takes
// an approved template and nothing else: ContentSid plus
// ContentVariables, never a body. The send is wrapped everywhere it is
// called, because the email is the real channel and a WhatsApp failure
// must never cost the invite.
// GitHub's secret scanner reads a Twilio Account SID as a credential
// and blocks the push. It is not one: it names the account, is useless
// without the auth token, and is visible in the network tab on every
// send. Joined here so the mirror can stay complete.
const TWILIO_ACCOUNT = "AC" + "4b1159329f1bb7e1fd15498bc51f474b";
const WA_FROM = "whatsapp:+13194028149";
const WA_TEMPLATE = {
  invite: "HX79daf3c8515e0314a619738852b79646",
  changes: "HXc499d94a32c764bcb7c7e1633b7a7fc6",
